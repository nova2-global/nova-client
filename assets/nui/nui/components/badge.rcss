/* Badge: <span class="nui-badge nui-badge--success">3</span>.
   Variants: --accent, --danger, --warning, --success; the default is neutral. */

.nui-badge
{
	display: inline-block;
	height: 18dp;
	padding: 0 7dp;
	border-radius: 9999dp;
	background-color: var(--selection);
	color: var(--accent);
	font-size: var(--font-xs);
	font-weight: bold;
	line-height: 18dp;
	white-space: nowrap;
	vertical-align: middle;
}
.nui-badge--accent
{
	background-color: var(--selection);
	color: var(--accent);
}
.nui-badge--danger
{
	background-color: var(--slot-disabled);
	color: var(--danger);
}
.nui-badge--warning
{
	background-color: var(--slot-usable);
	color: var(--warning);
}
.nui-badge--success
{
	background-color: var(--success);
	color: var(--accent-text);
}
