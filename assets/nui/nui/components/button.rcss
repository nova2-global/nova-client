/* Button: <button class="nui-button nui-button--primary nui-anim">.
   Variants: --primary, --secondary (default look), --ghost, --danger.
   Sizes: --small, --icon (square). Disabled: the `disabled` attribute
   (static, or data-attrif-disabled="expr"); it also blocks clicks.
   is-hover, is-active and is-focus force a state without the pointer or the
   keyboard (gallery snapshots, data-driven highlights). */

.nui-button
{
	display: inline-block;
	box-sizing: border-box;
	height: 32dp;
	padding: 0 var(--space-4);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: var(--radius-md);
	background-color: var(--surface-raised);
	color: var(--text);
	font-size: var(--font-md);
	font-weight: bold;
	line-height: 30dp;
	text-align: center;
	white-space: nowrap;
	tab-index: auto;
}
.nui-button:hover, .nui-button.is-hover
{
	background-color: var(--surface-hover);
}
.nui-button:active, .nui-button.is-active
{
	background-color: var(--surface-sunken);
	transform: translateY(1dp);
}
.nui-button:focus-visible, .nui-button.is-focus
{
	border-color: var(--focus-ring);
}
.nui-button[disabled], .nui-button:disabled
{
	opacity: 0.45;
	pointer-events: none;
}

/* Hover and press fade (--dur-fast, --ease-out). */
.nui-button.nui-anim
{
	transition: background-color border-color color 0.1s cubic-out;
}

.nui-button--primary
{
	background-color: var(--accent);
	border-color: var(--accent);
	color: var(--accent-text);
}
.nui-button--primary:hover, .nui-button--primary.is-hover
{
	background-color: var(--accent-hover);
	border-color: var(--accent-hover);
}
.nui-button--primary:active, .nui-button--primary.is-active
{
	background-color: var(--accent);
	border-color: var(--accent);
}

.nui-button--danger
{
	background-color: var(--danger);
	border-color: var(--danger);
	color: var(--accent-text);
}
.nui-button--danger:hover, .nui-button--danger.is-hover
{
	background-color: var(--danger-hover);
	border-color: var(--danger-hover);
}
.nui-button--danger:active, .nui-button--danger.is-active
{
	background-color: var(--danger);
	border-color: var(--danger);
}

.nui-button--ghost
{
	background-color: transparent;
	border-color: transparent;
}
.nui-button--ghost:hover, .nui-button--ghost.is-hover
{
	background-color: var(--surface-hover);
	border-color: transparent;
}
.nui-button--ghost:active, .nui-button--ghost.is-active
{
	background-color: var(--surface-sunken);
}

/* Focus wins over the variant border colors (same specificity, later rule). */
.nui-button--primary:focus-visible, .nui-button--danger:focus-visible, .nui-button--ghost:focus-visible,
.nui-button--primary.is-focus, .nui-button--danger.is-focus, .nui-button--ghost.is-focus
{
	border-color: var(--focus-ring);
}

.nui-button--small
{
	height: 24dp;
	padding: 0 var(--space-2);
	font-size: var(--font-sm);
	line-height: 22dp;
}
.nui-button--icon
{
	width: 32dp;
	padding: 0;
	font-size: var(--font-lg);
}
.nui-button--small.nui-button--icon
{
	width: 24dp;
	font-size: var(--font-md);
}
