/* Chat lines (docs/ui/AUTHORING.md "Chat lines"). The runtime registers
   nui-chat-lines; it reads the C++ feed chat.<view>.lines and makes one
   absolutely placed line element per line, keyed by the line's id, so an
   append lays out one line and moves the others by their bottom offset.

   <nui-chat-lines view="window" step="15" data-attr-mode="open ? 'edit' : 'view'"/>
   	view mode (the chat closed): the newest 4 lines younger than 5 s (legacy
   	keeps five but fades the fifth newest at once), each fading out
   	(is-fading) before it goes; the element sets its own height to its
   	lines. edit and log modes: as many lines as its height holds,
   	the newest at the bottom; in edit mode the top two get is-edge-0 and
   	is-edge-1, legacy's ramp.

   A line is div.nui-chat__line.nui-anim.nui-chat__line--t<type>, its runs
   spans (text.rcss); a run without a color tag takes the line's color, the
   chat type's token (CHAT_TYPE_TALKING 0 to BIG_NOTICE 8, Packet.h). The
   lines are single, not wrapped, as legacy draws them. Under reduced motion
   a line goes without its fade (the element removes it at once). */

nui-chat-lines
{
	display: block;
	position: relative;
}
.nui-chat__line
{
	position: absolute;
	white-space: nowrap;
	height: 15dp;
	line-height: 15dp;
	font-size: var(--font-sm);
	color: var(--chat-talking);
}
.nui-chat__line--t0 { color: var(--chat-talking); }
.nui-chat__line--t1 { color: var(--chat-info); }
.nui-chat__line--t2 { color: var(--chat-notice); }
.nui-chat__line--t3 { color: var(--chat-party); }
.nui-chat__line--t4 { color: var(--chat-guild); }
.nui-chat__line--t5 { color: var(--chat-command); }
.nui-chat__line--t6 { color: var(--chat-shout); }
.nui-chat__line--t7 { color: var(--chat-whisper); }
.nui-chat__line--t8 { color: var(--chat-big-notice); }
/* Legacy's ramp of a full open chat (CPythonChat::UpdateEditMode): the top
   line clear, the next at half. */
.nui-chat__line.is-edge-0
{
	opacity: 0;
}
.nui-chat__line.is-edge-1
{
	opacity: 0.5;
}
/* A closed chat's line fades as a whole in legacy's time (D13): 0.36 s, the
   tenth per frame at 60 fps of PythonChat.cpp. The element steps the line's
   inline opacity (three steps, its fade-steps): an opacity change rebuilds
   the line's meshes, so a transition here would rebuild them every frame.
   is-fading marks the line while it fades. */

/* The sender's language flag and empire flag at the start of a shout line
   (NOVA-51, NOVA-110; the element's "Marks", ElementChatLines.h):
   span.nui-chat__flag.nui-chat__flag--lang.nui-chat__flag--lang-<code>, then
   span.nui-chat__flag.nui-chat__flag--empire.nui-chat__flag--empire-<1..3>,
   before the runs (OLD's order). Modern themes draw the empire select's
   banners (the same art the empire and select windows show; a flag is
   content art, nui/content-art.json), 20 x 12dp, about their 128 x 79 aspect,
   inside the 15dp line, and the login strip's flags (server_flag_<code>,
   22 x 17) contained in the same box, so they keep their aspect; the classic
   skin draws OLD's 20 x 15 flags (classic.rcss). The size and the 4dp gap
   after each flag are defaults, Eddy to confirm. */
.nui-chat__flag
{
	display: inline-block;
	width: 20dp;
	height: 12dp;
	margin-right: 4dp;
	vertical-align: middle;
}
.nui-chat__flag--empire-1 { decorator: image("d:/ymir work/ui/intro/empire/empireflag_a.sub"); }
.nui-chat__flag--empire-2 { decorator: image("d:/ymir work/ui/intro/empire/empireflag_b.sub"); }
.nui-chat__flag--empire-3 { decorator: image("d:/ymir work/ui/intro/empire/empireflag_c.sub"); }
.nui-chat__flag--lang-en { decorator: image("d:/ymir work/ui/intro/login/server_flag_en.sub" contain); }
.nui-chat__flag--lang-ae { decorator: image("d:/ymir work/ui/intro/login/server_flag_ae.sub" contain); }
.nui-chat__flag--lang-br { decorator: image("d:/ymir work/ui/intro/login/server_flag_br.sub" contain); }
.nui-chat__flag--lang-cz { decorator: image("d:/ymir work/ui/intro/login/server_flag_cz.sub" contain); }
.nui-chat__flag--lang-de { decorator: image("d:/ymir work/ui/intro/login/server_flag_de.sub" contain); }
.nui-chat__flag--lang-dk { decorator: image("d:/ymir work/ui/intro/login/server_flag_dk.sub" contain); }
.nui-chat__flag--lang-es { decorator: image("d:/ymir work/ui/intro/login/server_flag_es.sub" contain); }
.nui-chat__flag--lang-fr { decorator: image("d:/ymir work/ui/intro/login/server_flag_fr.sub" contain); }
.nui-chat__flag--lang-gr { decorator: image("d:/ymir work/ui/intro/login/server_flag_gr.sub" contain); }
.nui-chat__flag--lang-hu { decorator: image("d:/ymir work/ui/intro/login/server_flag_hu.sub" contain); }
.nui-chat__flag--lang-it { decorator: image("d:/ymir work/ui/intro/login/server_flag_it.sub" contain); }
.nui-chat__flag--lang-nl { decorator: image("d:/ymir work/ui/intro/login/server_flag_nl.sub" contain); }
.nui-chat__flag--lang-pl { decorator: image("d:/ymir work/ui/intro/login/server_flag_pl.sub" contain); }
.nui-chat__flag--lang-pt { decorator: image("d:/ymir work/ui/intro/login/server_flag_pt.sub" contain); }
.nui-chat__flag--lang-ro { decorator: image("d:/ymir work/ui/intro/login/server_flag_ro.sub" contain); }
.nui-chat__flag--lang-ru { decorator: image("d:/ymir work/ui/intro/login/server_flag_ru.sub" contain); }
.nui-chat__flag--lang-tr { decorator: image("d:/ymir work/ui/intro/login/server_flag_tr.sub" contain); }
