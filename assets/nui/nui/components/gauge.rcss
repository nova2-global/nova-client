/* Gauge: <progress class="nui-gauge nui-gauge--red" direction="right"
   data-attr-value="hp"/>, with a value from 0 to 1 (max defaults to 1).
   Colors: --red, --pink, --purple, --blue (the legacy gauge colors); red is
   the default. RmlUi sizes the inner <fill> from the value, and the value
   shows at once: nothing eases toward it, so no Python runs per frame. Bind
   the value with data-attr-value; an inline style would be NUI009. A skin
   restyles it from its own sheets (classic: skins/classic/classic.rcss). */

progress.nui-gauge
{
	display: block;
	height: 6dp;
	background-color: var(--gauge-track);
	border-radius: 9999dp;
}
progress.nui-gauge fill
{
	background-color: var(--gauge-red);
	border-radius: 9999dp;
	decorator: linear-gradient(180deg, var(--text-inverse) 0%, var(--gauge-red) 24%, var(--gauge-red) 100%);
}
progress.nui-gauge--pink fill
{
	background-color: var(--gauge-pink);
	decorator: linear-gradient(180deg, var(--text-inverse) 0%, var(--gauge-pink) 24%, var(--gauge-pink) 100%);
}
progress.nui-gauge--purple fill
{
	background-color: var(--gauge-purple);
	decorator: linear-gradient(180deg, var(--text-inverse) 0%, var(--gauge-purple) 24%, var(--gauge-purple) 100%);
}
progress.nui-gauge--blue fill
{
	background-color: var(--gauge-blue);
	decorator: linear-gradient(180deg, var(--text-inverse) 0%, var(--gauge-blue) 24%, var(--gauge-blue) 100%);
}
