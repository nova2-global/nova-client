/* Glyphs: small pictograms drawn in code (docs/ui/AUTHORING.md "Code-drawn by
   default"), for buttons and chips that legacy draws with icon art. The
   shipped font holds none of these symbols, so each glyph is one to three
   spans shaped with boxes, borders (a zero-size box with one colored border
   is a triangle), radii and rotations:

   <span class="nui-glyph nui-glyph--send"><span class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span>

   Give every glyph __a and __b; __c only where its row below says so. The
   ink is the custom property --glyph-ink, var(--text) unless a context sets
   it (.my-button:hover .nui-glyph { --glyph-ink: var(--accent); }), so a
   glyph follows every theme, skin and player color. The glyph takes no
   pointer: presses go to its button. A glyph is 16dp square and sits on the
   text's middle; a context may scale it with a transform. Item, skill and
   other content icons stay images: glyphs are chrome only. Classic hides
   them (skins/classic/classic.rcss): it draws the legacy art instead.

   Names: close, plus, minus, chevron-up, chevron-down, chevron-left,
   chevron-right, send, log (c), chat, whisper (c), character, inventory,
   community (c), system (c), map, gift (c), gem, shop, heal, leave (c),
   mouse-move, mouse-attack (c), mouse-auto, mouse-camera (c), mouse-skill,
   home, coin, lock, and the rail's stall (c), ranking (c), events (c),
   achievements (c) and guide (c), whose __c is an accent part in
   --glyph-accent (var(--accent) unless a context sets it). Two or three
   elements each; nui.rtpl links this sheet after button.rcss. */

.nui-glyph
{
	--glyph-ink: var(--text);
	--glyph-accent: var(--accent);
	display: inline-block;
	position: relative;
	width: 16dp;
	height: 16dp;
	vertical-align: middle;
	pointer-events: none;
}
.nui-glyph__a, .nui-glyph__b, .nui-glyph__c
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	border-color: var(--glyph-ink);
}

/* close: two bars crossed at 45 degrees. */
.nui-glyph--close .nui-glyph__a, .nui-glyph--close .nui-glyph__b
{
	left: 1dp;
	top: 7dp;
	width: 14dp;
	height: 2dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--close .nui-glyph__a { transform: rotate(45deg); }
.nui-glyph--close .nui-glyph__b { transform: rotate(-45deg); }

/* plus and minus: bars at 0 and 90 degrees; minus keeps one. */
.nui-glyph--plus .nui-glyph__a, .nui-glyph--minus .nui-glyph__a
{
	left: 2dp;
	top: 7dp;
	width: 12dp;
	height: 2dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--plus .nui-glyph__b
{
	left: 7dp;
	top: 2dp;
	width: 2dp;
	height: 12dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--minus .nui-glyph__b
{
	display: none;
}

/* Chevrons: a corner of two 2dp borders, turned to point its way. */
.nui-glyph--chevron-up .nui-glyph__a, .nui-glyph--chevron-down .nui-glyph__a,
.nui-glyph--chevron-left .nui-glyph__a, .nui-glyph--chevron-right .nui-glyph__a
{
	left: 4dp;
	top: 4dp;
	width: 8dp;
	height: 8dp;
	border-width: 2dp 0 0 2dp;
}
.nui-glyph--chevron-up .nui-glyph__a { top: 6dp; transform: rotate(45deg); }
.nui-glyph--chevron-down .nui-glyph__a { top: 2dp; transform: rotate(225deg); }
.nui-glyph--chevron-left .nui-glyph__a { left: 6dp; transform: rotate(315deg); }
.nui-glyph--chevron-right .nui-glyph__a { left: 2dp; transform: rotate(135deg); }
.nui-glyph--chevron-up .nui-glyph__b, .nui-glyph--chevron-down .nui-glyph__b,
.nui-glyph--chevron-left .nui-glyph__b, .nui-glyph--chevron-right .nui-glyph__b
{
	display: none;
}

/* send: a triangle pointing right; a short shaft makes it a dart. */
.nui-glyph--send .nui-glyph__a
{
	left: 3dp;
	top: 2dp;
	width: 0;
	height: 0;
	border-width: 6dp 0 6dp 11dp;
	border-color: transparent transparent transparent var(--glyph-ink);
}
.nui-glyph--send .nui-glyph__b
{
	left: 1dp;
	top: 7dp;
	width: 5dp;
	height: 2dp;
	background-color: var(--glyph-ink);
}

/* log: three lines, the middle one shorter. */
.nui-glyph--log .nui-glyph__a, .nui-glyph--log .nui-glyph__b, .nui-glyph--log .nui-glyph__c
{
	left: 2dp;
	width: 12dp;
	height: 2dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--log .nui-glyph__a { top: 3dp; }
.nui-glyph--log .nui-glyph__b { top: 7dp; width: 8dp; }
.nui-glyph--log .nui-glyph__c { top: 11dp; }

/* chat and whisper: a speech bubble with its tail; whisper holds two dots. */
.nui-glyph--chat .nui-glyph__a, .nui-glyph--whisper .nui-glyph__a
{
	left: 1dp;
	top: 2dp;
	width: 14dp;
	height: 10dp;
	border-width: 2dp;
	border-radius: 3dp;
}
.nui-glyph--chat .nui-glyph__b, .nui-glyph--whisper .nui-glyph__b
{
	left: 4dp;
	top: 10dp;
	width: 4dp;
	height: 4dp;
	background-color: var(--glyph-ink);
	transform: rotate(45deg);
}
.nui-glyph--whisper .nui-glyph__c
{
	left: 5dp;
	top: 6dp;
	width: 6dp;
	height: 2dp;
	border-width: 0 2dp;
}

/* character: a head over shoulders. */
.nui-glyph--character .nui-glyph__a
{
	left: 5dp;
	top: 1dp;
	width: 6dp;
	height: 6dp;
	border-radius: 3dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--character .nui-glyph__b
{
	left: 2dp;
	top: 9dp;
	width: 12dp;
	height: 6dp;
	border-radius: 6dp 6dp 0 0;
	background-color: var(--glyph-ink);
}

/* inventory: a bag with a handle. */
.nui-glyph--inventory .nui-glyph__a
{
	left: 2dp;
	top: 5dp;
	width: 12dp;
	height: 10dp;
	border-radius: 2dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--inventory .nui-glyph__b
{
	left: 5dp;
	top: 1dp;
	width: 6dp;
	height: 5dp;
	border-width: 2dp 2dp 0 2dp;
	border-radius: 3dp 3dp 0 0;
}

/* community: two heads over one bar. */
.nui-glyph--community .nui-glyph__a, .nui-glyph--community .nui-glyph__b
{
	top: 2dp;
	width: 5dp;
	height: 5dp;
	border-radius: 3dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--community .nui-glyph__a { left: 2dp; }
.nui-glyph--community .nui-glyph__b { left: 9dp; }
.nui-glyph--community .nui-glyph__c
{
	left: 1dp;
	top: 9dp;
	width: 14dp;
	height: 5dp;
	border-radius: 3dp 3dp 1dp 1dp;
	background-color: var(--glyph-ink);
}

/* system: a gear, a ring with four teeth (the ends of two crossed bars). */
.nui-glyph--system .nui-glyph__a
{
	left: 3dp;
	top: 3dp;
	width: 10dp;
	height: 10dp;
	border-width: 3dp;
	border-radius: 9999dp;
}
.nui-glyph--system .nui-glyph__b
{
	left: 1dp;
	top: 6dp;
	width: 14dp;
	height: 4dp;
	border-width: 0 3dp;
}
.nui-glyph--system .nui-glyph__c
{
	left: 6dp;
	top: 1dp;
	width: 4dp;
	height: 14dp;
	border-width: 3dp 0;
}

/* map: a diamond with a center dot. */
.nui-glyph--map .nui-glyph__a
{
	left: 3dp;
	top: 3dp;
	width: 10dp;
	height: 10dp;
	border-width: 2dp;
	transform: rotate(45deg);
}
.nui-glyph--map .nui-glyph__b
{
	left: 7dp;
	top: 7dp;
	width: 2dp;
	height: 2dp;
	background-color: var(--glyph-ink);
}

/* gift: a box, its lid and the ribbon's loop on top. */
.nui-glyph--gift .nui-glyph__a
{
	left: 2dp;
	top: 8dp;
	width: 12dp;
	height: 7dp;
	border-width: 2dp;
}
.nui-glyph--gift .nui-glyph__b
{
	left: 1dp;
	top: 5dp;
	width: 14dp;
	height: 3dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--gift .nui-glyph__c
{
	left: 5dp;
	top: 0;
	width: 6dp;
	height: 6dp;
	border-width: 2dp;
	transform: rotate(45deg);
}

/* gem: a diamond in the accent's ramp (vertex colors, no shader, so it draws
   the same with effects off). */
.nui-glyph--gem .nui-glyph__a
{
	left: 3dp;
	top: 3dp;
	width: 10dp;
	height: 10dp;
	decorator: vertical-gradient(var(--accent-hover) var(--accent));
	transform: rotate(45deg);
}
.nui-glyph--gem .nui-glyph__b
{
	display: none;
}

/* shop: a coin, a ring with its mark. */
.nui-glyph--shop .nui-glyph__a
{
	left: 2dp;
	top: 2dp;
	width: 12dp;
	height: 12dp;
	border-width: 2dp;
	border-radius: 9999dp;
}
.nui-glyph--shop .nui-glyph__b
{
	left: 7dp;
	top: 5dp;
	width: 2dp;
	height: 6dp;
	background-color: var(--glyph-ink);
}

/* heal: a thick plus. */
.nui-glyph--heal .nui-glyph__a
{
	left: 2dp;
	top: 6dp;
	width: 12dp;
	height: 4dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--heal .nui-glyph__b
{
	left: 6dp;
	top: 2dp;
	width: 4dp;
	height: 12dp;
	background-color: var(--glyph-ink);
}

/* leave: an open door and an arrow out of it. */
.nui-glyph--leave .nui-glyph__a
{
	left: 1dp;
	top: 2dp;
	width: 8dp;
	height: 12dp;
	border-width: 2dp 0 2dp 2dp;
}
.nui-glyph--leave .nui-glyph__b
{
	left: 10dp;
	top: 4dp;
	width: 0;
	height: 0;
	border-width: 4dp 0 4dp 5dp;
	border-color: transparent transparent transparent var(--glyph-ink);
}
.nui-glyph--leave .nui-glyph__c
{
	left: 5dp;
	top: 7dp;
	width: 6dp;
	height: 2dp;
	background-color: var(--glyph-ink);
}

/* mouse-move: an arrow pointer, a corner triangle and its stem. (A rotated
   zero-size box does not turn about its border box's center, so triangles
   here are never rotated.) */
.nui-glyph--mouse-move .nui-glyph__a
{
	left: 3dp;
	top: 1dp;
	width: 0;
	height: 0;
	border-width: 12dp 9dp 0 0;
	border-color: var(--glyph-ink) transparent transparent transparent;
}
.nui-glyph--mouse-move .nui-glyph__b
{
	left: 7dp;
	top: 8dp;
	width: 3dp;
	height: 7dp;
	background-color: var(--glyph-ink);
	transform: rotate(-35deg);
}

/* mouse-attack: a sword, its blade, guard and pommel on one diagonal. */
.nui-glyph--mouse-attack .nui-glyph__a
{
	left: 8dp;
	top: 0;
	width: 2dp;
	height: 13dp;
	background-color: var(--glyph-ink);
	transform: rotate(45deg);
}
.nui-glyph--mouse-attack .nui-glyph__b
{
	left: 2dp;
	top: 9dp;
	width: 8dp;
	height: 2dp;
	background-color: var(--glyph-ink);
	transform: rotate(45deg);
}
.nui-glyph--mouse-attack .nui-glyph__c
{
	left: 1dp;
	top: 12dp;
	width: 3dp;
	height: 3dp;
	background-color: var(--glyph-ink);
}

/* mouse-auto: a ring open on its right (the side without a border tapers
   off, where a transparent side would blend into the corners) and an
   arrowhead at the gap (repeat). */
.nui-glyph--mouse-auto .nui-glyph__a
{
	left: 2dp;
	top: 2dp;
	width: 12dp;
	height: 12dp;
	border-width: 2dp 0 2dp 2dp;
	border-radius: 9999dp;
}
.nui-glyph--mouse-auto .nui-glyph__b
{
	left: 10dp;
	top: 5dp;
	width: 0;
	height: 0;
	border-width: 5dp 3dp 0 3dp;
	border-color: var(--glyph-ink) transparent transparent transparent;
}

/* mouse-camera: a camera body, its lens and its viewfinder. */
.nui-glyph--mouse-camera .nui-glyph__a
{
	left: 1dp;
	top: 4dp;
	width: 14dp;
	height: 10dp;
	border-width: 2dp;
	border-radius: 2dp;
}
.nui-glyph--mouse-camera .nui-glyph__b
{
	left: 5dp;
	top: 6dp;
	width: 6dp;
	height: 6dp;
	border-width: 2dp;
	border-radius: 9999dp;
}
.nui-glyph--mouse-camera .nui-glyph__c
{
	left: 3dp;
	top: 2dp;
	width: 4dp;
	height: 2dp;
	background-color: var(--glyph-ink);
}

/* mouse-skill: an eight-pointed star, two squares turned 45 degrees apart. */
.nui-glyph--mouse-skill .nui-glyph__a, .nui-glyph--mouse-skill .nui-glyph__b
{
	left: 3dp;
	top: 3dp;
	width: 10dp;
	height: 10dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--mouse-skill .nui-glyph__b { transform: rotate(45deg); }

/* home: a roof over a house. */
.nui-glyph--home .nui-glyph__a
{
	left: 1dp;
	top: 1dp;
	width: 0;
	height: 0;
	border-width: 0 7dp 6dp 7dp;
	border-color: transparent transparent var(--glyph-ink) transparent;
}
.nui-glyph--home .nui-glyph__b
{
	left: 3dp;
	top: 7dp;
	width: 10dp;
	height: 8dp;
	background-color: var(--glyph-ink);
}

/* coin: a filled disc with an inner ring (the inventory's money bar, which
   inks it gold). */
.nui-glyph--coin .nui-glyph__a
{
	left: 2dp;
	top: 2dp;
	width: 12dp;
	height: 12dp;
	border-radius: 9999dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--coin .nui-glyph__b
{
	left: 5dp;
	top: 5dp;
	width: 6dp;
	height: 6dp;
	border-width: 1dp;
	border-radius: 9999dp;
	border-color: var(--surface-sunken);
}

/* --- Wave 3c (P15) ---------------------------------------------------------------
   One more name: lock (a refine cell beyond the recipe, P15 spec 6.2). */

/* lock: a shackle, the top of a ring, over a filled body. */
.nui-glyph--lock .nui-glyph__a
{
	left: 4dp;
	top: 1dp;
	width: 8dp;
	height: 9dp;
	border-width: 2dp 2dp 0 2dp;
	border-radius: 4dp 4dp 0 0;
}
.nui-glyph--lock .nui-glyph__b
{
	left: 2dp;
	top: 7dp;
	width: 12dp;
	height: 8dp;
	border-radius: 1dp;
	background-color: var(--glyph-ink);
}

/* --- The inventory's shortcut rail ------------------------------------------------
   Five more names, from the reviewed inventory board: stall (c), ranking (c),
   events (c), achievements (c) and guide (c). Their __c is the accent part,
   inked with --glyph-accent, var(--accent) unless a context sets it. */

/* stall: an awning wider than the stand under it, its door in the
   accent. */
.nui-glyph--stall .nui-glyph__a
{
	left: 0;
	top: 2dp;
	width: 16dp;
	height: 5dp;
	border-radius: 2dp 2dp 4dp 4dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--stall .nui-glyph__b
{
	left: 2dp;
	top: 7dp;
	width: 12dp;
	height: 8dp;
	border-width: 0 2dp 2dp 2dp;
}
.nui-glyph--stall .nui-glyph__c
{
	left: 6dp;
	top: 9dp;
	width: 4dp;
	height: 6dp;
	background-color: var(--glyph-accent);
}

/* ranking: a podium, its top step high, a jewel in the accent above it. */
.nui-glyph--ranking .nui-glyph__a
{
	left: 5dp;
	top: 7dp;
	width: 6dp;
	height: 8dp;
	background-color: var(--glyph-ink);
}
.nui-glyph--ranking .nui-glyph__b
{
	left: 0;
	top: 10dp;
	width: 16dp;
	height: 5dp;
	border-width: 0 5dp;
	border-color: var(--glyph-ink);
	opacity: 0.7;
}
.nui-glyph--ranking .nui-glyph__c
{
	left: 6dp;
	top: 1dp;
	width: 4dp;
	height: 4dp;
	background-color: var(--glyph-accent);
	transform: rotate(45deg);
}

/* events: a calendar, its rings above the header, a mark in the accent. */
.nui-glyph--events .nui-glyph__a
{
	left: 1dp;
	top: 3dp;
	width: 14dp;
	height: 12dp;
	border-width: 4dp 2dp 2dp 2dp;
	border-radius: 2dp;
}
.nui-glyph--events .nui-glyph__b
{
	left: 4dp;
	top: 1dp;
	width: 8dp;
	height: 4dp;
	border-width: 0 2dp;
}
.nui-glyph--events .nui-glyph__c
{
	left: 6dp;
	top: 8dp;
	width: 4dp;
	height: 4dp;
	background-color: var(--glyph-accent);
	transform: rotate(45deg);
}

/* achievements: a medal hung from a V of ribbon (a corner of two 2dp
   borders, turned to point down), the jewel in the accent. */
.nui-glyph--achievements .nui-glyph__a
{
	left: 4dp;
	top: -3dp;
	width: 8dp;
	height: 8dp;
	border-width: 0 2dp 2dp 0;
	transform: rotate(45deg);
}
.nui-glyph--achievements .nui-glyph__b
{
	left: 3dp;
	top: 6dp;
	width: 10dp;
	height: 10dp;
	border-width: 2dp;
	border-radius: 9999dp;
}
.nui-glyph--achievements .nui-glyph__c
{
	left: 6dp;
	top: 9dp;
	width: 4dp;
	height: 4dp;
	border-radius: 9999dp;
	background-color: var(--glyph-accent);
}

/* guide: an open book, two pages on the spine, its bookmark in the
   accent. */
.nui-glyph--guide .nui-glyph__a, .nui-glyph--guide .nui-glyph__b
{
	top: 3dp;
	width: 7dp;
	height: 11dp;
	border-width: 2dp;
}
.nui-glyph--guide .nui-glyph__a
{
	left: 1dp;
	border-right-width: 1dp;
	border-radius: 2dp 0 0 2dp;
	transform: skewY(10deg);
}
.nui-glyph--guide .nui-glyph__b
{
	left: 8dp;
	border-left-width: 1dp;
	border-radius: 0 2dp 2dp 0;
	transform: skewY(-10deg);
}
.nui-glyph--guide .nui-glyph__c
{
	left: 11dp;
	top: 3dp;
	width: 2dp;
	height: 6dp;
	background-color: var(--glyph-accent);
}
