/* Digit art: <nui-number value="m1"/> draws the legacy CNumberLine glyphs
   (d:/ymir work/ui/game/taskbar/0.sub to 9.sub, m, g, p, colon, slash,
   percent, plus, questionmark), one <img class="nui-number__glyph"> per
   character, in a row with no gaps (docs/ui/AUTHORING.md "Digit art"). The
   runtime makes the children; `path` names another glyph folder. The art is
   1x only, so documents that show it need the assets/ETC root. */

nui-number
{
	display: inline-flex;
	flex-direction: row;
	vertical-align: top;
}

.nui-number__glyph
{
	display: block;
}
