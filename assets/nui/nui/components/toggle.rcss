/* Toggle switch over a real checkbox. The label forwards clicks to the input
   (no Python needed to flip it); the track and knob follow :checked through
   the sibling selector.

   <label class="nui-toggle">
       <input type="checkbox" class="nui-toggle__input" checked
              data-event-change="set_music(ev.checked)"/>
       <span class="nui-toggle__track nui-anim"><span class="nui-toggle__knob nui-anim"/></span>
       <span class="nui-toggle__label">@ui.OPTION_MUSIC</span>
   </label> */

.nui-toggle
{
	display: inline-flex;
	flex-direction: row;
	align-items: center;
	gap: var(--space-2);
}
.nui-toggle__input
{
	display: none;
}
.nui-toggle__track
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 34dp;
	height: 20dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 10dp;
	background-color: var(--surface-sunken);
}
.nui-toggle__knob
{
	display: block;
	position: absolute;
	left: 3dp;
	top: 3dp;
	width: 12dp;
	height: 12dp;
	border-radius: 6dp;
	background-color: var(--text-muted);
	transform: translateX(0dp);
}
.nui-toggle:hover .nui-toggle__track
{
	border-color: var(--text-muted);
}
.nui-toggle__input:checked + .nui-toggle__track
{
	background-color: var(--accent);
	border-color: var(--accent);
}
.nui-toggle__input:checked + .nui-toggle__track .nui-toggle__knob
{
	background-color: var(--accent-text);
	transform: translateX(14dp);
}
.nui-toggle__input:disabled + .nui-toggle__track, .nui-toggle__input:disabled + .nui-toggle__track + .nui-toggle__label
{
	opacity: 0.45;
}
/* Slide and fade (--dur-fast, --ease-out). */
.nui-toggle__track.nui-anim
{
	transition: background-color border-color 0.1s cubic-out;
}
.nui-toggle__knob.nui-anim
{
	transition: transform background-color 0.1s cubic-out;
}
