/* Hint tooltip, shown while the host is hovered; no Python involved.
   <span class="nui-has-tooltip">?<span class="nui-tooltip nui-anim">@ui.KEY</span></span>
   One line by default; nui-tooltip--wrap wraps long hints at 240dp.
   Item tooltips keep using the legacy uitooltip windows. */

.nui-has-tooltip
{
	position: relative;
}
.nui-tooltip
{
	display: block;
	position: absolute;
	left: 0;
	bottom: 100%;
	z-index: 10;
	margin-bottom: var(--space-1);
	/* RmlUi caps an absolutely positioned box's shrink-to-fit width at the
	   host's width; the negative margin widens that limit without moving it. */
	margin-right: -320dp;
	padding: var(--space-1) var(--space-2);
	border-radius: var(--radius-sm);
	background-color: var(--tooltip-bg);
	color: var(--text-inverse);
	font-size: var(--font-sm);
	font-weight: normal;
	line-height: 1.35;
	white-space: nowrap;
	pointer-events: none;
	visibility: hidden;
	opacity: 0;
}
.nui-tooltip--wrap
{
	width: 240dp;
	white-space: normal;
}
.nui-has-tooltip:hover .nui-tooltip, .nui-tooltip.is-open
{
	visibility: visible;
	opacity: 1;
}
/* Fade in (--dur-fast, --ease-out). */
.nui-tooltip.nui-anim
{
	transition: opacity 0.1s cubic-out;
}
