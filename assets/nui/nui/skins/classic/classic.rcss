/* Classic skin: the legacy Metin2 look (boards, title bars, buttons, fields,
   Tahoma) drawn by NovaUI. Every document links it through nui/nui.rtpl, and
   every rule here starts with .skin-classic, the body class of the classic
   theme (nui/theme/themes.json), so nothing here applies in a modern theme.

   Selector scheme (docs/ui/AUTHORING.md "Classic skin"):
   - A rule takes the exact modern selector it overrides with .skin-classic in
     front, so it outweighs that rule by one class (100,000) and never relies
     on sheet order against it. Components that can be the <body> itself
     (.nui-window) list both .skin-classic.x and .skin-classic .x.
   - Every modern state rule gets a classic rule one class heavier that sets
     everything the classic look needs, resets included.
   - No transition and no animation here: classic changes how things look,
     not how they move, so the reduced-motion and theme-switch rules in
     base.rcss act on classic as on modern. No ids.

   A window's own classic rules live in windows/<window>.rcss next to this
   sheet, which the runtime and nuitool apply after that window's sheets.

   The art is the legacy pixels at 1x and upscaled 2x art from a dp ratio of
   1.125 up (classic-sprites.rcss, generated by tools/nui_classic_art.py).
   Frames repeat their edges and center 1:1 as the legacy UI draws them
   (nui-repeat-box, registered by the NovaUI runtime); buttons stretch their
   center between two 6 px caps, which at the legacy widths (43, 61, 88dp) is
   the art 1:1. Colors and the slot-bar look come from the classic palette
   and skin tokens (tokens.json). */

/* --- Decorators --------------------------------------------------------------- */

@decorator classic-board : nui-repeat-box
{
	top-left-image: classic-board-tl;    top-image: classic-board-t;    top-right-image: classic-board-tr;
	left-image: classic-board-l;         center-image: classic-board-c; right-image: classic-board-r;
	bottom-left-image: classic-board-bl; bottom-image: classic-board-b; bottom-right-image: classic-board-br;
}
@decorator classic-thinboard : nui-repeat-box
{
	top-left-image: classic-thin-tl;     top-image: classic-thin-t;     top-right-image: classic-thin-tr;
	left-image: classic-thin-l;          center-image: classic-thin-c;  right-image: classic-thin-r;
	bottom-left-image: classic-thin-bl;  bottom-image: classic-thin-b;  bottom-right-image: classic-thin-br;
}
@decorator classic-titlebar : nui-repeat-box
{
	left-image: classic-title-l; center-image: classic-title-c; right-image: classic-title-r;
}
@decorator classic-thumb : nui-repeat-box
{
	top-image: classic-thumb-t; center-image: classic-thumb-c; bottom-image: classic-thumb-b;
}

/* --- Gauge (ui.Gauge) ------------------------------------------------------------
   The legacy gauge: the slot art with its two caps and the colored bar inset
   12dp from both ends, 8dp tall. The art is 1x only, from the legacy pattern
   folder, so the documents that use a gauge need the asset group that holds
   d:/ymir work/ (assets/ETC) for lint and snapshots. This section and the
   dialog's come first: they were the classic sections of the gauge and
   dialog component sheets, which load before this sheet, and the dialog's
   primary rule ties the disabled button rule further down. Each rule is one
   class heavier than the modern rule it overrides. */
@decorator nui-gauge-track : nui-repeat-box
{
	left-image: "d:/ymir work/ui/pattern/gauge_slot_left.tga";
	center-image: "d:/ymir work/ui/pattern/gauge_slot_center.tga";
	right-image: "d:/ymir work/ui/pattern/gauge_slot_right.tga";
}
@decorator nui-gauge-red : nui-repeat-box
{
	center-image: "d:/ymir work/ui/pattern/gauge_red.tga";
}
@decorator nui-gauge-pink : nui-repeat-box
{
	center-image: "d:/ymir work/ui/pattern/gauge_pink.tga";
}
@decorator nui-gauge-purple : nui-repeat-box
{
	center-image: "d:/ymir work/ui/pattern/gauge_purple.tga";
}
@decorator nui-gauge-blue : nui-repeat-box
{
	center-image: "d:/ymir work/ui/pattern/gauge_blue.tga";
}

.skin-classic progress.nui-gauge
{
	decorator: nui-gauge-track;
	height: 8dp;
	background-color: transparent;
	border-radius: 0;
}
.skin-classic progress.nui-gauge fill
{
	decorator: nui-gauge-red;
	margin: 0 12dp;
	background-color: transparent;
	border-radius: 0;
}
.skin-classic progress.nui-gauge--pink fill
{
	decorator: nui-gauge-pink;
	background-color: transparent;
}
.skin-classic progress.nui-gauge--purple fill
{
	decorator: nui-gauge-purple;
	background-color: transparent;
}
.skin-classic progress.nui-gauge--blue fill
{
	decorator: nui-gauge-blue;
	background-color: transparent;
}

/* --- Dialog (the dialog kit) --------------------------------------------------------
   The stone board comes from the window frame below (.skin-classic .nui-window).
   Its minimum width (200,000) would otherwise outweigh the dialog's own, and the
   text is the legacy gray. The footer keeps the dialog's centered row. */
.skin-classic .nui-window.nui-dialog
{
	min-width: 280dp;
}
.skin-classic .nui-dialog__text
{
	color: var(--text);
}
/* The legacy dialog buttons have gray labels; the primary one too. Before the
   classic disabled rule below, which has the same weight. */
.skin-classic .nui-dialog__footer .nui-button--primary
{
	color: var(--classic-button-text);
}

/* --- Window frame: the stone board (ui.Board) ---------------------------------- */

.skin-classic.nui-window, .skin-classic .nui-window
{
	decorator: classic-board;
	background-color: transparent;
	border-width: 0;
	border-radius: 0;
	min-width: 64dp;
}

/* The legacy title bar (BoardWithTitleBar): at (8, 7) of the board, the board
   width minus 15 wide, 23 px of bar on 32 px of art whose last 9 px are
   shadow, so the content starts 30 px from the top. */
.skin-classic .nui-window__titlebar
{
	decorator: classic-titlebar;
	border-bottom-width: 0;
	height: 32dp;
	margin: 7dp 7dp -9dp 8dp;
	padding: 0 3dp 0 0;
	align-items: flex-start;
}
.skin-classic .nui-window__handle
{
	height: 23dp;
	line-height: 23dp;
	text-align: center;
}
.skin-classic .nui-window__title
{
	font-weight: normal;
	color: var(--text);
}

/* The close button sits on the bar's socket at (width - 18, 3), 15 by 15, and
   its sprite carries the X. It is also a ghost icon button: the title-bar
   ancestor keeps each close rule one class above every button rule of the
   same state. */
.skin-classic .nui-window__titlebar .nui-window__close
{
	decorator: image(classic-close-01);
	width: 15dp;
	height: 15dp;
	margin-top: 3dp;
	padding: 0;
	border-width: 0;
	background-color: transparent;
	transform: none;
	color: transparent;
	line-height: 15dp;
}
.skin-classic .nui-window__titlebar .nui-window__close:hover, .skin-classic .nui-window__titlebar .nui-window__close.is-hover,
.skin-classic .nui-window__titlebar .nui-window__close:focus-visible, .skin-classic .nui-window__titlebar .nui-window__close.is-focus
{
	decorator: image(classic-close-02);
	background-color: transparent;
	border-color: transparent;
	transform: none;
}
.skin-classic .nui-window__titlebar .nui-window__close:active, .skin-classic .nui-window__titlebar .nui-window__close.is-active
{
	decorator: image(classic-close-03);
	background-color: transparent;
	border-color: transparent;
	transform: none;
}

.skin-classic .nui-window__footer
{
	border-top-width: 0;
}

/* --- Panel and divider: the thin board (ui.ThinBoard) ----------------------------- */

.skin-classic .nui-panel
{
	decorator: classic-thinboard;
	background-color: transparent;
	border-width: 0;
	border-radius: 0;
}
/* After the panel rule, which it ties: the slot bar. */
.skin-classic .nui-panel--sunken
{
	decorator: none;
	background-color: var(--classic-slot-fill);
	border-width: 1dp;
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
}
.skin-classic .nui-panel--flat
{
	decorator: none;
	border-width: 1dp;
	border-color: var(--classic-separator);
}
.skin-classic .nui-panel__title
{
	color: var(--text);
}

/* The server board's separator: a light line over a dark one. */
.skin-classic .nui-divider
{
	border-top-width: 1dp;
	border-top-color: var(--classic-separator);
	border-bottom-width: 1dp;
	border-bottom-color: var(--classic-separator-shadow);
}

/* --- Buttons (ui.Button): default, over and down art ------------------------------ */

/* Rule order matters only between classic rules of equal weight: the base,
   the variants and sizes (200,000), then the generic states, the size
   states and the ghost states (300,000), each group after the one it must
   win against. */
.skin-classic .nui-button
{
	decorator: tiled-horizontal(classic-button-large-01-l, classic-button-large-01-c, classic-button-large-01-r);
	height: 21dp;
	line-height: 21dp;
	padding: 0 8dp;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	color: var(--classic-button-text);
	font-weight: normal;
	font-size: var(--font-md);
}
/* Text colors on the base rules only, so window sheets can recolor them. */
.skin-classic .nui-button--primary
{
	color: var(--accent);
}
.skin-classic .nui-button--danger
{
	color: var(--danger);
}
.skin-classic .nui-button--small
{
	decorator: tiled-horizontal(classic-button-small-01-l, classic-button-small-01-c, classic-button-small-01-r);
	padding: 0 6dp;
}
.skin-classic .nui-button--medium
{
	decorator: tiled-horizontal(classic-button-middle-01-l, classic-button-middle-01-c, classic-button-middle-01-r);
	min-width: 61dp;
	padding: 0 9dp;
}
.skin-classic .nui-button--icon
{
	decorator: tiled-horizontal(classic-button-small-01-l, classic-button-small-01-c, classic-button-small-01-r);
	width: 21dp;
	padding: 0;
}
/* Outweighs the modern --small.--icon width; the art comes from the rules above. */
.skin-classic .nui-button--small.nui-button--icon
{
	width: 21dp;
	padding: 0;
}
/* After the sizes, so a ghost small or icon button has no art at rest. */
.skin-classic .nui-button--ghost
{
	decorator: none;
}

/* Over and down art; the legacy UI has no focus ring, so focus shows the over
   art. No lift and no dip: the art swap is the feedback. */
.skin-classic .nui-button:hover, .skin-classic .nui-button.is-hover,
.skin-classic .nui-button:focus-visible, .skin-classic .nui-button.is-focus
{
	decorator: tiled-horizontal(classic-button-large-02-l, classic-button-large-02-c, classic-button-large-02-r);
	background-color: transparent;
	border-color: transparent;
	transform: none;
}
.skin-classic .nui-button:active, .skin-classic .nui-button.is-active
{
	decorator: tiled-horizontal(classic-button-large-03-l, classic-button-large-03-c, classic-button-large-03-r);
	background-color: transparent;
	border-color: transparent;
	transform: none;
}
.skin-classic .nui-button--small:hover, .skin-classic .nui-button--small.is-hover,
.skin-classic .nui-button--small:focus-visible, .skin-classic .nui-button--small.is-focus,
.skin-classic .nui-button--icon:hover, .skin-classic .nui-button--icon.is-hover,
.skin-classic .nui-button--icon:focus-visible, .skin-classic .nui-button--icon.is-focus
{
	decorator: tiled-horizontal(classic-button-small-02-l, classic-button-small-02-c, classic-button-small-02-r);
}
.skin-classic .nui-button--small:active, .skin-classic .nui-button--small.is-active,
.skin-classic .nui-button--icon:active, .skin-classic .nui-button--icon.is-active
{
	decorator: tiled-horizontal(classic-button-small-03-l, classic-button-small-03-c, classic-button-small-03-r);
}
.skin-classic .nui-button--medium:hover, .skin-classic .nui-button--medium.is-hover,
.skin-classic .nui-button--medium:focus-visible, .skin-classic .nui-button--medium.is-focus
{
	decorator: tiled-horizontal(classic-button-middle-02-l, classic-button-middle-02-c, classic-button-middle-02-r);
}
.skin-classic .nui-button--medium:active, .skin-classic .nui-button--medium.is-active
{
	decorator: tiled-horizontal(classic-button-middle-03-l, classic-button-middle-03-c, classic-button-middle-03-r);
}
/* Last of the states, which they tie: the legacy list highlights. */
.skin-classic .nui-button--ghost:hover, .skin-classic .nui-button--ghost.is-hover,
.skin-classic .nui-button--ghost:focus-visible, .skin-classic .nui-button--ghost.is-focus
{
	decorator: none;
	background-color: var(--classic-hover-white);
}
.skin-classic .nui-button--ghost:active, .skin-classic .nui-button--ghost.is-active
{
	decorator: none;
	background-color: var(--classic-press-white);
}
/* Disabled, after every state: the legacy buttons have no disabled art, so
   the default art is tinted gray and the label dimmed, at full opacity (a
   lower opacity let the background show through the bevel). A disabled
   button takes no pointer (the modern rule), so it never shows the over or
   down art. tiled-horizontal and nui-repeat-box honor image-color. */
.skin-classic .nui-button[disabled], .skin-classic .nui-button:disabled
{
	opacity: 1;
	image-color: var(--classic-disabled-tint);
	color: var(--classic-disabled-text);
}

/* --- Text input: the legacy slot bar (Bar3D) ------------------------------------- */

.skin-classic .nui-input
{
	background-color: var(--classic-slot-fill);
	border-width: 1dp;
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
	border-radius: 0;
	height: 18dp;
	line-height: 16dp;
	padding: 0 3dp;
	color: var(--classic-edit-text);
	caret-color: var(--classic-edit-text);
	font-size: var(--font-md);
}
/* The legacy fields do not change on hover or focus; the caret shows the focus. */
.skin-classic .nui-input:hover, .skin-classic .nui-input.is-hover,
.skin-classic .nui-input:focus, .skin-classic .nui-input.is-focus
{
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
}
.skin-classic .nui-input:placeholder-shown
{
	color: var(--text-muted);
}
/* After the states, which the focused and hovered forms tie. */
.skin-classic .nui-input--invalid, .skin-classic .nui-input--invalid:hover, .skin-classic .nui-input--invalid.is-hover,
.skin-classic .nui-input--invalid:focus, .skin-classic .nui-input--invalid.is-focus
{
	border-color: var(--danger);
}

.skin-classic .nui-field__label
{
	color: var(--text);
	font-size: var(--font-md);
	margin-bottom: 2dp;
}
.skin-classic .nui-field__error
{
	font-size: var(--font-md);
}

/* --- Toggle as the legacy check box (uiguild.CheckBox) ----------------------------- */

/* A slot with the check mark on it while checked. */
.skin-classic .nui-toggle__track
{
	width: 26dp;
	height: 18dp;
	background-color: var(--classic-slot-fill);
	border-width: 1dp;
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
	border-radius: 0;
}
.skin-classic .nui-toggle__knob
{
	decorator: image(classic-check);
	left: 0;
	top: 0;
	width: 24dp;
	height: 16dp;
	background-color: transparent;
	border-radius: 0;
	transform: none;
	visibility: hidden;
}
.skin-classic .nui-toggle__input:checked + .nui-toggle__track
{
	background-color: var(--classic-slot-fill);
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
}
/* One class above the modern checked knob (400,000). */
.skin-classic .nui-toggle__input:checked + .nui-toggle__track .nui-toggle__knob
{
	visibility: visible;
	background-color: transparent;
	transform: none;
}
/* After the checked track, which they tie: hover and focus show in both states. */
.skin-classic .nui-toggle:hover .nui-toggle__track, .skin-classic .nui-toggle.is-hover .nui-toggle__track
{
	background-color: var(--classic-slot-dark);
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
}
.skin-classic .nui-toggle__input:focus-visible + .nui-toggle__track, .skin-classic .nui-toggle.is-focus .nui-toggle__track
{
	border-color: var(--focus-ring);
}

/* --- Vertical scrollbar (ui.ScrollBar) ----------------------------------------------- */

.skin-classic scrollbarvertical
{
	width: 15dp;
}
.skin-classic scrollbarvertical slidertrack
{
	width: 13dp;
	background-color: var(--classic-slot-fill);
	border-width: 1dp;
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
}
.skin-classic scrollbarvertical sliderarrowdec
{
	decorator: image(classic-scroll-up-01);
	width: 15dp;
	height: 16dp;
}
.skin-classic scrollbarvertical sliderarrowinc
{
	decorator: image(classic-scroll-down-01);
	width: 15dp;
	height: 16dp;
}
.skin-classic scrollbarvertical sliderarrowdec:hover
{
	decorator: image(classic-scroll-up-02);
}
.skin-classic scrollbarvertical sliderarrowinc:hover
{
	decorator: image(classic-scroll-down-02);
}
.skin-classic scrollbarvertical sliderarrowdec:active
{
	decorator: image(classic-scroll-up-03);
}
.skin-classic scrollbarvertical sliderarrowinc:active
{
	decorator: image(classic-scroll-down-03);
}
.skin-classic scrollbarvertical sliderbar
{
	decorator: classic-thumb;
	width: 10dp;
	margin-left: 2dp;
	min-height: 12dp;
	border-radius: 0;
	background-color: transparent;
}
.skin-classic scrollbarvertical sliderbar:hover, .skin-classic scrollbarvertical sliderbar:active
{
	background-color: transparent;
}

/* --- List: the legacy list box highlights ------------------------------------------ */

.skin-classic .nui-list
{
	background-color: transparent;
	border-width: 0;
	border-radius: 0;
}
/* Legacy rows are 17 px: a 15dp line between the 1dp edges. */
.skin-classic .nui-list__item
{
	border-radius: 0;
	border-left-width: 1dp;
	padding: 0 var(--space-1);
	line-height: 15dp;
}
.skin-classic .nui-list__item:hover, .skin-classic .nui-list__item.is-hover
{
	background-color: var(--classic-hover-white);
}
.skin-classic .nui-list__item.is-selected
{
	background-color: var(--classic-select);
	border-left-color: transparent;
}
.skin-classic .nui-list__item:focus-visible, .skin-classic .nui-list__item.is-focus
{
	border-color: var(--focus-ring);
}
/* One class above the modern selected-and-focused stripe: no stripe here. */
.skin-classic .nui-list__item.is-selected:focus-visible, .skin-classic .nui-list__item.is-selected.is-focus
{
	border-color: var(--focus-ring);
}

/* --- Tabs, tooltip, slots, slider ----------------------------------------------------- */

.skin-classic .nui-tabs tab
{
	font-weight: normal;
}

/* A thin board at least 32dp tall, so its 16dp corners never shrink. */
.skin-classic .nui-tooltip
{
	decorator: classic-thinboard;
	background-color: transparent;
	border-radius: 0;
	color: var(--classic-tooltip-text);
	padding: 8dp 10dp;
}

/* --- Slot grid (CSlotWindow, CGridSlotWindow) ------------------------------------
   The legacy 32dp pitch: no gap, cells of the slot base art with the icon at
   0,0, the legacy tints (the --slot-* tokens hold the legacy colors in the
   classic palette), the cover button art and the legacy digits, placed as
   CSlotWindow places its number line: right-aligned 4dp in from the item's
   right edge, its top 10dp above the bottom. Legacy cells have no hover look.
   The art is 1x only (legacy .sub regions), so slot documents need the
   assets/ETC root. */
.skin-classic .nui-slot-grid
{
	gap: 0;
}
.skin-classic .nui-slot-grid--cols-1 { width: 32dp; }
.skin-classic .nui-slot-grid--cols-2 { width: 64dp; }
.skin-classic .nui-slot-grid--cols-3 { width: 96dp; }
.skin-classic .nui-slot-grid--cols-4 { width: 128dp; }
.skin-classic .nui-slot-grid--cols-5 { width: 160dp; }
.skin-classic .nui-slot-grid--cols-6 { width: 192dp; }
.skin-classic .nui-slot-grid--cols-7 { width: 224dp; }
.skin-classic .nui-slot-grid--cols-8 { width: 256dp; }
.skin-classic .nui-slot-grid--cols-9 { width: 288dp; }
.skin-classic .nui-slot-grid--cols-10 { width: 320dp; }
.skin-classic .nui-slot
{
	width: 32dp;
	height: 32dp;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: image("d:/ymir work/ui/public/slot_base.sub");
}
.skin-classic .nui-slot:hover, .skin-classic .nui-slot.is-hover
{
	background-color: transparent;
	border-width: 0;
}
.skin-classic .nui-slot.is-selected, .skin-classic .nui-slot.is-target
{
	background-color: transparent;
	border-width: 0;
}
.skin-classic .nui-slot__icon
{
	width: 32dp;
	height: 32dp;
}
.skin-classic .nui-slot__cover
{
	left: 0;
	top: 0;
	border-width: 0;
	border-radius: 0;
	decorator: image("d:/ymir work/ui/public/slot_cover_button_01.sub");
}
.skin-classic .nui-slot:hover .nui-slot__cover
{
	decorator: image("d:/ymir work/ui/public/slot_cover_button_02.sub");
}
.skin-classic .nui-slot:active .nui-slot__cover
{
	decorator: image("d:/ymir work/ui/public/slot_cover_button_03.sub");
}
/* The pick highlight and the selection: white at 50% under the icon. */
.skin-classic .nui-slot.is-selected .nui-slot__tint
{
	z-index: -1;
	background-color: var(--slot-picked);
}
.skin-classic .nui-slot.is-target .nui-slot__tint
{
	z-index: -1;
	background-color: var(--slot-picked);
}
/* After the two above, which they tie: the disabled and locked tints win. */
.skin-classic .nui-slot.is-disabled .nui-slot__tint
{
	z-index: 1;
	background-color: var(--slot-disabled);
}
.skin-classic .nui-slot.is-locked .nui-slot__tint
{
	z-index: 7;
	background-color: var(--slot-locked);
}
.skin-classic .nui-slot__cooldown, .skin-classic .nui-slot__active, .skin-classic .nui-slot__finish
{
	left: 0;
	top: 0;
}
.skin-classic .nui-slot__count
{
	display: none;
}
.skin-classic .nui-slot__digits
{
	display: flex;
}
.skin-classic .nui-slot__key
{
	left: 0;
	top: 0;
}
.skin-classic .nui-slot-item
{
	width: 32dp;
	height: 32dp;
	align-items: flex-start;
	justify-content: flex-start;
}
.skin-classic .nui-slot-grid--layered .nui-slot-item .nui-slot__count
{
	display: none;
}
.skin-classic .nui-slot-item--c1 { left: 32dp; }
.skin-classic .nui-slot-item--c2 { left: 64dp; }
.skin-classic .nui-slot-item--c3 { left: 96dp; }
.skin-classic .nui-slot-item--c4 { left: 128dp; }
.skin-classic .nui-slot-item--c5 { left: 160dp; }
.skin-classic .nui-slot-item--c6 { left: 192dp; }
.skin-classic .nui-slot-item--c7 { left: 224dp; }
.skin-classic .nui-slot-item--c8 { left: 256dp; }
.skin-classic .nui-slot-item--c9 { left: 288dp; }
.skin-classic .nui-slot-item--r1 { top: 32dp; }
.skin-classic .nui-slot-item--r2 { top: 64dp; }
.skin-classic .nui-slot-item--r3 { top: 96dp; }
.skin-classic .nui-slot-item--r4 { top: 128dp; }
.skin-classic .nui-slot-item--r5 { top: 160dp; }
.skin-classic .nui-slot-item--r6 { top: 192dp; }
.skin-classic .nui-slot-item--r7 { top: 224dp; }
.skin-classic .nui-slot-item--r8 { top: 256dp; }
.skin-classic .nui-slot-item--r9 { top: 288dp; }
.skin-classic .nui-slot-item--w1 { width: 32dp; }
.skin-classic .nui-slot-item--w2 { width: 64dp; }
.skin-classic .nui-slot-item--w3 { width: 96dp; }
.skin-classic .nui-slot-item--h1 { height: 32dp; }
.skin-classic .nui-slot-item--h2 { height: 64dp; }
.skin-classic .nui-slot-item--h3 { height: 96dp; }
/* An item's state parts on its anchor cell only, the icon's top-left 32dp,
   as CSlotWindow draws them with the slot's cell size. */
.skin-classic .nui-slot-item .nui-slot__tint
{
	left: 0;
	top: 0;
	right: auto;
	bottom: auto;
	width: 32dp;
	height: 32dp;
	border-radius: 0;
}
.skin-classic .nui-slot-item .nui-slot__cover, .skin-classic .nui-slot-item .nui-slot__cooldown,
.skin-classic .nui-slot-item .nui-slot__active, .skin-classic .nui-slot-item .nui-slot__finish
{
	left: 0;
	top: 0;
}

.skin-classic .nui-slider slidertrack
{
	margin-top: 7dp;
	height: 4dp;
	border-radius: 0;
	background-color: var(--classic-slot-fill);
	border-width: 1dp;
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
}
/* RmlUi places the progress at the track's border edge plus its own margin,
   with the track's content height: the margin puts it inside the borders. */
.skin-classic .nui-slider sliderprogress
{
	margin: 1dp 0 0 1dp;
	border-radius: 0;
	background-color: var(--accent);
}
.skin-classic .nui-slider sliderbar
{
	decorator: tiled-horizontal(classic-button-small-01-l, classic-button-small-01-c, classic-button-small-01-r);
	width: 12dp;
	height: 16dp;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
}
.skin-classic .nui-slider sliderbar:hover, .skin-classic .nui-slider.is-hover sliderbar,
.skin-classic .nui-slider:focus-visible sliderbar, .skin-classic .nui-slider.is-focus sliderbar
{
	decorator: tiled-horizontal(classic-button-small-02-l, classic-button-small-02-c, classic-button-small-02-r);
	background-color: transparent;
}
.skin-classic .nui-slider sliderbar:active, .skin-classic .nui-slider.is-active sliderbar
{
	decorator: tiled-horizontal(classic-button-small-03-l, classic-button-small-03-c, classic-button-small-03-r);
	background-color: transparent;
}
