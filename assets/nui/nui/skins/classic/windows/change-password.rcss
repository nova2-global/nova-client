/* Classic skin overlay of nui/windows/change-password/change-password.rml:
   the legacy change-password dialog (uiscript changepassworddialog.py) at
   100%, 1dp to the legacy pixel: the stone board, 220 x 137; the title bar
   at 8, 8, 204 wide; the three parameter slots (61 x 18) at x 135, y 34, 59
   and 79, each field at 3, 3 in its slot (60 x 18), each label 110 left of
   its slot and 3 down; OK and Cancel on the middle art at y 103, 35 left
   and right of the middle (x 45 and 115), their labels the legacy gray. */

body.skin-classic.change-password .change-password__window
{
	width: 220dp;
	height: 137dp;
	min-width: 0;
	max-width: none;
}
body.skin-classic.change-password .change-password__titlebar
{
	position: absolute;
	left: 8dp;
	top: 8dp;
	width: 204dp;
	margin: 0;
	z-index: 1;
}
body.skin-classic.change-password .change-password__body
{
	display: block;
	padding: 0;
}
body.skin-classic.change-password .change-password__row
{
	display: block;
	position: absolute;
	left: 135dp;
	width: 61dp;
	height: 18dp;
	decorator: image("d:/ymir work/ui/public/parameter_slot_02.sub");
}
body.skin-classic.change-password .change-password__row--old { top: 34dp; }
body.skin-classic.change-password .change-password__row--new { top: 59dp; }
body.skin-classic.change-password .change-password__row--check { top: 79dp; }
body.skin-classic.change-password .change-password__label
{
	position: absolute;
	left: -110dp;
	top: 3dp;
	min-width: 0;
	line-height: 14dp;
	font-size: var(--font-md);
}
body.skin-classic.change-password .change-password__slot
{
	position: absolute;
	left: 3dp;
	top: 3dp;
	width: 60dp;
	height: 18dp;
}
/* The edit line on the slot art: no box of its own. */
body.skin-classic.change-password .change-password__field
{
	width: 60dp;
	height: 18dp;
	margin: 0;
	padding: 0;
	border-width: 0;
	background-color: transparent;
	line-height: 13dp;
}
body.skin-classic.change-password .change-password__footer
{
	display: block;
	padding: 0;
}
body.skin-classic.change-password .change-password__button
{
	position: absolute;
	top: 103dp;
	width: 61dp;
	min-width: 0;
	padding: 0;
	color: var(--classic-button-text);
}
body.skin-classic.change-password .change-password__button--accept { left: 45dp; }
body.skin-classic.change-password .change-password__button--cancel { left: 115dp; }

/* Pins against the modern sheet (the reviewed design's look, which classic
   does not take): no title glyph, the labels in the text color, on one
   line. */
body.skin-classic.change-password .change-password__icon
{
	display: none;
}
body.skin-classic.change-password .change-password__label
{
	color: var(--text);
	white-space: nowrap;
}
