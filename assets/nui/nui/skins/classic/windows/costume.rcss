/* Classic skin overlay of nui/windows/costume/costume.rml: the legacy
   costume window (uiscript costumewindow.py) at 100%, 1dp to the legacy
   pixel, the same with today's table (inv--table-new) and the foundation's
   (inv--table-old), as legacy's one uiscript since the cut (NOVA-97): the
   stone board, 140 x 180; the title bar at 6, 6, 130 wide; Costume_Base at
   13, 38 with costume_bg.jpg (113 x 129), its slot window at 3, 3 and the
   costume body and hair at their uiscript places, no slot base (the art
   has the frames). The window holds those two alone: its third slot
   (ring1's before the cut) went with the rings to the inventory, and the
   cut's other costume cells are not ported. */

body.skin-classic.cos
{
	width: 140dp;
	height: 180dp;
	min-width: 0;
}
body.skin-classic.cos .cos__titlebar
{
	display: block;
	position: absolute;
	left: 6dp;
	top: 6dp;
	width: 130dp;
	height: 32dp;
	margin: 0;
	padding: 0;
	z-index: 1;
}
body.skin-classic.cos .cos__handle
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 23dp;
	line-height: 21dp;
	text-align: center;
}
body.skin-classic.cos .cos__titlebar .nui-window__close
{
	position: absolute;
	left: 112dp;
	top: 3dp;
	margin: 0;
}
body.skin-classic.cos .cos__body
{
	display: block;
	position: relative;
	height: 180dp;
	padding: 0;
}
body.skin-classic.cos .cos-grid,
body.skin-classic.cos.cos--companion .cos-grid
{
	position: absolute;
	left: 13dp;
	top: 38dp;
	width: 113dp;
	height: 129dp;
	decorator: image("d:/ymir work/ui/costume/costume_bg.jpg" scale-none left top);
}
body.skin-classic.cos .cos-divider
{
	display: none;
}
body.skin-classic.cos .cos-wear-place
{
	width: 32dp;
	height: 32dp;
}
body.skin-classic.cos .cos-wear,
body.skin-classic.cos .cos-wear:hover
{
	display: block;
	width: 100%;
	height: 100%;
	decorator: none;
}
body.skin-classic.cos .cos-wear--costume_body { height: 64dp; }

/* The places, the same in both tables: the slot window's (3, 3) on the base
   plus each slot's x, y. */
body.skin-classic.cos.inv--table-new .cos-wear--costume_body,
body.skin-classic.cos.inv--table-old .cos-wear--costume_body { left: 64dp; top: 48dp; }
body.skin-classic.cos.inv--table-new .cos-wear--costume_hair,
body.skin-classic.cos.inv--table-old .cos-wear--costume_hair { left: 64dp; top: 11dp; }

/* No dead zone between two wear places (P14b): half the gap to the place
   beside it, where they stand 8dp apart or less (as the inventory's). */
body.skin-classic.cos .cos-wear--costume_body > .cos-wear { nui-hit-outset: 2.5dp 0 0 0; }
body.skin-classic.cos .cos-wear--costume_hair > .cos-wear { nui-hit-outset: 0 0 2.5dp 0; }
