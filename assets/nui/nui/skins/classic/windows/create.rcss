/* Classic skin overlay of nui/windows/create/create.rml. The runtime and
   nuitool apply it after the window's own sheet, create.rcss, in every theme;
   every rule starts with .skin-classic, so it acts only while a classic theme
   is in use (docs/ui/AUTHORING.md, Skins). */

/* The classic board is short enough at any height, so the class-name art
   stays where the window's sheet leaves it out for the modern board. */
@media (max-height: 719dp)
{
	.skin-classic .create-job
	{
		display: block;
	}
}

/* The legacy thin board with its rows at the legacy offsets: the
   description box (black, in a light line) 189 by 122 at (8, 10); the stat
   rows 19dp apart from 138 (the legacy gauge, 120dp, at x 45, and a 24 by 16
   box at x 172); the name, gender and shape rows with their labels
   centered on x 43 and the field (115 by 18) or the two middle buttons at
   x 79; Cancel and Create (the large art, 88dp) at x 11 and 109, 14dp above
   the bottom. A chosen gender or shape shows the down art, as the legacy
   radio buttons do. The arrows are the legacy dragon art. */
.skin-classic .nui-window.create-board
{
	width: 208dp;
	decorator: classic-thinboard;
	padding: 10dp 0dp 14dp 0dp;
}
/* The modern well around the description is not legacy's. */
.skin-classic .create-well
{
	padding: 0dp;
	background-color: transparent;
	border-width: 0dp;
	border-radius: 0dp;
}
.skin-classic .create-text
{
	height: 122dp;
	border-width: 1dp;
	color: var(--text);
	width: 189dp;
	margin: 0dp 0dp 0dp 8dp;
	padding: 6dp 7dp;
	background-color: var(--classic-slot-fill);
	border-color: var(--classic-slot-light);
	font-size: var(--font-md);
}
.skin-classic .create-stats
{
	display: block;
	padding: 4dp 0dp 0dp 15dp;
}
.skin-classic .create-stat
{
	gap: 0dp;
	width: 181dp;
	height: 19dp;
}
.skin-classic .create-stat__label
{
	font-weight: normal;
	min-width: 30dp;
	padding-right: 2dp;
	box-sizing: border-box;
	color: var(--text);
	font-size: var(--font-md);
}
.skin-classic .create-stat__gauge
{
	flex: 1 1 auto;
	max-width: 120dp;
	margin: 0dp 7dp 0dp auto;
}
.skin-classic .create-stat__value
{
	box-sizing: border-box;
	width: 24dp;
	height: 16dp;
	line-height: 14dp;
	background-color: var(--classic-slot-fill);
	border-width: 1dp;
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
	color: var(--text);
	text-align: center;
}
/* A row is the legacy 192dp (x 8 to 200); a label column narrows when a
   long button label needs the room. */
.skin-classic .create-row
{
	flex-wrap: nowrap;
	align-items: center;
	gap: 0dp;
	height: 23dp;
	padding: 0dp 8dp 0dp 8dp;
}
.skin-classic .create-row--name
{
	flex-direction: row;
	margin-top: 8dp;
}
.skin-classic .create-label
{
	font-size: var(--font-md);
	flex: 0 1 auto;
	width: 70dp;
	min-width: 0dp;
	padding: 0dp 1dp;
	box-sizing: border-box;
	color: var(--text);
	text-align: center;
}
.skin-classic .create-name
{
	flex: 0 0 auto;
	width: 115dp;
	margin-left: 3dp;
}
.skin-classic .create-choice
{
	flex: 0 0 auto;
	min-width: 61dp;
	margin-left: 1dp;
	padding: 0dp 4dp;
}
.skin-classic .create-choice + .create-choice
{
	margin-left: 0dp;
}
.skin-classic .create-choice.is-selected
{
	decorator: tiled-horizontal(classic-button-middle-03-l, classic-button-middle-03-c, classic-button-middle-03-r);
	background-color: transparent;
	border-color: transparent;
	color: var(--classic-button-text);
}
.skin-classic .create-footer
{
	justify-content: flex-start;
	gap: 10dp;
	margin: 3dp 0dp 0dp 11dp;
	padding: 0dp;
}
.skin-classic .create-button
{
	flex: 0 1 auto;
	min-width: 88dp;
	padding: 0dp;
}
/* The modern blades on the arrows are not legacy's. */
.skin-classic .create-blade, .skin-classic .create-tip
{
	display: none;
}
/* The legacy Create label is gray, as every legacy button label. */
.skin-classic .create-button.nui-button--primary
{
	color: var(--classic-button-text);
}
/* The classic disabled label (classic.rcss), which this rule and the
   selected choice's tie and follow. */
.skin-classic .create-button[disabled], .skin-classic .create-choice[disabled]
{
	color: var(--classic-disabled-text);
}
.skin-classic .create-arrow
{
	width: 160dp;
	height: 36dp;
	margin: 0dp;
	color: transparent;
}
.skin-classic .create-arrow--left
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_left_button_01.sub");
}
.skin-classic .create-arrow--right
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_right_button_01.sub");
}
.skin-classic .create-arrow--left:hover, .skin-classic .create-arrow--left:focus-visible
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_left_button_02.sub");
}
.skin-classic .create-arrow--right:hover, .skin-classic .create-arrow--right:focus-visible
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_right_button_02.sub");
}
.skin-classic .create-arrow--left:active
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_left_button_03.sub");
}
.skin-classic .create-arrow--right:active
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_right_button_03.sub");
}
