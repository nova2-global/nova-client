/* Classic skin overlay of nui/windows/dialog-input/dialog-input.rml. The
   runtime and nuitool apply it after the window's own sheet,
   dialog-input.rcss, in every theme; every rule starts with .skin-classic, so
   it acts only while a classic theme is in use (docs/ui/AUTHORING.md, Skins). */

/* The legacy input dialogs (uiscript inputdialog*.py): the title bar, the
   description and the slot-bar field under it, the two middle buttons 10dp
   apart, 11dp above the bottom edge. */
body.skin-classic.dialog-input .nui-window__body
{
	padding: 6dp 16dp 0dp 16dp;
}
body.skin-classic.dialog-input .nui-dialog__field
{
	width: 120dp;
	margin-top: 2dp;
}
body.skin-classic.dialog-input .nui-window__footer
{
	padding: 8dp 16dp 11dp 16dp;
	gap: 10dp;
}

/* Pins against the modern sheet (the reviewed design's look, which classic
   does not take): no title glyph, the middle art's width. */
body.skin-classic.dialog-input .dialog-input__icon
{
	display: none;
}
body.skin-classic.dialog-input .nui-dialog__footer .nui-button
{
	min-width: 61dp;
}

/* The shop name dialog's decoration button (Wave 5, NOVA-9; uicommon.py's
   decoButton): legacy's "..." on the extra small art beside the field. */
body.skin-classic.dialog-input .dialog-input__deco-host
{
	margin: 2dp 0 0 4dp;
}
body.skin-classic.dialog-input .dialog-input__deco
{
	width: 38dp;
	height: 19dp;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: image("d:/ymir work/ui/public/xsmall_button_01.sub" scale-none left top);
	color: var(--classic-button-text);
	line-height: 19dp;
	text-align: center;
}
body.skin-classic.dialog-input .dialog-input__deco:hover
{
	background-color: transparent;
	decorator: image("d:/ymir work/ui/public/xsmall_button_02.sub" scale-none left top);
}
body.skin-classic.dialog-input .dialog-input__deco:active
{
	background-color: transparent;
	decorator: image("d:/ymir work/ui/public/xsmall_button_03.sub" scale-none left top);
}
body.skin-classic.dialog-input .dialog-input__deco .nui-glyph
{
	display: none;
}
body.skin-classic.dialog-input .dialog-input__deco-label
{
	display: inline;
	color: var(--classic-button-text);
}
