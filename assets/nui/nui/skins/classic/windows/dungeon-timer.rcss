/* Classic overlay of the dungeon manager, direction D "Bestiary" (the board's
   Original look): the legacy board, 820 x 540, with its title bar, the thin
   board behind the details, legacy buttons and square slots; the deck's
   cards keep their places, on the legacy colors. */

body.skin-classic.dungeon-timer
{
	width: 820dp;
	height: 540dp;
	min-width: 0;
}
body.skin-classic.dungeon-timer .dungeon-timer__titlebar
{
	position: absolute;
	left: 8dp;
	top: 7dp;
	width: 805dp;
	margin: 0;
	z-index: 1;
	pointer-events: none;
}
body.skin-classic.dungeon-timer .dungeon-timer__handle,
body.skin-classic.dungeon-timer .dungeon-timer__titlebar .nui-window__close
{
	pointer-events: auto;
}
body.skin-classic.dungeon-timer .dungeon-timer__body
{
	padding: 0;
	height: 500dp;
	margin-top: 32dp;
}
body.skin-classic.dungeon-timer .dungeon-timer__card
{
	border-color: var(--border);
	border-radius: 0;
}
body.skin-classic.dungeon-timer .dungeon-timer__card--c
{
	border-color: var(--accent);
}
body.skin-classic.dungeon-timer .dungeon-timer__cap-name,
body.skin-classic.dungeon-timer .dungeon-timer__value,
body.skin-classic.dungeon-timer .dungeon-timer__drops-head,
body.skin-classic.dungeon-timer .dungeon-timer__seg-button,
body.skin-classic.dungeon-timer .dungeon-timer__filter,
body.skin-classic.dungeon-timer .dungeon-timer__chip
{
	font-weight: normal;
}
body.skin-classic.dungeon-timer .dungeon-timer__drops-head,
body.skin-classic.dungeon-timer .dungeon-timer__name
{
	color: var(--accent);
}
body.skin-classic.dungeon-timer .dungeon-timer__name
{
	font-size: 13dp;
	font-weight: normal;
}
/* The eye, the arrows and the Wiki book keep a drawn glyph, as the board's
   Original look does: legacy has no art for them. */
body.skin-classic.dungeon-timer .dungeon-timer__hide .nui-glyph,
body.skin-classic.dungeon-timer .dungeon-timer__arrow .nui-glyph,
body.skin-classic.dungeon-timer .dungeon-timer__wiki .nui-glyph
{
	display: inline-block;
}
body.skin-classic.dungeon-timer .dungeon-timer__arrow,
body.skin-classic.dungeon-timer .dungeon-timer__filter,
body.skin-classic.dungeon-timer .dungeon-timer__chip
{
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: tiled-horizontal(classic-button-middle-01-l, classic-button-middle-01-c, classic-button-middle-01-r);
	color: var(--classic-button-text);
}
body.skin-classic.dungeon-timer .dungeon-timer__arrow:hover,
body.skin-classic.dungeon-timer .dungeon-timer__filter:hover,
body.skin-classic.dungeon-timer .dungeon-timer__chip:hover
{
	decorator: tiled-horizontal(classic-button-middle-02-l, classic-button-middle-02-c, classic-button-middle-02-r);
}
body.skin-classic.dungeon-timer .dungeon-timer__arrow:active,
body.skin-classic.dungeon-timer .dungeon-timer__filter:active,
body.skin-classic.dungeon-timer .dungeon-timer__chip:active,
body.skin-classic.dungeon-timer .dungeon-timer__filter.is-on,
body.skin-classic.dungeon-timer .dungeon-timer__chip.is-on
{
	decorator: tiled-horizontal(classic-button-middle-03-l, classic-button-middle-03-c, classic-button-middle-03-r);
	color: var(--accent);
}
body.skin-classic.dungeon-timer .dungeon-timer__filter
{
	height: 21dp;
	padding: 0 6dp;
}
body.skin-classic.dungeon-timer .dungeon-timer__seg
{
	height: 21dp;
	flex: 0 0 21dp;
	border-width: 0;
	border-radius: 0;
}
body.skin-classic.dungeon-timer .dungeon-timer__seg-button
{
	border-width: 0;
	line-height: 21dp;
	height: 21dp;
	decorator: tiled-horizontal(classic-button-middle-01-l, classic-button-middle-01-c, classic-button-middle-01-r);
	color: var(--classic-button-text);
}
body.skin-classic.dungeon-timer .dungeon-timer__seg-button.is-on
{
	decorator: tiled-horizontal(classic-button-middle-03-l, classic-button-middle-03-c, classic-button-middle-03-r);
	color: var(--accent);
}
body.skin-classic.dungeon-timer .dungeon-timer__go
{
	height: 21dp;
	flex: 0 0 21dp;
	line-height: 21dp;
}
body.skin-classic.dungeon-timer .dungeon-timer__rank
{
	height: 21dp;
	min-width: 0;
	padding: 0;
	line-height: 21dp;
}
body.skin-classic.dungeon-timer .dungeon-timer__wiki
{
	padding: 0 8dp;
}
body.skin-classic.dungeon-timer .dungeon-timer__note
{
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: classic-thinboard;
	font-weight: normal;
}
/* The grid's 4dp gap is bridged by the cells' own hit outsets. */
body.skin-classic.dungeon-timer .dungeon-timer__drop
{
	nui-hit-outset: 2dp;
}
body.skin-classic.dungeon-timer .dungeon-timer__notice-box
{
	border-radius: 0;
}
