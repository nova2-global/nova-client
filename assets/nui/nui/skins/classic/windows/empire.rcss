/* Classic skin overlay of nui/windows/empire/empire.rml. The runtime and
   nuitool apply it after the window's own sheet, empire.rcss, in every theme;
   every rule starts with .skin-classic, so it acts only while a classic theme
   is in use (docs/ui/AUTHORING.md, Skins). */

/* The legacy thin board at the legacy offsets: the flag bar (black) at
   (24, 17), the name under it, the description box (black, in a light line)
   189 by 122 at x 10, and Exit and Choose (the large art, 88dp) 9dp under
   it, 16dp above the bottom. The arrows are the legacy art (82 by 28),
   without a label. */
body.skin-classic.empire
{
	background-color: var(--classic-slot-fill);
}
/* The legacy backdrop: the pattern between the two line strips, under the
   shade. */
.skin-classic .empire-pattern
{
	decorator: image("d:/ymir work/ui/intro/pattern/background_pattern.tga" repeat left top);
}
.skin-classic .empire-shade
{
	decorator: image("d:/ymir work/ui/intro/select/background_alpha.sub" fill);
	opacity: 1;
}
.skin-classic .empire-line, .skin-classic .empire-line--top, .skin-classic .empire-line--bottom
{
	decorator: image("d:/ymir work/ui/intro/pattern/line_pattern.tga" repeat-x left top);
}
.skin-classic .nui-window.empire-board
{
	width: 208dp;
	decorator: classic-thinboard;
	padding: 17dp 0dp 16dp 0dp;
}
.skin-classic .empire-flag-bar
{
	width: 159dp;
	height: 119dp;
	border-width: 0dp;
	margin: 0dp 0dp 0dp 24dp;
	background-color: var(--classic-slot-fill);
	border-radius: 0dp;
}
.skin-classic .empire-name
{
	font-size: var(--font-md);
	margin: 2dp 10dp 3dp 10dp;
	font-weight: normal;
}
/* The modern well around the description is not legacy's. */
.skin-classic .empire-well
{
	padding: 0dp;
	background-color: transparent;
	border-width: 0dp;
	border-radius: 0dp;
}
.skin-classic .empire-text
{
	height: 122dp;
	border-width: 1dp;
	color: var(--text);
	width: 189dp;
	margin: 0dp 0dp 0dp 10dp;
	padding: 6dp 7dp;
	background-color: var(--classic-slot-fill);
	border-color: var(--classic-slot-light);
	font-size: var(--font-md);
}
.skin-classic .empire-footer
{
	justify-content: flex-start;
	gap: 3dp;
	margin: 9dp 0dp 0dp 14dp;
	padding: 0dp;
}
.skin-classic .empire-button
{
	flex: 0 1 auto;
	min-width: 88dp;
	padding: 0dp;
}
/* The legacy Choose label is gray, as every legacy button label. */
.skin-classic .empire-button.nui-button--primary
{
	color: var(--classic-button-text);
}
.skin-classic .empire-arrow
{
	top: 340dp;
	width: 82dp;
	height: 28dp;
	color: transparent;
}
.skin-classic .empire-arrow--left
{
	left: 160dp;
	decorator: image("d:/ymir work/ui/intro/select/left_button_01.sub");
}
.skin-classic .empire-arrow--right
{
	left: 290dp;
	decorator: image("d:/ymir work/ui/intro/select/right_button_01.sub");
}
.skin-classic .empire-arrow--left:hover, .skin-classic .empire-arrow--left:focus-visible
{
	decorator: image("d:/ymir work/ui/intro/select/left_button_02.sub");
}
.skin-classic .empire-arrow--right:hover, .skin-classic .empire-arrow--right:focus-visible
{
	decorator: image("d:/ymir work/ui/intro/select/right_button_02.sub");
}
.skin-classic .empire-arrow--left:active
{
	decorator: image("d:/ymir work/ui/intro/select/left_button_03.sub");
}
.skin-classic .empire-arrow--right:active
{
	decorator: image("d:/ymir work/ui/intro/select/right_button_03.sub");
}
