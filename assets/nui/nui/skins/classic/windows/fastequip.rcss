/* Legacy's slot draws a tall item's icon from the cell's top. */
body.skin-classic.fastequip .fastequip__cell
{
	display: block;
	background-color: transparent;
}
body.skin-classic.fastequip .fastequip__row-label
{
	bottom: auto;
}
body.skin-classic.fastequip .fastequip__row-label--buffi
{
	left: 119dp;
	top: 330dp;
}
body.skin-classic.fastequip .fastequip__row-label--aura
{
	left: 310dp;
	top: 330dp;
}
body.skin-classic.fastequip .fastequip__buttons
{
	position: absolute;
	left: 0;
	top: 290dp;
	display: block;
	margin: 0;
}
body.skin-classic.fastequip .fastequip__switch
{
	position: absolute;
	left: 171dp;
	margin: 0;
}
body.skin-classic.fastequip .fastequip__clear
{
	position: absolute;
	left: 271dp;
}
body.skin-classic.fastequip .fastequip__edit
{
	position: absolute;
	left: 148dp;
	top: 80dp;
	z-index: 2;
	background-color: var(--surface-sunken);
}
