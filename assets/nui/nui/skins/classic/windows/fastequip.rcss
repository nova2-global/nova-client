/* Classic skin overlay of nui/windows/fastequip/fastequip.rml: legacy's
   fastequip window (uiscript fastequipwindow.py, OLD NewFastEquipWindow.py)
   at 100%, 1dp to the legacy pixel: the thin board, 460 x 435; the 10 sets
   as OLD's 88 x 21 rows from 16, 60, 23 apart (their colored bar, the edit
   mark at the left); the name bar at 115, 36 with the equipped bar left of
   it; the wear cells at OLD's slot positions from 111, 66; Switch and Clear
   at 171 and 271, 290; the row of buffi and aura cells under the buttons,
   the buffi's laid out as the costume window's (a tall weapon, the hair
   over the body).
   OLD's fast equip art is not shipped (as the legacy window's): the stock
   slot and buttons stand in. */

body.skin-classic.fastequip
{
	width: 460dp;
	height: 435dp;
	min-width: 0;
}
body.skin-classic.fastequip .fastequip__title-icon,
body.skin-classic.fastequip .fastequip__equipped-stripe
{
	display: none;
}
body.skin-classic.fastequip .fastequip__titlebar
{
	position: absolute;
	left: 8dp;
	top: 7dp;
	width: 445dp;
	margin: 0;
	z-index: 1;
}
body.skin-classic.fastequip .fastequip__body
{
	position: absolute;
	left: 0;
	top: 0;
	width: 460dp;
	height: 435dp;
	padding: 0;
	display: block;
}
body.skin-classic.fastequip .fastequip__sets
{
	position: absolute;
	left: 16dp;
	top: 36dp;
	width: 95dp;
	margin: 0;
}
body.skin-classic.fastequip .fastequip__sets-head
{
	height: 23dp;
	line-height: 23dp;
	text-align: center;
}
body.skin-classic.fastequip .fastequip__set
{
	display: block;
	position: relative;
	width: 88dp;
	height: 21dp;
	margin: 0 0 2dp 0;
	padding: 0;
	border-width: 0;
	border-radius: 0;
}
body.skin-classic.fastequip .fastequip__set-color
{
	position: absolute;
	left: 0;
	top: 0;
	width: 88dp;
	height: 21dp;
	margin: 0;
	border-radius: 0;
}
body.skin-classic.fastequip .fastequip__set-name
{
	position: absolute;
	left: 13dp;
	top: 3dp;
	width: 75dp;
	line-height: 15dp;
}
body.skin-classic.fastequip .fastequip__set-edit
{
	position: absolute;
	left: 0;
	top: 0;
	width: 13dp;
	height: 21dp;
	margin: 0;
}
body.skin-classic.fastequip .fastequip__main
{
	position: absolute;
	left: 0;
	top: 0;
	width: 460dp;
}
body.skin-classic.fastequip .fastequip__title-bar
{
	position: absolute;
	left: 115dp;
	top: 36dp;
	width: 327dp;
	height: 23dp;
	border-width: 0;
	border-radius: 0;
}
body.skin-classic.fastequip .fastequip__set-title
{
	line-height: 23dp;
}
body.skin-classic.fastequip .fastequip__canvas
{
	position: absolute;
	left: 111dp;
	top: 66dp;
	width: 336dp;
	height: 360dp;
	margin: 0;
	border-width: 0;
	background-color: transparent;
}
