/* Classic skin overlay of nui/windows/game-options/game-options.rml: the
   legacy game options (uiscript gameoptiondialog.py) at 100%, 1dp to the
   legacy pixel. The stone board, 300 x 333 (408 with the rows Waves 5 to 7
   add in uigameoption.py), with its title bar at 8, 8 (284 wide;
   the title centered over the whole bar, the close button at 266, 3); the
   labels at x 30, y 42 + 25 per row; the choices from x 90, middle art
   (61dp) 65 apart and the PvP choices small art (43dp) 45 apart, at y 40,
   65, 90, 115 and 140 (the block toggles' two rows), 165, 190, 215, 240,
   265 and 290 (the pickup filter's two rows, NOVA-50), 315 (hide shops,
   NOVA-9), 340 (sashes, NOVA-20), 365 (hide buffi, NOVA-38), 390 and 415
   (the mob info, NOVA-40), 440 (Keyboard, NOVA-121) and 465 (new items,
   NOVA-188; the board 508 tall). Labels are centered over their art as
   legacy's text lines are, a wider one overflowing both ends. The choice in
   effect and a blocked request show the down art. The PvP hints are legacy
   button tooltips: outlined text above the button, without a board. */

body.skin-classic.game-options
{
	width: 300dp;
	height: 508dp;
	min-width: 0;
}
/* z-index: the legacy rows below are positioned boxes placed from the
   board's corner, later in the document, so without it they would sit above
   the bar and take its close button's and handle's presses. */
body.skin-classic.game-options .game-options__titlebar
{
	display: block;
	position: absolute;
	left: 8dp;
	top: 8dp;
	width: 284dp;
	height: 32dp;
	margin: 0;
	padding: 0;
	z-index: 1;
}
body.skin-classic.game-options .game-options__handle
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 284dp;
	height: 23dp;
	line-height: 21dp;
	text-align: center;
}
body.skin-classic.game-options .game-options__titlebar .nui-window__close
{
	position: absolute;
	left: 266dp;
	top: 3dp;
	margin: 0;
}
body.skin-classic.game-options .game-options__body
{
	position: relative;
	height: 508dp;
	padding: 0;
}
body.skin-classic.game-options .go-row,
body.skin-classic.game-options .go-choices
{
	display: block;
	height: 0;
	margin: 0;
}
body.skin-classic.game-options .go-label
{
	position: absolute;
	left: 30dp;
	width: auto;
	color: var(--text);
	line-height: 14dp;
	white-space: nowrap;
}
body.skin-classic.game-options .go-label--name-color { top: 42dp; }
body.skin-classic.game-options .go-label--target-board { top: 67dp; }
body.skin-classic.game-options .go-label--pk { top: 92dp; }
body.skin-classic.game-options .go-label--block { top: 117dp; }
body.skin-classic.game-options .go-label--view-chat { top: 167dp; }
body.skin-classic.game-options .go-label--always-name { top: 192dp; }
body.skin-classic.game-options .go-label--damage { top: 217dp; }
body.skin-classic.game-options .go-label--sales { top: 242dp; }
body.skin-classic.game-options .go-label--pickup { top: 267dp; }
/* Wave 5's hide-shops row (legacy's at 315, the board grown 333 to 358). */
body.skin-classic.game-options .go-label--shops { top: 317dp; }
/* Wave 6's sash row (legacy's at 340, the board grown 358 to 383). */
body.skin-classic.game-options .go-label--sash { top: 342dp; }
/* The buffi's row (NOVA-38; legacy's at 365, the board grown to 408). */
body.skin-classic.game-options .go-label--buffi { top: 367dp; }
body.skin-classic.game-options .go-label--mob-level { top: 392dp; }
body.skin-classic.game-options .go-label--mob-ai { top: 417dp; }
/* The Keyboard row (NOVA-121; legacy's KEYBOARD_ROW_Y 440, the board 483). */
body.skin-classic.game-options .go-label--keys { top: 442dp; }
body.skin-classic.game-options .go-label--new-item { top: 467dp; }

body.skin-classic.game-options .go-choice
{
	position: absolute;
	width: 61dp;
	min-width: 0;
	height: 21dp;
	margin: 0;
	padding: 0;
	line-height: 21dp;
}
body.skin-classic.game-options .go-row--block .go-choice
{
	width: 61dp;
}
/* The label centered over the art, a wider one overflowing both ends. It
   takes no pointer, as legacy's text line takes none: the next choice's label
   would otherwise take the presses on the right part of the choice before it. */
body.skin-classic.game-options .go-choice__label
{
	position: absolute;
	left: -40dp;
	right: -40dp;
	top: 0;
	text-align: center;
	pointer-events: none;
}
body.skin-classic.game-options .go-choice--name-color-0 { left: 90dp; top: 40dp; }
body.skin-classic.game-options .go-choice--name-color-1 { left: 155dp; top: 40dp; }
body.skin-classic.game-options .go-choice--target-board-0 { left: 90dp; top: 65dp; }
body.skin-classic.game-options .go-choice--target-board-1 { left: 155dp; top: 65dp; }
body.skin-classic.game-options .go-choice--pk-0 { left: 90dp; top: 90dp; }
body.skin-classic.game-options .go-choice--pk-1 { left: 135dp; top: 90dp; }
body.skin-classic.game-options .go-choice--pk-4 { left: 180dp; top: 90dp; }
body.skin-classic.game-options .go-choice--pk-2 { left: 225dp; top: 90dp; }
body.skin-classic.game-options .go-choice--block-0 { left: 90dp; top: 115dp; }
body.skin-classic.game-options .go-choice--block-1 { left: 155dp; top: 115dp; }
body.skin-classic.game-options .go-choice--block-2 { left: 220dp; top: 115dp; }
body.skin-classic.game-options .go-choice--block-3 { left: 90dp; top: 140dp; }
body.skin-classic.game-options .go-choice--block-4 { left: 155dp; top: 140dp; }
body.skin-classic.game-options .go-choice--block-5 { left: 220dp; top: 140dp; }
body.skin-classic.game-options .go-choice--view-chat-1 { left: 90dp; top: 165dp; }
body.skin-classic.game-options .go-choice--view-chat-0 { left: 155dp; top: 165dp; }
body.skin-classic.game-options .go-choice--always-name-1 { left: 90dp; top: 190dp; }
body.skin-classic.game-options .go-choice--always-name-0 { left: 155dp; top: 190dp; }
body.skin-classic.game-options .go-choice--damage-1 { left: 90dp; top: 215dp; }
body.skin-classic.game-options .go-choice--damage-0 { left: 155dp; top: 215dp; }
body.skin-classic.game-options .go-choice--sales-1 { left: 90dp; top: 240dp; }
body.skin-classic.game-options .go-choice--sales-0 { left: 155dp; top: 240dp; }
body.skin-classic.game-options .go-choice--pickup-0 { left: 90dp; top: 265dp; }
body.skin-classic.game-options .go-choice--pickup-1 { left: 155dp; top: 265dp; }
body.skin-classic.game-options .go-choice--pickup-2 { left: 90dp; top: 290dp; }
body.skin-classic.game-options .go-choice--pickup-3 { left: 155dp; top: 290dp; }
body.skin-classic.game-options .go-choice--shops-0 { left: 90dp; top: 315dp; }
body.skin-classic.game-options .go-choice--shops-1 { left: 155dp; top: 315dp; }
body.skin-classic.game-options .go-choice--sash-1 { left: 90dp; top: 340dp; }
body.skin-classic.game-options .go-choice--sash-0 { left: 155dp; top: 340dp; }
body.skin-classic.game-options .go-choice--buffi-0 { left: 90dp; top: 365dp; }
body.skin-classic.game-options .go-choice--buffi-1 { left: 155dp; top: 365dp; }
body.skin-classic.game-options .go-choice--mob-level-1 { left: 90dp; top: 390dp; }
body.skin-classic.game-options .go-choice--mob-level-0 { left: 155dp; top: 390dp; }
body.skin-classic.game-options .go-choice--mob-ai-1 { left: 90dp; top: 415dp; }
body.skin-classic.game-options .go-choice--mob-ai-0 { left: 155dp; top: 415dp; }
body.skin-classic.game-options .go-choice--keys-open { left: 90dp; top: 440dp; }
body.skin-classic.game-options .go-choice--new-item-1 { left: 90dp; top: 465dp; }
body.skin-classic.game-options .go-choice--new-item-0 { left: 155dp; top: 465dp; }

/* The PvP choices on the small art; the choice in effect shows its down art,
   under the pointer too. */
body.skin-classic.game-options .go-choice--small
{
	width: 43dp;
	decorator: tiled-horizontal(classic-button-small-01-l, classic-button-small-01-c, classic-button-small-01-r);
}
body.skin-classic.game-options .go-choice--small:hover
{
	decorator: tiled-horizontal(classic-button-small-02-l, classic-button-small-02-c, classic-button-small-02-r);
}
body.skin-classic.game-options .go-choice--small:active,
body.skin-classic.game-options .go-choice--small.is-selected
{
	decorator: tiled-horizontal(classic-button-small-03-l, classic-button-small-03-c, classic-button-small-03-r);
}

body.skin-classic.game-options .nui-tooltip.go-tip
{
	decorator: none;
	padding: 0;
	background-color: transparent;
	color: var(--text);
	font-effect: outline(1dp var(--classic-text-outline));
}

/* Pins against the modern sheet (the reviewed design's look, which classic
   does not take): no title glyph, no row cells, the labels at their legacy
   places, the selected choice's label in the button text color. */
body.skin-classic.game-options .game-options__icon
{
	display: none;
}
body.skin-classic.game-options .go-row
{
	min-height: 0;
	padding: 0;
	border-width: 0;
	background-color: transparent;
}
body.skin-classic.game-options .go-label
{
	margin: 0;
}
body.skin-classic.game-options .go-choice.is-selected
{
	color: var(--classic-button-text);
}

/* The keys page (NOVA-121): the legacy key bindings dialog's board
   (uiscript keybindingsdialog.py, uikeybindings.py), 384 x 472, its title
   bar at 8, 8 (368 wide); the column heads at y 36 (the action at x 20, the
   keys centered over their cells); the list from y 56, a row every 22, the
   key cells on the large art (88dp) at x 172 and 266, a section's head as
   gold text at x 16, the action's label at x 20; legacy's scroll bar at
   x 358, y 56, 352 tall (16 rows); the notice line at x 20, y 416; Defaults
   at x 20, y 440, and Back (the legacy dialog closes by its title bar
   instead) at x 303, y 440, both on the middle art. A waiting cell shows the
   down art, as a held legacy button. */
body.skin-classic.game-options.go-keys-page
{
	width: 384dp;
	height: 472dp;
}
body.skin-classic.game-options.go-keys-page .game-options__body
{
	height: 472dp;
}
body.skin-classic.game-options.go-keys-page .game-options__titlebar,
body.skin-classic.game-options.go-keys-page .game-options__handle
{
	width: 368dp;
}
body.skin-classic.game-options.go-keys-page .game-options__titlebar .nui-window__close
{
	left: 350dp;
}
body.skin-classic.game-options .go-keys
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 384dp;
	height: 472dp;
}
body.skin-classic.game-options .gk-head
{
	display: block;
	position: absolute;
	left: 0;
	top: 36dp;
	width: 384dp;
	height: 14dp;
	padding: 0;
	color: var(--text);
	line-height: 14dp;
}
body.skin-classic.game-options .gk-head__action
{
	position: absolute;
	left: 20dp;
	top: 0;
	white-space: nowrap;
}
body.skin-classic.game-options .gk-head__key
{
	position: absolute;
	top: 0;
	width: 88dp;
	margin: 0;
	white-space: nowrap;
}
body.skin-classic.game-options .gk-head__key--1 { left: 172dp; }
body.skin-classic.game-options .gk-head__key--2 { left: 266dp; }
body.skin-classic.game-options .gk-list
{
	position: absolute;
	left: 16dp;
	top: 56dp;
	width: 357dp;
	height: 352dp;
	margin: 0;
	border-width: 0;
	border-radius: 0;
	overflow-y: scroll;
}
body.skin-classic.game-options .gk-row
{
	position: relative;
	height: 22dp;
	background-color: transparent;
}
body.skin-classic.game-options .gk-section
{
	position: absolute;
	left: 0;
	top: 4dp;
	padding: 0;
	color: var(--tip-title);
	font-weight: normal;
	font-size: var(--font-md);
	line-height: 14dp;
	white-space: nowrap;
}
body.skin-classic.game-options .gk-action
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 342dp;
	height: 22dp;
	padding: 0;
}
body.skin-classic.game-options .gk-label
{
	position: absolute;
	left: 4dp;
	top: 4dp;
	width: 148dp;
	color: var(--text);
	line-height: 14dp;
}
body.skin-classic.game-options .gk-action.is-changed .gk-label
{
	color: var(--text);
}
body.skin-classic.game-options .gk-cell
{
	position: absolute;
	top: 0;
	width: 88dp;
	height: 21dp;
	margin: 0;
	padding: 0;
	line-height: 21dp;
	font-size: var(--font-md);
}
body.skin-classic.game-options .gk-cell--1 { left: 156dp; width: 88dp; }
body.skin-classic.game-options .gk-cell--2 { left: 250dp; width: 88dp; }
body.skin-classic.game-options .gk-cell.is-selected
{
	color: var(--classic-button-text);
	border-color: transparent;
}
body.skin-classic.game-options .gk-notice
{
	position: absolute;
	left: 20dp;
	top: 416dp;
	width: 344dp;
	height: 14dp;
	margin: 0;
	color: var(--text);
	line-height: 14dp;
	white-space: nowrap;
	overflow: hidden;
}
body.skin-classic.game-options .gk-foot
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 0;
	height: 0;
	margin: 0;
}
body.skin-classic.game-options .gk-foot .nui-button
{
	position: absolute;
	width: 61dp;
	min-width: 0;
	height: 21dp;
	padding: 0;
	line-height: 21dp;
}
body.skin-classic.game-options .gk-reset { left: 20dp; top: 440dp; }
body.skin-classic.game-options .gk-back { left: 303dp; top: 440dp; }
/* A label centered over its art, a wider one overflowing both ends, as a
   legacy button's text line; it takes no pointer. */
body.skin-classic.game-options .gk-button__label
{
	position: absolute;
	left: -40dp;
	right: -40dp;
	top: 0;
	text-align: center;
	pointer-events: none;
}
