/* Classic skin overlay of nui/windows/guild-war-declare/guild-war-declare.rml: the
   legacy guild war declare dialog (uiscript declareguildwardialog.py) at 100%, 1dp
   to the legacy pixel: the stone board with its title bar, 230 x 170; the
   enemy label at 15, 40, its slot bar at 80, 37 (130 x 18, drawn 131 x 19) with the name at
   3, 3; the member cap's label at 15, 70 and its slot bar at 85, 67 (28 x 18),
   the end score's label at 122, 70 and its slot bar at 180, 67 (30 x 18), each
   field at 3, 3 (NOVA-90); the battle type's label at 15, 103 and its three
   buttons on the small art (43 x 21) at 80, 125 and 170, 100 (the declared one
   held down); OK at 49, 130 and Cancel at 120, 130 on the middle art. A type's
   hint is legacy's thin board tooltip. */

body.skin-classic.guild-war-declare .guild-war__window
{
	width: 230dp;
	height: 170dp;
	min-width: 0;
	max-width: none;
}
body.skin-classic.guild-war-declare .guild-war__titlebar
{
	position: absolute;
	left: 8dp;
	top: 7dp;
	width: 215dp;
	margin: 0;
	z-index: 1;
}
body.skin-classic.guild-war-declare .guild-war__body
{
	display: block;
	padding: 0;
}
body.skin-classic.guild-war-declare .guild-war__row
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	margin: 0;
}
body.skin-classic.guild-war-declare .guild-war__label
{
	position: absolute;
	left: 15dp;
	color: var(--text);
	font-size: var(--font-md);
	font-weight: normal;
}
body.skin-classic.guild-war-declare .guild-war__row--enemy .guild-war__label { top: 40dp; }
body.skin-classic.guild-war-declare .guild-war__row--type .guild-war__label { top: 103dp; }
/* The limits' columns are no boxes of their own: their labels and slot bars
   sit on the board, as the uiscript's. */
body.skin-classic.guild-war-declare .guild-war__limit
{
	display: block;
}
body.skin-classic.guild-war-declare .guild-war__limit--members .guild-war__label { top: 70dp; }
body.skin-classic.guild-war-declare .guild-war__limit--score .guild-war__label { left: 122dp; top: 70dp; }
/* Legacy's slot bar (a CBar3D) draws its bottom and right lines at y + h
   and x + w, so its 130 x 18 covers 131 x 19 px. */
body.skin-classic.guild-war-declare .guild-war__slot
{
	position: absolute;
	left: 80dp;
	top: 37dp;
	box-sizing: border-box;
	width: 131dp;
	height: 19dp;
	border-width: 1dp;
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
	background-color: var(--classic-slot-fill);
}
body.skin-classic.guild-war-declare .guild-war__limit--members .guild-war__slot
{
	left: 85dp;
	top: 67dp;
	width: 29dp;
}
body.skin-classic.guild-war-declare .guild-war__limit--score .guild-war__slot
{
	left: 180dp;
	top: 67dp;
	width: 31dp;
}
/* Legacy's edit line, 90 x 18 at 3, 3 of the slot bar. No margin: the
   dialog kit's field class sets one (components/dialog.rcss), which put
   the text 8dp low, over the slot's bottom edge. */
body.skin-classic.guild-war-declare .guild-war__field
{
	position: absolute;
	left: 2dp;
	top: 2dp;
	width: 90dp;
	height: 18dp;
	margin: 0;
	padding: 0;
	border-width: 0;
	background-color: transparent;
	line-height: 13dp;
}
/* The limits' edit lines, 3 digits each (legacy's 30 and 28 wide). */
body.skin-classic.guild-war-declare .guild-war__field--limit
{
	width: 24dp;
}
/* Legacy's text line at 3, 3 of the slot bar; no padding (the modern
   name's 6dp put it 8dp low, over the slot's bottom edge). */
body.skin-classic.guild-war-declare .guild-war__name
{
	position: absolute;
	left: 2dp;
	top: 2dp;
	height: 15dp;
	padding: 0;
	line-height: 13dp;
	overflow: visible;
}
body.skin-classic.guild-war-declare .guild-war__types
{
	display: block;
}
body.skin-classic.guild-war-declare .guild-war__type
{
	position: absolute;
	top: 100dp;
	width: 43dp;
	min-width: 0;
	padding: 0;
	overflow: visible;
	decorator: tiled-horizontal(classic-button-small-01-l, classic-button-small-01-c, classic-button-small-01-r);
}
body.skin-classic.guild-war-declare .guild-war__type:hover
{
	decorator: tiled-horizontal(classic-button-small-02-l, classic-button-small-02-c, classic-button-small-02-r);
}
body.skin-classic.guild-war-declare .guild-war__type:active,
body.skin-classic.guild-war-declare .guild-war__type.is-selected
{
	decorator: tiled-horizontal(classic-button-small-03-l, classic-button-small-03-c, classic-button-small-03-r);
}
/* The legacy label color on the held-down choice too (modern inks it). */
body.skin-classic.guild-war-declare .guild-war__type.is-selected
{
	color: var(--classic-button-text);
}
body.skin-classic.guild-war-declare .guild-war__type--0 { left: 80dp; }
body.skin-classic.guild-war-declare .guild-war__type--1 { left: 125dp; }
body.skin-classic.guild-war-declare .guild-war__type--2 { left: 170dp; }
body.skin-classic.guild-war-declare .guild-war__type-label
{
	position: absolute;
	left: -40dp;
	right: -40dp;
	top: 0;
	text-align: center;
}
body.skin-classic.guild-war-declare .guild-war__hint
{
	left: 0;
	bottom: auto;
	top: 24dp;
	text-align: center;
}
body.skin-classic.guild-war-declare .guild-war__footer
{
	display: block;
	padding: 0;
}
body.skin-classic.guild-war-declare .guild-war__button
{
	position: absolute;
	top: 130dp;
	width: 61dp;
	min-width: 0;
	padding: 0;
	color: var(--classic-button-text);
}
/* Legacy's middle buttons centered on the board, 5 apart and 30 right
   (-61 - 5 + 30 and 5 + 30): 49 and 120, where its window manager puts
   them, 130 down. */
body.skin-classic.guild-war-declare .guild-war__button--accept { left: 49dp; }
body.skin-classic.guild-war-declare .guild-war__button--cancel { left: 120dp; }
