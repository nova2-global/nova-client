/* Classic skin overlay of nui/windows/inventory/inventory.rml: the legacy
   inventory (uiscript inventorywindow.py) at 100%, 1dp to the legacy pixel,
   the same with today's table (inv--table-new) and the foundation's
   (inv--table-old), as legacy's one uiscript since the cut (NOVA-97): the
   stone board, 176 x 565, at legacy's place (the screen's right, 37 above
   the bottom); the title bar at 8, 7, 161 wide; Equipment_Base at 10, 33
   with equipment_bg_with_ring.tga (155 x 187), its slot window at 3, 3 and
   the wear slots at their uiscript places, the rings either side of the
   belt, no slot base (the art has the frames); the costume, dragon soul and
   mall buttons at their places on the base (78, 5; 114, 107; 118, 148);
   one tab a page on the small tab art at 8 + 32 i, 224 (legacy's five); the
   bag at 8, 246 on the slot base, at the 32px pitch; the money slot
   (parameter_slot_05.sub, 130 x 18) 28 above the bottom, centered 8 right
   of the middle (31, 537), its icon 18 left of it and the amount
   right-aligned 3 in from its right. The dragon soul button's active
   effect is legacy's slot active frames over it. The
   modern paper doll's art and stats row are not drawn; the shortcut rail,
   while it has entries, is a stone board of legacy slot cells on the
   board's left edge. */

body.skin-classic.inv
{
	width: 176dp;
	height: 565dp;
	min-width: 0;
}

/* The title bar: legacy's, placed from the board's corner. z-index: the
   parts below are positioned boxes later in the document. */
body.skin-classic.inv .inv__titlebar
{
	display: block;
	position: absolute;
	left: 8dp;
	top: 7dp;
	width: 161dp;
	height: 32dp;
	margin: 0;
	padding: 0;
	z-index: 1;
	/* Its last pixel lies over the top wear places, which take the pointer
	   there (P14b: no dead zone); its own controls take it. */
	pointer-events: none;
}
body.skin-classic.inv .inv__handle, body.skin-classic.inv .inv__titlebar .nui-window__close
{
	pointer-events: auto;
}
body.skin-classic.inv .inv__handle
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 23dp;
	line-height: 21dp;
	text-align: center;
}
body.skin-classic.inv .inv__titlebar .nui-window__close
{
	position: absolute;
	left: 143dp;
	top: 3dp;
	margin: 0;
}

/* The costume, dragon soul and mall buttons: legacy's art at their places
   on the equipment base (their uiscript offsets on Equipment_Base). */
body.skin-classic.inv .inv-equip .inv-button
{
	position: absolute;
	margin: 0;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
}
body.skin-classic.inv .inv-equip .inv-button--costume
{
	left: 78dp;
	top: 5dp;
	width: 32dp;
	height: 32dp;
	decorator: image("d:/ymir work/ui/game/costume_button_01.tga");
}
body.skin-classic.inv .inv-equip .inv-button--costume:hover
{
	decorator: image("d:/ymir work/ui/game/costume_button_02.tga");
	background-color: transparent;
}
body.skin-classic.inv .inv-equip .inv-button--costume:active
{
	decorator: image("d:/ymir work/ui/game/costume_button_03.tga");
	background-color: transparent;
}
body.skin-classic.inv .inv-equip .inv-button--dss,
body.skin-classic.inv .inv-equip .inv-button--dss.is-on
{
	left: 114dp;
	top: 107dp;
	width: 38dp;
	height: 34dp;
	decorator: image("d:/ymir work/ui/dragonsoul/dss_inventory_button_01.tga");
	background-color: transparent;
}
body.skin-classic.inv .inv-equip .inv-button--dss:hover
{
	decorator: image("d:/ymir work/ui/dragonsoul/dss_inventory_button_02.tga");
	background-color: transparent;
}
body.skin-classic.inv .inv-equip .inv-button--dss:active
{
	decorator: image("d:/ymir work/ui/dragonsoul/dss_inventory_button_03.tga");
	background-color: transparent;
}
body.skin-classic.inv .inv-equip .inv-button--mall
{
	left: 118dp;
	top: 148dp;
	width: 32dp;
	height: 32dp;
	decorator: image("d:/ymir work/ui/game/taskbar/mall_button_01.tga");
}
body.skin-classic.inv .inv-equip .inv-button--mall:hover
{
	decorator: image("d:/ymir work/ui/game/taskbar/mall_button_02.tga");
	background-color: transparent;
}
body.skin-classic.inv .inv-equip .inv-button--mall:active
{
	decorator: image("d:/ymir work/ui/game/taskbar/mall_button_03.tga");
	background-color: transparent;
}
/* The active dragon soul: legacy's slot window over the button at 3.2, 0
   with the 13 frames of the slot active effect. */
body.skin-classic.inv .inv-button__effect
{
	display: block;
	left: 3dp;
	top: 0;
	--frames-pattern: "d:/ymir work/ui/public/slotactiveeffect/%02d.sub#nui-additive";
}

/* The body's parts, placed from the board's corner. */
body.skin-classic.inv .inv__body
{
	display: block;
	position: relative;
	height: 565dp;
	padding: 0;
}

/* --- The equipment ----------------------------------------------------------- */

body.skin-classic.inv .inv-equip
{
	position: absolute;
	left: 10dp;
	top: 33dp;
	width: 155dp;
	height: 187dp;
	background-color: transparent;
	border-width: 0;
	border-radius: 0;
	decorator: image("d:/ymir work/ui/equipment_bg_with_ring.tga" scale-none left top);
}
/* The modern paper doll's art and stats row: legacy has neither. */
body.skin-classic.inv .inv-doll,
body.skin-classic.inv .inv-stats
{
	display: none;
}
/* A wear cell: the place's size, no base and no hover look (the base art
   draws the frames), the icon at the slot's corner. */
body.skin-classic.inv .inv-wear-place
{
	width: 32dp;
	height: 32dp;
}
body.skin-classic.inv .inv-wear,
body.skin-classic.inv .inv-wear:hover
{
	display: block;
	width: 100%;
	height: 100%;
	decorator: none;
}
body.skin-classic.inv .inv-wear--weapon { height: 96dp; }
body.skin-classic.inv .inv-wear--body { height: 64dp; }

/* The places, the same in both tables: the slot window's (3, 3) on the base
   plus each uiscript slot's x, y; the rings and the belt in a row (the
   uiscript's 2, 39 and 75, 106), on the art's ring boxes. */
body.skin-classic.inv.inv--table-new .inv-wear--body,
body.skin-classic.inv.inv--table-old .inv-wear--body { left: 42dp; top: 40dp; }
body.skin-classic.inv.inv--table-new .inv-wear--head,
body.skin-classic.inv.inv--table-old .inv-wear--head { left: 42dp; top: 5dp; }
body.skin-classic.inv.inv--table-new .inv-wear--foots,
body.skin-classic.inv.inv--table-old .inv-wear--foots { left: 42dp; top: 148dp; }
body.skin-classic.inv.inv--table-new .inv-wear--wrist,
body.skin-classic.inv.inv--table-old .inv-wear--wrist { left: 78dp; top: 70dp; }
body.skin-classic.inv.inv--table-new .inv-wear--weapon,
body.skin-classic.inv.inv--table-old .inv-wear--weapon { left: 6dp; top: 6dp; }
body.skin-classic.inv.inv--table-new .inv-wear--neck,
body.skin-classic.inv.inv--table-old .inv-wear--neck { left: 117dp; top: 70dp; }
body.skin-classic.inv.inv--table-new .inv-wear--ear,
body.skin-classic.inv.inv--table-old .inv-wear--ear { left: 117dp; top: 38dp; }
body.skin-classic.inv.inv--table-new .inv-wear--unique1,
body.skin-classic.inv.inv--table-old .inv-wear--unique1 { left: 5dp; top: 148dp; }
body.skin-classic.inv.inv--table-new .inv-wear--unique2,
body.skin-classic.inv.inv--table-old .inv-wear--unique2 { left: 78dp; top: 148dp; }
body.skin-classic.inv.inv--table-new .inv-wear--arrow,
body.skin-classic.inv.inv--table-old .inv-wear--arrow { left: 117dp; top: 5dp; }
body.skin-classic.inv.inv--table-new .inv-wear--shield,
body.skin-classic.inv.inv--table-old .inv-wear--shield { left: 78dp; top: 38dp; }
body.skin-classic.inv.inv--table-new .inv-wear--ring1,
body.skin-classic.inv.inv--table-old .inv-wear--ring1 { left: 5dp; top: 109dp; }
body.skin-classic.inv.inv--table-new .inv-wear--belt,
body.skin-classic.inv.inv--table-old .inv-wear--belt { left: 42dp; top: 109dp; }
body.skin-classic.inv.inv--table-new .inv-wear--ring2,
body.skin-classic.inv.inv--table-old .inv-wear--ring2 { left: 78dp; top: 109dp; }

/* No dead zone between two wear places (P14b): each cell's hit box reaches
   half the gap to the place beside it (nui-hit-outset: top, right,
   bottom, left), where the places stand 8dp apart or less; nothing draws
   differently. tools/nui_hit_test.py sweeps them. */
body.skin-classic.inv .inv-wear--body > .inv-wear { nui-hit-outset: 1.5dp 2dp 2.5dp 2dp; }
body.skin-classic.inv .inv-wear--head > .inv-wear { nui-hit-outset: 0 0 1.5dp 2dp; }
body.skin-classic.inv .inv-wear--foots > .inv-wear { nui-hit-outset: 3.5dp 2dp 0 2.5dp; }
body.skin-classic.inv .inv-wear--wrist > .inv-wear { nui-hit-outset: 0 3.5dp 3.5dp 2dp; }
body.skin-classic.inv .inv-wear--weapon > .inv-wear { nui-hit-outset: 0 2dp 3.5dp 0; }
body.skin-classic.inv .inv-wear--neck > .inv-wear { nui-hit-outset: 0 0 0 3.5dp; }
body.skin-classic.inv .inv-wear--ear > .inv-wear { nui-hit-outset: 0.5dp 0 0 3.5dp; }
body.skin-classic.inv .inv-wear--unique1 > .inv-wear { nui-hit-outset: 3.5dp 2.5dp 0 0; }
body.skin-classic.inv .inv-wear--unique2 > .inv-wear { nui-hit-outset: 3.5dp 0 0 2dp; }
body.skin-classic.inv .inv-wear--arrow > .inv-wear { nui-hit-outset: 0 0 0.5dp 0; }
body.skin-classic.inv .inv-wear--shield > .inv-wear { nui-hit-outset: 0 3.5dp 0 2dp; }
body.skin-classic.inv .inv-wear--belt > .inv-wear { nui-hit-outset: 2.5dp 2dp 3.5dp 2.5dp; }
body.skin-classic.inv .inv-wear--ring1 > .inv-wear { nui-hit-outset: 3.5dp 2.5dp 3.5dp 0; }
body.skin-classic.inv .inv-wear--ring2 > .inv-wear { nui-hit-outset: 3.5dp 0 3.5dp 2dp; }

/* The belt docks at the board's left edge, 241 below its top (legacy's
   GetBasePosition: x - 148, y + 241). */
body.skin-classic.inv .inv-belt-dock
{
	left: -10dp;
	top: 208dp;
}

/* --- The tabs ----------------------------------------------------------------- */

/* One tab a page on the small tab art, 32 wide at a 32px pitch from 8
   (legacy's Inventory_Tab_01 to _05 since NOVA-97: 8 + 32 i, 224). */
body.skin-classic.inv .inv-tabs
{
	position: absolute;
	left: 8dp;
	top: 224dp;
	width: 160dp;
	gap: 0;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
}
body.skin-classic.inv .inv-tab,
body.skin-classic.inv .inv-tab:hover,
body.skin-classic.inv .inv-tab:active,
body.skin-classic.inv .inv-tab.is-selected
{
	flex: 0 0 auto;
	width: 32dp;
	height: 19dp;
	min-width: 0;
	padding: 0;
	border-width: 0;
	background-color: transparent;
	color: var(--text);
	line-height: 19dp;
	decorator: image("d:/ymir work/ui/game/windows/tab_button_small_01.sub");
}
body.skin-classic.inv .inv-tab:hover
{
	decorator: image("d:/ymir work/ui/game/windows/tab_button_small_02.sub");
}
body.skin-classic.inv .inv-tab:active, body.skin-classic.inv .inv-tab.is-selected
{
	decorator: image("d:/ymir work/ui/game/windows/tab_button_small_03.sub");
}

/* --- The bag and the money ----------------------------------------------------- */

body.skin-classic.inv .inv-bag
{
	position: absolute;
	left: 8dp;
	top: 246dp;
}
/* The money slot from its icon (18 left of the slot) to the slot's right
   edge: 148 x 18 at 13, 537, the amount right-aligned 3 in from the right. */
body.skin-classic.inv .inv-money,
body.skin-classic.inv .inv-money:hover
{
	position: absolute;
	left: 13dp;
	top: 537dp;
	width: 148dp;
	height: 18dp;
	padding: 0 3dp 0 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: image("d:/ymir work/ui/game/windows/money_icon.sub" scale-none left bottom),
	           image("d:/ymir work/ui/public/parameter_slot_05.sub" scale-none right top);
}
body.skin-classic.inv .inv-money__amount,
body.skin-classic.inv .inv-money:hover .inv-money__amount
{
	height: 18dp;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	color: var(--text);
	font-weight: normal;
	line-height: 18dp;
}

/* --- The shortcut rail --------------------------------------------------------- */

/* While it has entries: the stone board on the board's left edge, under
   its title bar, holding one legacy slot cell per entry at the 32px pitch
   with the entry's glyph in the legacy text color. */
body.skin-classic.inv .inv-rail
{
	top: 33dp;
	margin-right: 8dp;
	padding: 8dp;
	gap: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: classic-board;
}
body.skin-classic.inv .inv-rail__grip
{
	display: none;
}
body.skin-classic.inv .inv-rail__button,
body.skin-classic.inv .inv-rail__button:hover,
body.skin-classic.inv .inv-rail__button:active
{
	width: 32dp;
	height: 32dp;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	line-height: 32dp;
	transform: none;
	decorator: image("d:/ymir work/ui/public/slot_base.sub");
}
body.skin-classic.inv .inv-rail__glyph
{
	display: inline-block;
	--glyph-ink: var(--text);
}
body.skin-classic.inv .inv-rail__button:hover .inv-rail__glyph
{
	--glyph-ink: var(--highlight);
}
body.skin-classic.inv .inv-rail__button[disabled] .inv-rail__glyph
{
	opacity: 0.5;
}
