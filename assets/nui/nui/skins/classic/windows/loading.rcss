/* Classic skin overlay of nui/windows/loading/loading.rml. The runtime and
   nuitool apply it after the window's own sheet, loading.rcss, in every theme;
   every rule starts with .skin-classic, so it acts only while a classic theme
   is in use (docs/ui/AUTHORING.md, Skins). */

/* The legacy emblem: its 24 frames of 1/60 s as skin-provided frames (the
   timing stays in the markup); the modern ring does not show. */
.skin-classic .loading-frames
{
	--frames-pattern: "d:/ymir work/ui/intro/loading/%02d.sub";
}
.skin-classic .loading__track, .skin-classic .loading__hole, .skin-classic .loading__ring,
.skin-classic .loading__tick, .skin-classic .loading__pct
{
	display: none;
}
/* The legacy box holds the emblem and the gauge with no panel of its own. */
.skin-classic .nui-board.loading-board
{
	background-color: transparent;
	border-width: 0dp;
	border-radius: 0dp;
}

/* The legacy gauge: the empty art, and the full art as the fill image, which
   RmlUi crops to the value as legacy SetPercentage crops it. The error line
   is the legacy text line, outlined for the image under it. */
.skin-classic progress.loading-gauge
{
	top: 25dp;
	width: 336dp;
	height: 30dp;
	decorator: image("d:/ymir work/ui/intro/loading/gauge_empty.sub");
	fill-image: "d:/ymir work/ui/intro/loading/gauge_full.sub";
	background-color: transparent;
	border-width: 0dp;
	border-radius: 0dp;
}
.skin-classic progress.loading-gauge fill
{
	decorator: none;
	background-color: transparent;
	border-radius: 0dp;
}
.skin-classic .loading-error
{
	padding: 0dp;
	background-color: transparent;
	border-radius: 0dp;
	color: var(--text);
	font-effect: outline(1dp var(--classic-text-outline));
}
