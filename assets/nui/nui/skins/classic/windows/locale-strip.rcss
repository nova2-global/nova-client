/* Classic overlay of the compact locale dropdown. The toggle and rows use
   the classic button component, and the list uses the same thin board as the
   login menu. */
.skin-classic .locale-strip__toggle
{
	min-height: 21dp;
	height: 21dp;
	padding: 0dp 9dp;
	background-color: transparent;
	border-color: transparent;
	border-radius: 0;
}
.skin-classic .locale-strip__menu
{
	top: 25dp;
	padding: 6dp;
	decorator: classic-thinboard;
	background-color: transparent;
	border-width: 0;
	border-radius: 0;
}
.skin-classic .locale-strip__item
{
	height: 21dp;
	padding: 0dp 9dp;
	border-left-width: 0;
	border-radius: 0;
}
.skin-classic .locale-strip__item.is-selected
{
	background-color: var(--classic-select);
	color: var(--classic-label-white);
}
.skin-classic .locale-strip__item.is-selected .locale-strip__name
{
	color: var(--classic-label-white);
}
.skin-classic .locale-strip__chevron
{
	display: inline-block;
}
