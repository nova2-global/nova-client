/* Classic skin overlay of nui/windows/login/login.rml. The runtime and nuitool
   apply it after the window's own sheet, login.rcss, in every theme; every
   rule starts with .skin-classic, so it acts only while a classic theme is in
   use (docs/ui/AUTHORING.md, Skins). */

/* The legacy login board (uiscript loginwindow.py) as one thin board, 208dp
   wide: the server row with Choose, the two painted fields, Exit and
   Connect at the legacy button sizes. The legacy UI draws two boards (the
   connect board and the login window art); this document is one board, so
   classic draws one (docs/ui/AUTHORING.md, Classic skin). Every rule
   starts with .skin-classic and outweighs the rule of login.rcss that it
   changes; none declares motion. */
body.skin-classic.login
{
	width: 208dp;
	margin-left: -104dp;
	min-width: 0dp;
	decorator: classic-thinboard;
}
/* The rows sit where the legacy art puts them, measured from the top of the
   connect board: the server row is the connect board (30dp), the painted
   fields are at +56 and +91 (35dp apart; the legacy edit lines inside them
   are 37 apart), each 17dp under the top of its label, and Exit and
   Connect are at +114, so the board is 142dp tall at rest. */
.skin-classic.login .nui-window__body
{
	padding: 0dp 15dp 0dp 15dp;
	gap: 0dp;
}
.skin-classic .login-server
{
	height: 30dp;
	padding: 0dp;
	background-color: transparent;
	border-width: 0dp;
	border-radius: 0dp;
}
/* The modern pictograms and the chevron on Choose are not legacy's; each
   field stands alone on its line, as before them. */
.skin-classic .login-icon
{
	display: none;
}
.skin-classic .login-control
{
	display: block;
}
.skin-classic.login .login-r2
{
	margin-top: 9dp;
}
.skin-classic .login-server__name
{
	color: var(--text);
}
/* Choose: the small art at its legacy width, the label across all of it.
   A minimum, not a width, so a longer translation widens the art instead
   of spilling out of it (French needs 54px in Tahoma). */
.skin-classic .login-server .login-button
{
	min-width: 43dp;
	padding: 0;
}
.skin-classic.login .nui-field
{
	text-align: center;
}
/* 15dp lines plus the classic 2dp margin: 17dp from a label's top to its field. */
.skin-classic.login .nui-field__label
{
	text-align: center;
	line-height: 15dp;
}
/* The field art of the legacy login window, 120 by 18, painted, not bordered.
   vertical-align: top keeps the field off the text baseline of its line,
   whose strut comes from the font's rounded ascent and descent and so does
   not scale linearly: on the baseline, each field row of the board grew
   1.5px beyond twice its 100% size at 200% with Tahoma. */
.skin-classic input.login-input
{
	decorator: image(classic-login-field);
	width: 120dp;
	height: 18dp;
	line-height: 18dp;
	vertical-align: top;
	padding: 0 4dp;
	border-width: 0;
	background-color: transparent;
	color: var(--classic-edit-text);
	caret-color: var(--classic-edit-text);
	text-align: left;
}
/* No border to color: the tint turns the painted bevel red. */
.skin-classic input.login-input.nui-input--invalid
{
	image-color: var(--danger);
}
/* The legacy UI shows login errors in popups, so classic keeps no empty
   line for one: the error line takes space only while there is an error
   (login-error--in follows error != ''), and the board, anchored at its
   bottom, grows upward by one line then. Centered like the labels, with
   the outline the legacy UI gives text over its art, since the thin board
   is translucent over the bright intro. */
.skin-classic.login .login-error
{
	display: none;
	min-height: 0dp;
	margin-top: var(--space-1);
	text-align: center;
	font-effect: outline(1dp var(--classic-text-outline));
}
.skin-classic.login .login-error.login-error--in
{
	display: block;
}
.skin-classic.login .nui-window__footer
{
	justify-content: center;
	gap: 2dp;
	padding: 5dp 15dp 7dp 15dp;
}
/* Exit and Connect: the large art at its legacy width, again as a minimum. */
.skin-classic .nui-window__footer .login-button
{
	min-width: 88dp;
	padding: 0;
	flex: 0 1 auto;
}
/* The legacy Connect label is gray. Both this and the classic --primary rule
   weigh 200,000, and this sheet comes after classic.rcss. */
.skin-classic .login-connect
{
	color: var(--classic-button-text);
}
