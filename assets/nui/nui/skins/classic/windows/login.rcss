/* Classic skin overlay of nui/windows/login/login.rml. The runtime and nuitool
   apply it after the window's own sheet, login.rcss, in every theme; every
   rule starts with .skin-classic, so it acts only while a classic theme is in
   use (docs/ui/AUTHORING.md, Skins). */

/* The one-page login of the reviewed classic board (LoginClassic): both
   boards in the legacy board art the window frame draws in classic, the
   saved accounts 280dp and the card 300dp wide, with the legacy board's
   tight padding; the headings centered in the legacy label color with its
   outline; the fields, toggles and buttons in the classic components' legacy
   art; the selected account on the legacy list's selection; no
   pictograms (the modern lock, person and chevron are not legacy's). None
   declares motion. */
.skin-classic .login-accounts
{
	width: 280dp;
}
.skin-classic .login-card
{
	width: 300dp;
}
.skin-classic .login-accounts__body, .skin-classic .login-card__body
{
	padding: 6dp 8dp 8dp 8dp;
	gap: 8dp;
}
.skin-classic .login-pane
{
	gap: 8dp;
}
.skin-classic .login-h, .skin-classic .login-title
{
	color: var(--classic-label-white);
	text-align: center;
	font-weight: normal;
	font-effect: outline(1dp var(--classic-text-outline));
}
.skin-classic .login-h
{
	font-size: var(--font-sm);
}
.skin-classic .login-title
{
	font-size: var(--font-md);
}
.skin-classic .login-acc
{
	gap: 8dp;
	padding: 4dp 4dp 4dp 6dp;
	border-width: 0;
	border-radius: 0;
}
.skin-classic .login-acc:hover
{
	background-color: var(--classic-hover-white);
}
.skin-classic .login-acc.is-selected
{
	background-color: var(--classic-select);
}
.skin-classic .login-acc__face
{
	width: 32dp;
	height: 32dp;
	border-radius: 0;
}
.skin-classic .login-acc__name
{
	font-weight: normal;
}
.skin-classic .login-char, .skin-classic .login-char__face
{
	border-radius: 0;
}
.skin-classic .login-add
{
	height: 21dp;
	border-width: 0;
	border-radius: 0;
	color: var(--highlight);
}
.skin-classic .login-hint
{
	color: var(--text-muted);
}
/* The modern pictograms and the chevron are not legacy's; the fields start
   at their own left edge. */
.skin-classic .login-icon, .skin-classic .login-chevron, .skin-classic .login-add__glyph
{
	display: none;
}
.skin-classic input.login-input
{
	height: 18dp;
	line-height: 18dp;
	padding-left: 4dp;
}
.skin-classic input.login-input--eye
{
	padding-right: 24dp;
}
.skin-classic .login-eye
{
	top: -3dp;
}
.skin-classic .login-tabs
{
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
}
.skin-classic .login-tab
{
	height: 21dp;
	line-height: 21dp;
}
.skin-classic .login-action
{
	height: 21dp;
	line-height: 21dp;
	border-radius: 0;
}
.skin-classic .login-link
{
	color: var(--highlight);
	font-weight: normal;
}
/* The status line as the legacy board's centered text: the server's dot,
   its name and count, the channel button. */
.skin-classic .login-status
{
	height: 21dp;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	justify-content: center;
}
.skin-classic .login-status__name
{
	color: var(--classic-label-white);
	font-weight: normal;
}
.skin-classic .login-dot
{
	width: 7dp;
	height: 7dp;
	border-radius: 0;
}
.skin-classic .login-menu
{
	margin-top: 0;
}
/* The legacy UI shows login errors in popups, so classic keeps no empty
   line for one: the error line takes space only while there is an error,
   centered like the labels, with the outline the legacy UI gives text over
   its art. */
.skin-classic .login-error
{
	display: none;
	min-height: 0dp;
	margin: 0;
	text-align: center;
	font-effect: outline(1dp var(--classic-text-outline));
}
.skin-classic .login-error.login-error--in
{
	display: block;
}
.skin-classic .login-link-button
{
	height: 21dp;
	line-height: 21dp;
	padding: 0 12dp;
	border-radius: 0;
	font-weight: normal;
}
.skin-classic .login-exit
{
	height: 21dp;
	line-height: 21dp;
}
/* The legacy primary labels are gray. Both this and the classic --primary
   rule weigh 200,000, and this sheet comes after classic.rcss. */
.skin-classic .login-connect
{
	color: var(--classic-button-text);
}
