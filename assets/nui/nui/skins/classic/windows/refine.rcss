/* Classic skin overlay of nui/windows/refine/refine.rml: legacy's refine
   dialogs (uirefine.py RefineDialogNew and RefineDialog, uiscript
   refinedialog.py) at 100%, 1dp to the legacy pixel. The new dialog's board
   is the tooltip + 60 wide (UpdateDialog): the title bar at (8, 8), the
   tooltip (a thin board, as legacy's ItemToolTip is) at (50, 38), the
   item's slots and icon 35 to its left, centered on it; the materials 8
   under it, every 34 px: the slot at x 15 and a thin board of the
   tooltip's width at x 50, 20 tall, its text 15 in; the cost 64 above the
   bottom, the middle buttons 35 above it, 35 left and right of the middle.
   The old dialog has no item, no materials: the tooltip at (15, 38), the
   board the tooltip + 30 wide. */

body.skin-classic.refine
{
	--tip-min-w: 190dp;
	min-width: 0;
	padding: 0;
}
body.skin-classic.refine .refine__titlebar
{
	position: absolute;
	left: 8dp;
	top: 8dp;
	right: 7dp;
	margin: 0;
	z-index: 1;
}
body.skin-classic.refine .refine__body
{
	display: block;
	padding: 38dp 10dp 0 0;
}
body.skin-classic.refine.refine--old .refine__body
{
	padding: 38dp 15dp 0 15dp;
}
body.skin-classic.refine .refine__main
{
	display: flex;
	flex-direction: row;
	align-items: center;
}
body.skin-classic.refine .refine__item-column
{
	width: 35dp;
	margin: 0 0 0 15dp;
}
body.skin-classic.refine .refine__item.nui-slot--h2, body.skin-classic.refine .refine__item.nui-slot--h3
{
	decorator: image("d:/ymir work/ui/public/slot_base.sub" repeat left top);
}
body.skin-classic.refine .refine__tip
{
	box-sizing: border-box;
	min-width: var(--tip-min-w);
	padding: 11dp 0 11dp 0;
}
body.skin-classic.refine .refine__materials
{
	margin-top: 8dp;
}
body.skin-classic.refine.refine--old .refine__materials
{
	display: none;
}
body.skin-classic.refine .refine__material
{
	display: block;
	position: relative;
	height: 34dp;
	margin: 0;
}
body.skin-classic.refine .refine__material-cell
{
	position: absolute;
	left: 15dp;
	top: 0;
}
body.skin-classic.refine .refine__material-text
{
	position: absolute;
	left: 50dp;
	top: 0;
	box-sizing: border-box;
	width: var(--tip-min-w);
	height: 20dp;
	margin: 0;
	padding: 0 0 0 15dp;
	line-height: 20dp;
	color: var(--text);
	decorator: classic-thinboard;
	font-effect: outline(1dp var(--classic-text-outline));
}
body.skin-classic.refine .refine__line
{
	margin-top: 7dp;
	line-height: 17dp;
	font-effect: outline(1dp var(--classic-text-outline));
}
body.skin-classic.refine.refine--old .refine__line
{
	margin-top: 6dp;
}
body.skin-classic.refine .refine__footer
{
	display: block;
	position: relative;
	height: 21dp;
	margin: 12dp 0 0 0;
	padding: 0 0 14dp 0;
}
body.skin-classic.refine .refine__accept, body.skin-classic.refine .refine__cancel
{
	position: absolute;
	left: 50%;
	top: 0;
	margin: 0 0 0 -65dp;
}
body.skin-classic.refine .refine__cancel
{
	margin: 0 0 0 5dp;
}
/* The legacy buttons' labels are gray, the first one too (refinedialog.py
   gives it no color): the classic primary's accent stays off. */
body.skin-classic.refine .refine__accept
{
	color: var(--classic-button-text);
}

/* --- the tooltip lines: legacy's (uitooltip.py ToolTip), the same in every
   overlay of a document with the tooltip block (tools/nui_tooltip_test.py
   checks it): 17 px a line, text outlined but where the rules leave it out
   (AppendMetinWearInformation), left lines 10 px in; a socket row is the
   legacy frame (36 x 36) at (9, -1) with the stone at (1, 1) in it and its lines at
   x 50, 16 px apart then 18 (legacy lets a long one run past the board's
   edge; here the board grows to hold it, 10 px to spare); a divider is legacy's two lines, 150 px wide,
   3 px under the line above, 11 px in all, centered by its slot (an
   inline block: auto margins would stretch a shrink-to-fit board). --- */
.skin-classic .nui-tip__line
{
	line-height: 17dp;
	padding: 0 10dp;
	font-effect: outline(1dp var(--classic-text-outline));
}
.skin-classic .nui-tip__line--plain
{
	font-effect: none;
}
.skin-classic .nui-tip__body > .nui-tip__slot:first-child .nui-tip-role--title,
.skin-classic .nui-tip__body > .nui-tip__slot:first-child .nui-tip-role--special
{
	font-weight: normal;
}
.skin-classic .nui-tip__rule
{
	display: inline-block;
	vertical-align: top;
	width: 150dp;
	height: 1dp;
	margin: 3dp 0 6dp 0;
	background-color: var(--tip-divider);
	border-bottom-width: 1dp;
	border-bottom-color: var(--tip-divider-shadow);
}
.skin-classic .nui-tip__socket
{
	display: block;
	position: relative;
	min-height: 35dp;
	padding: 0 0 0 50dp;
}
.skin-classic .nui-tip__socket-frame
{
	position: absolute;
	left: 9dp;
	top: -1dp;
	width: 36dp;
	height: 36dp;
	border-width: 0;
	border-radius: 0;
	decorator: image("d:/ymir work/ui/game/windows/metin_slot_silver.sub" scale-none left top);
}
.skin-classic .nui-tip__socket--gold .nui-tip__socket-frame
{
	decorator: image("d:/ymir work/ui/game/windows/metin_slot_gold.sub" scale-none left top);
}
.skin-classic .nui-tip__socket-icon
{
	position: absolute;
	left: 1dp;
	top: 1dp;
}
.skin-classic .nui-tip__socket-lines
{
	margin-left: 0;
	padding: 2dp 0 1dp 0;
}
.skin-classic .nui-tip__socket-lines .nui-tip__line
{
	line-height: 16dp;
	padding: 0 10dp 0 0;
}
.skin-classic .nui-tip__socket-lines > .nui-tip__slot:nth-child(n+3)
{
	margin-top: 2dp;
}
/* --- end of the tooltip lines --- */
