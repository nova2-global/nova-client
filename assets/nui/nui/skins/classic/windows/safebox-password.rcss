/* Classic skin overlay of nui/windows/safebox-password/safebox-password.rml:
   the legacy password dialog (uiscript passworddialog.py) at 100%, 1dp to
   the legacy pixel: the stone board, 250 x 150; the title bar at 8, 8, 234
   wide; the description lines centered on x 125, their tops at y 30, 42, 80,
   92 and 104; the field's parameter slot (61 x 18) centered at y 56, the
   field at 3, 3 in it, 60 x 18; OK at 59, 120 and Cancel at 130, 120 on the
   middle art, their labels the legacy gray. */

body.skin-classic.safebox-password .safebox-password__window
{
	width: 250dp;
	height: 150dp;
	min-width: 0;
	max-width: none;
}
body.skin-classic.safebox-password .safebox-password__titlebar
{
	position: absolute;
	left: 8dp;
	top: 8dp;
	width: 234dp;
	margin: 0;
	z-index: 1;
}
body.skin-classic.safebox-password .safebox-password__body
{
	display: block;
	padding: 0;
}
body.skin-classic.safebox-password .safebox-password__desc
{
	position: absolute;
	left: 0;
	width: 250dp;
	margin: 0;
	line-height: 14dp;
	color: var(--text);
	font-size: var(--font-md);
	text-align: center;
	white-space: nowrap;
	pointer-events: none;
}
body.skin-classic.safebox-password .safebox-password__desc--1 { top: 30dp; }
body.skin-classic.safebox-password .safebox-password__desc--2 { top: 42dp; }
body.skin-classic.safebox-password .safebox-password__desc--3 { top: 80dp; }
body.skin-classic.safebox-password .safebox-password__desc--4 { top: 92dp; }
body.skin-classic.safebox-password .safebox-password__desc--5 { top: 104dp; }
body.skin-classic.safebox-password .safebox-password__slot
{
	position: absolute;
	left: 95dp;
	top: 56dp;
	width: 61dp;
	height: 18dp;
	decorator: image("d:/ymir work/ui/public/parameter_slot_02.sub");
}
/* The edit line on the slot art: no box of its own. */
body.skin-classic.safebox-password .safebox-password__field
{
	position: absolute;
	left: 3dp;
	top: 3dp;
	width: 60dp;
	height: 18dp;
	margin: 0;
	padding: 0;
	border-width: 0;
	background-color: transparent;
	line-height: 13dp;
}
body.skin-classic.safebox-password .safebox-password__footer
{
	display: block;
	padding: 0;
}
body.skin-classic.safebox-password .safebox-password__button
{
	position: absolute;
	top: 120dp;
	width: 61dp;
	min-width: 0;
	padding: 0;
	color: var(--classic-button-text);
}
body.skin-classic.safebox-password .safebox-password__button--accept { left: 59dp; }
body.skin-classic.safebox-password .safebox-password__button--cancel { left: 130dp; }
