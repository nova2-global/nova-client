/* Classic skin overlay of nui/windows/server-board/server-board.rml. The
   runtime and nuitool apply it after the window's own sheet,
   server-board.rcss, in every theme; every rule starts with .skin-classic, so
   it acts only while a classic theme is in use (docs/ui/AUTHORING.md, Skins). */

/* The legacy thin board, exactly 400dp tall: the title 12dp from the top,
   the separator (a light line over a dark one) at 34dp, the lists at 40dp,
   the vertical separator at 246dp, the channel column at 255dp, and OK and
   Exit (the large art, 88dp) at 267dp, 351dp and 373dp. The lists are the
   legacy list boxes: no frame, 17dp rows. */
body.skin-classic.server-board
{
	height: 400dp;
	padding: 0dp;
	decorator: classic-thinboard;
}
.skin-classic .server-board__title
{
	height: 23dp;
	padding-top: 11dp;
	line-height: 15dp;
	font-weight: normal;
}
.skin-classic .server-board__rule
{
	margin: 0dp 11dp 0dp 10dp;
}
.skin-classic .server-board__row
{
	margin: 2dp 0dp 0dp 10dp;
}
.skin-classic.server-board .nui-list
{
	padding: 0dp;
}
.skin-classic .server-board__servers
{
	margin-top: 2dp;
}
.skin-classic .server-board__split
{
	height: 355dp;
	margin: 0dp 0dp 0dp 4dp;
	border-left-color: var(--classic-separator);
	border-right-width: 1dp;
	border-right-color: var(--classic-separator-shadow);
}
.skin-classic .server-board__side
{
	margin: 2dp 0dp 0dp 7dp;
}
.skin-classic .server-board__channels .nui-list__viewport
{
	height: 311dp;
}
.skin-classic .server-board__buttons
{
	align-items: flex-start;
	gap: 1dp;
	margin: 0dp 0dp 0dp 12dp;
}
.skin-classic .server-board__button
{
	min-width: 88dp;
	padding: 0dp;
}
/* The legacy rows are 17dp: the state fits the 15dp line. */
.skin-classic .server-board__channels .nui-list__item
{
	padding: 0dp var(--space-1);
}
/* Legacy writes the state as plain list text after the name ("CH1 NORM",
   intrologin.py), not as a badge: no pill, no variant color, the list's own
   type. The extra class outranks the badge variants. */
.skin-classic .server-board__state.nui-badge
{
	height: 15dp;
	line-height: 15dp;
	margin-left: 0dp;
	padding: 0dp;
	border-radius: 0dp;
	background-color: transparent;
	color: var(--text);
	font-size: var(--font-md);
	font-weight: normal;
}
/* The legacy OK label is gray. */
.skin-classic .server-board__button.nui-button--primary
{
	color: var(--classic-button-text);
}
@media (max-height: 560dp)
{
	body.skin-classic.server-board
	{
		height: 209dp;
	}
	.skin-classic .server-board__split
	{
		height: 164dp;
	}
	.skin-classic .server-board__channels .nui-list__viewport
	{
		height: 120dp;
	}
}
