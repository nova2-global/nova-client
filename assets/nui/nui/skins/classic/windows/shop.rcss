/* Classic skin overlay of nui/windows/shop/shop.rml: the legacy shop
   (uiscript shopdialog.py) at 100%, 1dp to the legacy pixel: the stone
   board, 184 x 328; the title bar at 8, 8, 169 wide; the grid at 12, 34 on
   the slot base at the 32px pitch; at y 295 the buy and sell toggles (middle
   art) at 21 and 104, or the two middle tabs at 21 and 104, or the three
   small tabs at 21, 71 and 120, or the player's own shop's close button
   (large art), centered. A tab's art follows its legacy button state
   (is-down: legacy's RadioButton Down), not the tab shown. */

body.skin-classic.shop
{
	width: 184dp;
	height: 328dp;
	min-width: 0;
}
body.skin-classic.shop .shop__title-icon
{
	display: none;
}
body.skin-classic.shop .shop__titlebar
{
	position: absolute;
	left: 8dp;
	top: 8dp;
	width: 169dp;
	margin: 0;
	z-index: 1;
	/* Its last 6dp lie over the grid's first row, which takes the pointer
	   there (P14b: no dead zone); the handle and the close button take it. */
	pointer-events: none;
}
body.skin-classic.shop .shop__handle, body.skin-classic.shop .shop__titlebar .nui-window__close
{
	pointer-events: auto;
}
/* Legacy's TitleBar puts its close button 3 from its right end
   (ui.py TitleBar.SetWidth: width - 15 - 3, 3); an offset, so the title
   keeps its place. */
body.skin-classic.shop .shop__titlebar .nui-window__close
{
	position: relative;
	left: -3dp;
}
body.skin-classic.shop .shop__body
{
	display: block;
	padding: 0;
}
body.skin-classic.shop .shop__grid
{
	position: absolute;
	left: 12dp;
	top: 34dp;
}
body.skin-classic.shop .shop__footer
{
	display: block;
	padding: 0;
}
body.skin-classic.shop .shop__buy, body.skin-classic.shop .shop__sell, body.skin-classic.shop .shop__close-shop
{
	position: absolute;
	top: 295dp;
}
body.skin-classic.shop .shop__buy
{
	left: 21dp;
	width: 61dp;
	color: var(--classic-button-text);
}
body.skin-classic.shop .shop__sell
{
	left: 104dp;
	width: 61dp;
}
body.skin-classic.shop .shop__close-shop
{
	left: 48dp;
	width: 88dp;
	color: var(--classic-button-text);
}
body.skin-classic.shop .shop__tabs
{
	display: block;
	position: absolute;
	left: 0;
	top: 295dp;
	width: 184dp;
	height: 21dp;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	/* Only the tabs take the pointer: the row's box lies over nothing else. */
	pointer-events: none;
}
body.skin-classic.shop .shop__tab-slot
{
	position: absolute;
	top: 0;
	width: 61dp;
	height: 21dp;
	pointer-events: auto;
}
body.skin-classic.shop .shop__tab-slot--0 { left: 21dp; }
body.skin-classic.shop .shop__tab-slot--1 { left: 104dp; }
body.skin-classic.shop.shop--tabs-small .shop__tab-slot { width: 43dp; }
body.skin-classic.shop.shop--tabs-small .shop__tab-slot--1 { left: 71dp; }
body.skin-classic.shop.shop--tabs-small .shop__tab-slot--2 { left: 120dp; }
body.skin-classic.shop .shop__tab
{
	width: 100%;
	min-width: 0;
	height: 21dp;
	padding: 0;
	border-radius: 0;
	color: var(--classic-button-text);
	line-height: 21dp;
	overflow: visible;
}
body.skin-classic.shop .shop__tab:hover
{
	background-color: transparent;
	color: var(--classic-button-text);
}
/* The tab's name centered over its art as legacy's text line is, a longer
   one overflowing both ends ("Weapons" on the 43dp small art), never cut;
   it takes no pointer, as legacy's text line takes none, so a press on the
   overflow is the neighbor's. */
body.skin-classic.shop .shop__tab-label
{
	position: absolute;
	left: -40dp;
	right: -40dp;
	top: 0;
	overflow: visible;
	text-align: center;
}
body.skin-classic.shop .shop__tab.is-current
{
	background-color: transparent;
	border-color: transparent;
	color: var(--classic-button-text);
}
/* The small tabs: legacy's small art; the middle ones keep the medium
   button's middle art. The down art last, as legacy's pressed button keeps
   it under the pointer. */
body.skin-classic.shop.shop--tabs-small .shop__tab
{
	decorator: tiled-horizontal(classic-button-small-01-l, classic-button-small-01-c, classic-button-small-01-r);
}
body.skin-classic.shop.shop--tabs-small .shop__tab:hover
{
	decorator: tiled-horizontal(classic-button-small-02-l, classic-button-small-02-c, classic-button-small-02-r);
}
body.skin-classic.shop.shop--tabs-small .shop__tab:active
{
	decorator: tiled-horizontal(classic-button-small-03-l, classic-button-small-03-c, classic-button-small-03-r);
}
body.skin-classic.shop .shop__tab.is-down, body.skin-classic.shop .shop__tab.is-down:hover
{
	decorator: tiled-horizontal(classic-button-middle-03-l, classic-button-middle-03-c, classic-button-middle-03-r);
}
body.skin-classic.shop.shop--tabs-small .shop__tab.is-down, body.skin-classic.shop.shop--tabs-small .shop__tab.is-down:hover
{
	decorator: tiled-horizontal(classic-button-small-03-l, classic-button-small-03-c, classic-button-small-03-r);
}

/* Offline VIEW: uiscript/shopdialognew.py widened to 345, with the 10 x 8
   grid still at (12, 34), page buttons at y 296 and the legacy owner panel
   from uiscript/offlineshop.py at y 322. */
body.skin-classic.shop.shop--offline
{
	width: 345dp;
	height: 328dp;
}
body.skin-classic.shop.shop--offline.shop--owner
{
	height: 472dp;
}
body.skin-classic.shop.shop--offline .shop__titlebar
{
	width: 330dp;
}
body.skin-classic.shop.shop--offline .shop__grid
{
	left: 12dp;
	top: 34dp;
}
body.skin-classic.shop.shop--offline .shop__pending
{
	border-radius: 0;
	background-color: var(--slot-unavailable);
}
body.skin-classic.shop.shop--offline .shop__lock
{
	height: 32dp;
	border-width: 0;
	border-radius: 0;
	font-size: var(--font-sm);
}
body.skin-classic.shop.shop--offline .shop__lock--locked
{
	background-color: var(--slot-locked);
}
body.skin-classic.shop.shop--offline .shop__lock--next
{
	background-color: var(--selection);
	color: var(--success);
}
body.skin-classic.shop.shop--offline .shop__lock--row-0 { top: 0; }
body.skin-classic.shop.shop--offline .shop__lock--row-1 { top: 32dp; }
body.skin-classic.shop.shop--offline .shop__lock--row-2 { top: 64dp; }
body.skin-classic.shop.shop--offline .shop__lock--row-3 { top: 96dp; }
body.skin-classic.shop.shop--offline .shop__lock--row-4 { top: 128dp; }
body.skin-classic.shop.shop--offline .shop__lock--row-5 { top: 160dp; }
body.skin-classic.shop.shop--offline .shop__lock--row-6 { top: 192dp; }
body.skin-classic.shop.shop--offline .shop__lock--row-7 { top: 224dp; }
body.skin-classic.shop.shop--offline .shop__pages
{
	position: absolute;
	left: 0;
	top: 296dp;
	width: 345dp;
	height: 21dp;
	margin: 0;
	gap: 10dp;
}
body.skin-classic.shop.shop--offline .shop__page
{
	width: 43dp;
	min-width: 43dp;
	padding: 0;
}
body.skin-classic.shop.shop--offline .shop__page.is-selected
{
	decorator: tiled-horizontal(classic-button-small-03-l, classic-button-small-03-c, classic-button-small-03-r);
	color: var(--classic-button-text);
}

body.skin-classic.shop .shop-owner
{
	display: block;
	position: absolute;
	left: 0;
	top: 322dp;
	width: 345dp;
	height: 150dp;
	margin: 0;
	padding: 0;
	border-width: 0;
}
body.skin-classic.shop .shop-owner__row
{
	display: block;
	position: absolute;
	left: 0;
	width: 345dp;
	height: 22dp;
	min-height: 0;
}
body.skin-classic.shop .shop-owner__row--sign { top: 0; }
body.skin-classic.shop .shop-owner__row--location { top: 26dp; }
body.skin-classic.shop .shop-owner__row--gold { top: 52dp; }
body.skin-classic.shop .shop-owner__row--time { top: 78dp; }
body.skin-classic.shop .shop-owner__value, body.skin-classic.shop .shop-owner__gold,
body.skin-classic.shop .shop-owner__time
{
	display: block;
	position: absolute;
	left: 14dp;
	top: 0;
	min-height: 0;
	height: 18dp;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	line-height: 18dp;
}
body.skin-classic.shop .shop-owner__value
{
	width: 250dp;
}
body.skin-classic.shop .shop-owner__gold
{
	box-sizing: border-box;
	width: 160dp;
	padding-left: 4dp;
	border-width: 1dp;
	border-color: var(--classic-slot-light);
	background-color: var(--classic-slot-fill);
}
body.skin-classic.shop .shop-owner__gold .nui-glyph
{
	display: none;
}
body.skin-classic.shop .shop-owner__time
{
	width: 250dp;
}
body.skin-classic.shop .shop-owner__time nui-countdown
{
	position: absolute;
	left: 116dp;
	top: 0;
	margin: 0;
	color: var(--text);
}
body.skin-classic.shop .shop-owner__side
{
	position: absolute;
	left: 270dp;
	top: 0;
	width: 61dp;
	min-width: 61dp;
	padding: 0;
}
body.skin-classic.shop .shop-owner__actions
{
	display: block;
	position: absolute;
	left: 0;
	top: 112dp;
	width: 345dp;
	height: 21dp;
}
body.skin-classic.shop .shop-owner__actions .nui-button
{
	position: absolute;
	top: 0;
	width: 88dp;
	min-width: 88dp;
	padding: 0;
}
body.skin-classic.shop .shop-owner__lock { left: 14dp; }
body.skin-classic.shop .shop-owner__logs { left: 128dp; }
body.skin-classic.shop .shop-owner__close { left: 243dp; }
