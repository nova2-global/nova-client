/* Classic skin overlay of nui/windows/target/target.rml: the legacy
   TargetBoard (uitarget.py), a thin board at the top center. Without the HP
   gauge it is 250 x 40 with the outlined name centered at y 13; with it the
   name is at 23, 13 and the 130dp legacy gauge at 175dp from the board's
   right edge, y 17 (legacy sizes the board 200 + 7 per letter; here it is as
   wide as the name needs); with buttons it is 65 tall, the small thin
   buttons 68dp apart at y 33, centered (legacy makes it 75dp per button,
   at least 150). The close button is 30dp from the right edge, y 13.
   Wave 10 (legacy uitarget.py): the gauge's bar is the legacy green while
   the target is poisoned, yellow while it burns, and the damage trail is
   the legacy orange bar over its empty part (NOVA-208; the three bars are
   gauge_red.tga turned on the hue wheel, as the legacy blue, pink and
   purple are); a metin stone's board is 54 tall with the queue hint
   centered at y 33 (NOVA-216); the archer gauge is code-drawn in the
   legacy colors (OLD's archergauge art is not in NEW's packs; NOVA-209). */

@decorator target-gauge-green : nui-repeat-box
{
	center-image: "d:/ymir work/ui/pattern/gauge_green.tga";
}
@decorator target-gauge-yellow : nui-repeat-box
{
	center-image: "d:/ymir work/ui/pattern/gauge_yellow.tga";
}
@decorator target-gauge-orange : nui-repeat-box
{
	center-image: "d:/ymir work/ui/pattern/gauge_orange.tga";
}

/* Legacy's whole name and the legacy gauge in the head; none of the modern
   head's badge, title and percent, nor its HP bar or a player's head. */
body.skin-classic.target .target-board__name
{
	display: inline;
}
body.skin-classic.target .target-board__hp-box
{
	display: block;
	height: 8dp;
}
body.skin-classic.target .target-board__badge,
body.skin-classic.target .target-board__title,
body.skin-classic.target .target-board__bar,
body.skin-classic.target .target-board__player
{
	display: none;
}
/* A player target keeps the legacy head (the modern one hides it). */
body.skin-classic.target .target-board--player .target-board__head
{
	display: flex;
}
body.skin-classic.target .target-board
{
	width: auto;
	min-width: 250dp;
	height: 40dp;
	padding: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: classic-thinboard;
}
body.skin-classic.target .target-board--buttons
{
	min-width: 150dp;
	height: 65dp;
}
body.skin-classic.target .target-board__head
{
	align-items: flex-start;
	height: 33dp;
	padding: 13dp 0 0 0;
	box-sizing: border-box;
}
body.skin-classic.target .target-board--hp .target-board__head
{
	padding: 13dp 45dp 0 23dp;
}
body.skin-classic.target .target-board__name
{
	font-weight: normal;
	font-size: var(--font-md);
	line-height: 14dp;
	font-effect: outline(1dp var(--classic-text-outline));
}
body.skin-classic.target .target-board--hp .target-board__name
{
	margin-right: 2dp;
}
body.skin-classic.target .target-board__hp-box
{
	margin-top: 4dp;
}
/* NOVA-208: the legacy bars by the target's state, and the trail over the
   empty slot, inset 12dp at both ends as the bar is. */
body.skin-classic.target progress.target-board__hp.is-poisoned fill
{
	decorator: target-gauge-green;
}
body.skin-classic.target progress.target-board__hp.is-burning fill
{
	decorator: target-gauge-yellow;
}
body.skin-classic.target .target-board__trail-track
{
	display: block;
	position: absolute;
	left: 12dp;
	right: 12dp;
	top: 0;
	height: 8dp;
}
body.skin-classic.target .target-board__trail
{
	bottom: auto;
	height: 8dp;
	border-radius: 0;
	background-color: transparent;
	decorator: target-gauge-orange;
}
/* NOVA-216: a metin stone's queue hint, centered under the name and the
   gauge, the board as wide as it needs. */
body.skin-classic.target .target-board--hint
{
	height: 54dp;
}
body.skin-classic.target .target-board__hint
{
	margin: 0;
	padding: 0 18dp;
	color: var(--classic-label-white);
	font-size: var(--font-md);
	white-space: nowrap;
	font-effect: outline(1dp var(--classic-text-outline));
}
/* NOVA-209: the archer gauge in the legacy colors, square, its edge the
   legacy separator gray. */
body.skin-classic.target progress.target-arrow__gauge
{
	border-color: var(--classic-separator);
	border-radius: 0;
	background-color: var(--classic-slot-fill);
}
body.skin-classic.target progress.target-arrow__gauge fill
{
	border-radius: 0;
	background-color: var(--classic-arrow-fill);
}
body.skin-classic.target .target-arrow__mark
{
	background-color: var(--classic-button-text);
}
body.skin-classic.target .target-arrow__tip
{
	font-weight: normal;
}
body.skin-classic.target .target-board__close
{
	right: 15dp;
	top: 13dp;
	width: 15dp;
	height: 15dp;
	color: transparent;
	font-size: 1dp;
	line-height: 1dp;
	decorator: image("d:/ymir work/ui/public/close_button_01.sub");
}
body.skin-classic.target .target-board__close:hover
{
	background-color: transparent;
	decorator: image("d:/ymir work/ui/public/close_button_02.sub");
}
body.skin-classic.target .target-board__close:active
{
	background-color: transparent;
	decorator: image("d:/ymir work/ui/public/close_button_03.sub");
}
body.skin-classic.target .target-board__buttons
{
	gap: 8dp;
	margin-top: 0;
	margin-right: 0;
	padding: 0 18dp;
}
body.skin-classic.target .target-board__button
{
	width: 60dp;
	height: 20dp;
	line-height: 20dp;
	padding: 0;
	color: var(--classic-button-text);
	font-size: var(--font-md);
	decorator: image("d:/ymir work/ui/public/small_thin_button_01.sub");
}
/* A label wider than the art overflows it on both sides, as the legacy
   centered button text does. It takes no pointer, as legacy's text line
   takes none: the next button's label would otherwise take the presses on
   the right part of the button before it. */
body.skin-classic.target .target-board__label
{
	display: block;
	margin: 0 -30dp;
	text-align: center;
	white-space: nowrap;
	pointer-events: none;
}
body.skin-classic.target .target-board__button:hover
{
	decorator: image("d:/ymir work/ui/public/small_thin_button_02.sub");
}
body.skin-classic.target .target-board__button:active
{
	decorator: image("d:/ymir work/ui/public/small_thin_button_03.sub");
}
/* NOVA-40 (legacy uitarget.py): the percent beside the gauge, the numbers over
   it, the element's name and the "?" info button after the name, in the
   legacy board's font. */
body.skin-classic.target .target-board__pct
{
	flex: 0 0 auto;
	margin: 0 6dp 0 0;
	font-weight: normal;
	font-effect: outline(1dp var(--classic-text-outline));
}
body.skin-classic.target .target-board__values
{
	position: absolute;
	right: 60dp;
	top: 1dp;
	margin: 0;
	color: var(--classic-button-text);
	font-effect: outline(1dp var(--classic-text-outline));
}
body.skin-classic.target .target-board__element
{
	position: absolute;
	left: 23dp;
	top: 0;
	margin: 0;
	padding: 0;
	background-color: transparent;
	font-weight: normal;
	font-effect: outline(1dp var(--classic-text-outline));
}
body.skin-classic.target .target-board__info
{
	width: 20dp;
	height: 16dp;
	margin: 0 0 0 4dp;
	padding: 0;
	line-height: 16dp;
	decorator: image("d:/ymir work/ui/public/xsmall_button_01.sub");
	color: var(--classic-button-text);
}
body.skin-classic.target .target-board__info:hover
{
	background-color: transparent;
	decorator: image("d:/ymir work/ui/public/xsmall_button_02.sub");
}
