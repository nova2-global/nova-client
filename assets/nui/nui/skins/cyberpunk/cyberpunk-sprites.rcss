/* Generated by tools/nui_skin_art.py from nui/skins/cyberpunk/art.json. Do not edit:
   python3 tools/nui_skin_art.py build (check verifies it). White art with alpha,
   tinted by image-color; each sprite <id> has <id>-inner, the rectangle a
   ninepatch decorator stretches. The 2x sheet replaces the 1x one from a dp
   ratio of 1.125 up (min-resolution compares the context's dp ratio, which is
   NovaUI's UI scale). */

@spritesheet cyberpunk-1x
{
	src: cyberpunk-1x.png;
	resolution: 1x;
	cyberpunk-panel: 2px 2px 48px 48px;
	cyberpunk-panel-inner: 14px 14px 24px 24px;
	cyberpunk-panel-edge: 54px 2px 64px 64px;
	cyberpunk-panel-edge-inner: 78px 26px 16px 16px;
	cyberpunk-chip-solid: 122px 2px 24px 24px;
	cyberpunk-chip-solid-inner: 129px 9px 10px 10px;
	cyberpunk-chip: 150px 2px 24px 24px;
	cyberpunk-chip-inner: 157px 9px 10px 10px;
	cyberpunk-chip-edge: 178px 2px 24px 24px;
	cyberpunk-chip-edge-inner: 185px 9px 10px 10px;
}

@media (min-resolution: 1.125x)
{
	@spritesheet cyberpunk-2x
	{
		src: cyberpunk-2x.png;
		resolution: 2x;
		cyberpunk-panel: 4px 4px 96px 96px;
		cyberpunk-panel-inner: 28px 28px 48px 48px;
		cyberpunk-panel-edge: 108px 4px 128px 128px;
		cyberpunk-panel-edge-inner: 156px 52px 32px 32px;
		cyberpunk-chip-solid: 244px 4px 48px 48px;
		cyberpunk-chip-solid-inner: 258px 18px 20px 20px;
		cyberpunk-chip: 300px 4px 48px 48px;
		cyberpunk-chip-inner: 314px 18px 20px 20px;
		cyberpunk-chip-edge: 356px 4px 48px 48px;
		cyberpunk-chip-edge-inner: 370px 18px 20px 20px;
	}
}
