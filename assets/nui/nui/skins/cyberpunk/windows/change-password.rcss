/* Cyberpunk overlay of nui/windows/change-password/change-password.rml,
   after the reviewed WChangePassword board: the title's tile a square with
   the dim neon line; the labels a size smaller and tracked. The fields and
   buttons are the component's. The modern layout stays. */

body.skin-cyberpunk.change-password .change-password__icon
{
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
	background-color: var(--cyberpunk-cell);
}
body.skin-cyberpunk.change-password .change-password__label
{
	font-size: var(--font-sm);
	letter-spacing: 0.5dp;
}
