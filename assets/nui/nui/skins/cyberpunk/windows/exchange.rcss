/* Cyberpunk overlay of nui/windows/exchange/exchange.rml, after the reviewed
   WExchange board: the trade emblem in a square tile with the dim neon line,
   one arrow magenta; each amount in a square well with the dim line and a
   neon underline, its coin in the warning gold; each lamp a cut chip with
   the faint line and a neon ring around its core; the rule between the
   columns magenta fading into cyan. Layout stays the modern one. */

/* The title's emblem: the button chip's cut fill and edge in one tint. */
body.skin-cyberpunk.exchange .exchange__title-icon
{
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
	background-color: var(--cyberpunk-cell);
}
body.skin-cyberpunk.exchange .exchange__arrow--in
{
	background-color: var(--cyberpunk-edge-alt);
}
body.skin-cyberpunk.exchange .exchange__arrow--in .exchange__arrow-head
{
	border-color: transparent var(--cyberpunk-edge-alt) transparent transparent;
}
body.skin-cyberpunk.exchange .exchange__divider
{
	decorator: linear-gradient(180deg, transparent 0%, var(--cyberpunk-edge-alt) 12%, var(--accent) 52%, transparent 100%);
}
/* The amounts: square wells, the dim line and the neon underline of a
   field; the player's lights its line under the pointer. */
body.skin-cyberpunk.exchange .exchange__money
{
	border-color: var(--border);
	border-bottom-color: var(--cyberpunk-edge);
	border-radius: 0;
}
body.skin-cyberpunk.exchange .exchange__money--owner:hover
{
	border-color: var(--cyberpunk-edge-dim);
	border-bottom-color: var(--accent);
}
body.skin-cyberpunk.exchange .exchange__coin
{
	--glyph-ink: var(--warning);
}
body.skin-cyberpunk.exchange .exchange__amount
{
	color: var(--cyberpunk-title);
	letter-spacing: 0.5dp;
}
/* The lamps: a cut chip with the faint line (its fill baked into the
   sprite), a neon ring around the core. */
body.skin-cyberpunk.exchange .exchange__light
{
	border-color: transparent;
	border-radius: 0;
	background-color: transparent;
	decorator: ninepatch(cyberpunk-chip, cyberpunk-chip-inner) border-box, ninepatch(cyberpunk-chip-edge, cyberpunk-chip-edge-inner) border-box;
	image-color: var(--border);
}
body.skin-cyberpunk.exchange .exchange__light-ring
{
	border-color: var(--cyberpunk-edge-dim);
}
