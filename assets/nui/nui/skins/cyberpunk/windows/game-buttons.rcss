/* Cyberpunk overlay of nui/windows/game-buttons/game-buttons.rml: the plus
   buttons as square dark chips with a neon edge and the plus in the accent
   (the minimap's buttons), their labels on square plates with a dim neon
   edge. */

body.skin-cyberpunk.game-buttons .game-button__plus
{
	border-color: var(--accent);
	border-radius: 0;
	background-color: var(--surface-sunken);
	decorator: none;
}
/* The plus in the accent on the dark chip (modern inks it in the accent's
   text color on its accent disc). */
body.skin-cyberpunk.game-buttons .game-button__glyph
{
	--glyph-ink: var(--accent);
}
body.skin-cyberpunk.game-buttons .game-button__plus:hover
{
	border-color: var(--accent-hover);
	background-color: var(--surface-hover);
}
body.skin-cyberpunk.game-buttons .game-button__plus:active
{
	border-color: var(--accent);
	background-color: var(--selection);
}
body.skin-cyberpunk.game-buttons .game-button__text
{
	border-width: 1dp;
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
}
