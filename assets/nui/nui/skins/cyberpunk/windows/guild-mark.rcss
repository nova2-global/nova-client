/* Cyberpunk overlay of nui/windows/guild-mark/guild-mark.rml, after the
   reviewed WGuildMark board: the guild emblem in a square tile with the dim
   neon edge, its bar magenta; the file list a square well on a faint cyan
   film with the dim line; the selected file lit from cyan to magenta,
   inside the 70% line with the magenta left edge; a thin neon scroll bar. */

body.skin-cyberpunk.guild-mark .guild-mark__title-icon
{
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
	background-color: var(--cyberpunk-cell);
}
body.skin-cyberpunk.guild-mark .guild-mark__title-icon .nui-glyph__c
{
	background-color: var(--cyberpunk-edge-alt);
}
body.skin-cyberpunk.guild-mark .guild-mark__list
{
	border-color: var(--border);
	border-radius: 0;
	background-color: var(--cyberpunk-cell);
}
body.skin-cyberpunk.guild-mark .guild-mark__row.is-selected
{
	border-color: var(--cyberpunk-edge);
	border-left-color: var(--cyberpunk-edge-alt);
	decorator: horizontal-gradient(var(--selection) var(--cyberpunk-holo-b));
	color: var(--cyberpunk-title);
}
body.skin-cyberpunk.guild-mark .guild-mark__scroll slidertrack
{
	border-radius: 0;
	background-color: var(--border);
}
body.skin-cyberpunk.guild-mark .guild-mark__scroll sliderbar
{
	border-radius: 0;
	background-color: var(--accent);
}
body.skin-cyberpunk.guild-mark .guild-mark__scroll sliderbar:hover, body.skin-cyberpunk.guild-mark .guild-mark__scroll sliderbar:active
{
	background-color: var(--accent-hover);
}
