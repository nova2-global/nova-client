/* Cyberpunk overlay of nui/windows/guild-war-declare/guild-war-declare.rml,
   after the reviewed WGuildWarDeclare board: the title's icon a square
   tile with the dim neon line, the sword's guard magenta, as the accept
   dialog's. The rest is the dialog kit's look in the component skin. */

body.skin-cyberpunk.guild-war-declare .guild-war__title-icon
{
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
	background-color: var(--cyberpunk-cell);
}
body.skin-cyberpunk.guild-war-declare .guild-war__title-icon .nui-glyph__b
{
	background-color: var(--cyberpunk-edge-alt);
}
