/* Cyberpunk overlay of nui/windows/loading/loading.rml, after the WLoading
   board of the reviewed mockup. The gauge panel (a board) is drawn as the
   skin's window frame: the cut-corner panel, its glowing neon outline, the
   two pulsing corner brackets, the running edge tab and the scan layer,
   moved here since the skin moves hooks on window frames only (the one
   board of the screen, shown while it loads: three hooks move, transform
   and opacity). The spinner is a neon sweep, a conic gradient from the
   accent to clear on the turning ring (its dot becomes the dark middle
   that leaves a 3dp band); the bar the skin's segmented gauge in acid, lit
   from the top, in a square dark track. Without effects the sweep draws one
   flat tint of the accent around the band, and the gauge's segment gaps go.
   The background picture is content and keeps its pixels. */

body.skin-cyberpunk.loading .loading-board
{
	decorator: ninepatch(cyberpunk-panel, cyberpunk-panel-inner) border-box;
	image-color: var(--surface);
}
body.skin-cyberpunk.loading .loading-board > .nui-chrome--outline
{
	left: -7dp;
	top: -7dp;
	right: -7dp;
	bottom: -7dp;
	decorator: ninepatch(cyberpunk-panel-edge, cyberpunk-panel-edge-inner) border-box;
	image-color: var(--cyberpunk-edge);
}
body.skin-cyberpunk.loading .loading-board > .nui-chrome--corner-tl, body.skin-cyberpunk.loading .loading-board > .nui-chrome--corner-br,
body.skin-cyberpunk.loading .loading-board > .nui-chrome--edge-top, body.skin-cyberpunk.loading .loading-board > .nui-chrome--scan
{
	display: block;
}
body.skin-cyberpunk.loading .loading-board > .nui-chrome--corner-tl.nui-anim
{
	animation: 2.4s sine-in-out infinite cyberpunk-pulse;
}
body.skin-cyberpunk.loading .loading-board > .nui-chrome--corner-br.nui-anim
{
	animation: 2.4s 1.2s sine-in-out infinite cyberpunk-pulse;
}
body.skin-cyberpunk.loading .loading-board > .nui-chrome--edge-top.nui-anim
{
	animation: 6s linear-in-out infinite cyberpunk-sweep;
}

body.skin-cyberpunk.loading .loading__track
{
	background-color: var(--cyberpunk-edge-dim);
}
body.skin-cyberpunk.loading .loading__ring
{
	border-radius: 20dp;
	decorator: conic-gradient(var(--accent) 0deg, transparent 270deg);
}
body.skin-cyberpunk.loading .loading__dot
{
	left: 3dp;
	top: 3dp;
	width: 34dp;
	height: 34dp;
	border-radius: 17dp;
	background-color: var(--surface);
}
body.skin-cyberpunk.loading progress.loading-gauge
{
	border-color: var(--border);
	border-radius: 0;
	background-color: var(--surface-sunken);
}
body.skin-cyberpunk.loading progress.loading-gauge fill
{
	border-radius: 0;
	background-color: var(--cyberpunk-acid);
	decorator: repeating-linear-gradient(90deg, transparent 0dp, transparent 4.9dp, var(--surface-sunken) 5dp, var(--surface-sunken) 5.9dp, transparent 6dp),
		vertical-gradient(var(--sheen) var(--sheen-clear));
}
body.skin-cyberpunk.loading .loading__pct
{
	letter-spacing: 1dp;
}

/* Reduced effects: no scan layer, and the edge tab the skin's plain resting
   bar (the frame's look; these rules outweigh the skin's own). */
@media (theme: reduced-effects)
{
	body.skin-cyberpunk.loading .loading-board > .nui-chrome--scan
	{
		display: none;
	}
	body.skin-cyberpunk.loading .loading-board > .nui-chrome--edge-top.nui-anim
	{
		animation: none;
	}
}
