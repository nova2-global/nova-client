/* Cyberpunk overlay of nui/windows/locale-strip/locale-strip.rml, in the login
   screen's look of the reviewed mockup: the band's bottom edge the dim neon
   line, as the skin's band frames; each flag's chip square, the locale in
   use on the soft cyan with the magenta underline of the skin's selected
   tab. The flags are content and keep their pixels. */

body.skin-cyberpunk.locale-strip
{
	border-bottom-color: var(--cyberpunk-edge-dim);
}
body.skin-cyberpunk.locale-strip .locale-strip__flag
{
	border-radius: 0;
}
body.skin-cyberpunk.locale-strip .locale-strip__flag.is-selected
{
	border-bottom-color: var(--cyberpunk-edge-alt);
}
