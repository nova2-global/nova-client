/* Cyberpunk overlay of nui/windows/minimap/minimap.rml: the reviewed
   mockup's radar (skins-stage2 ref Minimap-cyberpunk). The modern steel
   bezel becomes a dark band between a 1dp neon ring on the map's edge and
   a faint outer ring, with cyan ticks every 10 degrees on its inner half
   and a soft halo outside it; faint radar rings over the map; the north
   mark magenta; square dark buttons with the glyph in the accent (the close
   button magenta); the place line and the observers on dark plates with a
   magenta left edge, in the accent. The map view's rim fades into the band
   under a gradient ring the frame draws over it, with the radar rings
   (reduced effects shows both hard edged, without them). Not a mask: a mask
   costs two layers on every frame the always shown map shows. The map
   image itself is content and is never tinted. */

/* --- The bezel ---------------------------------------------------------------------- */

/* The band: the steel disc (146dp, 5dp past the 136dp frame) dark, its
   rim the faint outer ring. */
body.skin-cyberpunk.minimap .minimap__steel
{
	box-sizing: border-box;
	border-width: 1dp;
	border-color: var(--cyberpunk-edge-dim);
	background-color: var(--surface-sunken);
	decorator: none;
}
body.skin-cyberpunk.minimap .minimap__steel.nui-fx
{
	box-shadow: none;
}
/* The ticks: 1 degree in 10, cyan, on the band's inner half; the first
   decorator covers the outer half again in the band's color, then the
   outer ring (the disc's round border clips both). */
body.skin-cyberpunk.minimap .minimap__ticks
{
	decorator: radial-gradient(circle closest-side, transparent 0%, transparent 94.4%, var(--surface-sunken) 95.2%, var(--surface-sunken) 97.8%, var(--cyberpunk-edge-dim) 98.6%),
		repeating-conic-gradient(var(--cyberpunk-edge) 0deg, var(--cyberpunk-edge) 1deg, transparent 1deg, transparent 10deg);
}
/* Under the map: the disc in the band's color. */
body.skin-cyberpunk.minimap .minimap__base
{
	background-color: var(--surface-sunken);
}
/* The ring: a 1dp neon circle on the map's edge, where the modern one has
   a 5dp band. */
body.skin-cyberpunk.minimap .minimap__frame
{
	border-width: 1dp;
	border-color: var(--cyberpunk-edge);
}
/* Over the map: its rim faded into the band (the map is 128dp in the 132dp
   frame: 97% of its radius) and three faint radar rings. */
body.skin-cyberpunk.minimap .minimap__frame.nui-board--ring
{
	decorator: radial-gradient(circle closest-side, transparent 88%, var(--surface-sunken) 97%, transparent 97.5%),
		repeating-radial-gradient(circle closest-side, transparent 0dp, transparent 21.5dp, var(--border) 22dp, var(--border) 22.5dp, transparent 23dp);
}
/* Its halo: the ring board's outline hook, a soft glow just outside the
   band (13dp outside the frame, the band's rim at 7dp). */
body.skin-cyberpunk.minimap .minimap__frame > .nui-chrome--outline
{
	display: block;
	left: -13dp;
	top: -13dp;
	right: -13dp;
	bottom: -13dp;
	decorator: radial-gradient(circle closest-side, transparent 90%, var(--cyberpunk-glow) 92.5%, transparent 100%);
}
/* North: the mark in magenta. */
body.skin-cyberpunk.minimap .minimap__north
{
	border-color: transparent transparent var(--cyberpunk-edge-alt) transparent;
}

/* --- The buttons: square dark chips ------------------------------------------------- */

body.skin-cyberpunk.minimap .minimap__button, body.skin-cyberpunk.minimap .minimap__show
{
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
	background-color: var(--surface-sunken);
	decorator: none;
}
body.skin-cyberpunk.minimap .minimap__button--hide
{
	border-color: var(--cyberpunk-glow-alt);
}
body.skin-cyberpunk.minimap .minimap__button:hover, body.skin-cyberpunk.minimap .minimap__show:hover
{
	border-color: var(--accent);
	background-color: var(--surface-hover);
}
body.skin-cyberpunk.minimap .minimap__button--hide:hover
{
	border-color: var(--cyberpunk-edge-alt);
	background-color: var(--surface-hover);
}
body.skin-cyberpunk.minimap .minimap__button:active, body.skin-cyberpunk.minimap .minimap__show:active
{
	background-color: var(--selection);
}
body.skin-cyberpunk.minimap .minimap__glyph
{
	color: var(--accent);
}
body.skin-cyberpunk.minimap .minimap__icon, body.skin-cyberpunk.minimap .minimap__show-glyph
{
	--glyph-ink: var(--accent);
}
body.skin-cyberpunk.minimap .minimap__button--hide .minimap__icon, body.skin-cyberpunk.minimap .minimap__button--hide:hover .minimap__icon
{
	--glyph-ink: var(--cyberpunk-edge-alt);
}
body.skin-cyberpunk.minimap .minimap__button:hover .minimap__icon, body.skin-cyberpunk.minimap .minimap__show:hover .minimap__show-glyph
{
	--glyph-ink: var(--accent-hover);
}

/* --- The place line and the observers: dark plates ---------------------------------- */

body.skin-cyberpunk.minimap .minimap__text
{
	border-width: 1dp 1dp 1dp 2dp;
	border-color: var(--border) var(--border) var(--border) var(--cyberpunk-edge-alt);
	border-radius: 0;
	background-color: var(--surface);
	color: var(--accent);
	letter-spacing: 1dp;
}

/* Reduced effects: no halo, rim, radar rings or tick cover (without effects
   their gradients would draw one flat color over the map); the ticks go
   too, so the band is plain. */
@media (theme: reduced-effects)
{
	body.skin-cyberpunk.minimap .minimap__frame > .nui-chrome--outline
	{
		display: none;
	}
	body.skin-cyberpunk.minimap .minimap__frame.nui-board--ring, body.skin-cyberpunk.minimap .minimap__ticks
	{
		decorator: none;
	}
}
