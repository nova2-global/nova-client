/* Cyberpunk overlay of nui/windows/pick-money/pick-money.rml, after the
   reviewed WPickMoney board: the coin emblem in a square tile with the dim
   neon edge, the coin's inner ring magenta. The field and the buttons are
   the skin's components. */

body.skin-cyberpunk.pick-money .pick-money__title-icon
{
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
	background-color: var(--cyberpunk-cell);
}
body.skin-cyberpunk.pick-money .pick-money__title-icon .nui-glyph__b
{
	border-color: var(--cyberpunk-edge-alt);
}
