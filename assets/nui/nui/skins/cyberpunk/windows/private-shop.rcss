/* Cyberpunk overlay of nui/windows/private-shop/private-shop.rml, after the
   reviewed WPrivateShop board: the bag emblem in a square tile with the dim
   neon edge, its handle magenta; the shop's name in a square well with the
   look of a focused field (the brighter line, the accent underline), as
   legacy's edit line has the focus while the builder is open. */

body.skin-cyberpunk.pshop .pshop__title-icon
{
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
	background-color: var(--cyberpunk-cell);
}
body.skin-cyberpunk.pshop .pshop__title-icon .nui-glyph__b
{
	border-color: var(--cyberpunk-edge-alt);
}
body.skin-cyberpunk.pshop .pshop__name
{
	border-color: var(--cyberpunk-edge-dim);
	border-bottom-color: var(--accent);
	border-radius: 0;
}
body.skin-cyberpunk.pshop .pshop__name-text
{
	color: var(--cyberpunk-title);
}
