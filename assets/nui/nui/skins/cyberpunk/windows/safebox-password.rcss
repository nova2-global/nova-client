/* Cyberpunk overlay of nui/windows/safebox-password/safebox-password.rml,
   after the reviewed WSafeboxPassword board: the key emblem in a square tile
   with the dim neon edge, the key's bit magenta. The dialog, its field and
   its buttons are the skin's components. */

body.skin-cyberpunk.safebox-password .safebox-password__title-icon
{
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
	background-color: var(--cyberpunk-cell);
}
body.skin-cyberpunk.safebox-password .safebox-password__key-bit
{
	border-color: var(--cyberpunk-edge-alt);
}
