/* Cyberpunk overlay of nui/windows/shop-signs/shop-signs.rml: each private
   shop's sign a neon plate, violet edged, the shop's name in the gold of
   names; a decorated offline shop's sign (styles 1 to 5) the same plate in
   its style's edge, tint and name color, and a visited shop's plain sign the
   seen tint. */

body.skin-cyberpunk.shop-signs .shop-sign
{
	border-color: var(--cyberpunk-edge-alt);
	background-color: var(--surface);
}
body.skin-cyberpunk.shop-signs .shop-sign__text
{
	color: var(--cyberpunk-name);
}

body.skin-cyberpunk.shop-signs .shop-sign.shop-sign--style-1 { border-color: var(--shop-sign-1); background-color: var(--shop-sign-1-tint); }
body.skin-cyberpunk.shop-signs .shop-sign--style-1 .shop-sign__text { color: var(--shop-sign-1); }
body.skin-cyberpunk.shop-signs .shop-sign.shop-sign--style-2 { border-color: var(--shop-sign-2); background-color: var(--shop-sign-2-tint); }
body.skin-cyberpunk.shop-signs .shop-sign--style-2 .shop-sign__text { color: var(--shop-sign-2); }
body.skin-cyberpunk.shop-signs .shop-sign.shop-sign--style-3 { border-color: var(--shop-sign-3); background-color: var(--shop-sign-3-tint); }
body.skin-cyberpunk.shop-signs .shop-sign--style-3 .shop-sign__text { color: var(--shop-sign-3); }
body.skin-cyberpunk.shop-signs .shop-sign.shop-sign--style-4 { border-color: var(--shop-sign-4); background-color: var(--shop-sign-4-tint); }
body.skin-cyberpunk.shop-signs .shop-sign--style-4 .shop-sign__text { color: var(--shop-sign-4); }
body.skin-cyberpunk.shop-signs .shop-sign.shop-sign--style-5 { border-color: var(--shop-sign-5); background-color: var(--shop-sign-5-tint); }
body.skin-cyberpunk.shop-signs .shop-sign--style-5 .shop-sign__text { color: var(--shop-sign-5); }
body.skin-cyberpunk.shop-signs .shop-sign.is-seen
{
	background-color: var(--shop-sign-seen);
}
