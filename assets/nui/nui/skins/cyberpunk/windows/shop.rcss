/* Cyberpunk overlay of nui/windows/shop/shop.rml, after the reviewed WShop
   board: the storefront emblem in a square tile with the dim neon line, its
   door magenta; the tabs of a shop with tabs as the skin's underlined tabs
   (tracked muted labels over the row's dim line, the shown tab lit, a soft
   cyan rising from a magenta underline) instead of the modern segmented
   well. Layout stays the modern one: the row keeps its 32dp, as the tabs
   component's does in this skin (a 6dp gap above 26dp tabs, whose
   underline covers the row's line). */

body.skin-cyberpunk.shop .shop__title-icon
{
	border-color: var(--cyberpunk-edge-dim);
	border-radius: 0;
	background-color: var(--cyberpunk-cell);
}
body.skin-cyberpunk.shop .shop__emblem-awning
{
	border-radius: 0;
}
body.skin-cyberpunk.shop .shop__emblem-door
{
	background-color: var(--cyberpunk-edge-alt);
}
/* The tab row: no well, the dim line under it. */
body.skin-cyberpunk.shop .shop__tabs
{
	padding: 6dp 0 0 0;
	gap: 0;
	border-width: 0 0 1dp 0;
	border-color: var(--border);
	border-radius: 0;
	background-color: transparent;
}
body.skin-cyberpunk.shop .shop__tabs .shop__tab
{
	height: 26dp;
	border-width: 0 0 2dp 0;
	border-color: transparent;
	border-radius: 0;
	background-color: transparent;
	decorator: none;
	color: var(--text-muted);
	line-height: 24dp;
}
body.skin-cyberpunk.shop .shop__tabs .shop__tab:hover
{
	border-color: transparent;
	background-color: transparent;
	decorator: none;
	color: var(--text);
}
body.skin-cyberpunk.shop .shop__tabs .shop__tab.is-current
{
	border-color: transparent;
	border-bottom-color: var(--cyberpunk-edge-alt);
	background-color: transparent;
	decorator: vertical-gradient(transparent var(--cyberpunk-holo-a));
	color: var(--cyberpunk-title);
	font-effect: glow(0dp 3dp 0dp 0dp var(--cyberpunk-glow));
}
