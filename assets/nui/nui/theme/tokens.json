	"slots": {
		"$comment": "The color slots a player may set, per palette (P13 spec 5.1; docs/ui/AUTHORING.md \"Player colors\"): tools/nui_tokens.py writes them into nui/theme/colors.json with the palettes' tokens, and the runtime resolves a player's values with them (Core/Palette.h, tools/nui_palette.py). A palette without slots (classic) offers none. In light the notice and chat colors sit on dark backdrops in every theme, so the highlight lightens them there.",
		"dark": [
			{"slot": "accent", "kind": "color", "label": "OPTION_UI_COLOR_ACCENT", "swatches": ["#8ab4f8", "#7fd29a", "#f6c75a", "#f28b82", "#c58af9", "#5fe3d4", "#ff9e3a", "#e7eaf0"], "sets": [{"token": "accent", "rule": "value"}, {"token": "accent-hover", "rule": "mix", "with": "#ffffff", "t": 0.2}, {"token": "accent-text", "rule": "pick", "from": ["accent-text", "text"], "on": "accent"}, {"token": "selection", "rule": "mix", "with": "surface", "t": 0.72}]},
			{"slot": "panel", "kind": "color", "label": "OPTION_UI_COLOR_PANEL", "swatches": ["#1a1d23", "#1b2430", "#20202a", "#1e2a24", "#2a1e24", "#262626"], "sets": [{"token": "surface", "rule": "value"}, {"token": "surface-raised", "rule": "delta", "ref": "surface"}, {"token": "surface-sunken", "rule": "delta", "ref": "surface"}, {"token": "surface-hover", "rule": "delta", "ref": "surface"}, {"token": "surface-band", "rule": "delta", "ref": "surface"}, {"token": "border", "rule": "delta", "ref": "surface"}]},
			{"slot": "opacity", "kind": "percent", "label": "OPTION_UI_COLOR_OPACITY", "min": 50, "max": 100, "step": 5, "backdrop": "blur(6dp)", "sets": [{"token": "surface", "rule": "alpha"}, {"token": "surface-raised", "rule": "alpha"}, {"token": "surface-sunken", "rule": "alpha"}, {"token": "surface-hover", "rule": "alpha"}, {"token": "surface-band", "rule": "alpha"}]},
			{"slot": "highlight", "kind": "color", "label": "OPTION_UI_COLOR_HIGHLIGHT", "swatches": ["#f2d39b", "#ffd166", "#9fefff", "#ff9fbf", "#b9f18c", "#e7eaf0"], "sets": [{"token": "highlight", "rule": "value"}, {"token": "quest-title", "rule": "value"}, {"token": "notice-text-big", "rule": "value"}, {"token": "chat-notice", "rule": "value"}, {"token": "chat-big-notice", "rule": "value"}]}
		],
		"light": [
			{"slot": "accent", "kind": "color", "label": "OPTION_UI_COLOR_ACCENT", "swatches": ["#1a5fc4", "#1e7a3c", "#8a5300", "#b3261e", "#7438c4", "#0b6f6a", "#b14a00", "#1a1d23"], "sets": [{"token": "accent", "rule": "value"}, {"token": "accent-hover", "rule": "mix", "with": "#000000", "t": 0.2}, {"token": "accent-text", "rule": "pick", "from": ["accent-text", "text"], "on": "accent"}, {"token": "selection", "rule": "mix", "with": "surface", "t": 0.72}]},
			{"slot": "panel", "kind": "color", "label": "OPTION_UI_COLOR_PANEL", "swatches": ["#f3f4f6", "#ffffff", "#f4f1ea", "#eef3f8", "#f1f6ef", "#f8eff2"], "sets": [{"token": "surface", "rule": "value"}, {"token": "surface-raised", "rule": "delta", "ref": "surface"}, {"token": "surface-sunken", "rule": "delta", "ref": "surface"}, {"token": "surface-hover", "rule": "delta", "ref": "surface"}, {"token": "surface-band", "rule": "delta", "ref": "surface"}, {"token": "border", "rule": "delta", "ref": "surface"}]},
			{"slot": "opacity", "kind": "percent", "label": "OPTION_UI_COLOR_OPACITY", "min": 50, "max": 100, "step": 5, "backdrop": "blur(6dp)", "sets": [{"token": "surface", "rule": "alpha"}, {"token": "surface-raised", "rule": "alpha"}, {"token": "surface-sunken", "rule": "alpha"}, {"token": "surface-hover", "rule": "alpha"}, {"token": "surface-band", "rule": "alpha"}]},
			{"slot": "highlight", "kind": "color", "label": "OPTION_UI_COLOR_HIGHLIGHT", "swatches": ["#7a4a06", "#6b3fa0", "#0b6f6a", "#9b2c48", "#3e6b1f", "#1a1d23"], "sets": [{"token": "highlight", "rule": "value"}, {"token": "quest-title", "rule": "value"}, {"token": "notice-text-big", "rule": "mix", "with": "#ffffff", "t": 0.65}, {"token": "chat-notice", "rule": "mix", "with": "#ffffff", "t": 0.65}, {"token": "chat-big-notice", "rule": "mix", "with": "#ffffff", "t": 0.65}]}
		]
	},
