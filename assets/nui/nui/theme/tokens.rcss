/* Skin classic: overrides shared tokens and adds its own (classic-...) while a
   theme of this skin is in use. */
body.skin-classic
{
	--font-family: Nova Classic;
	--font-xs: 11dp;
	--font-sm: 12dp;
	--font-md: 12dp;
	--font-lg: 14dp;
	--font-xl: 14dp;
	--classic-slot-fill: #000000;
	--classic-slot-dark: #333333;
	--classic-slot-light: #b3b3b3;
	--classic-edit-text: #ffffff;
	--classic-button-text: #c7c7c7;
	--classic-tooltip-text: #c2c2c2;
	--classic-hover-white: #ffffff33;
	--classic-press-white: #ffffff80;
	--classic-select: #0000804d;
	--classic-separator: #777777;
	--classic-separator-shadow: #111111;
	--classic-text-outline: #000000;
	--classic-disabled-tint: #8c8c8cff;
	--classic-disabled-text: #6e6e6e;
	--classic-key-text: #000000;
	--classic-label-white: #ffffff;
	--classic-chat-press: #ffffff4d;
	--classic-chat-log-fill: #00000077;
	--classic-chat-grip: #989898;
	--classic-warning-text: #ff4c4c;
	--classic-mall-text: #f8bf24;
	--classic-help-curtain: #00000077;
	--classic-list-ex-select: #0000b3b3;
	--classic-quest-bar: #99999940;
	--classic-quest-bar-down: #aaaacc40;
	--classic-quest-bar-over: #ddddff40;
	--classic-quest-scroll-bar: #00000050;
	--classic-quest-scroll-bar-down: #40404050;
	--classic-quest-scroll-bar-over: #60606050;
	--classic-gb-enough: #c2c2c2;
	--classic-gb-short: #e67976;
	--classic-skill-group-text: #ffe3ad;
	--classic-maintenance-label: #f35637;
	--classic-maintenance-time: #dbad7b;
}
