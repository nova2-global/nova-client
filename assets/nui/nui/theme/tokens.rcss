body.theme-classic
{
	--surface: #1b1918;
	--surface-raised: #23201e;
	--surface-sunken: #000000;
	--surface-hover: #494746;
	--border: #777777;
	--text: #dadada;
	--text-muted: #c2c2c2;
	--text-inverse: #dadada;
	--accent: #ffc800;
	--accent-hover: #ffd84d;
	--accent-text: #000000;
	--danger: #ff4d4d;
	--danger-hover: #ff7a7a;
	--warning: #ffb96d;
	--success: #8ab98e;
	--focus-ring: #f2e7c1;
	--selection: #131237;
	--overlay-scrim: #00000080;
	--tooltip-bg: #0d0c0b;
	--ember: #ffb24ff2;
	--ember-hot: #fff3cff7;
	--ember-glow: #ff9e3a47;
	--sheen: #ffffff73;
	--sheen-clear: #ffffff00;
	--sweep: #fff6dc8c;
	--sweep-clear: #fff4d600;
	--gauge-track: #242424;
	--gauge-red: #bc5353;
	--gauge-pink: #bc5296;
	--gauge-purple: #8052bc;
	--gauge-blue: #5283bc;
	--cooldown-shade: #00000080;
	--slot-disabled: #ff00004d;
	--slot-locked: #00000080;
	--slot-picked: #ffffff80;
	--notice-bar: #00000080;
	--notice-text-big: #f2e7c1;
	--edge-gm: #ffa200;
	--party-link: #c2c2c2;
	--party-unlink: #808080;
	--hp-recovery: #ff000055;
	--sp-recovery: #0000ff55;
}

/* Skin classic: overrides shared tokens and adds its own (classic-...) while a
   theme of this skin is in use. */
body.skin-classic
{
	--font-family: Nova Classic;
	--font-xs: 11dp;
	--font-sm: 12dp;
	--font-md: 12dp;
	--font-lg: 14dp;
	--font-xl: 14dp;
	--classic-slot-fill: #000000;
	--classic-slot-dark: #333333;
	--classic-slot-light: #b3b3b3;
	--classic-edit-text: #ffffff;
	--classic-button-text: #c7c7c7;
	--classic-tooltip-text: #c2c2c2;
	--classic-hover-white: #ffffff33;
	--classic-press-white: #ffffff80;
	--classic-select: #0000804d;
	--classic-separator: #777777;
	--classic-separator-shadow: #111111;
	--classic-text-outline: #000000;
	--classic-disabled-tint: #8c8c8cff;
	--classic-disabled-text: #6e6e6e;
	--classic-key-text: #000000;
	--classic-label-white: #ffffff;
}
