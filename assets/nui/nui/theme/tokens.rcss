	--accent-text: #ffffff;
	--danger: #b3261e;
	--danger-hover: #8c1d18;
	--warning: #8a5300;
	--success: #1e7a3c;
	--focus-ring: #111317;
	--selection: #d6e4fb;
	--overlay-scrim: #0000007a;
	--tooltip-bg: #2a2f37;
	--ember: #ffb24ff2;
	--ember-hot: #fff3cff7;
	--ember-glow: #ff9e3a47;
	--sheen: #ffffff73;
	--sheen-clear: #ffffff00;
	--sweep: #fff6dc8c;
	--sweep-clear: #fff4d600;
	--gauge-track: #d5d9e0;
	--gauge-red: #b3261e;
	--gauge-pink: #b0306f;
	--gauge-purple: #7438c4;
	--gauge-blue: #1a5fc4;
	--cooldown-shade: #00000080;
	--slot-disabled: #b3261e47;
	--slot-locked: #1a1d2366;
	--slot-picked: #1a5fc440;
	--notice-bar: #00000080;
	--notice-text-big: #f2e7c1;
	--edge-gm: #ffb547;
	--party-link: #1a1d23;
	--party-unlink: #7a828f;
