/* Generated from tokens.json by tools/nui_tokens.py. Do not edit by hand.
   Regenerate from the nova-client repository root: python tools/nui_tokens.py
   Contrast of every text pair is checked there (WCAG AA). */

body
{
	--font-family: Noto Sans;
	--space-1: 4dp;
	--space-2: 8dp;
	--space-3: 12dp;
	--space-4: 16dp;
	--space-5: 24dp;
	--space-6: 32dp;
	--radius-sm: 2dp;
	--radius-md: 4dp;
	--radius-lg: 8dp;
	--font-xs: 11dp;
	--font-sm: 12dp;
	--font-md: 14dp;
	--font-lg: 16dp;
	--font-xl: 20dp;
	--dur-fast: 0.1s;
	--dur-med: 0.2s;
	--dur-slow: 0.3s;
	--ease-out: cubic-out;
	--ease-in-out: cubic-in-out;
}

/* Also the default: RmlUi computes styles once inside LoadDocument, before
   the runtime can put a theme class on <body>. */
body, body.theme-dark
{
	--surface: #1a1d23;
	--surface-raised: #232830;
	--surface-sunken: #121418;
	--surface-hover: #2c323c;
	--border: #3b424e;
	--text: #e7eaf0;
	--text-muted: #a4acba;
	--text-inverse: #16191e;
	--accent: #8ab4f8;
	--accent-hover: #a8c7fa;
	--accent-text: #0c1a30;
	--danger: #f28b82;
	--danger-hover: #f6aea9;
	--warning: #f6c75a;
	--success: #7fd29a;
	--focus-ring: #f2f5f9;
	--selection: #2a3a55;
	--overlay-scrim: #000000a6;
	--tooltip-bg: #e7eaf0;
	--ember: #ffb24ff2;
	--ember-hot: #fff3cff7;
	--ember-glow: #ff9e3a47;
	--sheen: #ffffff73;
	--sheen-clear: #ffffff00;
	--sweep: #fff6dc8c;
	--sweep-clear: #fff4d600;
}

body.theme-light
{
	--surface: #f3f4f6;
	--surface-raised: #ffffff;
	--surface-sunken: #e7e9ed;
	--surface-hover: #e3e6eb;
	--border: #c3c8d1;
	--text: #1a1d23;
	--text-muted: #525a67;
	--text-inverse: #f3f4f6;
	--accent: #1a5fc4;
	--accent-hover: #154ea3;
	--accent-text: #ffffff;
	--danger: #b3261e;
	--danger-hover: #8c1d18;
	--warning: #8a5300;
	--success: #1e7a3c;
	--focus-ring: #111317;
	--selection: #d6e4fb;
	--overlay-scrim: #0000007a;
	--tooltip-bg: #2a2f37;
	--ember: #ffb24ff2;
	--ember-hot: #fff3cff7;
	--ember-glow: #ff9e3a47;
	--sheen: #ffffff73;
	--sheen-clear: #ffffff00;
	--sweep: #fff6dc8c;
	--sweep-clear: #fff4d600;
}
