/* The affect icons' modern look (the mockup's Affects board): a row of the
   legacy icons from the top left, each framed, with the time left under a
   timed one and a modern tooltip that opens below. Classic (the legacy
   step and scale, the legacy thin board tooltip and the outlined name under
   a skill affect): skins/classic/windows/affects.rcss. */

body.affects
{
	focus: none;
	tab-index: none;
}
.affects__row
{
	position: absolute;
	left: 10dp;
	top: 10dp;
	display: flex;
	flex-direction: row;
}
/* The repeated slot around each icon (it binds nothing). */
.affects__slot
{
	display: block;
}
/* The tooltip host: one cell of the row, 32dp apart (legacy's IMAGE_STEP
   is 25; classic keeps it), framed: the icon at 24dp inside a gold ring
   with rounded corners and a soft shadow, the ring green on an affect that
   counts down, with its time left in a pill under it (a nui-countdown,
   which formats once a second while it shows). */
.affect
{
	display: block;
	position: relative;
	width: 32dp;
	height: 28dp;
}
.affect__image
{
	display: block;
	width: 24dp;
	height: 24dp;
	margin: 2dp;
	pointer-events: none;
}
.affect--small .affect__image
{
	width: 24dp;
	height: 24dp;
}
/* The nearest-sampled copy of the icon: a skin may show it instead. */
.affect__image--nearest
{
	display: none;
}
/* The frame over the icon's edge: 2dp wide, its corners covering the
   square icon's. */
.affect__ring
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 28dp;
	height: 28dp;
	box-sizing: border-box;
	border-width: 2dp;
	border-color: var(--tip-socket-gold);
	border-radius: 7dp;
	pointer-events: none;
}
.affect__ring--clocked
{
	border-color: var(--tip-positive);
}
.affect__ring.nui-fx
{
	box-shadow: 0 0 0 1dp var(--cooldown-shade), 0 2dp 6dp var(--cooldown-shade);
}
.affect__clock
{
	display: block;
	position: absolute;
	left: -6dp;
	top: 31dp;
	width: 40dp;
	text-align: center;
	pointer-events: none;
}
.affect__clock nui-countdown
{
	padding: 0 3dp;
	border-radius: 4dp;
	background-color: var(--tooltip-bg);
	color: var(--text-inverse);
	font-size: 9dp;
	font-weight: bold;
	line-height: 13dp;
	white-space: nowrap;
}
/* Below the icon and its time, at its left edge; as wide as the text, up
   to 320dp. */
.affect__tip
{
	top: 100%;
	bottom: auto;
	margin-top: 20dp;
	margin-bottom: 0;
	width: auto;
	max-width: 320dp;
}
.affect__title
{
	display: block;
	font-weight: bold;
}
/* A description wraps; the horse's lines are separate lines. */
.affect__line
{
	display: block;
	white-space: pre-line;
}
/* The remaining time stays on one line. */
.affect__time
{
	white-space: nowrap;
}
