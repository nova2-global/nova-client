<rml>
<head>
	<!-- The affect icons (uiaffectshower.py): the buffs, potions, mall and
	     premium affects, the lover's heart and the horse, in two rows from
	     the top left (NOVA-218). While the affects flag is on, the game window makes the facade
	     nui_affects.AffectShower (controller assets/root/nui_affects.py).
	     Each icon's tooltip opens on :hover with no Python: a title and a
	     line, the remaining time as a nui-countdown that counts on the
	     NovaUI clock, or, for a skill affect without a duration, its name
	     under the icon (label). icon_over() runs once as the pointer enters
	     an icon, for the two values legacy read every frame (an auto
	     potion's remainder, a dragon soul deck's time). The icons are legacy
	     art under d:/ymir work/ (assets/ETC, and metin2_patch_ds for the
	     dragon soul decks). Each icon has a second, nearest-sampled image
	     (#nui-nearest), which only the classic skin shows, at 100% and
	     below, where legacy shows its icons point sampled. -->
	<title>affects</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="affects.rcss"/>
</head>
<body template="nui" class="nui-overlay nui-below-legacy-ui affects" data-model="affects">
	<div id="affects" class="affects__rows">
		<!-- NOVA-218: two rows, each sorted by affect (nui_affects): the status
		     icons and the skill affects (icons), then the potions and item
		     bonuses (items), which sit under the first row when it has icons.
		     Both rows repeat one slot. -->
		<div id="affects-skills" class="affects__row">
			<!-- The repeated slot binds nothing: RmlUi updates a repeated
			     element's own views with the data-for that removes it, so when an
			     affect ends they could read an entry that is gone. -->
			<div class="affects__slot" data-for="icon : icons">
				<div class="affect nui-has-tooltip nui-interactive"
					data-attr-id="'affect-' + icon.key" data-class-affect--small="icon.small"
					data-event-mouseover="icon_over(icon.key)" data-event-mousedown="icon_press(icon.key, ev.button)">
					<img class="affect__image" data-if="icon.image != ''" data-attr-src="icon.image"/>
					<img class="affect__image affect__image--nearest" data-if="icon.image != ''" data-attr-src="icon.image + '#nui-nearest'"/>
					<span class="affect__ring nui-fx" data-class-affect__ring--clocked="icon.clocked &amp;&amp; icon.end > 0 &amp;&amp; icon.kind != 'premium'"></span>
					<span class="affect__clock" data-if="icon.clocked &amp;&amp; icon.end > 0 &amp;&amp; icon.kind != 'premium'"><nui-countdown format="hms" data-attr-end="icon.end"/></span>
					<span class="nui-tooltip nui-tooltip--wrap nui-anim affect__tip"
						data-if="icon.title != '' || icon.line != '' || icon.end > 0"
						data-class-affect__tip--label="icon.label" data-class-is-open="icon.key == open_key">
						<span class="affect__title" data-if="icon.title != ''">{{ icon.title }}</span>
						<span class="affect__line" data-if="icon.kind == 'premium'">{{ icon.line }}</span>
						<span class="affect__line affect__time" data-if="icon.clocked &amp;&amp; icon.end > 0">(<span>@game.LEFT_TIME</span> : <nui-countdown format="dhms" day="@game.DAY" hour="@game.HOUR" minute="@game.MINUTE" second="@game.SECOND" data-attr-end="icon.end"/>)</span>
						<span class="affect__line" data-if="!(icon.clocked &amp;&amp; icon.end > 0) &amp;&amp; icon.line != ''">{{ icon.line }}</span>
					</span>
				</div>
			</div>
		</div>
		<div id="affects-items" class="affects__row affects__row--items" data-class-affects__row--below="icons.size > 0">
			<div class="affects__slot" data-for="icon : items">
				<div class="affect nui-has-tooltip nui-interactive"
					data-attr-id="'affect-' + icon.key" data-class-affect--small="icon.small"
					data-event-mouseover="icon_over(icon.key)" data-event-mousedown="icon_press(icon.key, ev.button)">
					<img class="affect__image" data-if="icon.image != ''" data-attr-src="icon.image"/>
					<img class="affect__image affect__image--nearest" data-if="icon.image != ''" data-attr-src="icon.image + '#nui-nearest'"/>
					<span class="affect__ring nui-fx" data-class-affect__ring--clocked="icon.clocked &amp;&amp; icon.end > 0 &amp;&amp; icon.kind != 'premium'"></span>
					<span class="affect__clock" data-if="icon.clocked &amp;&amp; icon.end > 0 &amp;&amp; icon.kind != 'premium'"><nui-countdown format="hms" data-attr-end="icon.end"/></span>
					<span class="nui-tooltip nui-tooltip--wrap nui-anim affect__tip"
						data-if="icon.title != '' || icon.line != '' || icon.end > 0"
						data-class-affect__tip--label="icon.label" data-class-is-open="icon.key == open_key">
						<span class="affect__title" data-if="icon.title != ''">{{ icon.title }}</span>
						<span class="affect__line" data-if="icon.kind == 'premium'">{{ icon.line }}</span>
						<span class="affect__line affect__time" data-if="icon.clocked &amp;&amp; icon.end > 0">(<span>@game.LEFT_TIME</span> : <nui-countdown format="dhms" day="@game.DAY" hour="@game.HOUR" minute="@game.MINUTE" second="@game.SECOND" data-attr-end="icon.end"/>)</span>
						<span class="affect__line" data-if="!(icon.clocked &amp;&amp; icon.end > 0) &amp;&amp; icon.line != ''">{{ icon.line }}</span>
					</span>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
