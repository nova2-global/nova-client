/* Attach metin stone's modern look (P14 spec 6.5): a movable window at
   legacy's place (the screen's top left corner), the item's tooltip as it
   is and with the stone side by side, the stone between them under an
   arrow, the question, Yes and No. Classic (legacy's board, 15 + old + 45 +
   new + 15 wide, the tooltips at y 38, the arrow and the stone's slot in
   the 45 between them): skins/classic/windows/attach-metin.rcss. */

body.attach
{
	left: 0;
	top: 0;
	min-width: 0;
	focus: none;
	tab-index: none;
}
.attach button
{
	tab-index: none;
}
.attach__body
{
	display: block;
	padding: var(--space-3);
}
/* Both tooltips as wide as legacy makes them (the old one takes the new
   one's width), side by side from the top; the stone in the middle. */
.attach__tips
{
	display: flex;
	flex-direction: row;
	align-items: flex-start;
}
.attach__tip
{
	--tip-min-w: 190dp;
	flex-shrink: 0;
	box-sizing: border-box;
	min-width: var(--tip-min-w);
}
.attach__middle
{
	display: flex;
	flex-direction: column;
	align-items: center;
	align-self: center;
	flex-shrink: 0;
	width: 45dp;
}
.attach__arrow
{
	display: block;
	margin-bottom: var(--space-2);
}
.attach__arrow .nui-glyph
{
	--glyph-ink: var(--accent);
	transform: scale(1.5);
}
.attach__stone
{
	display: block;
	width: 32dp;
	height: 32dp;
	border-width: 2dp;
	border-color: var(--tip-socket-silver);
	border-radius: 18dp;
}
.attach__stone-icon
{
	display: block;
	width: 32dp;
	height: 32dp;
}
.attach__question
{
	display: block;
	margin-top: var(--space-3);
	text-align: center;
}
.attach__footer
{
	justify-content: center;
}
