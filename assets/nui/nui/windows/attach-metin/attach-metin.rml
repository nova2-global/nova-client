<rml>
<head>
	<!-- Attach metin stone (uiattachmetin.py AttachMetinDialog, uiscript
	     attachstonedialog.py; P14 spec 6.5). While the attach-metin flag is
	     on, the inventory makes nui_attach_metin.AttachMetinDialog
	     (controller assets/root/nui_attach_metin.py), a subclass of the
	     legacy class on proxies: Open (the stone put into the first socket
	     it fits) and Accept (the use packet) are legacy's code. The item's
	     tooltip as it is (old) and with the stone (new), both built by the
	     legacy rules and recorded (the block is components/item-tip.rcss's),
	     the stone between them, the question, Yes and No. The document
	     exists only while the dialog shows; it opens at legacy's place, the
	     screen's corner. The body and its controls take no focus; controls
	     act on a left mousedown. A left or right
	     press anywhere on it raises the window (board_press), as legacy's
	     window manager raised the window under a press. -->
	<title>attach-metin</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="../../components/item-tip.rcss"/>
	<link type="text/rcss" href="attach-metin.rcss"/>
</head>
<body template="nui" id="attach-metin" class="nui-window nui-fx nui-anim attach" data-model="attach_metin" data-event-mousedown="board_press(ev.button)">
	<div class="nui-window__titlebar attach__titlebar">
		<span class="attach-title-icon"><span class="nui-glyph nui-glyph--gem"><span class="nui-glyph__a"></span><span
			class="nui-glyph__b"></span></span></span>
		<handle class="nui-window__handle attach__handle" move_target="#document">
			<span class="nui-window__title attach__title">@ui.ATTACH_METIN_TITLE</span>
		</handle>
		<button id="attach-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim attach__close"
		        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	</div>
	<div class="nui-window__body attach__body">
		<div class="attach__tips">
			<div class="nui-board nui-board--tooltip nui-fx nui-tip attach__tip attach__tip--old" data-style---tip-min-w="old_min_w + 'dp'">
				<div id="attach-old" class="nui-tip__body">
					<div class="nui-tip__slot" data-for="l : old_lines">
						<div class="nui-tip__rule" data-if="l.rule"></div>
						<div class="nui-tip__line" data-if="l.t == 'line'"
						     data-class-nui-tip--gap-5="l.gap == 5" data-class-nui-tip--gap-10="l.gap == 10" data-class-nui-tip--gap-15="l.gap == 15" data-class-nui-tip--gap-20="l.gap == 20" data-class-nui-tip--gap-25="l.gap == 25" data-class-nui-tip--gap-30="l.gap == 30" data-class-nui-tip--gap-35="l.gap == 35" data-class-nui-tip--gap-40="l.gap == 40"
						     data-class-nui-tip__line--left="l.align == 'left'" data-class-nui-tip__line--right="l.align == 'right'"
						     data-class-nui-tip__line--plain="!l.outline">
							<span class="nui-tip__runslot" data-for="r : l.runs">
								<span class="nui-tip__run" data-if="r.k == 'text'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color">{{ r.text }}</span>
								<nui-text class="nui-tip__run" data-if="r.k == 'tags'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color" data-attr-value="r.text"/>
								<nui-countdown class="nui-tip__run" data-if="r.k == 'count'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color"
								     data-attr-end="r.end" day="@game.DAY" hour="@game.HOUR" minute="@game.MINUTE" second="@game.SECOND"/>
							</span>
						</div>
						<img class="nui-tip__image" data-if="l.t == 'image'" data-attr-src="l.src"
						     data-class-nui-tip--gap-5="l.gap == 5" data-class-nui-tip--gap-10="l.gap == 10" data-class-nui-tip--gap-15="l.gap == 15" data-class-nui-tip--gap-20="l.gap == 20" data-class-nui-tip--gap-25="l.gap == 25" data-class-nui-tip--gap-30="l.gap == 30" data-class-nui-tip--gap-35="l.gap == 35" data-class-nui-tip--gap-40="l.gap == 40"/>
						<div class="nui-tip__socket" data-if="l.t == 'socket'" data-class-nui-tip__socket--gold="l.frame == 'gold'"
						     data-class-nui-tip--gap-5="l.gap == 5" data-class-nui-tip--gap-10="l.gap == 10" data-class-nui-tip--gap-15="l.gap == 15" data-class-nui-tip--gap-20="l.gap == 20" data-class-nui-tip--gap-25="l.gap == 25" data-class-nui-tip--gap-30="l.gap == 30" data-class-nui-tip--gap-35="l.gap == 35" data-class-nui-tip--gap-40="l.gap == 40">
							<span class="nui-tip__socket-frame"><img class="nui-tip__socket-icon" data-if="l.icon != ''" data-attr-src="l.icon"/></span>
							<div class="nui-tip__socket-lines">
								<div class="nui-tip__slot" data-for="s : l.sub">
									<div class="nui-tip__line nui-tip__line--left" data-class-nui-tip__line--plain="!s.outline">
										<span class="nui-tip__runslot" data-for="r : s.runs">
											<span class="nui-tip__run" data-if="r.k == 'text'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color">{{ r.text }}</span>
											<nui-text class="nui-tip__run" data-if="r.k == 'tags'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color" data-attr-value="r.text"/>
											<nui-countdown class="nui-tip__run" data-if="r.k == 'count'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color"
											     data-attr-end="r.end" day="@game.DAY" hour="@game.HOUR" minute="@game.MINUTE" second="@game.SECOND"/>
										</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="attach__middle">
				<span class="attach__arrow"><span class="nui-glyph nui-glyph--chevron-right"><span
					class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span><span
					class="nui-glyph nui-glyph--chevron-right"><span class="nui-glyph__a"></span><span
					class="nui-glyph__b"></span></span></span>
				<span class="attach__stone"><img class="attach__stone-icon" data-if="metin_icon != ''" data-attr-src="metin_icon"/></span>
			</div>
			<div class="nui-board nui-board--tooltip nui-fx nui-tip attach__tip attach__tip--new" data-style---tip-min-w="new_min_w + 'dp'">
				<div id="attach-new" class="nui-tip__body">
					<div class="nui-tip__slot" data-for="l : new_lines">
						<div class="nui-tip__rule" data-if="l.rule"></div>
						<div class="nui-tip__line" data-if="l.t == 'line'"
						     data-class-nui-tip--gap-5="l.gap == 5" data-class-nui-tip--gap-10="l.gap == 10" data-class-nui-tip--gap-15="l.gap == 15" data-class-nui-tip--gap-20="l.gap == 20" data-class-nui-tip--gap-25="l.gap == 25" data-class-nui-tip--gap-30="l.gap == 30" data-class-nui-tip--gap-35="l.gap == 35" data-class-nui-tip--gap-40="l.gap == 40"
						     data-class-nui-tip__line--left="l.align == 'left'" data-class-nui-tip__line--right="l.align == 'right'"
						     data-class-nui-tip__line--plain="!l.outline">
							<span class="nui-tip__runslot" data-for="r : l.runs">
								<span class="nui-tip__run" data-if="r.k == 'text'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color">{{ r.text }}</span>
								<nui-text class="nui-tip__run" data-if="r.k == 'tags'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color" data-attr-value="r.text"/>
								<nui-countdown class="nui-tip__run" data-if="r.k == 'count'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color"
								     data-attr-end="r.end" day="@game.DAY" hour="@game.HOUR" minute="@game.MINUTE" second="@game.SECOND"/>
							</span>
						</div>
						<img class="nui-tip__image" data-if="l.t == 'image'" data-attr-src="l.src"
						     data-class-nui-tip--gap-5="l.gap == 5" data-class-nui-tip--gap-10="l.gap == 10" data-class-nui-tip--gap-15="l.gap == 15" data-class-nui-tip--gap-20="l.gap == 20" data-class-nui-tip--gap-25="l.gap == 25" data-class-nui-tip--gap-30="l.gap == 30" data-class-nui-tip--gap-35="l.gap == 35" data-class-nui-tip--gap-40="l.gap == 40"/>
						<div class="nui-tip__socket" data-if="l.t == 'socket'" data-class-nui-tip__socket--gold="l.frame == 'gold'"
						     data-class-nui-tip--gap-5="l.gap == 5" data-class-nui-tip--gap-10="l.gap == 10" data-class-nui-tip--gap-15="l.gap == 15" data-class-nui-tip--gap-20="l.gap == 20" data-class-nui-tip--gap-25="l.gap == 25" data-class-nui-tip--gap-30="l.gap == 30" data-class-nui-tip--gap-35="l.gap == 35" data-class-nui-tip--gap-40="l.gap == 40">
							<span class="nui-tip__socket-frame"><img class="nui-tip__socket-icon" data-if="l.icon != ''" data-attr-src="l.icon"/></span>
							<div class="nui-tip__socket-lines">
								<div class="nui-tip__slot" data-for="s : l.sub">
									<div class="nui-tip__line nui-tip__line--left" data-class-nui-tip__line--plain="!s.outline">
										<span class="nui-tip__runslot" data-for="r : s.runs">
											<span class="nui-tip__run" data-if="r.k == 'text'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color">{{ r.text }}</span>
											<nui-text class="nui-tip__run" data-if="r.k == 'tags'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color" data-attr-value="r.text"/>
											<nui-countdown class="nui-tip__run" data-if="r.k == 'count'" data-attr-class="'nui-tip__run nui-tip-role--' + r.role" data-style---tip-color="r.color"
											     data-attr-end="r.end" day="@game.DAY" hour="@game.HOUR" minute="@game.MINUTE" second="@game.SECOND"/>
										</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="attach__question">@ui.ATTACH_METIN_INFO</div>
	</div>
	<div class="nui-window__footer attach__footer">
		<button id="attach-accept" class="nui-button nui-button--primary nui-button--medium nui-anim attach__accept"
		        data-event-mousedown="accept_press(ev.button)">@ui.YES</button>
		<button id="attach-cancel" class="nui-button nui-button--medium nui-anim attach__cancel"
		        data-event-mousedown="cancel_press(ev.button)">@ui.NO</button>
	</div>
</body>
</rml>
