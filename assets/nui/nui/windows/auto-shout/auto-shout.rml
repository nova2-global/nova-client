<rml>
<head>
	<!-- The auto-shout window (NOVA-204; legacy uiautoshout.py AutoShoutWindow,
	     uiscript autoshoutwindow.py; OLD uiChat.py:1571-1840). The button by
	     the chat input opens it; while the auto-shout flag is on, that is
	     nui_auto_shout.AutoShoutWindow (controller
	     assets/root/nui_auto_shout.py), a subclass of the legacy class on
	     proxies: the field opens with the character's message (the last
	     shout the player sent), Start sends "/auto_shout on <text>", Stop
	     "/auto_shout off" (autoshout.py; the server owns the repeat). The
	     state: Off, Starting... until the server's AutoShoutState, or On with
	     the time to the next shout (a nui-countdown from the server's last
	     state, on by the interval at its end). Enter in the field is Start or
	     Stop, Escape closes. The body takes no focus but on its field;
	     controls act on a left mousedown; a press anywhere raises the window.
	     Only while it shows. -->
	<title>auto-shout</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="auto-shout.rcss"/>
</head>
<body template="nui" id="auto-shout" class="nui-window nui-fx nui-anim nui-field-passes-hotkeys nui-field-keeps-focus auto-shout" data-model="auto_shout"
      data-event-mousedown="board_press(ev.button)">
	<div class="nui-window__titlebar auto-shout__titlebar">
		<handle class="nui-window__handle auto-shout__handle" move_target="#document">
			<span class="auto-shout__title-icon"><span class="nui-glyph nui-glyph--refresh"><span
				class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></span>
			<span class="nui-window__title auto-shout__title">@game.AUTO_SHOUT_TITLE</span>
		</handle>
		<button id="auto-shout-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim auto-shout__close"
		        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	</div>
	<div class="nui-window__body auto-shout__body">
		<p class="auto-shout__desc">@game.AUTO_SHOUT_DESC</p>
		<span class="auto-shout__label">@game.AUTO_SHOUT_MESSAGE</span>
		<div class="auto-shout__slot"><input id="auto-shout-message" type="text" class="nui-input auto-shout__field"
			data-attr-maxlength="message_max" data-event-mousedown="field_press(ev.button)"/></div>
		<div class="auto-shout__state" data-class-is-on="state == 'on'" data-class-is-waiting="state == 'waiting'">
			<span class="auto-shout__dot"></span>
			<span class="auto-shout__status" data-if="state == 'off'">@game.AUTO_SHOUT_STATUS_OFF</span>
			<span class="auto-shout__status" data-if="state == 'waiting'">@game.AUTO_SHOUT_STATUS_WAITING</span>
			<span class="auto-shout__status" data-if="state == 'on'">@game.AUTO_SHOUT_STATUS_ON</span>
			<span class="auto-shout__next" data-if="state == 'on'">@game.AUTO_SHOUT_NEXT <nui-countdown id="auto-shout-countdown"
				class="auto-shout__countdown" format="ms" data-attr-end="next_end" data-event-countdownend="countdown_end()"/></span>
		</div>
	</div>
	<div class="nui-window__footer auto-shout__footer">
		<button id="auto-shout-toggle" class="nui-button nui-anim auto-shout__toggle" data-class-nui-button--primary="state == 'off'"
		        data-event-mousedown="toggle_press(ev.button)"><span class="auto-shout__toggle-label" data-if="state == 'off'">@game.AUTO_SHOUT_START</span><span
			class="auto-shout__toggle-label" data-if="state != 'off'">@game.AUTO_SHOUT_STOP</span></button>
	</div>
</body>
</rml>
