/* The belt's modern look (P14 spec 6.3; the stage 1 design, WBelt board):
   a board beside the inventory with a lean 4 x 4 grid and, on its left, the
   minimize chevron in a well as tall as the grid; the cells beyond the
   belt's grade are striped; collapsed, a 16dp tab with the expand chevron.
   The controller docks it (place_next_to), so its place here only frames
   it in its snapshots. Classic (legacy's expand and minimize art and the
   stone board; no title): skins/classic/windows/belt-inventory.rcss. */

body.belt
{
	left: 8dp;
	top: 8dp;
	focus: none;
	tab-index: none;
}
.belt button
{
	tab-index: none;
}
body.belt.belt--expanded
{
	padding: var(--space-2);
}
.belt__layer
{
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: var(--space-1);
}
.belt__expand, .belt__minimize
{
	display: block;
	width: 16dp;
	min-width: 0;
	height: 48dp;
	margin-top: 8dp;
	padding: 0;
}
.belt__expand .nui-glyph, .belt__minimize .nui-glyph
{
	position: absolute;
	left: 0;
	top: 16dp;
}
.belt__expand, .belt__minimize
{
	position: relative;
}
/* Expanded, the minimize chevron sits in a well beside the whole grid. */
.belt__minimize
{
	width: 22dp;
	height: 172dp;
	margin-top: 0;
	background-color: var(--surface-sunken);
	border-color: var(--border);
	border-radius: 9dp;
}
.belt__minimize:hover
{
	background-color: var(--surface-hover);
	border-color: var(--border);
}
.belt__minimize .nui-glyph
{
	left: 2dp;
	top: 77dp;
}
/* A cell beyond the belt's grade: the component's dimmed cell, striped. */
.belt__grid > .nui-slot.is-unavailable,
.belt__grid > .nui-slot.is-unavailable:hover
{
	decorator: repeating-linear-gradient(135deg, transparent 0dp, transparent 5dp, var(--border) 5dp, var(--border) 10dp);
}
/* Its lock, in the cell's middle in the muted text: the cell's number part,
   empty there, is a 12 x 14dp padlock drawn by two gradients (the body, the
   first decorator, over the lower half of the shackle, a ring; the ring's
   stops in percent of its 4dp radius, as RmlUi misplaces dp stops in a
   radial gradient), so the lean cell needs no other element (P14 spec
   4.2). --belt-lock-ink colors it. Their first stops are clear, so a device
   without effects, which draws a gradient in one color, shows no lock. */
.belt__grid > .nui-slot
{
	--belt-lock-ink: var(--text-muted);
}
.belt__grid > .nui-slot.is-unavailable.is-empty > .nui-slot__number
{
	display: block;
	left: 13dp;
	top: 11dp;
	right: auto;
	bottom: auto;
	width: 12dp;
	height: 14dp;
	decorator: linear-gradient(180deg, transparent 0%, transparent 43%, var(--belt-lock-ink) 43%, var(--belt-lock-ink) 100%),
	           radial-gradient(circle 4dp at 50% 4.5dp, transparent 0%, transparent 48%, var(--belt-lock-ink) 48%, var(--belt-lock-ink) 98%, transparent 98%, transparent 100%);
}
.belt__grid > .nui-slot.is-unavailable.is-empty > .nui-slot__number .nui-number__text
{
	display: none;
}
