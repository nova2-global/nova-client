<rml>
<head>
	<!-- The big notice board (uitip.py BigBoard): the big notices the server
	     sends (BINARY_SetBigMessage, the OX event), one at a time in the big
	     font on a bar at the top center. While the big-board flag is on, the
	     Interface makes the facade nui_big_board.BigBoard (controller
	     assets/root/nui_big_board.py), which steps as the tip board does, on
	     a format="none" nui-countdown. A long notice wraps within the line.
	     The classic frame art is in the season1 group (assets/season1), a
	     root for lint and snapshots. It takes no input. -->
	<title>big-board</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="big-board.rcss"/>
</head>
<body template="nui" class="nui-overlay nui-below-legacy-ui big-board" data-model="big_board">
	<div id="big-board" class="big-board__bar nui-board nui-board--notice nui-fx" data-if="shown">
		<div class="big-board__clip">
			<div id="big-line-a" class="big-line nui-anim" data-class-is-front="front == 'a'" data-class-is-back="front != 'a'"><span class="big-line__text">{{ line_a }}</span></div>
			<div id="big-line-b" class="big-line nui-anim" data-class-is-front="front == 'b'" data-class-is-back="front != 'b'"><span class="big-line__text">{{ line_b }}</span></div>
		</div>
		<img class="big-board__frame big-board__frame--0" src="/season1/interface/oxevent/frame_0.sub"/>
		<img class="big-board__frame big-board__frame--1" src="/season1/interface/oxevent/frame_1.sub"/>
		<img class="big-board__frame big-board__frame--2" src="/season1/interface/oxevent/frame_2.sub"/>
		<nui-countdown id="big-timer" format="none" data-attr-end="next_at" data-event-countdownend="advance()"/>
	</div>
</body>
</rml>
