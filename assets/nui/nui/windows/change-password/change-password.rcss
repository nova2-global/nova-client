/* The change-password dialog's modern look (P16 spec 5.4.2): the dialog
   kit's look (components/dialog.rcss) with three rows, each a label and a
   password field, then Cancel and OK. The scrim centers it. Classic
   (legacy's 220 x 137 board, the labels left of the parameter slots, the
   middle buttons at the uiscript's places):
   skins/classic/windows/change-password.rcss. */

.change-password button
{
	tab-index: none;
	focus: none;
}
.change-password__body
{
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}
/* Rows read left to right, though the dialog look centers its text. */
.change-password__row
{
	text-align: left;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: var(--space-3);
}
.change-password__label
{
	flex: 1 1 auto;
	min-width: 120dp;
	color: var(--text);
	white-space: nowrap;
	pointer-events: none;
}
.change-password__slot
{
	display: block;
	flex: 0 0 auto;
}
.change-password__field
{
	width: 120dp;
}
