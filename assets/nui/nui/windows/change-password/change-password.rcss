/* The change-password dialog's modern look (P16 spec 5.4.2; the reviewed
   design, board WChangePassword): the dialog kit's look
   (components/dialog.rcss) with its title glyph, three rows, each a label
   column and a password field filling the row, then OK and Cancel in
   legacy's order. The scrim centers it. Classic (legacy's 220 x 137 board,
   the labels left of the parameter slots, the middle buttons at the
   uiscript's places): skins/classic/windows/change-password.rcss. */

/* While the mismatch message shows over it, the message's scrim dims the
   screen alone: two stacked scrims left it nearly black (cyberpunk). */
body.change-password--covered
{
	background-color: transparent;
}
.change-password button
{
	tab-index: none;
	focus: none;
}
.change-password__window
{
	width: 340dp;
}

/* The title glyph on the accent's soft tile: a padlock. */
.change-password__icon
{
	display: inline-block;
	box-sizing: border-box;
	width: 24dp;
	height: 24dp;
	margin: -2dp var(--space-2) 0 0;
	padding: 3dp;
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	background-color: var(--selection);
	line-height: 16dp;
	vertical-align: middle;
}
.change-password__glyph
{
	--glyph-ink: var(--accent);
	display: block;
}
.change-password__glyph .nui-glyph__a
{
	left: 4dp;
	top: 1dp;
	width: 8dp;
	height: 9dp;
	border-width: 2dp 2dp 0 2dp;
	border-radius: 4dp 4dp 0 0;
}
.change-password__glyph .nui-glyph__b
{
	left: 2dp;
	top: 7dp;
	width: 12dp;
	height: 8dp;
	border-radius: 2dp;
	background-color: var(--glyph-ink);
}

.change-password__body
{
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
	padding: var(--space-3) 18dp var(--space-2) 18dp;
}
/* Rows read left to right, though the dialog look centers its text. */
.change-password__row
{
	text-align: left;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: var(--space-2);
}
/* The label column; a longer translation wraps in it. */
.change-password__label
{
	flex: 0 0 142dp;
	min-width: 0;
	color: var(--text-muted);
	line-height: 16dp;
	pointer-events: none;
}
.change-password__slot
{
	display: block;
	flex: 1 1 auto;
}
.change-password__field
{
	width: 100%;
}
/* OK first, then Cancel, as legacy's (the dialog footer puts the primary
   button last). */
.change-password__footer
{
	flex-direction: row-reverse;
	gap: 10dp;
}
.change-password__button
{
	min-width: 92dp;
}
