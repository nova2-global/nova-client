<rml>
<head>
	<!-- The safebox's change-password dialog (uisafebox.py
	     ChangePasswordDialog, uiscript changepassworddialog.py; P16 spec
	     5.4.2). The NovaUI safebox makes nui_safebox.ChangePasswordDialog, a
	     subclass of the legacy class on proxies (its board: assets/root/
	     nui_change_password.py): Tab and Enter move the focus old, new, check,
	     old; Enter in the check field or OK compares the new fields (a
	     mismatch: the dialog kit's message; a match: legacy's change command),
	     Cancel, the close button and Escape close it, all legacy's code. A
	     modal (D12) above the legacy UI layer: the scrim centers it. The three
	     fields are password inputs whose text never enters the model; their
	     maxlength is SAFEBOX_PASSWORD_MAX_LEN. The buttons take no focus and
	     act on a left mousedown. -->
	<title>change-password</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="change-password.rcss"/>
</head>
<body template="nui" class="nui-scrim nui-fx change-password" data-model="change_password"
      data-event-mousedown="board_press(ev.button)">
	<div class="nui-window nui-fx nui-dialog nui-anim change-password__window" id="change-password">
		<div class="nui-window__titlebar change-password__titlebar">
			<handle class="nui-window__handle change-password__handle" move_target="change-password">
				<span class="nui-window__title change-password__title">@ui.CHANGE_PASSWORD_TITLE</span>
			</handle>
			<button id="change-password-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim"
			        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
				class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
		</div>
		<div class="nui-window__body change-password__body">
			<div class="change-password__row change-password__row--old">
				<span class="change-password__label">@ui.CHANGE_PASSWORD_OLD</span>
				<div class="change-password__slot"><input id="change-password-old" type="password"
					class="nui-input change-password__field" data-attr-maxlength="max"/></div>
			</div>
			<div class="change-password__row change-password__row--new">
				<span class="change-password__label">@ui.CHANGE_PASSWORD_NEW</span>
				<div class="change-password__slot"><input id="change-password-new" type="password"
					class="nui-input change-password__field" data-attr-maxlength="max"/></div>
			</div>
			<div class="change-password__row change-password__row--check">
				<span class="change-password__label">@ui.CHANGE_PASSWORD_CONFIRM</span>
				<div class="change-password__slot"><input id="change-password-check" type="password"
					class="nui-input change-password__field" data-attr-maxlength="max"/></div>
			</div>
		</div>
		<div class="nui-window__footer nui-dialog__footer change-password__footer">
			<button id="change-password-cancel" class="nui-button nui-button--medium nui-anim change-password__button change-password__button--cancel"
			        data-event-mousedown="cancel_press(ev.button)">@ui.CANCEL</button>
			<button id="change-password-accept" class="nui-button nui-button--medium nui-button--primary nui-anim change-password__button change-password__button--accept"
			        data-event-mousedown="accept_press(ev.button)">@ui.OK</button>
		</div>
	</div>
</body>
</rml>
