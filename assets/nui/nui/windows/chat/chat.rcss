/* The chat's modern look. The body is the 600dp block; the facade puts its
   bottom center on the taskbar's top. Closed: the lines (the newest five,
   for 5 s) on the view shade right above that edge. Open: the input row,
   34dp, and above it the history panel, as tall as history_height (the
   sizing bar's drag), with a grip at its top; the lines fill the panel from
   10dp below its top, so a 138dp history holds 8 lines, as legacy's does.
   The row lays out its parts in a flex row (a pill for the mode, the field,
   the three glyph buttons), so a long mode name does not cover the field.
   The chat's backdrop (the shared overlay) and line colors stay dark in
   every modern palette: the colors of tags (item links, notices) come from
   game data made for a dark backdrop; the input row takes the panel color
   (the mockup's Chat board). Classic (the legacy pieces at their legacy
   places): skins/classic/windows/chat.rcss. */

/* The facade places the body (set_position, its bottom center on the
   taskbar's top), which writes left and top; the sheet's own place uses
   left and top as well (a bottom would stretch the body once top is set)
   and frames the window in its 960 x 320dp snapshots. */
body.chat
{
	left: 50%;
	top: 258dp;
	width: 600dp;
	margin-left: -300dp;
	focus: none;
	tab-index: none;
	pointer-events: none;
}
/* focus is inherited, so the body's none keeps every part from taking the
   focus; the field and the mode button take it back (the facade moves the
   focus to the mode button, which takes no keys, when a legacy edit line
   takes wndMgr's focus). Nothing is in the tab order. */
.chat button
{
	tab-index: none;
}

.chat__block
{
	position: relative;
	width: 600dp;
}

/* The history sits on the input row (or, closed, on the block's bottom
   edge): its bottom stays put while the sizing bar's drag changes its
   height, so it grows upward. Its height is the resize handle's, inline. */
.chat__history
{
	position: absolute;
	left: 0;
	bottom: 100%;
	width: 600dp;
	height: 138dp;
}
/* Open: the history on the shared overlay (the tooltip translucency, the
   player's overlay opacity), clear at its top and full from a fifth down,
   with round top corners. */
.chat__block.is-open .chat__history
{
	border-radius: 12dp 12dp 0 0;
	decorator: linear-gradient(180deg, var(--chat-view-shade-top) 0%, var(--tooltip-bg) 22%, var(--tooltip-bg) 100%);
}

/* The sizing bar, drawn over the oldest line, as legacy's. */
.chat__resize
{
	display: none;
	position: absolute;
	left: 0;
	top: 0;
	width: 600dp;
	z-index: 1;
}
.chat__block.is-open .chat__resize
{
	display: block;
}
.chat__grip
{
	display: block;
	width: 44dp;
	height: 4dp;
	margin: 4dp auto 0 auto;
	border-radius: 2dp;
	background-color: var(--chat-talking);
	opacity: 0.45;
	pointer-events: none;
}

/* The lines element places each line by its bottom offset and sets its own
   height while closed; open, its box is the panel below the first 10dp. */
.chat__lines
{
	position: absolute;
	left: 0;
	bottom: 0;
	width: 600dp;
	pointer-events: none;
}
.chat__lines .nui-chat__line
{
	margin-left: 12dp;
	font-size: var(--font-md);
	font-effect: shadow(0dp 1dp var(--text-outline));
}
/* An item link: a chip of the link color's family around the run, whose
   text keeps the color its tag gives it. */
.chat__lines .nui-link
{
	padding: 0 4dp;
	border-width: 1dp;
	border-color: var(--gauge-blue);
	border-radius: 4dp;
	background-color: var(--sp-recovery);
}
.chat__lines.has-lines
{
	decorator: vertical-gradient(var(--chat-view-shade-top) var(--chat-view-shade-bottom));
}
.chat__block.is-quiet .chat__lines
{
	visibility: hidden;
}
.chat__block.is-open .chat__lines
{
	top: 10dp;
	pointer-events: auto;
	decorator: none;
}

/* The input row stays in the layout while closed, 0dp tall and clipped, so
   its field can take the focus in the call that opens the chat. The clip is
   forced: RmlUi clips only content that overflows, and an absolutely placed
   part (the classic layout) does not count. */
.chat__input-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: relative;
	box-sizing: border-box;
	width: 600dp;
	height: 0;
	padding: 0 var(--space-1);
	overflow: hidden;
	clip: always;
}
/* Open: a 34dp row on the panel color under a line, round at its bottom;
   the mode pill, the field and the three buttons 24dp tall. */
.chat__block.is-open .chat__input-row
{
	height: 34dp;
	overflow: visible;
	clip: auto;
	border-width: 1dp 0 0 0;
	border-color: var(--border);
	border-radius: 0 0 12dp 12dp;
	background-color: var(--surface);
}

.chat__mode
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	min-width: 48dp;
	height: 24dp;
	margin-right: 6dp;
	padding: 0 10dp;
	border-width: 1dp;
	border-color: var(--accent);
	border-radius: 7dp;
	background-color: var(--selection);
	color: var(--accent);
	font-size: var(--font-md);
	font-weight: bold;
	line-height: 22dp;
	text-align: center;
	white-space: nowrap;
	focus: auto;
}
.chat__mode:hover
{
	background-color: var(--surface-hover);
}
.chat__mode:active
{
	background-color: var(--surface-sunken);
}

.chat__field
{
	display: block;
	flex: 1 1 auto;
	position: relative;
	height: 24dp;
	margin-right: 6dp;
}
input.chat__input
{
	width: 100%;
	height: 24dp;
	font-size: var(--font-md);
	line-height: 22dp;
	focus: auto;
}
/* The prefix mark over the field's first character (# party, % guild,
   ! shout), in the mark color: the same glyph at the same place, so it
   covers the field's own. The field's text starts after its 1dp border and
   8dp padding. */
.chat__mark
{
	display: block;
	position: absolute;
	left: 9dp;
	top: 1dp;
	color: var(--chat-mark);
	font-size: var(--font-md);
	line-height: 22dp;
	pointer-events: none;
}

.chat__button
{
	display: block;
	flex: 0 0 auto;
	width: 26dp;
	height: 24dp;
	margin-left: 2dp;
	padding: 0;
	border-width: 0;
	border-radius: 7dp;
	background-color: transparent;
}
.chat__button:hover
{
	background-color: var(--surface-hover);
}
.chat__button:active
{
	background-color: var(--surface-sunken);
}
/* The send, whisper and log buttons draw a glyph (components/glyph.rcss);
   classic draws the legacy button art instead (its overlay). */
.chat__glyph
{
	position: absolute;
	left: 5dp;
	top: 4dp;
	--glyph-ink: var(--text-muted);
}
.chat__send .chat__glyph
{
	--glyph-ink: var(--accent);
}
.chat__button:hover .chat__glyph
{
	--glyph-ink: var(--accent);
}
