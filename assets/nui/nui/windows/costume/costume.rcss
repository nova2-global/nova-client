/* The costume window's modern look (P14 spec 6.2; the stage 1 design,
   WCostume board; Wave 6): a movable window beside the inventory. Its
   cells stand on a stage around a figure (an image the controller passes,
   male or female by the race) on a small rune circle that turns the other
   way to the inventory's, over a diamond mesh and a soft accent halo: the
   costume hair and body on the right, and in the foundation's table
   (inv--table-old) the weapon costume, the costume sash and the sash
   costume down the left and the aura at the figure's feet, each empty one
   showing its place's mark (Wave 6, NOVA-20, 21, 23). Today's table keeps
   the three empty frames legacy's costume art paints on the left instead.
   The other names keep places on the 44dp pitch, should a table show them
   again, and so does a companion's block, in rows 4 to 6 under a divider.
   Under the stage, legacy's five switches in a row that wraps (three, then
   two), the stage's width, and under them the aura panel while it is open:
   a sunken panel with a toggle per aura flag (NOVA-22, 23).
   Classic (legacy's 216 x 236 board with costume_bg.jpg):
   skins/classic/windows/costume.rcss. */

body.cos
{
	left: 20dp;
	top: 20dp;
	min-width: 0;
	focus: none;
	tab-index: none;
}
.cos button
{
	tab-index: none;
}
/* The title bar's window icon, as the dragon soul window's: the person
   glyph (who wears the costumes) on the accent's soft tile. */
.cos-title-icon
{
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 24dp;
	height: 24dp;
	margin-right: 6dp;
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	background-color: var(--selection);
}
.cos-title-icon .nui-glyph
{
	--glyph-ink: var(--accent);
	transform: scale(0.8);
}
.cos__body
{
	padding: var(--space-2);
}
.cos-grid
{
	position: relative;
	width: 84dp;
	height: 84dp;
}
body.cos.cos--companion .cos-grid
{
	height: 304dp;
}
/* The stage: the well under a diamond mesh (thin lines 45 degrees either
   way); the halo is the light. Its places are from its padding box. Both
   tables stand the costume hair and body on it (the foundation's, live since
   the cut, as today's), with the weapon, accessory and ring places as faint
   frames that take nothing (Eddy, 2026-11-04). */
body.cos.inv--table-new .cos-grid,
body.cos.inv--table-old .cos-grid
{
	box-sizing: border-box;
	width: 176dp;
	height: 210dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 10dp;
	decorator: repeating-linear-gradient(45deg, var(--border) 0dp, var(--border) 0.7dp, transparent 0.7dp, transparent 11.3dp),
	           repeating-linear-gradient(-45deg, var(--border) 0dp, var(--border) 0.7dp, transparent 0.7dp, transparent 11.3dp);
}

/* The foundation's table stands a third cell in the left column (the sash
   costume, under the sash): the stage is 8dp taller. */
body.cos.inv--table-old .cos-grid
{
	height: 218dp;
}

/* --- The stage's art (both tables) ------------------------------------------- */

.cos-stage
{
	display: none;
}
body.cos.inv--table-new .cos-stage,
body.cos.inv--table-old .cos-stage
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 174dp;
	height: 208dp;
	pointer-events: none;
}
body.cos.inv--table-old .cos-stage
{
	height: 216dp;
}
.cos-stage__halo, .cos-stage__rune, .cos-stage__figure, .cos-stage__frame
{
	display: block;
	position: absolute;
	pointer-events: none;
}
.cos-stage__halo
{
	left: 22dp;
	top: 6dp;
	width: 132dp;
	height: 196dp;
	decorator: radial-gradient(48% 46% at 50% 46%, var(--accent-glow) 0%, transparent 64%);
	opacity: 0.7;
}
/* A device without effects draws a gradient as its middle color: the halo
   would be a flat box. */
@media (theme: no-effects)
{
	.cos-stage__halo
	{
		display: none;
	}
}
/* The figure, 180dp tall, centered on the stage's middle line, its feet on
   the rune circle. */
.cos-stage__figure
{
	left: 0;
	top: 12dp;
	width: 172dp;
	height: 180dp;
	text-align: center;
}
/* In the accent's glow (the design's lavender figure, see-through in every
   theme): image-color multiplies the gray carvings, alpha included; its glow
   is a drop shadow while effects are on. */
.cos-stage__image
{
	height: 180dp;
	image-color: var(--accent-glow);
}
.cos-stage__image.nui-fx
{
	filter: drop-shadow(var(--accent-glow) 0dp 0dp 3dp);
}
/* The rune circle: rings and a hexagram on a 112dp disc laid back in
   perspective; it turns once in 34s, the other way to the inventory's. */
.cos-stage__rune
{
	left: 30dp;
	top: 131dp;
	width: 112dp;
	height: 112dp;
	transform: perspective(240dp) rotateX(74deg);
}
.cos-stage__spin
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 112dp;
	height: 112dp;
	opacity: 0.55;
}
.cos-stage__spin.nui-anim
{
	animation: 34s linear-in-out infinite cos-rune-turn;
}
@keyframes cos-rune-turn
{
	from { transform: rotate(0deg); }
	to { transform: rotate(-360deg); }
}
.cos-stage__ring, .cos-stage__chord
{
	display: block;
	position: absolute;
	box-sizing: border-box;
}
.cos-stage__ring
{
	border-color: var(--accent-glow);
	border-radius: 9999dp;
}
.cos-stage__ring--outer
{
	left: 3dp;
	top: 3dp;
	width: 106dp;
	height: 106dp;
	border-width: 1dp;
}
.cos-stage__ring--glow
{
	left: 10dp;
	top: 10dp;
	width: 92dp;
	height: 92dp;
	border-width: 1dp;
	border-color: var(--accent);
}
.cos-stage__ring--inner
{
	left: 20dp;
	top: 20dp;
	width: 72dp;
	height: 72dp;
	border-width: 1dp;
}
/* The hexagram: six chords of the inner ring, each 18dp from the middle. */
.cos-stage__chord
{
	left: 25dp;
	top: 55.5dp;
	width: 62dp;
	height: 1dp;
	background-color: var(--accent-glow);
}
.cos-stage__chord--a { transform: rotate(0deg) translateY(18dp); }
.cos-stage__chord--b { transform: rotate(60deg) translateY(18dp); }
.cos-stage__chord--c { transform: rotate(120deg) translateY(18dp); }
.cos-stage__chord--d { transform: rotate(180deg) translateY(18dp); }
.cos-stage__chord--e { transform: rotate(240deg) translateY(18dp); }
.cos-stage__chord--f { transform: rotate(300deg) translateY(18dp); }
/* The empty frames on the left, as legacy's costume art paints them: an
   empty cell's look, but they hold nothing and take no pointer. */
.cos-stage__frame
{
	left: 11dp;
	width: 44dp;
	box-sizing: border-box;
	background-color: transparent;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 8dp;
}
.cos-stage__frame--a { top: 21dp; height: 92dp; }
.cos-stage__frame--b { top: 118dp; height: 44dp; }
.cos-stage__frame--c { left: 64dp; top: 150dp; height: 44dp; }
/* The foundation's table holds those places' cells (Wave 6): their marks
   replace the frames. */
body.cos.inv--table-old .cos-stage__frame
{
	display: none;
}
/* The marks of the three places no item takes (the costume weapon,
   accessory and ring): faint, 22dp, decoration only. */
.cos-stage__frame
{
	display: flex;
	align-items: center;
	justify-content: center;
}
.cos-stage__mark
{
	--glyph-ink: var(--text-muted);
	opacity: 0.5;
	transform: scale(1.375);
}
/* The design's sword lies across its frame, the guard to the upper right,
   its blade a thin line. */
.cos-stage__frame--a .cos-stage__mark
{
	transform: rotate(-135deg) scale(1.375);
}
.cos-stage__frame--a .cos-stage__mark .nui-glyph__a
{
	left: 7dp;
	width: 2dp;
}
.cos-stage__frame--a .cos-stage__mark .nui-glyph__b
{
	left: 4dp;
	top: 11dp;
	width: 8dp;
	height: 1.5dp;
}
/* No grip past the guard: the design's T ends the line. */
.cos-stage__frame--a .cos-stage__mark .nui-glyph__c
{
	display: none;
}
.cos-divider
{
	position: absolute;
	left: 0;
	top: 151dp;
	width: 100%;
	height: 1dp;
	background-color: var(--border);
}

/* A place by name: column c and row r on the 44dp pitch (left c x 44dp,
   top r x 44dp); a place the table in use lacks has no element. */
.cos-wear-place
{
	position: absolute;
	width: 40dp;
	height: 40dp;
}
.cos-wear--costume_body, .cos-wear--buffi_costume_body { height: 84dp; }
/* The stage's places (both tables, the design's): the hair and the body on
   the stage's right, today's ring at the figure's feet. */
body.cos.inv--table-new .cos-wear--costume_hair,
body.cos.inv--table-old .cos-wear--costume_hair { left: 115dp; top: 21dp; width: 44dp; height: 44dp; }
body.cos.inv--table-new .cos-wear--costume_body,
body.cos.inv--table-old .cos-wear--costume_body { left: 115dp; top: 85dp; width: 44dp; height: 86dp; }
body.cos.inv--table-new .cos-wear--ring1 { left: 64dp; top: 150dp; width: 44dp; height: 44dp; }
/* Wave 6 (the foundation's table): the weapon costume on frame a's place,
   the costume sash on frame b's (1dp higher) and the sash costume under
   it, 4dp apart, so the cells' shared 2dp outset leaves no dead zone
   between them; the aura on frame c's place, at the figure's feet; the
   hair and the body 4dp further right, so the stage's margins match and
   the aura stands more than 8dp from every neighbor (P14b). */
body.cos.inv--table-old .cos-wear--costume_weapon { left: 11dp; top: 21dp; width: 44dp; height: 92dp; }
body.cos.inv--table-old .cos-wear--costume_sash { left: 11dp; top: 117dp; width: 44dp; height: 44dp; }
body.cos.inv--table-old .cos-wear--costume_sash2 { left: 11dp; top: 165dp; width: 44dp; height: 44dp; }
body.cos.inv--table-old .cos-wear--costume_aura { left: 64dp; top: 150dp; width: 44dp; height: 44dp; }
body.cos.inv--table-old .cos-wear--costume_hair { left: 119dp; }
body.cos.inv--table-old .cos-wear--costume_body { left: 119dp; }
.cos-wear--costume_weapon, .cos-wear--buffi_costume_weapon { height: 128dp; }
.cos-wear--costume_hair { left: 0; top: 0; }
.cos-wear--costume_body { left: 44dp; top: 0; }
.cos-wear--ring1 { left: 88dp; top: 0; }
.cos-wear--costume_weapon { left: 88dp; top: 0; }
.cos-wear--costume_facial { left: 132dp; top: 0; }
.cos-wear--costume_aura { left: 176dp; top: 0; }
.cos-wear--costume_mount { left: 0; top: 44dp; }
.cos-wear--costume_sash2 { left: 132dp; top: 44dp; }
.cos-wear--costume_pet { left: 176dp; top: 44dp; }
.cos-wear--effect_weapon { left: 0; top: 88dp; }
.cos-wear--effect_armor { left: 44dp; top: 88dp; }
/* The companion's block, rows 4 to 6 under the divider. */
.cos-wear--buffi_costume_hair { left: 0; top: 176dp; }
.cos-wear--buffi_costume_body { left: 44dp; top: 176dp; }
.cos-wear--buffi_costume_weapon { left: 88dp; top: 176dp; }
.cos-wear--buffi_costume_facial { left: 132dp; top: 176dp; }
.cos-wear--buffi_costume_sash2 { left: 132dp; top: 220dp; }
.cos-wear--effect_weapon_1 { left: 0; top: 220dp; }
.cos-wear--effect_armor_1 { left: 44dp; top: 264dp; }
/* The names the other table holds in another window keep a place here too,
   so a table change needs no new rule (P14 spec 3.3). */
.cos-wear--costume_sash, .cos-wear--ring2, .cos-wear--belt { left: 132dp; top: 88dp; }

/* The design's cells are outlines the figure shows through; the hover, the
   drop footprint and the other states keep their fills (heavier rules). */
.cos-wear
{
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
	background-color: transparent;
	border-radius: 8dp;
}
.cos-wear .nui-slot__icon
{
	height: auto;
}
/* An empty Wave 6 place's mark (w.marks), as the stage's frames drew it:
   faint, 22dp, decoration only. */
.cos-wear .cos-wear__mark
{
	--glyph-ink: var(--text-muted);
	opacity: 0.5;
	transform: scale(1.375);
}
/* The weapon costume's sword lies across its cell, the guard to the upper
   right, its blade a thin line, as frame a's. */
.cos-wear--costume_weapon .cos-wear__mark
{
	transform: rotate(-135deg) scale(1.375);
}
.cos-wear--costume_weapon .cos-wear__mark .nui-glyph__a
{
	left: 7dp;
	width: 2dp;
}
.cos-wear--costume_weapon .cos-wear__mark .nui-glyph__b
{
	left: 4dp;
	top: 11dp;
	width: 8dp;
	height: 1.5dp;
}
.cos-wear--costume_weapon .cos-wear__mark .nui-glyph__c
{
	display: none;
}

/* --- The switches and the aura panel (Wave 6) ---------------------------------- */

/* Legacy's five switches under the stage, its width: three in the first
   row, two in the second, which share its width. */
.cos-switches
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	width: 176dp;
	gap: 4dp;
	margin-top: var(--space-2);
}
/* The small text keeps the widest label (Costume) clear of the edges. */
.cos-switch
{
	flex: 1 1 56dp;
	min-width: 0;
	padding: 0 2dp;
	font-size: var(--font-sm);
	text-align: center;
	white-space: nowrap;
}
/* The aura panel: a sunken panel under the switches, a toggle per flag. */
.cos-wing
{
	display: flex;
	flex-direction: column;
	gap: 6dp;
	box-sizing: border-box;
	width: 176dp;
	margin-top: var(--space-2);
	padding: 8dp 10dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 8dp;
}
.cos-wing__row
{
	display: flex;
	color: var(--text);
	font-size: var(--font-md);
}
.cos .nui-toggle__input
{
	tab-index: none;
}
