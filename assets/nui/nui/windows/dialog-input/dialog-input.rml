<rml>
<head>
	<!-- The input dialog of the dialog kit (controller:
	     assets/root/nui_dialog_input.py): uiCommon.InputDialog and the two
	     InputDialogWithDescription classes. A modal with a title bar, 0 to 2
	     lines of description and one field. The field's value never enters
	     the model: it reports every edit through change (ev.value), and
	     Enter there arrives as ev.linebreak. secret makes it a password
	     field. -->
	<title>dialog-input</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="dialog-input.rcss"/>
</head>
<body template="nui" class="nui-scrim dialog-input" data-model="dialog_input">
	<div class="nui-window nui-dialog nui-anim" id="dialog-input">
		<div class="nui-window__titlebar">
			<handle class="nui-window__handle" move_target="dialog-input">
				<span class="nui-window__title">{{ title }}</span>
			</handle>
			<button id="dialog-input-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim" data-event-click="cancel()">&#215;</button>
		</div>
		<div class="nui-window__body">
			<p class="nui-dialog__text" data-for="line : lines">{{ line }}</p>
			<input id="dialog-input-field" class="nui-input nui-dialog__field" data-attr-type="secret ? 'password' : 'text'" data-attr-maxlength="max" data-event-change="edit(ev.value, ev.linebreak)"/>
		</div>
		<div class="nui-window__footer nui-dialog__footer">
			<button id="dialog-input-cancel" class="nui-button nui-button--medium nui-anim" data-event-click="cancel()">@ui.CANCEL</button>
			<button id="dialog-input-accept" class="nui-button nui-button--medium nui-button--primary nui-anim" data-event-click="accept()">@ui.OK</button>
		</div>
	</div>
</body>
</rml>
