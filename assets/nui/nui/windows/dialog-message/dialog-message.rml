<rml>
<head>
	<!-- The message dialog of the dialog kit (controller:
	     assets/root/nui_dialog_message.py): uiCommon.PopupDialog and the phase
	     popup (networkModule.PopupDialog). A modal: the scrim centers the
	     dialog, and its one button has the focus on each show, so Enter
	     presses it. One document for every caller; the lines and the label
	     come from the model (caller text through nui.plain_text). The look is
	     components/dialog.rcss's, so the window has no sheet of its own (RmlUi
	     refuses a sheet without rules). -->
	<title>dialog-message</title>
	<link type="text/template" href="../../nui.rtpl"/>
</head>
<body template="nui" class="nui-scrim dialog-message" data-model="dialog_message">
	<div class="nui-window nui-dialog nui-anim" id="dialog-message">
		<div class="nui-window__titlebar" data-if="title != ''">
			<handle class="nui-window__handle" move_target="dialog-message">
				<span class="nui-window__title">{{ title }}</span>
			</handle>
		</div>
		<div class="nui-window__body">
			<p class="nui-dialog__text" data-for="line : lines">{{ line }}</p>
		</div>
		<div class="nui-window__footer nui-dialog__footer">
			<button id="dialog-message-accept" class="nui-button nui-button--medium nui-button--primary nui-anim" autofocus="autofocus" data-event-click="accept()">{{ button }}</button>
		</div>
	</div>
</body>
</rml>
