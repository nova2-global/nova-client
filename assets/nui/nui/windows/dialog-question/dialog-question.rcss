/* The question dialog (nui_dialog_question.py). The width and the centered
   text and footer come from components/dialog.rcss; the scrim centers it. */

/* --- Classic skin ------------------------------------------------------------
   The legacy question (uiscript questiondialog.py): the message about 38dp
   below the top of the stone board, the two middle buttons 63dp below it,
   18dp apart, 21dp above the bottom edge. */
body.skin-classic.dialog-question .nui-window__body
{
	padding: 31dp 16dp 0dp 16dp;
}
body.skin-classic.dialog-question .nui-window__footer
{
	padding: 12dp 16dp 21dp 16dp;
	gap: 18dp;
}
