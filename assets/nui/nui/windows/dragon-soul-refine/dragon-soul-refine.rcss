/* The dragon soul refine window's modern look (P15 spec 6.2, restyled to
   the reviewed design): a 380dp window opened where legacy opens it, beside
   the dragon soul window's left edge with its top on that window's top
   (dragon-soul.rcss: 246dp from the screen's right, 392dp wide and 693dp
   tall with its border, above the 37dp strip; this one is 345dp tall, so
   638dp from the right and 37 + 693 - 345dp from the bottom; legacy: 287
   left of the dragon soul window, the two tops at H - 37 - 505). The two
   fit side by side beside the inventory on a 1024 wide screen. In legacy's order from the top:
   - a sunken well with the material cells, 5 x 3 on the 44dp pitch (a
     placed item, the recipe's ghost at half alpha with no count (is-ghost),
     a closed cell at or past the recipe's count, hatched and dimmed with
     the lock glyph (is-closed, components/slot-grid.rcss)), the arrow and
     the result cells, 2 x 3;
   - the three mode choices (grade, step, strength) as a segmented well,
     the mode in use raised;
   - the fee in a sunken bar with the coin, and the primary refine button
     at the lower right.
   Classic (legacy's 287 x 232 board with its picture, the closed cells'
   cap and the buttons' art at 100%): skins/classic/windows/dragon-soul-refine.rcss. */

body.dsr
{
	right: 638dp;
	bottom: 385dp;
	width: 380dp;
	min-width: 0;
	focus: none;
	tab-index: none;
}
/* Placed from Python (where the player left it). */
body.dsr.dsr--placed
{
	right: auto;
	bottom: auto;
}
.dsr button
{
	tab-index: none;
}
/* The board's picture is classic's. */
.dsr-bg
{
	display: none;
}
/* The title's icon chip. */
.dsr-title-icon
{
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 24dp;
	height: 24dp;
	margin-right: 6dp;
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	background-color: var(--selection);
}
.dsr-title-icon .nui-glyph
{
	--glyph-ink: var(--accent);
	transform: scale(0.8);
}
.dsr__body
{
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	padding: var(--space-3);
}

/* --- The cells --------------------------------------------------------------------- */

.dsr-main
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 356dp;
	padding: 10dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 11dp;
}
.dsr-cells, .dsr-result
{
	flex: 0 0 auto;
}
/* A closed cell: the component's dimmed look, hatched. */
.dsr-cell.is-closed, .dsr-cell.is-closed:hover
{
	decorator: repeating-linear-gradient(135deg, transparent 0dp, transparent 5dp, var(--border) 5dp, var(--border) 10dp);
}
.dsr-arrow
{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	flex: 1 1 auto;
	min-width: 0;
	height: 24dp;
	white-space: nowrap;
	pointer-events: none;
}
.dsr-arrow .nui-glyph
{
	--glyph-ink: var(--accent);
	margin: 0 -3dp;
	transform: scale(1.3);
}

/* --- The modes: a segmented well, the mode in use raised ------------------------------ */

.dsr-modes
{
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	box-sizing: border-box;
	gap: 2dp;
	width: 356dp;
	margin-top: 14dp;
	padding: 3dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 9dp;
}
.dsr-mode-place
{
	display: flex;
	flex: 1 1 auto;
	min-width: 0;
}
.dsr-mode
{
	flex: 1 1 auto;
	min-width: 0;
	height: 24dp;
	padding: 0 var(--space-2);
	line-height: 22dp;
	white-space: nowrap;
}
.dsr-modes .dsr-mode
{
	border-color: transparent;
	border-radius: 6dp;
	background-color: transparent;
	color: var(--text-muted);
}
.dsr-modes .dsr-mode:hover
{
	background-color: var(--surface-hover);
	color: var(--text);
}
.dsr-modes .dsr-mode.is-selected
{
	background-color: var(--surface-raised);
	border-color: var(--border);
	color: var(--text);
}
.dsr-mode__label, .dsr-refine__label
{
	pointer-events: none;
}

/* --- The fee and the refine button -------------------------------------------------- */

.dsr-foot
{
	display: flex;
	flex-direction: column;
	align-items: stretch;
	flex: 0 0 auto;
	width: 356dp;
	margin-top: 10dp;
}
.dsr-fee
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 38dp;
	gap: var(--space-2);
	padding: 0 10dp 0 var(--space-2);
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: var(--radius-lg);
}
.dsr-fee__coin
{
	--glyph-ink: var(--warning);
	flex: 0 0 auto;
	margin: 0 4dp;
}
.dsr-fee__amount
{
	flex: 1 1 auto;
	min-width: 0;
	color: var(--text);
	font-size: 13dp;
	font-weight: bold;
	text-align: right;
	white-space: nowrap;
	overflow: hidden;
}
.dsr-refine
{
	align-self: flex-end;
	min-width: 108dp;
	margin-top: 10dp;
}
