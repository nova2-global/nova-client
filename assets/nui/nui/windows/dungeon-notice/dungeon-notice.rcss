/* The dungeon ready notice (NOVA-25): legacy's 150 x 50 boxes, 150dp from
   the top, centered and stacked 50dp apart, each with the dungeon's name
   over "Available" (legacy's half-black box; here a tile).
   The timers draw nothing. Classic: skins/classic/windows/dungeon-notice.rcss. */

body.dungeon-notice
{
	width: 100%;
	height: 100%;
}
.dungeon-notice__timers, .dungeon-notice__timer
{
	display: none;
}
.dungeon-notice__stack
{
	position: absolute;
	left: 0;
	top: 150dp;
	width: 100%;
}
.dungeon-notice__box
{
	display: block;
	box-sizing: border-box;
	width: 170dp;
	height: 50dp;
	margin: 0 auto;
	padding-top: 7dp;
}
.dungeon-notice__title
{
	display: block;
	text-align: center;
	color: var(--accent);
	font-size: var(--font-sm);
	font-weight: bold;
}
.dungeon-notice__text
{
	display: block;
	text-align: center;
	color: var(--success);
	font-size: var(--font-sm);
}
