/* The dungeon manager, direction D "Bestiary" (the D-bestiary board,
   820 x 540): a deck of boss cards over the front dungeon's details, its
   merged drops and Run or Practice. A card's place is a slot class (the
   design's sizes, offsets, opacity and wrap-around) and its move a
   transition. Classic: skins/classic/windows/dungeon-timer.rcss. */

body.dungeon-timer
{
	left: 16dp;
	top: 16dp;
	width: 820dp;
	height: 540dp;
	min-width: 0;
	focus: none;
	tab-index: none;
}
.dungeon-timer button
{
	tab-index: none;
	focus: none;
}
.dungeon-timer__titlebar
{
	height: 40dp;
}
.dungeon-timer__body
{
	display: flex;
	flex-direction: column;
	height: 500dp;
	padding: 0;
}
/* --- the deck ------------------------------------------------------------- */
.dungeon-timer__deck
{
	position: relative;
	flex: 0 0 322dp;
	height: 322dp;
	overflow: hidden;
}
.dungeon-timer__card
{
	display: flex;
	flex-direction: column;
	position: absolute;
	box-sizing: border-box;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 10dp;
	background-color: var(--surface-raised);
	text-align: center;
	overflow: hidden;
}
.dungeon-timer__card.nui-anim
{
	transition: left top width height opacity 0.3s cubic-out;
}
.dungeon-timer__card--c { left: 306dp; top: 13dp; width: 206dp; height: 296dp; opacity: 1; z-index: 10; border-color: var(--accent); }
.dungeon-timer__card--r1 { left: 514dp; top: 54dp; width: 150dp; height: 214dp; opacity: 0.8; z-index: 6; }
.dungeon-timer__card--l1 { left: 154dp; top: 54dp; width: 150dp; height: 214dp; opacity: 0.8; z-index: 6; }
.dungeon-timer__card--r2 { left: 667dp; top: 81dp; width: 112dp; height: 160dp; opacity: 0.5; z-index: 3; }
.dungeon-timer__card--l2 { left: 39dp; top: 81dp; width: 112dp; height: 160dp; opacity: 0.5; z-index: 3; }
.dungeon-timer__card--r3 { left: 784dp; top: 97dp; width: 90dp; height: 128dp; opacity: 0; z-index: 1; visibility: hidden; }
.dungeon-timer__card--l3 { left: -56dp; top: 97dp; width: 90dp; height: 128dp; opacity: 0; z-index: 1; visibility: hidden; }
.dungeon-timer__card--out { display: none; }
/* A hidden card, shown by the chip: fainter off the front, and dashed. RCSS has
   no dashed border, so the card's edge is four strips of short strokes. */
.dungeon-timer__card.is-hidden
{
	border-color: transparent;
}
.dungeon-timer__dash
{
	display: block;
	position: absolute;
	z-index: 1;
}
.dungeon-timer__dash--t, .dungeon-timer__dash--b
{
	left: 0;
	right: 0;
	height: 1dp;
	decorator: repeating-linear-gradient(90deg, var(--text-muted) 0dp, var(--text-muted) 4dp, transparent 4dp, transparent 8dp);
}
.dungeon-timer__dash--l, .dungeon-timer__dash--r
{
	top: 0;
	bottom: 0;
	width: 1dp;
	decorator: repeating-linear-gradient(0deg, var(--text-muted) 0dp, var(--text-muted) 4dp, transparent 4dp, transparent 8dp);
}
.dungeon-timer__dash--t { top: 0; }
.dungeon-timer__dash--b { bottom: 0; }
.dungeon-timer__dash--l { left: 0; }
.dungeon-timer__dash--r { right: 0; }
.dungeon-timer__card--r1.is-hidden, .dungeon-timer__card--l1.is-hidden { opacity: 0.48; }
.dungeon-timer__card--r2.is-hidden, .dungeon-timer__card--l2.is-hidden { opacity: 0.3; }
.dungeon-timer__art
{
	display: block;
	position: relative;
	flex: 1 1 auto;
	min-height: 0;
	background-color: var(--scene);
	overflow: hidden;
}
/* The boss: one view size (its render target), scaled by the card's slot. */
.dungeon-timer__view
{
	position: absolute;
	left: 50%;
	top: 4dp;
	width: 206dp;
	height: 252dp;
	margin-left: -103dp;
	transform-origin: 50% 0;
}
.dungeon-timer__view.nui-anim
{
	transition: transform 0.3s cubic-out;
}
.dungeon-timer__card--r1 .dungeon-timer__view,
.dungeon-timer__card--l1 .dungeon-timer__view { transform: scale(0.68); }
.dungeon-timer__card--r2 .dungeon-timer__view,
.dungeon-timer__card--l2 .dungeon-timer__view { transform: scale(0.47); }
.dungeon-timer__card--r3 .dungeon-timer__view,
.dungeon-timer__card--l3 .dungeon-timer__view { transform: scale(0.34); }
/* NOVA-256: a boss made after its card showed (not warmed in time) fades in; a card without its
   boss shows its plain background, no placeholder. */
.dungeon-timer__view--fade.nui-anim
{
	animation: 0.15s linear-in-out dungeon-timer-view-in;
}
@keyframes dungeon-timer-view-in
{
	from { opacity: 0; }
	to { opacity: 1; }
}
.dungeon-timer__badge
{
	position: absolute;
	left: 6dp;
	top: 6dp;
	padding: 1dp 8dp;
	border-radius: 9dp;
	background-color: var(--cooldown-shade);
	font-size: var(--font-sm);
	font-weight: bold;
	white-space: nowrap;
}
.dungeon-timer__badge--ready, .dungeon-timer__badge--hidden { color: var(--dungeon-badge-ready); }
.dungeon-timer__badge--cd { color: var(--dungeon-badge-cooldown); }
.dungeon-timer__cap
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	padding: 6dp 8dp 8dp;
}
.dungeon-timer__cap-name
{
	display: block;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
	color: var(--text);
	font-weight: bold;
}
.dungeon-timer__cap-level
{
	display: block;
	color: var(--text-muted);
	font-size: var(--font-sm);
}
/* The eye on the front card, the chip and the arrows. */
.dungeon-timer__hide
{
	position: absolute;
	left: 478dp;
	top: 19dp;
	box-sizing: border-box;
	width: 28dp;
	height: 28dp;
	padding: 6dp;
	border-width: 0;
	border-radius: 14dp;
	background-color: var(--cooldown-shade);
	z-index: 15;
}
.dungeon-timer__hide .nui-glyph
{
	--glyph-ink: var(--text-inverse);
}
.dungeon-timer__hide.is-locked
{
	opacity: 0.4;
	pointer-events: none;
}
.dungeon-timer__chip
{
	position: absolute;
	right: 12dp;
	top: 10dp;
	height: 24dp;
	padding: 0 12dp;
	border-width: 1dp;
	border-color: transparent;
	border-radius: 12dp;
	background-color: var(--surface-sunken);
	color: var(--text-muted);
	font-weight: bold;
	line-height: 22dp;
	z-index: 20;
}
.dungeon-timer__chip.is-on
{
	border-color: var(--accent);
	background-color: var(--selection);
	color: var(--text);
}
.dungeon-timer__arrow
{
	position: absolute;
	top: 141dp;
	width: 36dp;
	height: 40dp;
	padding: 12dp 10dp;
	box-sizing: border-box;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 4dp;
	background-color: var(--surface-raised);
	z-index: 20;
}
.dungeon-timer__arrow--prev { left: 12dp; }
.dungeon-timer__arrow--next { right: 12dp; }
.dungeon-timer__arrow:hover { background-color: var(--surface-hover); }
.dungeon-timer__empty
{
	position: absolute;
	left: 0;
	right: 0;
	top: 140dp;
	margin: 0;
	color: var(--danger);
	text-align: center;
}
/* --- the details, the drops and the actions -------------------------------- */
.dungeon-timer__pane
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	gap: 16dp;
	min-height: 0;
	margin: 0 12dp 12dp;
	padding: 10dp 12dp;
	border-radius: 6dp;
}
.dungeon-timer__col
{
	display: flex;
	flex-direction: column;
	min-width: 0;
}
.dungeon-timer__col--details { flex: 0 0 210dp; gap: 6dp; }
.dungeon-timer__col--drops { flex: 1 1 auto; gap: 6dp; }
.dungeon-timer__col--actions { flex: 0 0 190dp; gap: 8dp; }
.dungeon-timer__head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 8dp;
}
.dungeon-timer__name
{
	flex: 1 1 auto;
	min-width: 0;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
	color: var(--accent);
	font-size: 15dp;
	font-weight: bold;
}
.dungeon-timer__wiki
{
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 5dp;
	height: 24dp;
	min-width: 0;
	padding: 0 8dp;
}
.dungeon-timer__wiki .nui-glyph { width: 14dp; height: 14dp; }
.dungeon-timer__boss
{
	margin: 0;
	color: var(--text-muted);
	font-size: var(--font-sm);
}
.dungeon-timer__facts
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 6dp 10dp;
}
.dungeon-timer__fact
{
	flex: 0 0 100dp;
	min-width: 0;
}
.dungeon-timer__label
{
	display: block;
	color: var(--text-muted);
	font-size: var(--font-sm);
}
.dungeon-timer__value
{
	display: block;
	color: var(--text);
	font-weight: bold;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.dungeon-timer__ticket
{
	flex: 0 0 auto;
	width: 32dp;
	height: 32dp;
	margin-top: 2dp;
}
.dungeon-timer__drops-head
{
	margin: 0;
	color: var(--text);
	font-weight: bold;
}
.dungeon-timer__drops-count
{
	color: var(--text-muted);
	font-size: var(--font-sm);
	font-weight: normal;
}
.dungeon-timer__filters
{
	display: flex;
	flex-direction: row;
	gap: 4dp;
}
.dungeon-timer__filter
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6dp;
	height: 24dp;
	padding: 0 10dp;
	box-sizing: border-box;
	border-width: 1dp;
	border-color: transparent;
	border-radius: 12dp;
	background-color: var(--surface-sunken);
	color: var(--text-muted);
	font-weight: bold;
	white-space: nowrap;
}
.dungeon-timer__filter.is-on
{
	border-color: var(--accent);
	background-color: var(--selection);
	color: var(--text);
}
.dungeon-timer__filter-dot
{
	display: block;
	flex: 0 0 auto;
	width: 7dp;
	height: 7dp;
	border-radius: 4dp;
}
.dungeon-timer__filter--guaranteed .dungeon-timer__filter-dot { background-color: var(--success); }
.dungeon-timer__filter--common .dungeon-timer__filter-dot { background-color: var(--accent); }
.dungeon-timer__filter--rare .dungeon-timer__filter-dot { background-color: var(--warning); }
.dungeon-timer__note
{
	display: block;
	margin: 0;
	min-height: 24dp;
	box-sizing: border-box;
	padding: 4dp 8dp;
	border-width: 1dp;
	border-color: var(--accent);
	border-radius: 4dp;
	background-color: var(--selection);
	color: var(--text);
	font-size: var(--font-sm);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
.dungeon-timer__drop-grid
{
	display: flex;
	flex: 0 0 84dp;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	gap: 4dp;
	height: 84dp;
	min-height: 0;
	padding-right: 6dp;
	overflow-y: auto;
}
.dungeon-timer__drop-grid.is-dim
{
	opacity: 0.3;
}
/* A cell is the whole item: .nui-slot's hit outset covers half the 4dp gap and
   the band shows along its bottom, so the grid has no dead zones. */
.dungeon-timer__drop
{
	flex: 0 0 36dp;
	box-sizing: border-box;
	width: 36dp;
	height: 36dp;
	border-bottom-width: 2dp;
}
.dungeon-timer__drop .nui-slot__icon
{
	max-width: 32dp;
	max-height: 32dp;
}
.dungeon-timer__drop--guaranteed { border-bottom-color: var(--success); }
.dungeon-timer__drop--common { border-bottom-color: var(--accent); }
.dungeon-timer__drop--rare { border-bottom-color: var(--warning); }
.dungeon-timer__drops-note
{
	flex: 1 1 100%;
	margin: 6dp 0 0;
	color: var(--text-muted);
	font-size: var(--font-sm);
	text-align: center;
}
.dungeon-timer__hidden-clock
{
	display: none;
}
.dungeon-timer__seg
{
	display: flex;
	flex-direction: row;
	flex: 0 0 28dp;
	box-sizing: border-box;
	height: 28dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 4dp;
	overflow: hidden;
}
.dungeon-timer__seg-button
{
	flex: 1 1 0;
	border-width: 0 0 2dp;
	border-color: transparent;
	background-color: transparent;
	color: var(--text-muted);
	font-weight: bold;
	text-align: center;
	line-height: 26dp;
}
.dungeon-timer__seg-button.is-on
{
	border-color: var(--accent);
	background-color: var(--selection);
	color: var(--text);
}
.dungeon-timer__go
{
	flex: 0 0 34dp;
	height: 34dp;
	min-width: 0;
	padding: 0;
	text-align: center;
	line-height: 34dp;
}
.dungeon-timer__go[disabled]
{
	opacity: 0.55;
}
.dungeon-timer__go-clock
{
	margin-left: 4dp;
}
.dungeon-timer__notice
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 7dp;
	border-width: 0;
	background-color: transparent;
	color: var(--text);
	white-space: nowrap;
}
.dungeon-timer__notice-box
{
	display: block;
	position: relative;
	box-sizing: border-box;
	flex: 0 0 15dp;
	width: 15dp;
	height: 15dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 4dp;
	background-color: var(--surface-sunken);
}
.dungeon-timer__notice.is-checked .dungeon-timer__notice-box
{
	border-color: var(--accent);
	background-color: var(--accent);
}
.dungeon-timer__notice-mark
{
	display: none;
	position: absolute;
	left: 4dp;
	top: 1dp;
	width: 4dp;
	height: 7dp;
	border-width: 0 2dp 2dp 0;
	border-color: var(--accent-text);
	transform: rotate(45deg);
}
.dungeon-timer__notice.is-checked .dungeon-timer__notice-mark
{
	display: block;
}
.dungeon-timer__ranks
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4dp;
}
.dungeon-timer__ranks-label
{
	flex: 0 0 30dp;
}
.dungeon-timer__rank
{
	flex: 1 1 0;
	min-width: 0;
	height: 28dp;
	padding: 0;
	text-align: center;
	line-height: 26dp;
	white-space: nowrap;
}
