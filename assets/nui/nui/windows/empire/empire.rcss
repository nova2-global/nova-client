/* Empire select: full screen and opaque. Positions are the legacy screen
   fractions and sizes the legacy pixels in dp (uiscript
   selectempirewindow.py): the title at (237/800, 46/600), the atlas
   (495 by 357) at (282/800, 170/600) with its areas and area flags at their
   legacy offsets, the arrows under the atlas at its legacy offsets
   (160, 340) and (290, 340), and the board, 208dp wide, at 40/800 from the
   left with its bottom where the legacy board's was (75/600 above the
   bottom edge), so a tall scale keeps its buttons on the screen. The
   modern backdrop is the scene color with a 42dp band along the top and the
   bottom that fades from the scene's band color (two-color vertex gradients,
   no shader). The scene is dark in every palette: the locale's title art
   holds its subtitle in white, made for legacy's dark backdrop. Classic draws the legacy pattern between the legacy line
   strips, under the legacy shade (skins/classic/windows/empire.rcss). */
body.empire
{
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: var(--scene);
}

.empire-pattern
{
	position: absolute;
	left: 0dp;
	top: 42dp;
	right: 0dp;
	bottom: 42dp;
}
.empire-shade
{
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
}
.empire-line
{
	position: absolute;
	left: 0dp;
	width: 100%;
	height: 42dp;
}
.empire-line--top
{
	top: 0dp;
	decorator: vertical-gradient(var(--scene-band) transparent);
}
.empire-line--bottom
{
	bottom: 0dp;
	decorator: vertical-gradient(transparent var(--scene-band));
}

.empire-title
{
	position: absolute;
	left: 29.625%;
	top: 7.67%;
}

.empire-atlas
{
	position: absolute;
	left: 35.25%;
	top: 28.33%;
	width: 495dp;
	height: 357dp;
	decorator: image("d:/ymir work/ui/intro/empire/atlas.sub");
}
/* An area and its flag show while lit; otherwise they are clear (and an area
   still takes the pointer, as the legacy area button over it did). */
.empire-area, .empire-area-flag
{
	position: absolute;
	opacity: 0;
}
.empire-area.is-lit, .empire-area-flag.is-lit
{
	opacity: 1;
}
/* Small single images, so the fade rebuilds only their own quads. */
.empire-area.nui-anim, .empire-area-flag.nui-anim
{
	transition: opacity 0.3s cubic-out;
}
.empire-area-flag
{
	pointer-events: none;
}
.empire-area--a
{
	left: 43dp;
	top: 201dp;
}
.empire-area--b
{
	left: 17dp;
	top: 16dp;
}
.empire-area--c
{
	left: 314dp;
	top: 33dp;
}
.empire-area-flag--a
{
	left: 167dp;
	top: 235dp;
}
.empire-area-flag--b
{
	left: 70dp;
	top: 42dp;
}
.empire-area-flag--c
{
	left: 357dp;
	top: 78dp;
}

/* Modern arrows: icon buttons centered on the legacy arrow art (82 by 28). */
.empire-arrow
{
	position: absolute;
	top: 338dp;
}
.empire-arrow--left
{
	left: 185dp;
}
.empire-arrow--right
{
	left: 315dp;
}

.empire-board
{
	position: absolute;
	left: 5%;
	bottom: 12.5%;
	width: 208dp;
	min-width: 0dp;
	box-sizing: border-box;
}
.empire-flag-bar
{
	display: flex;
	align-items: center;
	justify-content: center;
	width: 159dp;
	height: 119dp;
	margin: var(--space-3) auto 0dp auto;
	background-color: var(--surface-sunken);
	border-radius: var(--radius-md);
}
.empire-name
{
	margin: var(--space-2) var(--space-3);
	text-align: center;
	font-weight: bold;
}
/* The description scrolls in a square box (the scissor clips it). */
.empire-text
{
	box-sizing: border-box;
	height: 122dp;
	margin: 0dp var(--space-3) var(--space-3) var(--space-3);
	padding: var(--space-1) var(--space-2);
	overflow-y: auto;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	font-size: var(--font-sm);
}
.empire-text__paragraph
{
	margin-bottom: var(--space-2);
}
.empire-footer
{
	justify-content: center;
}
