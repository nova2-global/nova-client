/* Empire select: full screen and opaque. Positions are the legacy screen
   fractions and sizes the legacy pixels in dp (uiscript
   selectempirewindow.py): the title at (237/800, 46/600), the atlas
   (495 by 357) at (282/800, 170/600) with its areas and area flags at their
   legacy offsets, the arrows under the atlas at its legacy offsets
   (160, 340) and (290, 340), and the board, 208dp wide, at 40/800 from the
   left with its bottom where the legacy board's was (75/600 above the
   bottom edge), so a tall scale keeps its buttons on the screen. The
   modern backdrop is the scene color with a 42dp band along the top and the
   bottom that fades from the scene's band color (two-color vertex gradients,
   no shader). The scene is dark in every palette: the locale's title art
   holds its subtitle in white, made for legacy's dark backdrop. Classic draws the legacy pattern between the legacy line
   strips, under the legacy shade (skins/classic/windows/empire.rcss).

   Modern (the reviewed design, stage 1): a soft accent glow behind the
   atlas; a 260dp panel with the flag in a well across it, the kingdom's
   name, the description in a rounded well (the box inside scrolls and
   stays square), Exit and Choose as wide as each other; the arrows as
   round outlined buttons with chevrons, light on the dark scene in every
   palette, the accent under the pointer. */
body.empire
{
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: var(--scene);
}

.empire-pattern
{
	position: absolute;
	left: 0dp;
	top: 42dp;
	right: 0dp;
	bottom: 42dp;
}
.empire-shade
{
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	decorator: radial-gradient(50% 55% at 55% 52%, var(--accent-glow) 0%, transparent 100%);
	opacity: 0.35;
}
.empire-line
{
	position: absolute;
	left: 0dp;
	width: 100%;
	height: 42dp;
}
.empire-line--top
{
	top: 0dp;
	decorator: vertical-gradient(var(--scene-band) transparent);
}
.empire-line--bottom
{
	bottom: 0dp;
	decorator: vertical-gradient(transparent var(--scene-band));
}

.empire-title
{
	position: absolute;
	left: 29.625%;
	top: 7.67%;
}

.empire-atlas
{
	position: absolute;
	left: 35.25%;
	top: 28.33%;
	width: 495dp;
	height: 357dp;
	decorator: image("d:/ymir work/ui/intro/empire/atlas.sub");
}
/* An area and its flag show while lit; otherwise they are clear (and an area
   still takes the pointer, as the legacy area button over it did). */
.empire-area, .empire-area-flag
{
	position: absolute;
	opacity: 0;
}
.empire-area.is-lit, .empire-area-flag.is-lit
{
	opacity: 1;
}
/* Small single images, so the fade rebuilds only their own quads. */
.empire-area.nui-anim, .empire-area-flag.nui-anim
{
	transition: opacity 0.3s cubic-out;
}
.empire-area-flag
{
	pointer-events: none;
}
.empire-area--a
{
	left: 43dp;
	top: 201dp;
}
.empire-area--b
{
	left: 17dp;
	top: 16dp;
}
.empire-area--c
{
	left: 314dp;
	top: 33dp;
}
.empire-area-flag--a
{
	left: 167dp;
	top: 235dp;
}
.empire-area-flag--b
{
	left: 70dp;
	top: 42dp;
}
.empire-area-flag--c
{
	left: 357dp;
	top: 78dp;
}

/* Modern arrows: round outlined buttons centered on the legacy arrow art
   (82 by 28 at (160, 340) and (290, 340)). */
.empire-arrow
{
	position: absolute;
	top: 336dp;
	width: 36dp;
	height: 36dp;
	padding: 0dp;
	border-radius: 18dp;
	background-color: var(--scene-band);
	border-color: var(--sheen);
	line-height: 34dp;
}
.empire-arrow .nui-glyph
{
	--glyph-ink: var(--text-inverse);
}
.empire-arrow:hover
{
	background-color: var(--scene-band);
	border-color: var(--accent);
}
.empire-arrow:hover .nui-glyph
{
	--glyph-ink: var(--accent);
}
.empire-arrow--left
{
	left: 183dp;
}
.empire-arrow--right
{
	left: 313dp;
}
.empire-board
{
	position: absolute;
	left: 5%;
	bottom: 12.5%;
	width: 260dp;
	min-width: 0dp;
	box-sizing: border-box;
	padding: 12dp 12dp 0dp 12dp;
}
.empire-flag-bar
{
	display: flex;
	align-items: center;
	justify-content: center;
	height: 112dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 10dp;
}
.empire-name
{
	margin: 10dp 0dp;
	text-align: center;
	font-size: 15dp;
	font-weight: bold;
}
.empire-well
{
	padding: 8dp 4dp 8dp 10dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 10dp;
}
/* The description scrolls in a square box (the scissor clips it). */
.empire-text
{
	box-sizing: border-box;
	height: 168dp;
	padding: 0dp 8dp 0dp 0dp;
	overflow-y: auto;
	color: var(--text-muted);
	font-size: var(--font-sm);
}
.empire-text__paragraph
{
	margin-bottom: var(--space-2);
}
.empire-footer
{
	gap: 8dp;
	margin: 12dp -12dp 0dp -12dp;
	padding: 12dp;
}
.empire-button
{
	flex: 1 1 0dp;
}
.empire-action
{
	height: 34dp;
	line-height: 32dp;
}
