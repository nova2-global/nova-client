/* The exchange's modern look (P16 spec 5.1.2; the reviewed mockup WExchange,
   grown to wave 4b's window, NOVA-12): two columns, the partner left and
   the player right as legacy, each headed by its face in a round well (the
   player's ring in the accent) beside the partner's name and level chip or
   "You", then a 6 x 4 lean grid on the 44dp pitch in raised wells (their
   edges in the success color while that side accepted, legacy's green
   slot base), then a money pill (the coin glyph, the amount bold at its
   right) and a lamp (a ring in a 28dp well, its core lit and glowing in
   the success color when that side accepted); an accent-ended rule between
   the columns; under both, the history's three lines in a sunken panel
   and the accept button at its right; the trade
   emblem (two arrows) before the title. The controller centers it at its
   first show and keeps the place the player drags it to; the sheet's place
   frames it in its snapshots. Classic (legacy's 442 x 307 board, the face
   frames, the middle bar, the parameter slot art under each amount, the
   lamps' art, the small button and the history's thin board):
   skins/classic/windows/exchange.rcss. */

body.exchange
{
	left: 16dp;
	top: 16dp;
	width: 577dp;
	min-width: 0;
	focus: none;
	tab-index: none;
}
.exchange button
{
	tab-index: none;
	focus: none;
}
/* The title's emblem: an accent chip with two arrows passing each other. */
.exchange__title-icon
{
	display: inline-block;
	position: relative;
	box-sizing: border-box;
	width: 24dp;
	height: 24dp;
	margin-right: var(--space-2);
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	background-color: var(--selection);
	vertical-align: middle;
}
.exchange__arrow
{
	display: block;
	position: absolute;
	width: 11dp;
	height: 2dp;
	background-color: var(--accent);
}
.exchange__arrow--out
{
	left: 4dp;
	top: 6dp;
}
.exchange__arrow--in
{
	right: 4dp;
	bottom: 6dp;
}
.exchange__arrow-head
{
	display: block;
	position: absolute;
	top: -2dp;
	width: 0;
	height: 0;
}
.exchange__arrow--out .exchange__arrow-head
{
	right: -3dp;
	border-width: 3dp 0 3dp 4dp;
	border-color: transparent transparent transparent var(--accent);
}
.exchange__arrow--in .exchange__arrow-head
{
	left: -3dp;
	border-width: 3dp 4dp 3dp 0;
	border-color: transparent var(--accent) transparent transparent;
}
.exchange__body
{
	display: flex;
	flex-direction: column;
	gap: var(--space-3);
	padding: 10dp 12dp 12dp;
}
.exchange__sides
{
	display: flex;
	flex-direction: row;
	align-items: stretch;
	gap: var(--space-3);
}
.exchange__side
{
	display: flex;
	flex: 0 0 264dp;
	flex-direction: column;
	gap: var(--space-2);
	min-width: 0;
}
/* The head: the face in a round well (legacy's box_face frame), the name
   over the level chip, or "You" in the accent. */
.exchange__head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: var(--space-2);
	height: 48dp;
}
.exchange__face
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 44dp;
	height: 44dp;
	border-width: 2dp;
	border-color: var(--border);
	border-radius: 22dp;
	background-color: var(--surface-sunken);
}
.exchange__face--owner
{
	border-color: var(--accent);
}
/* A round clip (a stencil mask while the window shows). */
.exchange__face-clip
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 40dp;
	height: 40dp;
	overflow: hidden;
	border-radius: 20dp;
	pointer-events: none;
}
.exchange__face-image
{
	position: absolute;
	left: 0;
	top: 0;
	width: 40dp;
	height: 40dp;
}
.exchange__who
{
	display: flex;
	flex: 1 1 auto;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-1);
	min-width: 0;
	pointer-events: none;
}
.exchange__name
{
	display: block;
	color: var(--text);
	font-size: var(--font-md);
	font-weight: bold;
	white-space: nowrap;
}
.exchange__name--you
{
	color: var(--accent);
}
.exchange__level
{
	display: block;
	box-sizing: border-box;
	height: 17dp;
	padding: 0 6dp;
	border-radius: 6dp;
	background-color: var(--selection);
	color: var(--accent);
	font-size: var(--font-xs);
	font-weight: bold;
	line-height: 17dp;
	white-space: nowrap;
}
/* The trade grids' wells: the raised fill under every resting cell (one
   decorator for the grid, as the component's). */
.exchange__grid
{
	decorator: nui-cells(40dp 4dp 7dp var(--surface-hover) var(--border) 1dp);
}
/* An accepted side's wells: legacy's green slot base as their edges. */
.exchange__grid.is-accepted
{
	decorator: nui-cells(40dp 4dp 7dp var(--surface-hover) var(--success) 1dp);
}
.exchange__divider
{
	flex: 0 0 1dp;
	width: 1dp;
	decorator: linear-gradient(180deg, transparent 0%, var(--accent-glow) 15%, var(--border) 50%, var(--accent-glow) 85%, transparent 100%);
}
.exchange__row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: var(--space-2);
	height: 28dp;
}
/* The amount: legacy's dotted text, bold at the right of a sunken pill; the
   player's is a button that opens the money input. */
.exchange__money
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 auto;
	box-sizing: border-box;
	height: 28dp;
	padding: 0 9dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 7dp;
}
.exchange__money--owner:hover
{
	border-color: var(--accent);
}
.exchange__coin
{
	--glyph-ink: var(--warning);
}
.exchange__amount
{
	flex: 1 1 auto;
	color: var(--text);
	font-size: var(--font-md);
	font-weight: bold;
	text-align: right;
	white-space: nowrap;
	pointer-events: none;
}
/* The lamp: a ring in a sunken well, its core muted, or the success color
   with a static glow while that side accepted; a state, no motion. */
.exchange__light
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 28dp;
	height: 28dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 8dp;
	background-color: var(--surface-sunken);
}
.exchange__light-ring
{
	display: block;
	position: absolute;
	left: 4dp;
	top: 4dp;
	box-sizing: border-box;
	width: 18dp;
	height: 18dp;
	border-width: 1dp;
	border-color: var(--surface-hover);
	border-radius: 9dp;
	pointer-events: none;
}
.exchange__light-core
{
	display: block;
	position: absolute;
	left: 7dp;
	top: 7dp;
	width: 12dp;
	height: 12dp;
	border-radius: 6dp;
	background-color: var(--text-muted);
	pointer-events: none;
}
.exchange__light.is-on .exchange__light-core
{
	background-color: var(--success);
}
.is-on > .exchange__light-core.nui-fx
{
	box-shadow: 0 0 10dp 2dp var(--success);
}
/* Under both columns: the history (legacy's ExchangeLogs, its last three
   lines, the newest last) and the accept button at its right, on the
   history's last line. */
.exchange__foot
{
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	gap: var(--space-3);
}
.exchange__log
{
	flex: 1 1 auto;
	min-width: 0;
	padding: 6dp 10dp;
	background-color: var(--surface-sunken);
	border-radius: 7dp;
	pointer-events: none;
}
.exchange__log-line
{
	display: block;
	height: 16dp;
	overflow: hidden;
	color: var(--text-muted);
	font-size: var(--font-sm);
	line-height: 16dp;
	white-space: nowrap;
}
.exchange__accept
{
	flex: 0 0 auto;
	min-width: 92dp;
}
