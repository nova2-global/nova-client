			</div>
			<div id="fastequip-cell-3" class="nui-slot nui-anim nui-fx nui-has-tooltip fastequip__cell fastequip__cell--w3" data-if="cells[3].shown"
			     data-class-is-empty="cells[3].kind == ''" data-class-is-target="cells[3].target == 'move'"
