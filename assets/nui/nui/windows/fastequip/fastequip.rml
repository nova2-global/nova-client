<rml>
<head>
	<!-- Fast equip (Wave 8, NOVA-17; legacy uifastequip.py FastEquipWindow,
	     uiscript fastequipwindow.py, OLD root/uiFastEquip.py). While the
	     fastequip flag is on, the Interface makes nui_fastequip.FastEquipWindow,
	     a subclass of the legacy class on proxies: the 10 sets with their name
	     and color, the selected set's wear cells (only the ones the server can
	     use today, fastEquip.IsUsableCell), Switch, Clear and the edit panel.
	     A cell's events go to legacy's handlers by its wear index; a press, a
	     drag's release or a legacy drop on the canvas between the cells goes
	     to legacy's DropAnywhere, which finds the item's cell (Eddy, r41). The
	     name field takes the focus on a press (focus: auto under the body's
	     focus: none) and its text never enters the model. The refresh timer
	     is a nui-countdown so nothing runs per frame. The document exists
	     only while the window shows and draws below the legacy UI layer. -->
	<title>fastequip</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="fastequip.rcss"/>
</head>
<body template="nui" id="fastequip" class="nui-window nui-fx nui-anim nui-below-legacy-ui fastequip" data-model="fastequip"
      data-event-mousedown="board_press(ev.button)">
	<div class="nui-window__titlebar fastequip__titlebar">
		<handle class="nui-window__handle fastequip__handle" move_target="#document">
			<span class="fastequip__title-icon"><span class="nui-glyph nui-glyph--inventory"><span
				class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></span>
			<span class="nui-window__title fastequip__title">@ui.FAST_EQUIP_TITLE</span>
		</handle>
		<button id="fastequip-close-x" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim fastequip__close-x"
		        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	</div>
	<div class="nui-window__body fastequip__body">
		<nui-countdown class="fastequip__timer" format="none" data-attr-end="refresh_end" data-event-countdownend="refresh_due()"/>
		<div class="fastequip__sets">
			<div class="fastequip__sets-head">@ui.FAST_EQUIP_SETS</div>
			<div class="fastequip__set nui-anim" data-for="s : sets" data-attr-id="'fastequip-set-' + s.index" data-class-is-selected="s.selected"
			     data-event-mousedown="set_press(s.index, ev.button)">
				<div class="fastequip__set-color" data-style---fe-color="s.css"></div>
				<span class="fastequip__set-name">{{ s.name }}</span>
				<button class="nui-button nui-button--ghost nui-button--icon nui-anim fastequip__set-edit" data-attr-id="'fastequip-edit-' + s.index"
				        data-event-mousedown="edit_press(s.index, ev.button)" data-event-click="edit_click(s.index)"><span class="fastequip__set-edit-mark">...</span></button>
			</div>
		</div>
		<div class="fastequip__main">
			<div class="fastequip__title-bar" data-class-is-equipped="equipped" data-style---fe-color="title_css">
				<span class="fastequip__set-title">{{ title }}</span>
				<div class="fastequip__equipped-stripe"></div>
			</div>
			<div id="fastequip-canvas" class="fastequip__canvas" data-class-is-attaching="attaching" data-class-nui-attach-right="attach_right"
			     data-event-mousedown="canvas_press(ev.button)" data-event-mouseup="canvas_release(ev.button)"
			     data-event-nuidrop="canvas_drop()">
			<div id="fastequip-cell-0" class="nui-slot nui-anim nui-fx nui-has-tooltip fastequip__cell fastequip__cell--w0" data-if="cells[0].shown"
			     data-class-is-empty="cells[0].kind == ''" data-class-is-target="cells[0].target == 'move'"
			     data-class-is-blocked="cells[0].target == 'blocked'" data-class-is-disabled="cells[0].disabled"
			     data-class-fastequip__cell--missing="cells[0].missing"
			     data-event-mousedown="slot_press(0, ev.button)" data-event-mouseup="slot_release(0, ev.button)"
			     data-event-dblclick="slot_use(0)" data-event-mouseover="slot_over(0)"
			     data-event-mouseout="slot_out(0)" data-event-nuidrop="slot_drop(0)">
				<img class="nui-slot__icon" data-if="cells[0].icon != ''" data-attr-src="cells[0].icon"/>
				<nui-number class="nui-slot__number" data-if="cells[0].count != ''" data-attr-value="cells[0].count"/>
				<div class="nui-slot__tint"></div>
				<span class="nui-tooltip nui-anim fastequip__tip" data-if="cells[0].missing">@ui.FAST_EQUIP_MISSING</span>
			</div>
			<div id="fastequip-cell-1" class="nui-slot nui-anim nui-fx nui-has-tooltip fastequip__cell fastequip__cell--w1" data-if="cells[1].shown"
			     data-class-is-empty="cells[1].kind == ''" data-class-is-target="cells[1].target == 'move'"
			     data-class-is-blocked="cells[1].target == 'blocked'" data-class-is-disabled="cells[1].disabled"
			     data-class-fastequip__cell--missing="cells[1].missing"
			     data-event-mousedown="slot_press(1, ev.button)" data-event-mouseup="slot_release(1, ev.button)"
			     data-event-dblclick="slot_use(1)" data-event-mouseover="slot_over(1)"
			     data-event-mouseout="slot_out(1)" data-event-nuidrop="slot_drop(1)">
				<img class="nui-slot__icon" data-if="cells[1].icon != ''" data-attr-src="cells[1].icon"/>
				<nui-number class="nui-slot__number" data-if="cells[1].count != ''" data-attr-value="cells[1].count"/>
				<div class="nui-slot__tint"></div>
				<span class="nui-tooltip nui-anim fastequip__tip" data-if="cells[1].missing">@ui.FAST_EQUIP_MISSING</span>
			</div>
			<div id="fastequip-cell-2" class="nui-slot nui-anim nui-fx nui-has-tooltip fastequip__cell fastequip__cell--w2" data-if="cells[2].shown"
			     data-class-is-empty="cells[2].kind == ''" data-class-is-target="cells[2].target == 'move'"
			     data-class-is-blocked="cells[2].target == 'blocked'" data-class-is-disabled="cells[2].disabled"
			     data-class-fastequip__cell--missing="cells[2].missing"
