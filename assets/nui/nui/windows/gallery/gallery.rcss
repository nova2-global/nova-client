/* Gallery page layout. Components come from nui/nui.rtpl. */

/* Sized to fit a 1920x1080 dp viewport whole (the client's auto scale at
   1080, 1620 and 2160 lines): 24dp margins, a 1720dp width (the three
   component columns of 440dp and the 296dp glyph and board column; classic,
   which hides that column, keeps 1400dp), and a body whose content is shown
   whole up to 80vh (864dp at 1080). On a shorter viewport the body scrolls
   instead: 80vh leaves the 152dp of margin, title bar, padding and footer
   on screen down to 760dp (RCSS has no calc()). */
body.nui-window
{
	left: 24dp;
	top: 24dp;
	width: 1720dp;
}

.gallery-body
{
	max-height: 80vh;
	overflow-y: auto;
}

.gallery-columns
{
	display: flex;
	flex-direction: row;
	gap: var(--space-5);
}
.gallery-column
{
	flex: 1 1 0;
}
.gallery-column h2
{
	margin-top: var(--space-4);
}
.gallery-column--chrome
{
	flex: 0 0 296dp;
}

/* Every glyph (components/glyph.rcss) in a 32dp cell, at 125%. */
.gallery-glyphs
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: var(--space-1);
	margin-bottom: var(--space-3);
}
.gallery-glyph
{
	display: block;
	position: relative;
	width: 32dp;
	height: 32dp;
}
.gallery-glyph .nui-glyph
{
	position: absolute;
	left: 8dp;
	top: 8dp;
	transform: scale(1.25);
}

/* The chrome's boards and tile (components/window-frame.rcss). */
.gallery-boards
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	gap: var(--space-2);
	margin-bottom: var(--space-3);
}
.gallery-board
{
	display: block;
	width: 80dp;
	height: 32dp;
	padding: 0 var(--space-2);
	line-height: 32dp;
}
.gallery-ring
{
	display: block;
	position: relative;
	width: 64dp;
	height: 64dp;
}
.gallery-ring__disc, .gallery-ring__ring
{
	position: absolute;
	left: 0;
	top: 0;
	width: 64dp;
	height: 64dp;
}
.gallery-ring__ring
{
	box-sizing: border-box;
}
.gallery-band
{
	height: 32dp;
	padding: 0 var(--space-2);
	line-height: 32dp;
}

/* Button states as a table: columns line up and still grow with longer
   translations (German labels run about a third longer than English). RmlUi
   does not shrink tables to fit, so the table spans the body. */
.gallery-matrix
{
	display: table;
	column-gap: var(--space-2);
	row-gap: var(--space-2);
	margin-bottom: var(--space-2);
}
.gallery-matrix__row
{
	display: table-row;
}
.gallery-matrix__cell
{
	display: table-cell;
	vertical-align: middle;
	text-align: center;
}
.gallery-matrix__cell.gallery-label
{
	text-align: left;
}
.gallery-label, .gallery-state
{
	color: var(--text-muted);
	font-size: var(--font-xs);
}
.gallery-state
{
	text-align: center;
}
.gallery-matrix .nui-button
{
	min-width: 76dp;
}
.gallery-gap
{
	margin-bottom: var(--space-2);
}

.gallery-fields
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: var(--space-3);
}

.gallery-type h1, .gallery-type h2, .gallery-type h3, .gallery-type h4
{
	margin-top: 0;
}

/* Tagged text as the chat shows it: the chat's backdrop and line color, so
   the game's own tag colors read in every theme. One tight line: the body
   shows its content whole at 80vh only with room to spare of about 28dp. */
.gallery-tagged
{
	margin-bottom: 0;
	padding: 1dp var(--space-2);
	background-color: var(--chat-edit-shade);
	color: var(--chat-talking);
	font-size: var(--font-sm);
}

.gallery-list .nui-list__viewport
{
	height: 196dp;
}

.gallery-tooltip-host
{
	margin-left: var(--space-5);
}
/* Room above for the open two-line hint, which rises from its host. */
.gallery-hint-line
{
	margin-top: 48dp;
}

.gallery-slider
{
	display: inline-flex;
	flex-direction: row;
	align-items: center;
	gap: var(--space-2);
	margin-right: var(--space-3);
}
.gallery-slider .gallery-state
{
	min-width: 44dp;
	text-align: left;
}
.gallery-slider .nui-slider
{
	width: 140dp;
}

.gallery-size-label
{
	margin-left: var(--space-3);
}

.gallery-gauges
{
	gap: var(--space-4);
	margin-bottom: var(--space-2);
}
.gallery-gauge
{
	width: 160dp;
}

.gallery-panels
{
	align-items: stretch;
}

.gallery-first
{
	margin-top: 0;
}

/* The two slot grids side by side, aligned at their tops. */
.gallery-slots
{
	align-items: flex-start;
	gap: var(--space-2);
}
