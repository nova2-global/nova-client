/* The game buttons' modern look: a round accent button with a plus and its
   label in a pill below it, at the legacy anchors (the left buttons from
   the screen's left, the right ones from its right, all from its bottom).
   Classic (the legacy plus art and white labels): skins/classic/windows/
   game-buttons.rcss. */

body.game-buttons
{
	focus: none;
	tab-index: none;
}
.game-buttons button
{
	focus: none;
	tab-index: none;
}
.game-button
{
	display: block;
	position: absolute;
	width: 36dp;
	height: 36dp;
}
/* help 170 and status 100 above the bottom at the left; tasks, the observer
   end and the guild building 170, and skills 100, above it at the right. */
.game-button--help { left: 48dp; bottom: 134dp; }
.game-button--status { left: 66dp; bottom: 64dp; }
.game-button--quest, .game-button--observer, .game-button--build { right: 48dp; bottom: 134dp; }
.game-button--skill { right: 48dp; bottom: 64dp; }

.game-button__plus
{
	display: block;
	box-sizing: border-box;
	width: 36dp;
	height: 36dp;
	padding: 0;
	border-width: 2dp;
	border-color: var(--accent-hover);
	border-radius: 18dp;
	background-color: var(--accent);
	color: var(--accent-text);
	font-size: var(--font-xl);
	font-weight: bold;
	line-height: 30dp;
	text-align: center;
}
.game-button__plus:hover
{
	background-color: var(--accent-hover);
}
.game-button__plus:active
{
	background-color: var(--accent);
	border-color: var(--accent);
}
.game-button__label
{
	display: block;
	position: absolute;
	left: -82dp;
	width: 200dp;
	top: 40dp;
	text-align: center;
	pointer-events: none;
}
.game-button__text
{
	padding: 1dp 6dp;
	border-radius: var(--radius-sm);
	background-color: var(--tooltip-bg);
	color: var(--text-inverse);
	font-size: var(--font-sm);
	font-weight: bold;
}
