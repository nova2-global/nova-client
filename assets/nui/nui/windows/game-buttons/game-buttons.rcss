/* The game buttons' modern look: a round accent button with a plus and its
   label in a pill beside it, at the legacy anchors (the left buttons from
   the screen's left, the right ones from its right, all from its bottom),
   raised 12dp for the modern taskbar, which is 11dp taller than legacy's.
   The pill sits right of a left button and left of a right one, not under
   it as legacy's see-through text does: under the button it would cover the
   taskbar's gauge and button hints, which open just above the bar, and a
   long label (pt, pl) grows away from the screen's edge. Classic (the
   legacy plus art and white labels at the legacy places):
   skins/classic/windows/game-buttons.rcss. */

body.game-buttons
{
	focus: none;
	tab-index: none;
}
.game-buttons button
{
	focus: none;
	tab-index: none;
}
.game-button
{
	display: block;
	position: absolute;
	width: 36dp;
	height: 36dp;
}
/* help 182 and status 112 above the bottom at the left (legacy 170 and 100);
   tasks, the observer end and the guild building 182, and skills 112, above
   it at the right. */
.game-button--help { left: 48dp; bottom: 146dp; }
.game-button--status { left: 66dp; bottom: 76dp; }
.game-button--quest, .game-button--observer, .game-button--build { right: 48dp; bottom: 146dp; }
.game-button--skill { right: 48dp; bottom: 76dp; }

.game-button__plus
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 36dp;
	height: 36dp;
	padding: 0;
	border-width: 2dp;
	border-color: var(--accent-hover);
	border-radius: 18dp;
	background-color: var(--accent);
	decorator: radial-gradient(circle at 50% 30%, var(--accent-hover) 0%, var(--accent) 70%, var(--accent) 100%);
}
.game-button__plus.nui-fx
{
	box-shadow: 0 0 10dp var(--accent-glow);
}
.game-button__plus:hover
{
	background-color: var(--accent-hover);
	decorator: none;
}
.game-button__plus:active
{
	background-color: var(--accent);
	border-color: var(--accent);
	decorator: none;
}
/* The plus, in the accent's text color, centered. */
.game-button__glyph
{
	position: absolute;
	left: 8dp;
	top: 8dp;
	transform: scale(1.25);
	--glyph-ink: var(--accent-text);
}
.game-button__label
{
	display: block;
	position: absolute;
	left: 42dp;
	width: 200dp;
	top: 9dp;
	text-align: left;
	pointer-events: none;
}
.game-button--quest .game-button__label, .game-button--observer .game-button__label,
.game-button--build .game-button__label, .game-button--skill .game-button__label
{
	left: auto;
	right: 42dp;
	text-align: right;
}
.game-button__text
{
	padding: 2dp 8dp;
	border-width: 1dp;
	border-color: var(--tip-divider);
	border-radius: 6dp;
	background-color: var(--tooltip-bg);
	color: var(--text-inverse);
	font-size: var(--font-sm);
	font-weight: bold;
}
