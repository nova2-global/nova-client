/* The game options' modern look (the reviewed design, board WGameOptions):
   a movable window with its title glyph, label and choice rows in legacy's
   order, every other row on a sunken cell; the choices share their row
   evenly, the six block toggles in two rows of three and the pickup
   filter's four in two rows of two (NOVA-50), as legacy's. The choice in
   effect is selected (is-selected) and takes the accent ink; a blocked
   request is a selected toggle. The facade centers the body. Classic (the
   legacy board, 300 x 383, at legacy's places):
   skins/classic/windows/game-options.rcss. */

/* The sheet's own place frames the window and its shadow in its 560 x
   560dp snapshots; the facade's center() replaces it in the client. */
body.game-options
{
	left: 20dp;
	top: 8dp;
	width: 440dp;
	focus: none;
	tab-index: none;
}
.game-options button
{
	tab-index: none;
}

/* The title glyph on the accent's soft tile: a panel with two setting
   bars, as the system menu's Game Options. */
.game-options__icon
{
	display: inline-block;
	box-sizing: border-box;
	width: 24dp;
	height: 24dp;
	margin: -2dp var(--space-2) 0 0;
	padding: 3dp;
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	background-color: var(--selection);
	line-height: 16dp;
	vertical-align: middle;
}
.game-options__glyph
{
	--glyph-ink: var(--accent);
	display: block;
}
.game-options__glyph .nui-glyph__a
{
	left: 1dp;
	top: 1dp;
	width: 14dp;
	height: 14dp;
	border-width: 2dp;
	border-radius: 3dp;
}
.game-options__glyph .nui-glyph__b, .game-options__glyph .nui-glyph__c
{
	left: 4dp;
	height: 2dp;
	background-color: var(--glyph-ink);
}
.game-options__glyph .nui-glyph__b { top: 5dp; width: 8dp; }
.game-options__glyph .nui-glyph__c { top: 9dp; width: 5dp; }

.game-options__body
{
	padding: var(--space-3) var(--space-4) var(--space-4) var(--space-4);
}
.go-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 34dp;
	margin-top: 6dp;
	padding: 0 7dp;
	border-width: 1dp;
	border-color: transparent;
	border-radius: var(--radius-lg);
}
.go-row:first-child
{
	margin-top: 0;
}
.go-row:nth-child(even)
{
	border-color: var(--border);
	background-color: var(--surface-sunken);
}
.go-label
{
	display: block;
	flex: 0 0 auto;
	width: 100dp;
	margin-right: var(--space-2);
	color: var(--text-muted);
	font-size: var(--font-md);
}
.go-choices
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	flex: 1 1 auto;
	gap: 5dp;
}
.go-choice
{
	display: block;
	flex: 1 1 0;
	min-width: 0;
	height: 26dp;
	padding: 0 6dp;
	font-size: var(--font-sm);
	line-height: 24dp;
}
.go-choice.is-selected
{
	color: var(--accent);
}
/* The four PvP modes share their row by their labels' widths, which differ
   most between locales. */
.go-row--pk .go-choice
{
	flex: 1 1 auto;
	padding: 0 4dp;
}
/* The block toggles: three to a row, the label at the first row's top. */
.go-row--block
{
	align-items: flex-start;
	padding-top: 6dp;
	padding-bottom: 6dp;
}
.go-row--block .go-label
{
	margin-top: 5dp;
}
.go-row--block .go-choice
{
	flex: 1 1 30%;
}
/* The pickup filter's toggles: two to a row, as legacy's, sharing the
   width as the block toggles do; the label at the first row's top. */
.go-row--pickup
{
	align-items: flex-start;
	padding-top: 6dp;
	padding-bottom: 6dp;
}
.go-row--pickup .go-label
{
	margin-top: 5dp;
}
.go-row--pickup .go-choice
{
	flex: 1 1 45%;
	min-width: 0;
}
.go-tip
{
	font-weight: normal;
}

/* NOVA-121: the Keyboard row's one button keeps a choice's width. */
.go-row--keys .go-choice
{
	flex: 0 0 auto;
	width: 140dp;
}

/* The keys page: the column heads, a list of fixed height that scrolls (a
   section's head, then its actions, every other row on a sunken cell as the
   main page's rows), the notice line and the buttons. A key cell that waits
   for its key is selected (the accent); an action whose keys differ from the
   defaults has its label in the accent's ink. The rows' texts take no
   pointer, so a hover is the cell's alone. */
.go-keys
{
	display: block;
}
.gk-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 20dp;
	padding: 0 22dp 0 8dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
}
.gk-head__action
{
	flex: 1 1 auto;
}
.gk-head__key
{
	display: block;
	flex: 0 0 auto;
	width: 104dp;
	margin-left: 6dp;
	text-align: center;
}
.gk-list
{
	display: block;
	height: 556dp;
	margin-top: 4dp;
	overflow-y: auto;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: var(--radius-lg);
}
.gk-row
{
	display: block;
	height: 30dp;
}
.gk-row:nth-child(even)
{
	background-color: var(--surface-sunken);
}
.gk-section
{
	display: block;
	padding: 0 8dp;
	color: var(--accent);
	font-size: var(--font-sm);
	font-weight: bold;
	line-height: 30dp;
	pointer-events: none;
}
.gk-action
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 30dp;
	padding: 0 6dp 0 14dp;
}
.gk-label
{
	display: block;
	flex: 1 1 auto;
	min-width: 0;
	color: var(--text-muted);
	font-size: var(--font-md);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	pointer-events: none;
}
.gk-action.is-changed .gk-label
{
	color: var(--text);
}
.gk-cell
{
	display: block;
	flex: 0 0 auto;
	width: 104dp;
	height: 24dp;
	margin-left: 6dp;
	padding: 0 4dp;
	font-size: var(--font-sm);
	line-height: 22dp;
	text-align: center;
	tab-index: none;
}
.gk-cell.is-selected
{
	color: var(--accent);
	border-color: var(--accent);
}
.gk-cell__text
{
	pointer-events: none;
	white-space: nowrap;
}
.gk-notice
{
	display: block;
	height: 34dp;
	margin-top: 8dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
	line-height: 17dp;
}
.gk-foot
{
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	gap: 8dp;
	margin-top: 6dp;
}
.gk-foot .nui-button
{
	min-width: 96dp;
	tab-index: none;
}
.gk-button__label
{
	pointer-events: none;
}

/* NOVA-211, NOVA-215: the yang and country flag rows are two-choice rows as
   the others. NOVA-213: the search field over the rows, and its results
   laid over the rows below it while it holds text: a raised panel, a list
   of fixed height that scrolls (a row's label, then its section muted).
   The field takes the focus (the body has focus: none, which it inherits).
   A found row takes the accent's edge and soft fill until its timer ends. */
.go-search
{
	display: block;
	position: relative;
	margin-bottom: 8dp;
}
.go-search__field
{
	display: block;
	width: 100%;
	focus: auto;
	tab-index: auto;
}
.go-results
{
	position: absolute;
	left: 0;
	right: 0;
	top: 34dp;
	z-index: 2;
	padding: 4dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: var(--radius-lg);
	background-color: var(--surface-raised);
}
.go-results__list
{
	height: 196dp;
}
.go-result
{
	height: 28dp;
	tab-index: none;
}
.go-result__label
{
	flex: 1 1 auto;
	color: var(--text);
	font-size: var(--font-md);
	white-space: nowrap;
	pointer-events: none;
}
.go-result__where
{
	flex: 0 0 auto;
	color: var(--text-muted);
	font-size: var(--font-sm);
	white-space: nowrap;
	pointer-events: none;
}
.go-results__none
{
	display: block;
	padding: 6dp 8dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
}
/* The rows keep their place under the results but hide, so no press
   reaches a row the results cover. */
.go-main.go-under-results
{
	visibility: hidden;
}
.go-found-timer
{
	display: none;
}
.go-row.is-found, .go-row.is-found:nth-child(even)
{
	border-color: var(--accent);
	background-color: var(--selection);
}
.go-row.is-found .go-label
{
	color: var(--accent);
}
