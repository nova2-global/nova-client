<rml>
<head>
	<!-- The gaya market (Wave 5, NOVA-10; legacy uigemshop.py GemShopWindow,
	     uiscript gemshopwindow.py). While the gem-shop flag is on, the
	     Interface makes nui_gem_shop.GemShopWindow (controller
	     assets/root/nui_gem_shop.py), a subclass of the legacy class on
	     proxies: the slots, prices and locked slots (the player module's
	     GetGemShop* getters), the questions before an unlock, a buy or a
	     refresh, and the packets are legacy's code. The nine slots stand in
	     legacy's 3 x 3 market, each with its price in gaya under it; a
	     locked slot (to unlock with the server's item) shows the lock. The
	     refresh time is legacy's "HH:MM", written again when its minute turns
	     (a nui-countdown timer, so no Python runs per frame); the 500-unit
	     walk-away is the engine's watch. The document exists only while the
	     window shows and draws below the legacy UI layer. A left or right
	     press anywhere on it raises the window (board_press). -->
	<title>gem-shop</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="gem-shop.rcss"/>
</head>
<body template="nui" id="gem-shop" class="nui-window nui-fx nui-anim nui-below-legacy-ui gem-shop" data-model="gem_shop"
      data-event-mousedown="board_press(ev.button)">
	<div class="nui-window__titlebar gem-shop__titlebar">
		<handle class="nui-window__handle gem-shop__handle" move_target="#document">
			<span class="gem-shop__title-icon"><span class="nui-glyph nui-glyph--gem"><span
				class="nui-glyph__a"></span><span class="nui-glyph__b"></span><span class="nui-glyph__c"></span></span></span>
			<span class="nui-window__title gem-shop__title">@ui.GEMSHOP_TITLE</span>
		</handle>
		<button id="gem-shop-close-x" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim gem-shop__close-x"
		        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	</div>
	<div class="nui-window__body gem-shop__body">
		<div class="gem-shop__head">
			<button id="gem-shop-refresh" class="nui-button nui-button--icon nui-anim gem-shop__refresh"
			        data-event-mousedown="refresh_press(ev.button)"><span class="nui-glyph nui-glyph--refresh"><span
				class="nui-glyph__a"></span><span class="nui-glyph__b"></span><span class="nui-glyph__c"></span></span></button>
			<span class="gem-shop__time-label">@ui.GEMSHOP_LEFTTIME</span>
			<span id="gem-shop-time" class="gem-shop__time">{{ refresh_time }}</span>
			<nui-countdown class="gem-shop__clock" format="none" data-attr-end="minute_end" data-event-countdownend="minute()"/>
		</div>
		<div id="gem-shop-market" class="gem-shop__market" data-class-is-attaching="attaching"
		     data-class-nui-attach-right="attach_right">
			<div class="gem-shop__item" data-for="c : cells">
				<div class="nui-slot nui-anim nui-fx gem-shop__cell" data-attr-id="'gem-shop-cell-' + it_index"
				     data-class-is-empty="c.kind == ''" data-class-is-disabled="c.disabled"
				     data-event-mousedown="cell_press(it_index, ev.button)" data-event-mouseup="cell_release(it_index, ev.button)"
				     data-event-mouseover="cell_over(it_index)" data-event-mouseout="cell_out(it_index)">
					<img class="nui-slot__icon" data-if="c.icon != ''" data-attr-src="c.icon"/>
					<nui-number class="nui-slot__number" data-if="c.count != ''" data-attr-value="c.count"/>
					<div class="nui-slot__tint" data-if="c.disabled"></div>
					<span class="nui-glyph nui-glyph--lock gem-shop__lock" data-if="c.disabled"><span
						class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span>
				</div>
				<div class="gem-shop__price"><span class="gem-shop__coin"></span><span class="nui-glyph nui-glyph--gem gem-shop__gem"><span
					class="nui-glyph__a"></span><span class="nui-glyph__b"></span><span class="nui-glyph__c"></span></span><span
					class="gem-shop__amount">{{ prices[it_index] }}</span></div>
			</div>
		</div>
	</div>
</body>
</rml>
