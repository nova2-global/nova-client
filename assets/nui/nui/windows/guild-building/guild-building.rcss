/* The guild building window's modern look: a compact window at legacy's
   anchor (10dp from the left, its bottom 50dp above the screen's), code
   drawn from the tokens, in three columns: the categories over the costs,
   the buildings, then the position over the rotation; Preview, Accept and
   Cancel in the footer. A cost the player is short of takes the danger
   color. The parts are absolutely placed in a fixed-size body, as legacy's
   window is fixed, so a long label never moves its neighbors. Classic (the
   legacy board at legacy's places, the slot bars, the slider and button
   art): skins/classic/windows/guild-building.rcss. */

body.guild-building
{
	left: 10dp;
	bottom: 50dp;
	width: 630dp;
	min-width: 0;
	focus: none;
	tab-index: none;
}
.guild-building__handle
{
	display: flex;
	flex-direction: row;
	align-items: center;
}
.guild-building__title-icon
{
	display: flex;
	flex: 0 0 auto;
	align-items: center;
	justify-content: center;
	width: 22dp;
	height: 22dp;
	margin-right: 7dp;
	border-width: 1dp;
	border-color: var(--accent);
	border-radius: 6dp;
	background-color: var(--selection);
}
.guild-building__title-icon .nui-glyph
{
	--glyph-ink: var(--accent);
	transform: scale(0.75);
}
.guild-building__title
{
	display: block;
	overflow: hidden;
}
.guild-building button
{
	tab-index: none;
}

.guild-building__body
{
	position: relative;
	height: 241dp;
	padding: 0;
}

.guild-building__categories,
.guild-building__buildings,
.guild-building__costs,
.guild-building__position,
.guild-building__rotation
{
	position: absolute;
}
.guild-building__categories { left: 12dp; top: 12dp; width: 148dp; }
.guild-building__costs { left: 12dp; top: 126dp; width: 148dp; }
.guild-building__buildings { left: 170dp; top: 12dp; width: 164dp; height: 209dp; }
.guild-building__position { left: 344dp; top: 12dp; width: 274dp; }
.guild-building__rotation { left: 344dp; top: 110dp; width: 274dp; }

.guild-building__heading
{
	display: block;
	height: 18dp;
	margin-bottom: 4dp;
	color: var(--text-muted);
	font-size: 10dp;
	font-weight: bold;
	line-height: 18dp;
	text-align: center;
	white-space: nowrap;
}

/* The lists: compact rows (24dp), the categories' three in full, the
   buildings' list scrolling past six. */
/* border-box: a row is 24dp at every scale, so whole rows fill the
   viewports (a 1dp border rounds up at 150%). */
.guild-building__row
{
	box-sizing: border-box;
	height: 25dp;
	padding: 2dp var(--space-2);
	line-height: 18dp;
	font-size: var(--font-md);
	text-align: center;
	white-space: nowrap;
}
.guild-building__list
{
	box-sizing: border-box;
	padding: 5dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 8dp;
	background-color: var(--surface-sunken);
}
/* The selected row: the list's selection with a 3dp accent edge. */
.guild-building__row.is-selected
{
	border-left-width: 3dp;
	border-left-color: var(--accent);
	color: var(--text);
}
.guild-building__row-label
{
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
}
.guild-building__viewport--categories
{
	height: 79dp;
	overflow-y: hidden;
}
.guild-building__viewport--buildings
{
	height: 175dp;
}

/* The costs: a label and its value on one row each. */
.guild-building__cost
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 23dp;
	margin-bottom: 4dp;
	line-height: 23dp;
}
/* At least 46dp, so the values line up; a longer label (br "Compensado")
   pushes its own value. */
.guild-building__label
{
	display: block;
	flex: 0 0 auto;
	min-width: 46dp;
	margin-right: 4dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
	white-space: nowrap;
}
.guild-building__value
{
	display: block;
	box-sizing: border-box;
	flex: 1 1 auto;
	min-width: 0;
	height: 23dp;
	padding: 0 5dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 5dp;
	background-color: var(--surface-sunken);
	color: var(--text);
	font-size: var(--font-sm);
	font-weight: bold;
	line-height: 21dp;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
.guild-building__value.is-short
{
	color: var(--danger);
}

/* The position: X and Y in two read-only boxes, the Change button beside
   them. */
.guild-building__coord
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 191dp;
	height: 25dp;
	margin-bottom: 5dp;
}
.guild-building__axis
{
	display: block;
	flex: 0 0 auto;
	width: 18dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
	font-weight: bold;
}
.guild-building__coord-value
{
	display: block;
	flex: 1 1 auto;
	height: 24dp;
	padding: 0 var(--space-2);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: var(--radius-sm);
	background-color: var(--surface-sunken);
	color: var(--text);
	font-size: var(--font-sm);
	font-weight: bold;
	line-height: 22dp;
	text-align: center;
	white-space: nowrap;
}
/* A tall button beside both coordinates, at least 75dp wide; the widest
   label of the 17 locales (de "Wechseln") fits it. */
.guild-building__change
{
	position: absolute;
	right: 0;
	top: 22dp;
	min-width: 75dp;
	height: 55dp;
	padding: 0 var(--space-2);
	line-height: 53dp;
}

/* The rotation: one row per axis, the slider filling it. */
.guild-building__axis-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 25dp;
	gap: 7dp;
}
.guild-building__slider
{
	flex: 1 1 auto;
	width: 211dp;
}
.guild-building__slider-value
{
	display: block;
	flex: 0 0 31dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
	text-align: right;
}

/* Preview at the left of the footer, Accept and Cancel at its right. */
.guild-building__footer
{
	align-items: center;
	justify-content: flex-end;
	padding: 10dp var(--space-3) var(--space-3);
}
.guild-building__preview
{
	margin-right: 0;
}
.guild-building__accept,
.guild-building__cancel
{
	min-width: 72dp;
}
