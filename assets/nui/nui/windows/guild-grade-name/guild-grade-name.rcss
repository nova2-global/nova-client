/* The grade name dialog's modern look (P16 spec 5.9.5): the dialog kit's
   look (components/dialog.rcss: the width, the centered field and footer):
   the field, Cancel and OK. At legacy's place (D21): with placed, the
   dialog's top left is (--grade-name-x, --grade-name-y), which the
   controller sets from legacy's pixels; otherwise the scrim centers it.
   Classic (legacy's
   170 x 90 board, the parameter slot under the field, the middle buttons at
   the uiscript's places): skins/classic/windows/guild-grade-name.rcss. */

.guild-grade-name button
{
	tab-index: none;
	focus: none;
}
.guild-grade-name__slot
{
	display: block;
}
.guild-grade-name__label
{
	pointer-events: none;
}

body.guild-grade-name
{
	--grade-name-x: 0dp;
	--grade-name-y: 0dp;
}
/* Not the scrim's flex centering: the dialog at the controller's place. */
body.guild-grade-name--placed
{
	display: block;
}
body.guild-grade-name--placed .guild-grade-name__window
{
	position: absolute;
	left: var(--grade-name-x);
	top: var(--grade-name-y);
}
