/* The guild war accept dialog's modern look (P16 spec 5.10.2; the
   reviewed WGuildWarAccept board of stage 1): the dialog kit's frame
   (components/dialog.rcss), an upright sword in an accent tile before
   its title, its rows 38dp apart with their labels in a
   96dp column: the declaring guild's name in a sunken well behind a red
   crest, the war's member cap and end score as the server sent them
   (NOVA-90; a line each, none for a limit it did not send), the battle
   type's three buttons (the declared one selected, its label in the
   accent; each shows its hint on hover; each as wide as its label), then
   OK and Cancel, legacy's order. The scrim centers it. Classic (legacy's
   230 x 175 board, the slot bar under the name, the limit lines, the small
   type buttons and the middle buttons at the uiscript's places):
   skins/classic/windows/guild-war-accept.rcss. */

.guild-war button
{
	tab-index: none;
	focus: none;
}
.guild-war__handle
{
	display: flex;
	flex-direction: row;
	align-items: center;
}
/* The title's icon: an upright sword in an accent tile, as the guild
   window's. */
.guild-war__title-icon
{
	display: flex;
	flex: 0 0 auto;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 24dp;
	height: 24dp;
	margin-right: 8dp;
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	background-color: var(--selection);
	line-height: 22dp;
}
.guild-war__title-icon .nui-glyph
{
	--glyph-ink: var(--accent);
}
.guild-war__title
{
	display: block;
	overflow: hidden;
}
.guild-war__body
{
	padding-top: 10dp;
}
.guild-war__row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 38dp;
}
.guild-war__label
{
	display: block;
	flex: 0 0 96dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
	font-weight: bold;
	text-align: left;
	white-space: nowrap;
}
/* The declaring guild in a sunken well, behind its crest (a red gem in a
   soft red halo). */
.guild-war__slot
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 0;
	min-width: 0;
	min-height: 28dp;
	box-sizing: border-box;
	padding: 0 9dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 7dp;
	background-color: var(--surface-sunken);
}
.guild-war__crest
{
	display: block;
	flex: 0 0 auto;
	width: 6dp;
	height: 6dp;
	margin: 0 11dp 0 3dp;
	border-width: 4dp;
	border-color: var(--slot-disabled);
	border-radius: 3dp;
	background-color: var(--danger);
	transform: rotate(45deg);
}
.guild-war__field
{
	width: 100%;
}
/* The declaring guild's name: one line, or two for a long one (the
   foundation's 24 characters), never cut. */
.guild-war__name
{
	display: block;
	flex: 1 1 0;
	min-width: 0;
	padding: 4dp 0;
	line-height: 18dp;
	font-weight: bold;
	color: var(--text);
	text-align: left;
	white-space: normal;
}
/* A limit's line, the player's message as legacy writes it. */
.guild-war__limit-line
{
	display: block;
	color: var(--text);
	white-space: normal;
}
/* Wide enough for the longest battle type labels of the locales (ru
   "Поле битвы", hu "Harcmező", it "Bandiera") in one row. */
.guild-war__window
{
	width: 360dp;
}
/* Each type button as wide as its label, the rest of the row shared; a
   label longer than the row would allow wraps the buttons, never cuts. */
.guild-war__types
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	flex: 1 1 0;
	gap: var(--space-1);
}
.guild-war__type
{
	flex: 1 0 auto;
	padding: 0 var(--space-2);
}
.guild-war__type.is-selected
{
	color: var(--accent);
}
.guild-war__type-label, .guild-war__button-label
{
	pointer-events: none;
}
.guild-war__hint
{
	left: 0;
	text-align: left;
}
.guild-war__hint-title
{
	display: block;
	margin-bottom: var(--space-1);
	font-weight: bold;
}
.guild-war__hint-line
{
	display: block;
}
