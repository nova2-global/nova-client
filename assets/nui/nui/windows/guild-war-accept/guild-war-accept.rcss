/* The guild war accept dialog's modern look (P16 spec 5.10.2): the dialog
   kit's look (components/dialog.rcss): the enemy guild's row, the battle
   type's three buttons (the declared one selected; each shows its hint on
   hover; each as wide as its label), Cancel and OK. The scrim centers it. Classic (legacy's 230 x 130
   board, the slot bar under the name, the small type buttons and the
   middle buttons at the uiscript's places):
   skins/classic/windows/guild-war-accept.rcss. */

.guild-war button
{
	tab-index: none;
	focus: none;
}
.guild-war__row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: var(--space-2);
}
.guild-war__label
{
	display: block;
	flex: 0 0 96dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
	white-space: nowrap;
}
.guild-war__slot
{
	display: block;
	flex: 1 1 0;
	min-width: 0;
}
.guild-war__field
{
	width: 100%;
}
/* The declaring guild's name: one line, or two for a long one (the
   foundation's 24 characters), never cut. */
.guild-war__name
{
	display: block;
	padding: 6dp 0;
	line-height: 20dp;
	color: var(--text);
	white-space: normal;
}
/* Wide enough for the longest battle type labels of the locales (ru
   "Поле битвы", hu "Harcmező", it "Bandiera") in one row. */
.guild-war__window
{
	width: 360dp;
}
/* Each type button as wide as its label, the rest of the row shared; a
   label longer than the row would allow wraps the buttons, never cuts. */
.guild-war__types
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	flex: 1 1 0;
	gap: var(--space-1);
}
.guild-war__type
{
	flex: 1 0 auto;
	padding: 0 var(--space-2);
}
.guild-war__type-label, .guild-war__button-label
{
	pointer-events: none;
}
.guild-war__hint
{
	left: 0;
	text-align: left;
}
.guild-war__hint-title
{
	display: block;
	margin-bottom: var(--space-1);
	font-weight: bold;
}
.guild-war__hint-line
{
	display: block;
}
