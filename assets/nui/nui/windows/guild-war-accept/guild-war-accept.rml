<rml>
<head>
	<!-- The guild war accept dialog (uiguild.py AcceptGuildWarDialog, uiscript
	     acceptguildwardialog.py; P16 spec 5.10). While the guild-war-dialogs
	     flag is on, the game window makes, when the guild master receives a
	     declaration, nui_guild_war_accept.AcceptGuildWarDialog, a subclass of
	     the legacy class on proxies: the declaring guild's name and type, its
	     member cap and end score (NOVA-90: each line only when the server
	     sent one), the type buttons that choose the declared type again, OK
	     (/war <name>) and Cancel or the close button (/nowar <name>) are
	     legacy's code. A
	     modal (D12) above the legacy UI layer, which the scrim centers. It
	     has no field, and legacy's dialog handles no key. Each type button
	     shows its hint (the type's title and descriptions, legacy's tooltip)
	     on hover. The buttons take no focus and act on a left mousedown. -->
	<title>guild-war-accept</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="guild-war-accept.rcss"/>
</head>
<body template="nui" class="nui-scrim nui-fx guild-war guild-war-accept" data-model="guild_war_accept"
      data-event-mousedown="board_press(ev.button)">
	<div class="nui-window nui-fx nui-dialog nui-anim guild-war__window" id="guild-war-accept">
		<div class="nui-window__titlebar guild-war__titlebar">
			<handle class="nui-window__handle guild-war__handle" move_target="guild-war-accept">
				<span class="nui-window__title guild-war__title">@ui.GUILD_WAR_ACCEPT</span>
			</handle>
			<button id="guild-war-accept-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim"
			        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
				class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
		</div>
		<div class="nui-window__body guild-war__body">
			<div class="guild-war__row guild-war__row--enemy"><span class="guild-war__label">@ui.GUILD_WAR_ENEMY</span><div
				class="guild-war__slot"><span class="guild-war__crest"></span><span id="guild-war-accept-name" class="guild-war__name"><nui-text links="off"
				data-attr-value="name"/></span></div></div>
			<div class="guild-war__row guild-war__row--limit guild-war__row--members" data-if="members_shown &amp;&amp; members != ''"><span
				id="guild-war-accept-members" class="guild-war__limit-line">{{ members }}</span></div>
			<div class="guild-war__row guild-war__row--limit guild-war__row--score" data-if="score_shown &amp;&amp; score != ''"><span
				id="guild-war-accept-score" class="guild-war__limit-line">{{ score }}</span></div>
			<div class="guild-war__row guild-war__row--type" data-if="type_select"><span class="guild-war__label">@ui.GUILD_WAR_BATTLE_TYPE</span><div
				class="guild-war__types"><button class="nui-button nui-anim nui-has-tooltip guild-war__type" data-for="h, i : hints"
				data-attr-id="'guild-war-type-' + i" data-class-guild-war__type--0="i == 0" data-class-guild-war__type--1="i == 1"
				data-class-guild-war__type--2="i == 2" data-class-is-selected="i == type"
				data-event-mousedown="type_press(i, ev.button)"><span class="guild-war__type-label">{{ h.label }}</span><span
				class="nui-tooltip nui-tooltip--wrap nui-anim guild-war__hint"><span class="guild-war__hint-title">{{ h.title }}</span><span
				class="guild-war__hint-line" data-for="line : h.lines">{{ line }}</span></span></button></div></div>
		</div>
		<div class="nui-window__footer nui-dialog__footer guild-war__footer">
			<!-- OK first, then Cancel: legacy's order (OK at 49, Cancel at 120),
			     which the reviewed design keeps. -->
			<button id="guild-war-accept-ok" class="nui-button nui-button--medium nui-button--primary nui-anim guild-war__button guild-war__button--accept"
			        data-event-mousedown="accept_press(ev.button)"><span class="guild-war__button-label">@ui.OK</span></button>
			<button id="guild-war-accept-cancel" class="nui-button nui-button--medium nui-anim guild-war__button guild-war__button--cancel"
			        data-event-mousedown="cancel_press(ev.button)"><span class="guild-war__button-label">@ui.CANCEL</span></button>
		</div>
	</div>
</body>
</rml>
