/* The guild war boards' modern look: a column of small panels 10dp from the
   left and 50dp from the bottom, the first war at the bottom and each later
   one above it, 4dp apart. A board holds two rows 18dp apart: the guild's
   mark (16 x 12) and its text, 20dp in. Its width follows its longest text,
   where legacy computes 30 + longest name * 6 + 40. Classic (the thin
   board, 50dp tall, the marks at 10, 10 + 18k and the texts at 30, 10 + 18k,
   uiguild.py:396-428): skins/classic/windows/guild-war.rcss. */

body.guild-war
{
	focus: none;
	tab-index: none;
}
.guild-war__column
{
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 4dp;
	position: absolute;
	left: 10dp;
	bottom: 50dp;
}
.guild-war__slot
{
	display: block;
}
.nui-panel.guild-war__board
{
	display: block;
	padding: 6dp 10dp 6dp 8dp;
	font-size: var(--font-sm);
	color: var(--text);
}
.guild-war__row-slot
{
	display: block;
}
.guild-war__row
{
	display: block;
	position: relative;
	height: 18dp;
	padding-left: 22dp;
	line-height: 18dp;
	white-space: nowrap;
}
.guild-war__mark
{
	position: absolute;
	left: 0;
	top: 3dp;
	width: 16dp;
	height: 12dp;
}
