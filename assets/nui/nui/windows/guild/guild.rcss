/* The guild window's modern look (P16 spec 5.9.2; the skins stage's
   WGuild* boards): a 500 x 500dp window, a page icon, the page's name and
   the window's key as its title, the shown page in the body and the six
   tabs in a well at its bottom (the base page's disabled, as legacy's),
   their labels on two lines where they need it, never cut. The info page
   is two cards (the guild's values with the offer; the mark, the uploads,
   the enemies and the war declaration), each under a title bar with a
   rule after its title; the comments, the members and the grades are
   tables of rows with wells for their values (a member's online dot
   before its name, the player's own line accented); the skills three cards of
   cells over the dragon power. Controls hover with the surface's hover
   color; checks are wells that hold an accent check mark. The controller
   centers it on the screen at its first open (P18; legacy's place, the
   screen's corner, was D21) and keeps a dragged place after it; the sheet
   centers it on any frame at least 640dp wide, as the client does, and
   puts it 16dp from the corner of a smaller one. Classic (legacy's
   376 x 356 board, the locale's tab art, every place of the uiscripts and
   of uiguild.py's page builders at 1dp per pixel):
   skins/classic/windows/guild.rcss. */

body.guild
{
	display: flex;
	flex-direction: column;
	left: 16dp;
	top: 16dp;
	width: 500dp;
	height: 500dp;
	min-width: 0;
	focus: none;
	tab-index: none;
}
/* The screen's center, as the controller's center() places it: the
   runtime's placement takes the margins into account, so a placed or
   dragged window stays where it is put. */
@media (min-width: 640dp)
{
	body.guild
	{
		left: 50%;
		top: 50%;
		margin-left: -250dp;
		margin-top: -250dp;
	}
}
.guild button
{
	tab-index: none;
	focus: none;
}
/* The post button parks the focus when a legacy edit line takes wndMgr's
   (a button takes no keys). */
.guild .guild__post
{
	focus: auto;
}
.guild__titlebar
{
	flex: 0 0 auto;
}
.guild__handle
{
	display: flex;
	flex-direction: row;
	align-items: center;
}
/* The page's icon: a glyph in an accent tile. */
.guild__title-icon
{
	display: flex;
	flex: 0 0 auto;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 24dp;
	height: 24dp;
	margin-right: 8dp;
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	background-color: var(--selection);
	line-height: 22dp;
}
.guild__title-icon .nui-glyph
{
	--glyph-ink: var(--accent);
}
.guild__title
{
	display: block;
	flex: 0 1 auto;
	min-width: 0;
	overflow: hidden;
}
/* The window's key (legacy's G), as a key cap. */
.guild__title-key
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	min-width: 16dp;
	height: 16dp;
	margin-left: 8dp;
	padding: 0 3dp;
	border-width: 1dp 1dp 2dp 1dp;
	border-color: var(--border);
	border-radius: 4dp;
	color: var(--text-muted);
	font-size: 10dp;
	font-weight: bold;
	line-height: 13dp;
	text-align: center;
}
.guild__body
{
	display: block;
	position: relative;
	flex: 1 1 0;
	min-height: 0;
	padding: 0;
}
.guild__page
{
	display: block;
	position: absolute;
	left: var(--space-3);
	top: 10dp;
	right: var(--space-3);
	bottom: 10dp;
}
/* Labels on buttons take no pointer, so a press is the button's. */
.guild__button-label, .guild__tab-label
{
	pointer-events: none;
}

/* --- Shared parts ---------------------------------------------------------------------- */

/* A card: a raised panel under a title bar. */
.guild__card, .guild__skill-panel
{
	display: block;
	box-sizing: border-box;
	padding: 0;
	background-color: var(--surface-raised);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 9dp;
}
.guild__card
{
	position: absolute;
	top: 0;
	bottom: 0;
}
/* A card's title bar: the title, then a rule to the bar's end. */
.guild__bar
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 28dp;
	margin: 0;
	padding: 0 10dp;
	border-bottom-width: 1dp;
	border-bottom-color: var(--border);
	border-radius: 8dp 8dp 0 0;
	decorator: linear-gradient(180deg, var(--surface-hover) 0%, var(--surface-raised) 100%);
	white-space: nowrap;
}
.guild__bar-title
{
	display: block;
	flex: 0 1 auto;
	min-width: 0;
	overflow: hidden;
	font-size: var(--font-sm);
	font-weight: bold;
	color: var(--text-muted);
	letter-spacing: 0.4dp;
}
.guild__bar-line
{
	display: block;
	flex: 1 1 0;
	height: 1dp;
	margin-left: 9dp;
	background-color: var(--border);
}
/* A value's label: two lines where a locale needs them (de
   "Durchschnittliches Level"), never cut. */
.guild__label
{
	display: block;
	flex: 0 0 auto;
	width: 100dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
	line-height: 12dp;
	white-space: normal;
}
.guild__value
{
	display: block;
	flex: 1 1 0;
	min-width: 0;
	color: var(--text);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
/* A value's well. */
.guild__field .guild__value, .guild__value--base
{
	box-sizing: border-box;
	height: 26dp;
	padding: 0 var(--space-2);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 6dp;
	background-color: var(--surface-sunken);
	font-weight: bold;
	line-height: 24dp;
	text-align: center;
}
/* A table's head: small bold muted labels over a rule, on two lines
   where a locale needs them and never cut (the board's capitals would not
   fit the columns in every locale). */
.guild__head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 30dp;
	border-bottom-width: 1dp;
	border-bottom-color: var(--border);
	color: var(--text-muted);
	font-size: 10dp;
	font-weight: bold;
	line-height: 11dp;
}
.guild__head-cell
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	white-space: normal;
}
/* A check: an 18dp well that holds an accent check mark while checked. */
.guild__check
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 18dp;
	height: 18dp;
	padding: 0;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 5dp;
	background-color: var(--surface-sunken);
}
.guild__check:hover
{
	border-color: var(--text-muted);
}
.guild__check-mark
{
	display: none;
	position: absolute;
	left: 3dp;
	top: 3dp;
	width: 8dp;
	height: 4dp;
	border-width: 0 0 2dp 2dp;
	border-color: var(--accent);
	transform: rotate(-45deg);
	pointer-events: none;
}
.guild__check.is-checked .guild__check-mark
{
	display: block;
}
.guild__tip
{
	left: auto;
	right: 0;
	margin-right: 0;
	margin-left: -320dp;
}

/* --- The info page --------------------------------------------------------------------- */

.guild__card--values
{
	left: 0;
	width: 242dp;
}
.guild__card--mark
{
	right: 0;
	width: 224dp;
}
.guild__field
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 26dp;
	margin: 0 10dp 7dp;
}
.guild__field--name { margin-top: 10dp; }
.guild__field .guild__label
{
	margin-right: 7dp;
}
.guild__offer
{
	flex: 0 0 auto;
	min-width: 55dp;
	height: 22dp;
	margin-left: 7dp;
	padding: 0 7dp;
	border-radius: 6dp;
	font-size: var(--font-sm);
	line-height: 20dp;
}
/* The mark in its frame: a well with an accent ring 5dp in. */
.guild__mark-slot
{
	display: block;
	position: absolute;
	left: 10dp;
	top: 38dp;
	box-sizing: border-box;
	width: 72dp;
	height: 58dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 10dp;
	background-color: var(--surface-sunken);
}
.guild__mark
{
	display: block;
	position: absolute;
	left: 3dp;
	top: 4dp;
	width: 64dp;
	height: 48dp;
}
.guild__mark--nearest
{
	display: none;
}
.guild__mark-ring
{
	display: block;
	position: absolute;
	left: 4dp;
	top: 4dp;
	right: 4dp;
	bottom: 4dp;
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	pointer-events: none;
}
.guild__mark-buttons
{
	display: block;
	position: absolute;
	left: 92dp;
	top: 41dp;
	right: 10dp;
}
/* 10dp: the widest label (dk "Upload Ordenssymbol") fits. */
.guild__upload
{
	display: block;
	width: 100%;
	height: 22dp;
	margin-bottom: 7dp;
	padding: 0 var(--space-1);
	border-radius: 6dp;
	font-size: 10dp;
	line-height: 20dp;
}
.guild__bar--enemies
{
	position: absolute;
	left: 0;
	top: 106dp;
	right: 0;
	border-radius: 0;
}
.guild__enemies
{
	display: block;
	position: absolute;
	left: 10dp;
	top: 142dp;
	right: 10dp;
}
/* An enemy: a well with a danger diamond before the name. */
.guild__enemy
{
	display: block;
	position: relative;
	box-sizing: border-box;
	height: 28dp;
	margin-bottom: 6dp;
	padding: 0 var(--space-2) 0 22dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 6dp;
	background-color: var(--surface-sunken);
	line-height: 26dp;
	color: var(--text);
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
.guild__enemy-mark
{
	display: block;
	position: absolute;
	left: 8dp;
	top: 10dp;
	width: 5dp;
	height: 5dp;
	background-color: var(--danger);
	opacity: 0.75;
	transform: rotate(45deg);
}
.guild__declare
{
	display: block;
	position: absolute;
	left: auto;
	right: 10dp;
	bottom: 10dp;
	height: 28dp;
	line-height: 26dp;
}

/* --- The board page -------------------------------------------------------------------- */

.guild__head--board
{
	position: relative;
}
.guild__head-name
{
	display: block;
	width: 154dp;
	padding-left: 24dp;
}
.guild__head-text
{
	display: block;
	flex: 1 1 0;
}
.guild__refresh
{
	position: absolute;
	right: 0;
	top: 3dp;
	width: 24dp;
	height: 24dp;
}
/* The refresh mark: an open accent ring (a box with three borders). */
.guild__refresh-mark
{
	display: block;
	position: absolute;
	left: 5dp;
	top: 5dp;
	width: 10dp;
	height: 10dp;
	border-width: 2dp;
	border-color: var(--accent) var(--accent) var(--accent) transparent;
	border-radius: 7dp;
	transform: rotate(45deg);
	pointer-events: none;
}
.guild__comments
{
	display: block;
}
.guild__comment
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: relative;
	box-sizing: border-box;
	height: 26dp;
	margin-bottom: 2dp;
	padding: 0 2dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 6dp;
	background-color: var(--surface-raised);
	white-space: nowrap;
}
.guild__comment:hover
{
	background-color: var(--surface-hover);
}
/* A notice: a warning edge, a warm tint and its "!". */
.guild__comment.is-notice
{
	border-left-width: 3dp;
	border-left-color: var(--warning);
}
.guild__notice-tint
{
	display: none;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	border-radius: 0 5dp 5dp 0;
	background-color: var(--warning);
	opacity: 0.1;
	pointer-events: none;
}
.guild__comment.is-notice .guild__notice-tint
{
	display: block;
}
.guild__notice
{
	display: block;
	flex: 0 0 auto;
	width: 16dp;
	height: 14dp;
	margin-right: 6dp;
	color: transparent;
	font-weight: bold;
	line-height: 14dp;
	text-align: center;
}
.guild__comment.is-notice .guild__notice
{
	margin-left: -2dp;
	color: var(--warning);
}
.guild__comment-name
{
	display: block;
	flex: 0 0 124dp;
	margin-right: 6dp;
	font-weight: bold;
	color: var(--text);
	overflow: hidden;
	text-overflow: ellipsis;
}
.guild__comment-text
{
	display: block;
	position: relative;
	flex: 1 1 0;
	min-width: 0;
	color: var(--text);
	overflow: hidden;
}
.guild__comment-full
{
	display: none;
}
/* A long comment shows its whole text on hover, over the row. */
.guild__comment.is-long:hover .guild__comment-text
{
	overflow: visible;
}
.guild__comment.is-long:hover .guild__comment-short
{
	display: none;
}
.guild__comment.is-long:hover .guild__comment-full
{
	display: inline;
	padding: 2dp var(--space-1);
	background-color: var(--surface-raised);
}
/* The delete button: a 22dp well with the close glyph. */
.guild__delete
{
	flex: 0 0 auto;
	width: 22dp;
	height: 22dp;
	margin-left: 6dp;
	border-radius: 5dp;
	line-height: 20dp;
	background-color: var(--surface-sunken);
	border-color: var(--border);
}
.guild__delete .nui-glyph
{
	transform: scale(0.75);
}
.guild__post-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: absolute;
	left: var(--space-3);
	right: var(--space-3);
	bottom: 10dp;
	height: 28dp;
}
.guild__post-slot
{
	display: block;
	flex: 1 1 0;
	min-width: 0;
	margin-right: 7dp;
}
.guild__comment-field
{
	width: 100%;
	focus: auto;
}
.guild__post
{
	flex: 0 0 auto;
	width: 30dp;
	height: 28dp;
	padding: 0;
}
.guild__post .nui-glyph
{
	--glyph-ink: var(--accent-text);
}

/* --- The member page ------------------------------------------------------------------- */

/* The columns: name, grade, job, level, offer and general, 5dp apart. */
.guild__head--member
{
	margin-right: 10dp;
	padding: 0 12dp 0 8dp;
}
.guild__head-cell--name, .guild__member-name { width: 126dp; }
.guild__head-cell--grade, .guild__combo-box { width: 82dp; margin-left: 5dp; }
.guild__head-cell--job, .guild__member-cell--job { width: 65dp; margin-left: 5dp; text-align: center; }
.guild__head-cell--level, .guild__member-cell--level { width: 41dp; margin-left: 5dp; text-align: center; }
.guild__head-cell--offer, .guild__member-cell--offer { width: 59dp; margin-left: 5dp; text-align: center; }
.guild__head-cell--general { width: 47dp; margin-left: 5dp; text-align: center; }
.guild__head-cell--grade { text-align: center; }
.guild__members
{
	display: block;
	position: relative;
	margin-right: 10dp;
	padding-top: 4dp;
}
.guild__member
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 26dp;
	margin-bottom: 2dp;
	padding: 0 12dp 0 7dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 6dp;
	background-color: var(--surface-raised);
	white-space: nowrap;
}
.guild__member:hover
{
	background-color: var(--surface-hover);
}
/* The player's own line: the selection fill, a 3dp accent edge on its
   left (its padding 2dp narrower, so every cell stays put), the name bold
   in the highlight color. */
.guild__member.is-self
{
	padding-left: 5dp;
	border-left-width: 3dp;
	border-left-color: var(--accent);
	background-color: var(--selection);
}
.guild__member.is-self .guild__member-name
{
	color: var(--highlight);
	font-weight: bold;
}
/* A member's online dot before its name: the success color while online,
   the muted ink, fainter, while offline. */
.guild__online
{
	display: inline-block;
	width: 6dp;
	height: 6dp;
	margin-right: 6dp;
	border-radius: 3dp;
	background-color: var(--text-muted);
	opacity: 0.6;
	vertical-align: middle;
}
.guild__online.is-online
{
	background-color: var(--success);
	opacity: 1;
}
.guild__member-name, .guild__member-cell
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	color: var(--text);
	overflow: hidden;
	text-overflow: ellipsis;
}
.guild__combo-box
{
	display: block;
	box-sizing: border-box;
	position: relative;
	flex: 0 0 auto;
	height: 20dp;
	padding-right: 0;
}
.guild__combo
{
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 20dp;
	padding: 0 var(--space-1);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 5dp;
	background-color: var(--surface-sunken);
	color: var(--text-muted);
	line-height: 18dp;
	text-align: center;
	overflow: hidden;
}
.guild__combo.is-enabled
{
	color: var(--text);
}
.guild__combo.is-enabled:hover
{
	background-color: var(--surface-hover);
}
.guild__combo.is-open
{
	border-color: var(--accent);
}
.guild__combo-text
{
	pointer-events: none;
}
/* The open list under its line's combo box (the lines 28dp apart from
   4dp down, the box 20dp tall in the middle of its 26dp line, 138dp in),
   over the lines below it: one list for the window, placed by its line's
   class. */
.guild__combo-list
{
	display: block;
	position: absolute;
	left: 138dp;
	width: 82dp;
	top: 28dp;
	z-index: 10;
	padding: 2dp 0;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 5dp;
	background-color: var(--surface-raised);
}
.guild__combo-list--0 { top: 28dp; }
.guild__combo-list--1 { top: 56dp; }
.guild__combo-list--2 { top: 84dp; }
.guild__combo-list--3 { top: 112dp; }
.guild__combo-list--4 { top: 140dp; }
.guild__combo-list--5 { top: 168dp; }
.guild__combo-list--6 { top: 196dp; }
.guild__combo-list--7 { top: 224dp; }
.guild__combo-list--8 { top: 252dp; }
.guild__combo-list--9 { top: 280dp; }
.guild__combo-list--10 { top: 308dp; }
.guild__combo-list--11 { top: 336dp; }
.guild__combo-list--12 { top: 364dp; }
.guild__combo-item
{
	display: block;
	height: 18dp;
	padding: 0 var(--space-2);
	line-height: 18dp;
	color: var(--text);
	overflow: hidden;
}
.guild__combo-item:hover
{
	background-color: var(--selection);
}
.guild__member-general
{
	margin-left: 19dp;
}
.guild__member-scroll-box
{
	position: absolute;
	right: 0;
	top: 34dp;
	bottom: 2dp;
	width: 8dp;
}
input.guild__member-scroll
{
	display: block;
	width: 8dp;
	height: 100%;
	focus: none;
}
.guild__member-scroll slidertrack
{
	width: 2dp;
	margin-left: 3dp;
	border-radius: 2dp;
	background-color: var(--border);
}
.guild__member-scroll sliderbar
{
	width: 8dp;
	height: 84dp;
	border-radius: 4dp;
	background-color: var(--text-muted);
}
.guild__member-scroll sliderbar:hover, .guild__member-scroll sliderbar:active
{
	background-color: var(--accent);
}
.guild__member-scroll sliderprogress
{
	display: none;
}
.guild__member-scroll sliderarrowdec, .guild__member-scroll sliderarrowinc
{
	width: 0;
	height: 0;
}

/* --- The base page ------------------------------------------------------------------------ */

.guild__base-name
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 36dp;
	margin: 0 68dp 8dp;
}
.guild__base-name .guild__label
{
	width: 110dp;
	margin-right: 8dp;
	font-size: var(--font-md);
	font-weight: bold;
}
.guild__bar--resources, .guild__bar--buildings
{
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 9dp 9dp 0 0;
}
.guild__resources
{
	display: flex;
	flex-direction: row;
	box-sizing: border-box;
	height: 69dp;
	margin-bottom: 8dp;
	padding: 7dp;
	border-width: 0 1dp 1dp 1dp;
	border-color: var(--border);
	border-radius: 0 0 9dp 9dp;
	background-color: var(--surface-raised);
}
.guild__resource
{
	display: block;
	flex: 1 1 0;
	min-width: 0;
	margin-right: 5dp;
	text-align: center;
}
/* A resource's name: two lines where a locale needs them, never cut. */
.guild__resource-name
{
	display: block;
	height: 20dp;
	font-size: 9dp;
	line-height: 10dp;
	color: var(--text-muted);
	white-space: normal;
}
.guild__resource-value
{
	display: block;
	box-sizing: border-box;
	height: 24dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 5dp;
	background-color: var(--surface-sunken);
	font-weight: bold;
	line-height: 22dp;
}
.guild__basket
{
	display: flex;
	flex-direction: column;
	justify-content: center;
	flex: 1.5 1 0;
	min-width: 0;
	border-width: 0;
	color: var(--accent);
	font-size: 10dp;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
}
.guild__basket-line
{
	display: block;
}
.guild__head--base
{
	box-sizing: border-box;
	height: 28dp;
	padding: 0 7dp;
	background-color: var(--surface-raised);
	border-width: 0 1dp 1dp;
	border-color: var(--border);
}
.guild__head-cell--building { width: 104dp; padding-left: var(--space-1); }
.guild__head-cell--rank { width: 48dp; }
/* A cost column's resource (legacy's six names, the resources card's):
   centered over its cell and as wide as its column (the cell and the gap
   after it), in the resources card's small type, on two lines where a
   locale needs them (a long word breaks rather than run into the next). */
.guild__head-cell--cost
{
	width: 41dp;
	font-size: 9dp;
	font-weight: normal;
	line-height: 10dp;
	text-align: center;
	word-break: break-word;
}
.guild__head-cell--operate { margin-left: auto; padding-right: var(--space-1); }
.guild__buildings
{
	display: block;
	padding: 3dp 7dp 4dp;
	border-width: 0 1dp 1dp;
	border-color: var(--border);
	border-radius: 0 0 9dp 9dp;
	background-color: var(--surface-raised);
}
.guild__building
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 25dp;
	margin-bottom: 2dp;
	padding: 1dp 0;
	color: var(--text-muted);
	font-size: var(--font-sm);
	white-space: nowrap;
}
.guild__building-name, .guild__building-grade, .guild__building-gem
{
	display: block;
	box-sizing: border-box;
	height: 23dp;
	margin-right: 4dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 5dp;
	background-color: var(--surface-sunken);
	line-height: 21dp;
	text-align: center;
	overflow: hidden;
	text-overflow: ellipsis;
}
.guild__building-name { width: 108dp; text-align: left; padding-left: 6dp; }
.guild__building-grade { width: 38dp; }
.guild__building-gem { width: 37dp; }
.guild__building-power { margin-left: auto; margin-right: 8dp; }

/* --- The skill page --------------------------------------------------------------------------- */

/* Three cards of cells (the grid of nine centered in each) and the dragon
   power's card at the page's bottom. */
.guild__skill-panel
{
	height: 100dp;
	margin-bottom: 7dp;
}
.guild__skill-panel--affect
{
	height: 124dp;
}
.guild__bar--passive, .guild__bar--active, .guild__bar--affect
{
	height: 26dp;
}
.guild__bar--passive
{
	position: relative;
}
/* The skill points: a badge at the passive bar's end, apart from its
   title, the word "available" before the count (legacy's "available" art
   is the classic look's). */
.guild__points
{
	display: block;
	position: absolute;
	right: 10dp;
	top: 4dp;
	box-sizing: border-box;
	min-width: 22dp;
	height: 17dp;
	padding: 0 7dp;
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 9dp;
	background-color: var(--selection);
	color: var(--accent);
	font-size: var(--font-sm);
	font-weight: bold;
	line-height: 15dp;
	text-align: center;
}
.guild__points-art
{
	display: none;
}
.guild__points-label
{
	margin-right: var(--space-1);
	font-weight: normal;
}
.guild__skills
{
	margin: 7dp auto 0;
}
/* A skill of level 0 (legacy's disabled cover): its icon dimmed. */
.guild__skill.is-unavailable .nui-slot__icon
{
	opacity: 0.4;
}
/* A cooling skill's seconds left (a nui-countdown), centered on its icon
   over the sweep: light bold digits with a dark outline. */
.guild__skill-left
{
	display: block;
	position: absolute;
	left: 3dp;
	top: 3dp;
	width: 32dp;
	height: 32dp;
	z-index: 4;
	color: var(--text-inverse);
	font-size: var(--font-md);
	font-weight: bold;
	line-height: 32dp;
	text-align: center;
	font-effect: outline(1dp var(--text-outline));
	pointer-events: none;
}
/* A skill's "+": a small button at the cell's bottom left corner. */
.guild__plus
{
	display: block;
	position: absolute;
	left: 1dp;
	bottom: 1dp;
	width: 15dp;
	height: 15dp;
	padding: 0;
	border-radius: 4dp;
	background-color: var(--slot-locked);
	line-height: 15dp;
	z-index: 2;
}
.guild__plus .nui-glyph
{
	--glyph-ink: var(--warning);
	transform: scale(0.75);
}
.guild__plus:hover
{
	background-color: var(--surface-hover);
}
.guild__power
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	box-sizing: border-box;
	height: 52dp;
	padding: 0 10dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 9dp;
	background-color: var(--surface-raised);
}
.guild__power-title
{
	display: block;
	flex: 0 0 auto;
	margin-right: 10dp;
	color: var(--text-muted);
	font-weight: bold;
}
.guild__gauge-slot
{
	display: block;
	flex: 1 1 0;
	min-width: 0;
}
progress.guild__gp--ratio
{
	width: 100%;
	height: 8dp;
}
progress.guild__gp--legacy
{
	display: none;
}
.guild__power-value
{
	display: block;
	flex: 0 0 auto;
	min-width: 68dp;
	margin: 0 8dp 0 12dp;
	color: var(--text);
	font-size: 13dp;
	text-align: center;
}
.guild__heal
{
	flex: 0 0 auto;
	height: 28dp;
	padding: 0 var(--space-3);
	line-height: 26dp;
}

/* --- The grade page ---------------------------------------------------------------------------- */

/* The columns: the number (40dp), the name (100dp) and the four rights
   (70dp each, their checks in the middle), 7dp apart. */
.guild__head--grade
{
	height: 29dp;
	padding: 0 7dp;
}
.guild__head-cell--number, .guild__grade-number { width: 40dp; text-align: center; }
.guild__head-cell--grade-name { width: 100dp; margin-left: 7dp; text-align: center; }
.guild__head-cell--auth { width: 70dp; margin-left: 7dp; text-align: center; }
.guild__grades
{
	display: block;
	padding: 4dp 7dp 0;
}
.guild__grade
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 23dp;
	margin-bottom: 2dp;
	white-space: nowrap;
}
.guild__grade-number
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	height: 21dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 5dp;
	background-color: var(--surface-sunken);
	color: var(--text-muted);
	line-height: 19dp;
}
.guild__grade-name
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 100dp;
	height: 21dp;
	margin: 0 0 0 7dp;
	padding: 0 var(--space-1);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 5dp;
	background-color: var(--surface-sunken);
	color: var(--text);
	line-height: 19dp;
	text-align: center;
	overflow: hidden;
}
.guild__grade-name:hover
{
	background-color: var(--surface-hover);
}
.guild__auth
{
	flex: 0 0 auto;
	margin-left: 59dp;
}
.guild__auth--1
{
	margin-left: 33dp;
}
/* Grade 1 (the master's) is not editable: no hover, no press (legacy's
   disabled slots and checks keep the pointer and ignore it). */
.guild__grade.is-disabled .guild__grade-name,
.guild__grade.is-disabled .guild__check
{
	opacity: 0.55;
}
.guild__grade.is-disabled .guild__grade-name:hover
{
	background-color: var(--surface-sunken);
}
.guild__grade.is-disabled .guild__check:hover
{
	border-color: var(--border);
}

/* --- The tabs ---------------------------------------------------------------------------- */

/* A segmented well of five tabs, each as wide as its label and an even
   share of the room left. A label longer than 108dp (the longest one-word
   label of the 17 locales, de "Gildeninformationen", fits) takes two lines,
   and when the row is still full (French, Spanish) every tab gives up room
   in proportion and its label wraps again; none is cut. The board's equal
   tabs with 60dp labels would cut the German and Danish one-word labels. */
.guild__tabs
{
	display: flex;
	flex-direction: row;
	box-sizing: border-box;
	flex: 0 0 auto;
	height: 30dp;
	margin: 0 var(--space-3) var(--space-3);
	padding: 2dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 9dp;
	background-color: var(--surface-sunken);
}
.guild__tab-art
{
	display: none;
}
.guild__tab
{
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	flex: 1 1 auto;
	min-width: 0;
	height: 24dp;
	padding: 0 3dp;
	border-width: 1dp;
	border-color: transparent;
	border-radius: 6dp;
	background-color: transparent;
	color: var(--text-muted);
	font-size: 10dp;
	font-weight: bold;
	line-height: 10dp;
	text-align: center;
	white-space: normal;
}
.guild__tab:hover
{
	background-color: var(--surface-hover);
	color: var(--text);
}
.guild__tab.is-selected
{
	border-color: var(--border);
	background-color: var(--surface-raised);
	color: var(--text);
}
.guild__tab-label
{
	display: block;
	flex: 0 1 auto;
	min-width: 0;
	max-width: 108dp;
	white-space: normal;
}
/* The base page's tab: disabled, as legacy's (zero wide there). */
.guild__tab[disabled]
{
	display: none;
}
