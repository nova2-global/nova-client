/* The help's modern look (P11 spec D14; the reviewed design, board WHelp):
   a centered card on the scrim under its title row, the 20 lines in two
   columns under the "Controls" heading, each on a cell with an accent
   bullet, the taskbar pointers' texts under the "Taskbar guide" heading
   as a grid of tiles, four to a row, each with its glyph (the
   pointers aim at the legacy taskbar's places, which the modern taskbar
   does not keep, so their art is hidden), and Close centered in the
   footer. Classic (legacy's layout over the whole screen):
   skins/classic/windows/help.rcss. */
/* The modal's body takes the focus when it shows (RmlUi's FocusFlag::Auto
   needs a focusable element), so its keydown handler hears Escape and H;
   the button takes none, so a press keeps the focus on the body. */
body.help
{
	tab-index: none;
}
.help button
{
	focus: none;
	tab-index: none;
}
/* Classic's curtain parts; the modern scrim dims the whole screen. */
.help__curtain
{
	display: none;
}
/* 800dp with its padding and border: each column holds the longest English
   line (HELP_SCREEN_CAPTURE) on one line; a longer translation wraps in its
   cell. The card is never taller than the screen (about 480dp: 998 px at
   200% on a 900 px screen): the title, the pointers' tiles and Close stay,
   and the lines scroll. */
.help__card
{
	box-sizing: border-box;
	width: 800dp;
	max-height: 100vh;
	display: flex;
	flex-direction: column;
	padding: 0 18dp 0 18dp;
}
.help__heading, .help__intro, .help__guide, .help__sticks, .help__footer
{
	flex: 0 0 auto;
}
.help__lines
{
	flex: 1 1 auto;
	overflow-y: auto;
}
/* The title row, as a title bar: the glyph on the accent's soft tile, the
   title, a rule under them across the card. */
.help__heading
{
	display: block;
	height: 36dp;
	margin: 0 -18dp 10dp -18dp;
	padding: 0 14dp;
	border-bottom-width: 1dp;
	border-bottom-color: var(--border);
	color: var(--text);
	font-size: 13dp;
	font-weight: bold;
	line-height: 36dp;
}
.help__icon
{
	display: inline-block;
	box-sizing: border-box;
	width: 24dp;
	height: 24dp;
	margin: -2dp var(--space-2) 0 0;
	padding: 3dp;
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	background-color: var(--selection);
	line-height: 16dp;
	vertical-align: middle;
}
/* An open book, two pages on one spine (the system menu's Help). */
.help__glyph
{
	--glyph-ink: var(--accent);
	display: block;
}
.help__glyph .nui-glyph__a, .help__glyph .nui-glyph__b
{
	top: 2dp;
	width: 7dp;
	height: 12dp;
	border-width: 2dp;
}
.help__glyph .nui-glyph__a
{
	left: 1dp;
	border-radius: 2dp 0 0 2dp;
}
.help__glyph .nui-glyph__b
{
	left: 8dp;
	border-radius: 0 2dp 2dp 0;
}

/* "Controls" (underlined) and the reference note at the right, over the
   lines; "Taskbar guide" and the parts' count on a rule across the card,
   over the tiles. They keep the card (with its shadow) within a 720dp
   screen. */
.help__intro, .help__guide
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	white-space: nowrap;
}
.help__intro
{
	margin-bottom: 6dp;
}
.help__intro-title, .help__guide-title
{
	color: var(--text-muted);
	font-size: var(--font-sm);
	font-weight: bold;
	line-height: 14dp;
}
.help__intro-title
{
	padding-bottom: 4dp;
	border-bottom-width: 1dp;
	border-bottom-color: var(--border);
}
.help__intro-note
{
	margin-left: var(--space-3);
	color: var(--text-muted);
	font-size: var(--font-sm);
}
.help__guide
{
	margin: 8dp 0 6dp 0;
	padding-bottom: 4dp;
	border-bottom-width: 1dp;
	border-bottom-color: var(--border);
}
.help__guide-badge
{
	margin-left: var(--space-3);
}

.help__lines, .help__sticks
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
/* Two columns read down, in legacy's order, 16dp apart. */
.help__column
{
	display: block;
	box-sizing: border-box;
	width: 50%;
}
.help__column:first-child
{
	padding-right: var(--space-2);
}
.help__column + .help__column
{
	padding-left: var(--space-2);
}
.help__line
{
	display: block;
	position: relative;
	box-sizing: border-box;
	min-height: 24dp;
	margin: 0 0 3dp 0;
	padding: 3dp 8dp 3dp 23dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 6dp;
	background-color: var(--surface-sunken);
	color: var(--text);
	font-size: var(--font-sm);
	line-height: 16dp;
}
/* The bullet: an accent diamond. */
.help__bullet
{
	display: block;
	position: absolute;
	left: 9dp;
	top: 8dp;
	width: 5dp;
	height: 5dp;
	background-color: var(--accent);
	transform: rotate(45deg);
}

/* The pointers' texts: tiles, four to a row, each with its glyph and its
   labels centered on the tile's height, under their heading. */
.help__sticks
{
	gap: 7dp;
}
.help-stick
{
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	align-content: center;
	position: relative;
	box-sizing: border-box;
	flex: 1 1 22%;
	min-height: 48dp;
	padding: 6dp 6dp 6dp 32dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: var(--radius-lg);
	background-color: var(--surface-sunken);
	color: var(--text-muted);
	font-size: var(--font-sm);
	line-height: 14dp;
}
.help-stick__glyph
{
	--glyph-ink: var(--text-muted);
	position: absolute;
	left: 9dp;
	top: 50%;
	margin-top: -8dp;
}
.help-stick__art
{
	display: none;
}
.help-stick__label
{
	display: block;
	margin-right: 4dp;
}
/* The footer spans the card's width, out of its side padding; Close in its
   middle. */
.help__footer
{
	justify-content: center;
	margin: 12dp -18dp 0 -18dp;
}
.help__close
{
	min-width: 110dp;
}
