<rml>
<head>
	<!-- The inventory (uiinventory.py InventoryWindow, uiscript
	     inventorywindow.py; P14 spec 6.1). While the inventory flag is on,
	     the Interface makes nui_inventory.InventoryWindow (controller
	     assets/root/nui_inventory.py), a subclass of the legacy class whose
	     widgets are proxies: every flow, packet, question and rule is
	     legacy's code, and this document shows what legacy's refresh tells
	     the proxies. It exists only while the inventory shows
	     (nui_hud.OnDemand). The wear cells are the equipment group of the
	     wear table (nui_limits), placed by name (inv-wear--<name>) in each
	     skin's sheet; the bag is a lean slot grid of INVENTORY_PAGE_SIZE
	     cells, one page at a time; the page tabs, the bag's columns and the
	     money's digits come from the limits module too. Cell events reach the
	     legacy handlers through nui_slots.LegacySlotEvents (pick and place
	     through the legacy mouse controller). The body and its controls take
	     no focus, so controls act on a left mousedown. It draws below the
	     legacy UI layer (nui-below-legacy-ui), as legacy's window lived in
	     it, so the shop, exchange and safebox windows opened over it cover
	     it; the belt docks to inv-belt-dock. A left or right
	     press anywhere on it raises the window (board_press), as legacy's
	     window manager raised the window under a press. -->
	<title>inventory</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="inventory.rcss"/>
</head>
<body template="nui" id="inventory" class="nui-window nui-fx nui-anim nui-below-legacy-ui inv" data-model="inventory" data-event-mousedown="board_press(ev.button)"
      data-class-inv--table-new="table == 'new'" data-class-inv--table-old="table == 'old'"
      data-class-inv--tabs-small="size(pages) > 2" data-class-inv--placed="placed">
	<div class="nui-window__titlebar inv__titlebar">
		<handle id="inv-title" class="nui-window__handle inv__handle" move_target="#document">
			<span class="nui-window__title inv__title">@ui.INVENTORY_TITLE</span>
		</handle>
		<button id="inv-costume" class="nui-button nui-button--ghost nui-button--icon nui-anim nui-has-tooltip inv-button inv-button--costume"
		        data-if="has_costume" data-event-mousedown="costume_press(ev.button)"><span class="nui-glyph nui-glyph--character"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span><span class="nui-tooltip nui-anim inv-tip">@ui.COSTUME_TITLE</span></button>
		<button id="inv-dss" class="nui-button nui-button--ghost nui-button--icon nui-anim nui-has-tooltip inv-button inv-button--dss"
		        data-if="has_dss" data-class-is-active="dss_active" data-event-mousedown="dss_press(ev.button)"><span class="nui-glyph nui-glyph--gem"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span><nui-frames class="inv-button__effect" data-if="dss_active"
			count="13" delay="0.0667"/><span class="nui-tooltip nui-anim inv-tip">@ui.TASKBAR_DRAGON_SOUL</span></button>
		<button id="inv-mall" class="nui-button nui-button--ghost nui-button--icon nui-anim nui-has-tooltip inv-button inv-button--mall"
		        data-if="has_mall" data-event-mousedown="mall_press(ev.button)"><span class="nui-glyph nui-glyph--shop"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span><span class="nui-tooltip nui-anim inv-tip">@ui.MALL_TITLE</span></button>
		<button id="inv-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim inv__close"
		        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	</div>
	<div class="nui-window__body inv__body">
		<div id="inv-equip" class="inv-equip">
			<div class="inv-figure"><span class="inv-figure__head"></span><span class="inv-figure__body"></span><span
				class="inv-figure__arm inv-figure__arm--left"></span><span class="inv-figure__arm inv-figure__arm--right"></span><span
				class="inv-figure__leg inv-figure__leg--left"></span><span class="inv-figure__leg inv-figure__leg--right"></span></div>
			<div class="inv-wear-place" data-for="w : wear" data-attr-class="'inv-wear-place inv-wear--' + w.name">
				<div class="nui-slot nui-anim inv-wear" data-attr-id="'inv-wear-' + w.name"
				     data-class-is-empty="w.kind == ''" data-class-is-target="w.target == 'move'"
				     data-class-is-blocked="w.target == 'blocked'"
				     data-event-mousedown="wear_press(it_index, ev.button)" data-event-mouseup="wear_release(it_index, ev.button)"
				     data-event-dblclick="wear_use(it_index)" data-event-mouseover="wear_over(it_index)"
				     data-event-mouseout="wear_out(it_index)" data-event-nuidrop="wear_drop(it_index)">
					<img class="nui-slot__icon" data-if="w.icon != ''" data-attr-src="w.icon"/>
					<nui-number class="nui-slot__number" data-if="w.count != ''" data-attr-value="w.count"/>
				</div>
			</div>
			<div id="inv-belt-dock" class="inv-belt-dock"></div>
		</div>
		<div id="inv-tabs" class="inv-tabs">
			<button class="nui-button nui-anim nui-has-tooltip inv-tab" data-for="p : pages" data-attr-id="'inv-tab-' + it_index"
			        data-class-is-selected="it_index == page" data-event-mousedown="page_press(it_index, ev.button)"><span
				class="inv-tab__label">{{ p.label }}</span><span class="nui-tooltip nui-anim inv-tip">{{ p.hint }}</span></button>
		</div>
		<div id="inv-bag" class="nui-slot-grid nui-slot-grid--lean inv-bag"
		     data-class-nui-slot-grid--cols-5="bag_cols == 5" data-class-nui-slot-grid--cols-4="bag_cols == 4">
			<div class="nui-slot nui-anim nui-fx" data-for="c : bag" data-attr-id="'inv-bag-' + it_index"
			     data-class-is-empty="c.kind == '' &amp;&amp; !c.covered" data-class-is-covered="c.covered"
			     data-class-is-picked="c.picked" data-class-is-active="c.active"
			     data-class-is-target="c.target == 'move'" data-class-is-blocked="c.target == 'blocked'"
			     data-class-is-usable="c.target == 'usable'" data-class-is-unusable="c.target == 'unusable'"
			     data-class-nui-slot--h2="c.h == 2" data-class-nui-slot--h3="c.h == 3"
			     data-event-mousedown="bag_press(it_index, ev.button)" data-event-mouseup="bag_release(it_index, ev.button)"
			     data-event-dblclick="bag_use(it_index)" data-event-mouseover="bag_over(it_index)"
			     data-event-mouseout="bag_out(it_index)" data-event-nuidrop="bag_drop(it_index)">
				<img class="nui-slot__icon" data-if="c.icon != ''" data-attr-src="c.icon"/>
				<nui-number class="nui-slot__number" data-if="c.count != ''" data-attr-value="c.count"/>
				<nui-frames class="nui-slot__active" data-if="c.active" count="13" delay="0.0667"/>
			</div>
		</div>
		<div id="inv-money" class="inv-money" data-event-mousedown="money_press(ev.button)">
			<span class="nui-glyph nui-glyph--coin inv-money__coin"><span class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span>
			<span class="inv-money__amount">{{ money }}</span>
		</div>
	</div>
</body>
</rml>
