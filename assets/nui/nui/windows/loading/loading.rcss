/* Loading screen: full screen and opaque, under a body that never takes the
   mouse (nui-overlay). Positions are the legacy screen fractions and sizes
   the legacy pixels in dp (uiscript loadingwindow.py): the board is 400 by
   80 at the horizontal middle and 500/600 of the height, the emblem at its
   top left and the gauge (336 by 30) at (70, 25). The background is the
   loading picture (content) in every theme; the emblem's spinning art is
   classic's (its frames come from skins/classic/windows/loading.rcss), and
   modern turns a ring at its place; the gauge follows the theme. */
body.loading
{
	background-color: var(--surface-sunken);
}

/* Stretched over the whole screen, as legacy scales it by width / image width
   and height / image height. */
.loading-background
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.loading-board
{
	position: absolute;
	left: 50%;
	top: 83.33%;
	width: 400dp;
	height: 80dp;
	margin-left: -200dp;
}

/* The engine's contract for nui-frames (Core/ElementFrames.h): an inline
   flex box takes the size of frame 0, and the frames are blocks. */
.loading-frames
{
	position: absolute;
	left: 0dp;
	top: 0dp;
	display: inline-flex;
}
.loading-frames .nui-frames__frame
{
	display: block;
}

/* Modern: a track ring centered on the emblem's 70 by 74dp place and an
   accent dot that circles on it once a second; only the ring box turns
   (transform only), and reduced motion holds it still. Every part is a
   borderless disc: RmlUi fits a radius into the padding box, so a bordered
   circle would draw flat sides. */
.loading__track, .loading__hole, .loading__ring
{
	display: block;
	position: absolute;
}
.loading__track, .loading__ring
{
	left: 15dp;
	top: 17dp;
	width: 40dp;
	height: 40dp;
}
.loading__track
{
	border-radius: 20dp;
	background-color: var(--border);
}
.loading__hole
{
	left: 21dp;
	top: 23dp;
	width: 28dp;
	height: 28dp;
	border-radius: 14dp;
	background-color: var(--surface);
}
.loading__dot
{
	display: block;
	position: absolute;
	left: 17dp;
	top: 0;
	width: 6dp;
	height: 6dp;
	border-radius: 3dp;
	background-color: var(--accent);
}
.loading__ring.nui-anim
{
	animation: 1s linear-in-out infinite loading-ring-turn;
}
@keyframes loading-ring-turn
{
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}

/* Modern: a track and a fill in tokens, on the middle line of the legacy
   gauge's box. */
progress.loading-gauge
{
	position: absolute;
	left: 70dp;
	top: 36dp;
	width: 336dp;
	height: 8dp;
	background-color: var(--gauge-track);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 4dp;
}
progress.loading-gauge fill
{
	background-color: var(--accent);
	border-radius: 3dp;
}

.loading-error
{
	position: absolute;
	left: 10dp;
	top: 10dp;
	padding: var(--space-1) var(--space-2);
	background-color: var(--surface);
	border-radius: var(--radius-sm);
	color: var(--danger);
}
