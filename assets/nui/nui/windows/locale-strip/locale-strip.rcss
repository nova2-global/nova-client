/* Compact locale dropdown at the top right of the login screen. The current
   locale button holds its flag, native name and chevron. The right-aligned
   menu opens below it and shows every locale without taking focus. */
body.locale-strip
{
	position: absolute;
	right: 20dp;
	top: 20dp;
	min-width: 210dp;
	height: 36dp;
	focus: none;
	tab-index: none;
}
.locale-strip__toggle, .locale-strip__item
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	focus: none;
	tab-index: none;
}
.locale-strip__toggle
{
	width: 100%;
	height: 36dp;
	padding: 0dp 10dp;
	background-color: var(--surface-band);
	border-color: var(--border);
	border-radius: 10dp;
}
.locale-strip__image
{
	display: block;
	flex: 0 0 auto;
	width: 22dp;
	height: 17dp;
}
.locale-strip__name
{
	flex: 1 1 auto;
	min-width: 0;
	color: var(--text);
	text-align: left;
	white-space: nowrap;
}
.locale-strip__chevron
{
	flex: 0 0 auto;
	transform: scale(0.75);
	--glyph-ink: var(--text-muted);
}
.locale-strip__chevron.locale-strip__chevron--up
{
	transform: rotate(180deg) scale(0.75);
}
.locale-strip__menu
{
	display: block;
	position: absolute;
	right: 0dp;
	top: 40dp;
	min-width: 100%;
	padding: 6dp;
}
.locale-strip__entry
{
	display: block;
}
.locale-strip__item
{
	width: 100%;
	height: 28dp;
	padding: 0dp 8dp;
	border-left-width: 2dp;
	border-left-color: transparent;
	border-radius: 6dp;
}
.locale-strip__item.is-selected
{
	border-left-color: var(--accent);
	background-color: var(--selection);
	color: var(--accent);
}
.locale-strip__item.is-selected .locale-strip__name
{
	color: var(--accent);
}
