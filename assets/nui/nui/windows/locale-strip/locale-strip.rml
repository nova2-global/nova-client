<rml>
<head>
	<!-- Compact locale dropdown at the top right of the login screen. It
	     replaces the legacy row of flags while the locale-strip flag is on
	     (controller: assets/root/nui_locale_strip.py). The document never
	     takes focus, so its button and entries act on left mousedown and a
	     login field keeps its caret. A data-for wrapper owns each repeated
	     entry; the child owns item views, as RmlUi 6.3 requires. -->
	<title>locale-strip</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="locale-strip.rcss"/>
</head>
<body template="nui" class="locale-strip" data-model="locale_strip">
	<button id="locale-toggle" class="nui-button nui-button--ghost nui-anim locale-strip__toggle"
	        data-class-is-selected="open" data-event-mousedown="toggle(ev.button)"><img
		class="locale-strip__image" data-attr-src="selected.image"/><span
		class="locale-strip__name">{{ selected.name }}</span><span
		class="nui-glyph nui-glyph--chevron-down locale-strip__chevron" data-class-locale-strip__chevron--up="open"><span
		class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	<div id="locale-menu" class="nui-board nui-fx locale-strip__menu" data-if="open">
		<div class="locale-strip__entry" data-for="flag : flags"><button
			class="nui-button nui-button--ghost nui-anim locale-strip__item"
			data-attr-id="'locale-flag-' + flag.code" data-class-is-selected="flag.code == current"
			data-event-mousedown="pick(flag.code, ev.button)"><img
			class="locale-strip__image" data-attr-src="flag.image"/><span
			class="locale-strip__name">{{ flag.name }}</span></button></div>
	</div>
</body>
</rml>
