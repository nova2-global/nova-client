/* Login board: a body-level window, centered horizontally and 72dp above the
   bottom edge like the legacy server board. It stays off the screen center,
   where the legacy locale confirm dialog opens without a lock (uicommon.py
   QuestionDialog) and NovaUI, drawn above it, would take its clicks.
   Modern (the reviewed login card, stage 1): a 380dp card with 16dp of
   padding and 12dp between its rows, no title bar; the server row in a
   sunken well with Choose as a small raised button and its chevron; the
   fields 38dp tall, each with its pictogram (a person, a lock) in its
   left padding; Exit and Connect 40dp tall, Connect taking the room. The
   legacy rows and their order stay: server, fields, error, buttons.
   Classic: skins/classic/windows/login.rcss. */
body.login
{
	width: 380dp;
	left: 50%;
	margin-left: -190dp;
	bottom: 72dp;
}

/* The NovaUI virtual keyboard below the board: the board rises above it.
   Same threshold as the keyboard's own sheet. */
@media (min-height: 680dp)
{
	body.login.login--keyboard
	{
		bottom: 303dp;
	}
}

.login .nui-window__body
{
	padding: 16dp 16dp 4dp 16dp;
	gap: 12dp;
}

/* The server row: the card's status well (the mockup's server and channel
   line), the name in body text, Choose at its right end. */
.login-server
{
	box-sizing: border-box;
	height: 38dp;
	padding: 0dp 6dp 0dp 12dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 10dp;
}
.login-server__name
{
	color: var(--text);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
/* Choose: the label, then a small chevron, as the mockup's channel button. */
.login-chevron
{
	margin: -1dp -3dp 0dp 2dp;
	transform: scale(0.75);
	--glyph-ink: var(--text-muted);
}

/* A field and its pictogram: the pictogram sits over the field's left
   padding and takes no pointer, so a press on it goes to the field. */
.login-control
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: relative;
}
/* The input component is 200dp wide; these fill the card, 38dp tall, the
   text after the pictogram. */
input.login-input
{
	width: 100%;
	height: 38dp;
	padding-left: 34dp;
	line-height: 36dp;
}
.login-icon
{
	position: absolute;
	left: 11dp;
	top: 11dp;
	--glyph-ink: var(--text-muted);
	pointer-events: none;
}
/* The lock: a shackle (a ring's upper half) over a body. */
.login-lock
{
	display: block;
	width: 16dp;
	height: 16dp;
}
.login-lock__shackle, .login-lock__body
{
	display: block;
	position: absolute;
	box-sizing: border-box;
}
.login-lock__shackle
{
	left: 4dp;
	top: 1dp;
	width: 8dp;
	height: 9dp;
	border-width: 2dp 2dp 0dp 2dp;
	border-color: var(--text-muted);
	border-radius: 4dp 4dp 0dp 0dp;
}
.login-lock__body
{
	left: 3dp;
	top: 7dp;
	width: 10dp;
	height: 8dp;
	border-radius: 2dp;
	background-color: var(--text-muted);
}

/* An empty-field error focuses the field it names, and the component's
   :focus border (200,000) outweighs --invalid (100,000); this keeps the
   error border on the focused field (210,000). */
input.login-input.nui-input--invalid
{
	border-color: var(--danger);
}

/* Tab moves only between the two fields, as on the legacy board; the
   buttons are for the mouse, and Enter in a field submits. */
button.login-button
{
	tab-index: none;
}
/* Exit and Connect: the card's large buttons; Connect takes the room. */
.login .nui-window__footer
{
	padding: 12dp 16dp 16dp 16dp;
	gap: 8dp;
}
.nui-window__footer .login-button
{
	min-width: 96dp;
}
/* One class each, so the classic button rules (two classes) keep their
   size in classic. */
.login-action
{
	height: 40dp;
	line-height: 38dp;
	border-radius: 10dp;
}
.login-connect
{
	flex: 1 1 auto;
}

/* One line kept for the error (data-visible hides it with visibility), so
   the bottom-anchored panel does not grow upward when an error appears. */
.login-error
{
	min-height: 17dp;
	margin-top: -4dp;
}

/* --- Intro motion ----------------------------------------------------------
   Adapted from RmlUi's animation sample (Samples/basic/animation): keyframe
   transforms, a class-triggered keyframe set, and transitions on hover.
   Rules here follow docs/ui/AUTHORING.md "Motion":
   - values are written out (RmlUi 6.3 ignores var() inside transition);
   - every animating rule carries nui-anim and at most two other classes, so
     the reduced-motion rule in base.rcss switches all of it off;
   - the board itself only moves (transform). Fading the whole board would
     rebuild every mesh in it on each frame (see window-frame.rcss); the
     small rows fade instead.
   RmlUi has no animation-fill-mode, and a delayed animation shows the final
   state until it starts, so each row's keyframes hold the hidden state
   first instead of using a delay. */

/* The board rises from below with a small overshoot on every show. Same
   weight as the window frame's open rule and linked later, so it wins. */
.login.nui-shown.nui-anim
{
	animation: 0.7s back-out login-enter;
}

@keyframes login-enter
{
	from { transform: translateY(64dp) scale(0.95); }
	to   { transform: translateY(0dp) scale(1); }
}

/* Rows follow one after another, 80ms apart: each holds hidden for its
   offset, then fades and rises 12dp over 0.4s. */
.nui-shown .login-r1.nui-anim { animation: 0.55s cubic-out login-row-1; }
.nui-shown .login-r2.nui-anim { animation: 0.63s cubic-out login-row-2; }
.nui-shown .login-r3.nui-anim { animation: 0.71s cubic-out login-row-3; }
.nui-shown .login-r4.nui-anim { animation: 0.79s cubic-out login-row-4; }

@keyframes login-row-1
{
	0%   { opacity: 0; transform: translateY(12dp); }
	27%  { opacity: 0; transform: translateY(12dp); }
	100% { opacity: 1; transform: translateY(0dp); }
}
@keyframes login-row-2
{
	0%   { opacity: 0; transform: translateY(12dp); }
	36%  { opacity: 0; transform: translateY(12dp); }
	100% { opacity: 1; transform: translateY(0dp); }
}
@keyframes login-row-3
{
	0%   { opacity: 0; transform: translateY(12dp); }
	44%  { opacity: 0; transform: translateY(12dp); }
	100% { opacity: 1; transform: translateY(0dp); }
}
@keyframes login-row-4
{
	0%   { opacity: 0; transform: translateY(12dp); }
	49%  { opacity: 0; transform: translateY(12dp); }
	100% { opacity: 1; transform: translateY(0dp); }
}

/* Buttons lift on hover and dip on press. The transition list repeats the
   button component's color transitions and adds the transform. */
button.login-button.nui-anim
{
	transition: transform background-color border-color color 0.14s cubic-out;
}
button.login-button:hover
{
	transform: translateY(-2dp);
}
button.login-button:active
{
	transform: translateY(1dp) scale(0.97);
}

/* Fields ease their focus border in a little slower than the default. */
input.login-input.nui-anim
{
	transition: border-color background-color 0.2s cubic-out;
}

/* A slanted light band crosses the Connect button every 4.5s. The button
   clips it (overflow: hidden, clip: always), and pointer-events: none
   keeps the band out of the hover and click path. Two halves make one
   band that is brightest in its middle, from horizontal-gradient
   decorators (vertex colors, drawn by both renderers). */
button.login-connect
{
	position: relative;
	overflow: hidden;
	/* RmlUi clips only when it sees overflowing content; the band is moved by
	   a transform and positioned absolutely, which it does not count. */
	clip: always;
}
.login-sheen
{
	position: absolute;
	top: -8dp;
	bottom: -8dp;
	left: 0dp;
	width: 44dp;
	display: flex;
	flex-direction: row;
	pointer-events: none;
	transform: translateX(-72dp) skewX(-20deg);
}
.login-sheen__half
{
	width: 50%;
	height: 100%;
	decorator: horizontal-gradient(var(--sheen-clear) var(--sheen));
}
.login-sheen__half--out
{
	decorator: horizontal-gradient(var(--sheen) var(--sheen-clear));
}
.login-sheen.nui-anim
{
	animation: 4.5s cubic-in-out infinite login-sheen;
}

@keyframes login-sheen
{
	0%   { transform: translateX(-72dp) skewX(-20deg); }
	72%  { transform: translateX(-72dp) skewX(-20deg); }
	100% { transform: translateX(168dp) skewX(-20deg); }
}

/* An empty-field error shakes the fields and slides its text in. The
   classes come from the model (data-class-*), so each new error after a
   cleared one plays them again. */
.login-shake.nui-anim
{
	animation: 0.45s linear-in-out login-shake;
}

@keyframes login-shake
{
	0%   { transform: translateX(0dp); }
	15%  { transform: translateX(-9dp); }
	30%  { transform: translateX(8dp); }
	45%  { transform: translateX(-6dp); }
	60%  { transform: translateX(4dp); }
	75%  { transform: translateX(-2dp); }
	100% { transform: translateX(0dp); }
}

.login-error--in.nui-anim
{
	animation: 0.3s cubic-out login-error-in;
}

@keyframes login-error-in
{
	from { opacity: 0; transform: translateX(-10dp); }
	to   { opacity: 1; transform: translateX(0dp); }
}
