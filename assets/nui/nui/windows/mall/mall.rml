<rml>
<head>
	<!-- The item mall storage (uisafebox.py MallWindow, uiscript
	     mallwindow.py; P16 spec 5.5). While the mall flag is on, the Interface
	     makes nui_mall.MallWindow (controller assets/root/nui_mall.py), a
	     subclass of the legacy class on proxies: taking an item (the
	     inventory's drop sends the check-out), the refusal of any drop on the
	     mall and the close command are legacy's code. One page of
	     SAFEBOX_PAGE_SIZE cells, legacy's one page (D16: the first 45 of the
	     mall's cells, no page buttons). The document exists only while the
	     window shows; the distance rule is the engine's
	     (nuigame.WatchLeaveRange), so nothing runs per frame. The body and its
	     controls take no focus; controls act on a left mousedown. It draws
	     below the legacy UI layer, as legacy's window lived in it. A left or
	     right press anywhere on it raises the window (board_press). -->
	<title>mall</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="mall.rcss"/>
</head>
<body template="nui" id="mall" class="nui-window nui-fx nui-anim nui-below-legacy-ui mall" data-model="mall"
      data-event-mousedown="board_press(ev.button)">
	<div class="nui-window__titlebar mall__titlebar">
		<handle class="nui-window__handle mall__handle" move_target="#document">
			<span class="nui-window__title mall__title">@ui.MALL_TITLE</span>
		</handle>
		<button id="mall-close-x" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim mall__close-x"
		        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	</div>
	<div class="nui-window__body mall__body">
		<div id="mall-grid" class="nui-slot-grid nui-slot-grid--lean mall__grid" data-class-is-attaching="attaching"
		     data-class-nui-slot-grid--cols-5="cols == 5">
			<div class="nui-slot nui-anim nui-fx" data-for="c : cells" data-attr-id="'mall-cell-' + it_index"
			     data-class-is-empty="c.kind == '' &amp;&amp; !c.covered" data-class-is-covered="c.covered"
			     data-class-is-picked="c.picked"
			     data-class-is-target="c.target == 'move'" data-class-is-blocked="c.target == 'blocked'"
			     data-class-nui-slot--h2="c.h == 2" data-class-nui-slot--h3="c.h == 3"
			     data-event-mousedown="cell_press(it_index, ev.button)" data-event-mouseup="cell_release(it_index, ev.button)"
			     data-event-dblclick="cell_use(it_index)" data-event-mouseover="cell_over(it_index)"
			     data-event-mouseout="cell_out(it_index)" data-event-nuidrop="cell_drop(it_index)">
				<img class="nui-slot__icon" data-if="c.icon != ''" data-attr-src="c.icon"/>
				<nui-number class="nui-slot__number" data-if="c.count != ''" data-attr-value="c.count"/>
			</div>
		</div>
	</div>
	<div class="nui-window__footer mall__footer">
		<button id="mall-close" class="nui-button nui-anim mall__button"
		        data-event-mousedown="close_press(ev.button)"><span class="mall__label">@ui.CLOSE</span></button>
	</div>
</body>
</rml>
