/* The music list's modern look: a movable window with a list of ten rows
   and its three buttons. The facade centers the body at each open, as
   legacy does. Classic (the legacy board, 170 x 300, its list and scroll
   bar and the small buttons at legacy's places):
   skins/classic/windows/music-list.rcss. */

/* The sheet's own place frames the window in its 320 x 400dp snapshots;
   the facade's center() replaces it in the client. */
body.music-list
{
	left: 20dp;
	top: 12dp;
	width: 280dp;
	min-width: 0;
	focus: none;
	tab-index: none;
}
.music-list button, .music-list .nui-list__item
{
	tab-index: none;
}
.music-list__body
{
	padding: var(--space-3) var(--space-3) 0 var(--space-3);
}
.music-list .music-list__viewport
{
	height: 220dp;
}
.music-list__item
{
	height: 26dp;
	padding-top: 0;
	padding-bottom: 0;
	line-height: 26dp;
}
.music-list__label
{
	white-space: nowrap;
}
.music-list__footer
{
	justify-content: center;
}
.music-list__button
{
	padding: 0 var(--space-2);
}
