<rml>
<head>
	<!-- The music list (uiselectmusic.py FileListDialog, uiscript
	     musiclistwindow.py), opened by the system options' Change button.
	     The facade is nui_system_options.FileListDialog, its board
	     nui_music_list.MusicListBoard (controller
	     assets/root/nui_music_list.py). The document exists only while the
	     list shows (nui_hud.OnDemand). The rows are the default theme first,
	     then every BGM/*.mp3 file; a left press selects one, OK plays it
	     through the system options, Cancel and the close button hide the
	     list, Refresh reads the folder again. The rows' own bindings read
	     only the index and top-level keys (the list shrinks on a refresh);
	     the label sits on a child. -->
	<title>music-list</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="music-list.rcss"/>
</head>
<body template="nui" class="nui-window nui-fx nui-anim music-list" data-model="music_list">
	<div class="nui-window__titlebar music-list__titlebar">
		<handle class="nui-window__handle music-list__handle" move_target="#document">
			<span class="music-list__title-icon"><span class="music-list__note"><span class="music-list__note-head"></span><span
				class="music-list__note-stem"></span><span class="music-list__note-flag"></span></span></span>
			<span class="nui-window__title music-list__title">@ui.MUSICLIST_TITLE</span>
		</handle>
		<button id="music-list-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim" data-event-mousedown="act('cancel', ev.button)"><span
			class="nui-glyph nui-glyph--close"><span class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	</div>
	<div class="nui-window__body music-list__body">
		<div class="nui-list music-list__list">
			<div class="nui-list__viewport music-list__viewport">
				<div class="nui-list__item nui-anim music-list__item" data-for="f : files"
					data-attr-id="'music-list-item-' + it_index" data-class-is-selected="it_index == selected"
					data-event-mousedown="pick(it_index, ev.button)"><span class="nui-list__label music-list__label">{{ f.label }}</span></div>
			</div>
		</div>
	</div>
	<div class="nui-window__footer music-list__footer">
		<button id="music-list-ok" class="nui-button nui-button--medium nui-button--primary nui-anim music-list__button music-list__button--ok" data-event-mousedown="act('ok', ev.button)"><span class="music-list__button-label">@ui.OK</span></button>
		<button id="music-list-cancel" class="nui-button nui-button--medium nui-anim music-list__button music-list__button--cancel" data-event-mousedown="act('cancel', ev.button)"><span class="music-list__button-label">@ui.CANCEL</span></button>
		<button id="music-list-refresh" class="nui-button nui-button--medium nui-anim music-list__button music-list__button--refresh" data-event-mousedown="act('refresh', ev.button)"><span class="music-list__button-label">@ui.MARKLIST_REFRESH</span></button>
	</div>
</body>
</rml>
