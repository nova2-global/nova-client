/* The party's modern look (the reviewed WParty board of stage 1): the
   member boards in a column at the top left (10, 52), each a 154 x 48 tile:
   a role tile with the role's pictogram (the leader's shield, the
   attacker's sword, a person for none; the tooltip of a role button names
   it), the name with the HP percent, the HP gauge with a sheen and ticks,
   and the party affect icons below it; the role buttons a leader opens to
   the right of a board; the menu toggle under the boards (a fading rule and
   a chevron) and the menu below it, a board with the heal, break up or
   leave glyph chips and the two EXP modes. An offline member is dimmed.
   Classic (the legacy boards at the legacy positions, the stone menu
   toggle, the thin board menu and the large buttons):
   skins/classic/windows/party.rcss. */

body.party
{
	focus: none;
	tab-index: none;
}
.party button
{
	focus: none;
	tab-index: none;
}
.party
{
	position: absolute;
	left: 10dp;
	top: 52dp;
	width: 154dp;
}
/* One member: its board, 48dp tall, 52dp apart. */
.party__row
{
	display: block;
	position: relative;
	height: 48dp;
	margin-bottom: 4dp;
}

/* --- Role tiles, role pictograms and glyph chips ------------------------------------
   A party-art-host is a member's role or one of the buttons. Its face holds
   the role as data-state (the controller's state_name; on a child, since a
   repeated element's own views may read a gone entry when its list
   shrinks). Modern draws the face as the role's pictogram in code, or a
   glyph (components/glyph.rcss); classic draws the legacy button art on the
   face instead (skins/classic/windows/party.rcss). */

.party-art-host
{
	display: block;
	position: absolute;
	padding: 0;
	border-width: 0;
	background-color: transparent;
}
/* The pictogram: 18dp, by role. */
.party-role__face
{
	display: block;
	position: absolute;
	left: 8dp;
	top: 10dp;
	width: 18dp;
	height: 18dp;
	pointer-events: none;
}
/* None (a member without a role): a person. */
.party-role__face[data-state=normal]
{
	decorator: radial-gradient(circle 4dp at 9dp 5dp, var(--text) 80%, transparent 100%),
	           radial-gradient(ellipse 8dp 6.5dp at 9dp 18dp, var(--text) 88%, transparent 100%);
}
/* The leader: a gold shield. */
.party-role__face[data-state=leader]
{
	left: 10dp;
	width: 14dp;
	border-radius: 3dp 3dp 8dp 8dp;
	background-color: var(--warning);
}
/* The attacker: a sword (the blade, and its guard as the bottom border),
   turned. */
.party-role__face[data-state=attacker]
{
	left: 13dp;
	top: 9dp;
	width: 3dp;
	height: 15dp;
	border-width: 0 3dp 3dp 3dp;
	border-color: transparent transparent var(--danger) transparent;
	border-radius: 2dp 2dp 0 0;
	background-color: var(--danger);
	transform: rotate(45deg);
}
/* The berserker: a red gem. */
.party-role__face[data-state=berserker], .party-role__face[data-state=skill-master]
{
	left: 11dp;
	top: 13dp;
	width: 12dp;
	height: 12dp;
	border-radius: 2dp;
	background-color: var(--gauge-red);
	transform: rotate(45deg);
}
/* The skill master: a violet gem. */
.party-role__face[data-state=skill-master]
{
	background-color: var(--accent);
}
/* The tanker and the defender: a shield's outline, violet or green. */
.party-role__face[data-state=tanker], .party-role__face[data-state=defender]
{
	left: 10dp;
	width: 14dp;
	border-width: 2dp;
	border-color: var(--accent);
	border-radius: 3dp 3dp 8dp 8dp;
}
.party-role__face[data-state=defender]
{
	border-color: var(--success);
}
/* The buffer: a blue ring. */
.party-role__face[data-state=buffer]
{
	left: 9dp;
	top: 11dp;
	width: 16dp;
	height: 16dp;
	border-width: 3dp;
	border-color: var(--gauge-blue);
	border-radius: 8dp;
}
/* The expel button shows its glyph; its face carries classic's art only. */
.party-role__face[data-state=expel] { display: none; }
/* The member's role tile and the role buttons and the menu's buttons: raised
   chips with a border. */
.party-member__state, .party-role, .party-menu__icon
{
	box-sizing: border-box;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 7dp;
	background-color: var(--surface-sunken);
}
.party-member__state[data-state=leader]
{
	border-color: var(--warning);
}
.party-member__state[data-state=attacker]
{
	border-color: var(--danger);
	background-color: var(--slot-disabled);
}
.party-role, .party-menu__icon
{
	background-color: var(--surface-raised);
}
.party-role .party-role__face
{
	left: 4dp;
	top: 14dp;
}
.party-role .party-role__face[data-state=leader], .party-role .party-role__face[data-state=tanker],
.party-role .party-role__face[data-state=defender]
{
	left: 6dp;
}
.party-role .party-role__face[data-state=attacker]
{
	left: 10dp;
	top: 13dp;
}
.party-role .party-role__face[data-state=berserker], .party-role .party-role__face[data-state=skill-master]
{
	left: 7dp;
	top: 17dp;
}
.party-role .party-role__face[data-state=buffer]
{
	left: 5dp;
	top: 15dp;
}
.party-role:hover, .party-menu__icon:hover
{
	border-color: var(--accent);
	background-color: var(--selection);
}
.party-role:active, .party-menu__icon:active
{
	background-color: var(--surface-sunken);
}
.party-role:hover .nui-glyph, .party-menu__icon:hover .nui-glyph
{
	--glyph-ink: var(--accent);
}
.party-role__glyph
{
	position: absolute;
	left: 5dp;
	top: 15dp;
}
.party-menu__glyph
{
	position: absolute;
	left: 7dp;
	top: 7dp;
	transform: scale(1.25);
}

/* --- A member's board: the tile, the role tile at 3, 3 of its padding box,
   the name and the percent over the HP bar from 44dp in, the affects
   below. --------------------------------------------------------------------------- */

.party-member
{
	position: absolute;
	left: 0;
	top: 0;
	width: 154dp;
	height: 48dp;
	box-sizing: border-box;
}
.party-member__state
{
	left: 3dp;
	top: 3dp;
	width: 34dp;
	height: 40dp;
}
.party-member__bar
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: absolute;
	left: 44dp;
	top: 3dp;
	right: 6dp;
	height: 16dp;
	pointer-events: none;
}
.party-member__name
{
	display: block;
	flex: 1 1 0;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	color: var(--party-unlink);
	font-size: var(--font-md);
	font-weight: bold;
	line-height: 16dp;
	white-space: nowrap;
}
.is-linked .party-member__name
{
	color: var(--party-link);
}
.party-member__pct
{
	display: block;
	flex: 0 0 auto;
	margin-left: var(--space-1);
	color: var(--text-muted);
	font-size: var(--font-xs);
	line-height: 16dp;
}
/* The HP bar: the gauge, its sheen, the empty part drawn over the sheen,
   and ticks at every tenth (9.6dp apart on the 96dp bar). */
.party-member__hp, .party-member__sheen-clock, .party-member__cover, .party-member__ticks
{
	display: block;
	position: absolute;
	left: 44dp;
	top: 21dp;
	width: 102dp;
	height: 7dp;
	pointer-events: none;
}
.party-member__sheen-clock
{
	overflow: hidden;
}
.party-member__sheen
{
	display: block;
	position: absolute;
	left: 0;
	top: 1dp;
	bottom: 1dp;
	width: 100%;
	transform-origin: 10% 50%;
	transform: scaleX(0);
	pointer-events: none;
}
nui-blink.nui-blink-off .party-member__sheen
{
	decorator: linear-gradient(90deg, var(--sheen-clear) 0%, var(--sheen) 10%, var(--sheen-clear) 20%, var(--sheen-clear) 100%);
}
nui-blink.nui-blink-off .party-member__sheen.nui-anim
{
	animation: 1.7s cubic-in-out party-sheen;
}
@keyframes party-sheen
{
	0% { transform: translateX(0%) scaleX(0); }
	12% { transform: translateX(8%) scaleX(1); }
	88% { transform: translateX(72%) scaleX(1); }
	100% { transform: translateX(80%) scaleX(0); }
}
/* Reduced motion: no sheen, and no clock toggling its gradient. */
@media (theme: reduced-motion)
{
	.party-member__sheen-clock
	{
		display: none;
	}
}
progress.party-member__cover
{
	background-color: transparent;
}
progress.party-member__cover fill
{
	border-radius: 9999dp;
	background-color: var(--gauge-track);
}
.party-member__ticks
{
	width: 92dp;
	decorator: repeating-linear-gradient(90deg, transparent 0%, transparent 10.4%, var(--cooldown-shade) 10.4%, var(--cooldown-shade) 11.11%);
}
/* An offline member: the board dimmed. */
.party-member .party-member__state, .party-member .party-member__bar
{
	opacity: 0.56;
}
.party-member.is-linked .party-member__state, .party-member.is-linked .party-member__bar
{
	opacity: 1;
}
/* The nine affect images at the legacy uiscript places, 14dp apart (Buffer
   and Skill master sit on Attacker and Defender, as partymemberinfoboard.py
   has them). */
.party-affect
{
	position: absolute;
	top: 31dp;
	width: 12dp;
	height: 12dp;
}
.party-affect--0 { left: 44dp; }
.party-affect--1 { left: 58dp; }
.party-affect--2 { left: 72dp; }
.party-affect--3 { left: 58dp; }
.party-affect--4 { left: 72dp; }
.party-affect--5 { left: 86dp; }
.party-affect--6 { left: 100dp; }
.party-affect--7 { left: 114dp; }
.party-affect--8 { left: 128dp; }
.party-affect__image
{
	display: block;
	pointer-events: none;
}

/* --- The role buttons a leader opens: 30dp apart, 4dp right of the board ---------- */

.party-roles
{
	position: absolute;
	left: 158dp;
	top: 0;
	height: 48dp;
	display: flex;
	flex-direction: row;
}
.party-role
{
	position: relative;
	width: 28dp;
	height: 48dp;
	margin-right: 2dp;
}

/* --- The menu toggle and the menu ------------------------------------------------- */

.party__menu-button
{
	display: block;
	box-sizing: border-box;
	width: 154dp;
	height: 24dp;
	padding: 0;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 7dp;
	background-color: var(--surface-raised);
	text-align: center;
	line-height: 22dp;
}
.party__menu-button:hover
{
	border-color: var(--accent);
	background-color: var(--selection);
}
.party__menu-button:hover .nui-glyph
{
	--glyph-ink: var(--accent);
}
/* The toggle's mark: a rule fading at both ends, then a chevron that points
   down, or up while the menu is open. */
.party__menu-mark
{
	display: inline-block;
	width: 62dp;
	height: 2dp;
	margin-bottom: 1dp;
	border-radius: 1dp;
	vertical-align: middle;
	decorator: linear-gradient(90deg, transparent 0%, var(--text-muted) 50%, transparent 100%);
}
.party__menu-glyph
{
	margin-left: 5dp;
	--glyph-ink: var(--text-muted);
	transform: scale(0.75);
}
.party__menu-button.is-open .party__menu-glyph
{
	transform: scale(0.75) rotate(180deg);
}
.party-menu
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 154dp;
	margin-top: 4dp;
	padding: var(--space-2);
}
.party-menu__buttons
{
	display: flex;
	flex-direction: row;
	justify-content: center;
	height: 32dp;
}
.party-menu__icon
{
	position: relative;
	width: 32dp;
	height: 32dp;
	margin: 0 2dp;
}
.party-menu__title
{
	display: block;
	margin: var(--space-2) 0 var(--space-1) 0;
	color: var(--text-muted);
	font-size: var(--font-sm);
	font-weight: bold;
	text-align: center;
}
.party-menu__modes
{
	display: flex;
	flex-direction: column;
	gap: var(--space-1);
}
.party-menu__mode
{
	display: block;
	height: 26dp;
	line-height: 24dp;
	padding: 0 var(--space-2);
	font-size: var(--font-sm);
}
.party-menu__mode.is-active
{
	border-color: var(--accent);
	color: var(--accent);
	transform: none;
}
