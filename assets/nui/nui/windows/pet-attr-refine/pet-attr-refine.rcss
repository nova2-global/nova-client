/* The pet bonus refine window's modern look (NOVA-24): a sunken panel with
   the bonus's name over its current level and value, a chevron, and its
   next ones (the next value in the accent); a second panel with the
   materials and the cost; Upgrade and Cancel. Centered at its first show.
   Classic (legacy's 260 x 330 board): skins/classic/windows/pet-attr-refine.rcss. */

body.pet-attr-refine
{
	left: 16dp;
	top: 16dp;
	width: 300dp;
	min-width: 0;
	focus: none;
	tab-index: none;
}
.pet-attr-refine button
{
	tab-index: none;
	focus: none;
}
.pet-attr-refine__body
{
	display: flex;
	flex-direction: column;
	padding: 10dp 14dp 4dp;
}
.pet-attr-refine__top, .pet-attr-refine__materials-box
{
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 10dp;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 8dp;
	background-color: var(--surface-sunken);
}
.pet-attr-refine__materials-box
{
	margin-top: 10dp;
}
.pet-attr-refine__caption
{
	display: block;
	margin-bottom: 6dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
	text-align: center;
	white-space: nowrap;
	pointer-events: none;
}
.pet-attr-refine__materials
{
	display: flex;
	flex-direction: row;
	justify-content: center;
	gap: var(--space-1);
}
.pet-attr-refine__material-cell
{
	display: block;
	width: 40dp;
	height: 40dp;
}
.pet-attr-refine__cost
{
	display: block;
	height: 18dp;
	margin-top: 6dp;
	color: var(--text);
	font-size: var(--font-md);
	line-height: 18dp;
	text-align: center;
	white-space: nowrap;
	pointer-events: none;
}
.pet-attr-refine__footer
{
	justify-content: center;
}
.pet-attr-refine__button
{
	min-width: 104dp;
}
.pet-attr-refine__label
{
	pointer-events: none;
}
.pet-attr-refine__attribute
{
	display: block;
	margin-bottom: 8dp;
	color: var(--text);
	font-size: var(--font-lg);
	font-weight: bold;
	text-align: center;
	white-space: nowrap;
	pointer-events: none;
}
.pet-attr-refine__row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
	height: 20dp;
	pointer-events: none;
}
.pet-attr-refine__label
{
	flex: 1 1 auto;
	color: var(--text-muted);
	font-size: var(--font-sm);
	white-space: nowrap;
}
.pet-attr-refine__level
{
	flex: 0 0 auto;
	width: 48dp;
	color: var(--text);
	font-size: var(--font-md);
	text-align: right;
	white-space: nowrap;
}
.pet-attr-refine__value
{
	flex: 0 0 auto;
	width: 64dp;
	color: var(--text);
	font-size: var(--font-md);
	font-weight: bold;
	text-align: right;
	white-space: nowrap;
}
.pet-attr-refine__value--next
{
	color: var(--accent);
}
.pet-attr-refine__arrow
{
	display: block;
	width: 16dp;
	height: 16dp;
	margin: 2dp 0;
}
.pet-attr-refine__arrow .nui-glyph
{
	--glyph-ink: var(--accent);
}
