<rml>
<head>
	<!-- The pet bonus refine window (NOVA-24; legacy uipet.py
	     PetAttrRefineWindow, uiscript petrefineattrwindow.py, 260 x 330).
	     BINARY_PetAttrRefineInfo opens nui_pet_attr_refine.PetAttrRefineWindow
	     (controller assets/root/nui_pet_attr_refine.py), a subclass of the
	     legacy class on proxies: the bonus's name, its current level and
	     value over its next ones, the materials (icon, count, item tooltip),
	     the cost, Upgrade (legacy's money and material checks, then
	     pet.RefineAttr) and Cancel are legacy's code; legacy closes it at the
	     top level. Centered; the document exists only while the window
	     shows. -->
	<title>pet-attr-refine</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="pet-attr-refine.rcss"/>
</head>
<body template="nui" id="pet-attr-refine" class="nui-window nui-fx nui-anim pet-attr-refine" data-model="pet_attr_refine"
      data-event-mousedown="board_press(ev.button)">
	<div class="nui-window__titlebar pet-attr-refine__titlebar">
		<handle class="nui-window__handle pet-attr-refine__handle" move_target="#document">
			<span class="nui-window__title pet-attr-refine__title">@ui.REFINE_TTILE</span>
		</handle>
		<button id="pet-attr-refine-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim pet-attr-refine__close"
		        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
			class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	</div>
	<div class="nui-window__body pet-attr-refine__body">
		<div class="pet-attr-refine__top">
			<div id="pet-attr-refine-attribute" class="pet-attr-refine__attribute">{{ attribute }}</div>
			<div class="pet-attr-refine__row">
				<span class="pet-attr-refine__label">@ui.PET_UI_CURRENT_VALUE</span>
				<span id="pet-attr-refine-current-level" class="pet-attr-refine__level">{{ current_level }}</span>
				<span id="pet-attr-refine-current-value" class="pet-attr-refine__value">{{ current_value }}</span>
			</div>
			<span class="pet-attr-refine__arrow"><span class="nui-glyph nui-glyph--chevron-down"><span
				class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></span>
			<div class="pet-attr-refine__row">
				<span class="pet-attr-refine__label">@ui.PET_UI_NEXT_VALUE</span>
				<span id="pet-attr-refine-next-level" class="pet-attr-refine__level">{{ next_level }}</span>
				<span id="pet-attr-refine-next-value" class="pet-attr-refine__value pet-attr-refine__value--next">{{ next_value }}</span>
			</div>
		</div>
			<div class="pet-attr-refine__materials-box">
				<div class="pet-attr-refine__caption">@ui.PET_UI_REQUIREMENTS</div>
				<div id="pet-attr-refine-materials" class="pet-attr-refine__materials">
					<div class="nui-slot pet-attr-refine__material-cell" data-for="m : materials" data-attr-id="'pet-attr-refine-material-' + it_index"
					     data-event-mouseover="material_over(it_index)" data-event-mouseout="material_out(it_index)">
						<img class="nui-slot__icon" data-if="m.icon != ''" data-attr-src="m.icon"/>
						<nui-number class="nui-slot__number" data-if="m.count != ''" data-attr-value="m.count"/>
					</div>
				</div>
				<div id="pet-attr-refine-cost" class="pet-attr-refine__cost">{{ cost }}</div>
			</div>
	</div>
	<div class="nui-window__footer pet-attr-refine__footer">
		<button id="pet-attr-refine-ok" class="nui-button nui-button--medium nui-button--primary nui-anim pet-attr-refine__button"
		        data-event-mousedown="upgrade_press(ev.button)">@ui.PET_REFINE_BUTTON</button>
		<button id="pet-attr-refine-cancel" class="nui-button nui-button--medium nui-anim pet-attr-refine__button"
		        data-event-mousedown="cancel_press(ev.button)">@ui.CANCEL</button>
	</div>
</body>
</rml>
