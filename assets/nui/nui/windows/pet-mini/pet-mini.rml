<rml>
<head>
	<!-- The pet's mini window (NOVA-24; legacy uipet.py PetInterfaceWindow,
	     uiscript petinterfacewindow.py, 245 x 135 open, 75 x 75 folded).
	     While a pet is out (BINARY_PetSummon) the Interface's
	     nui_pet_mini.PetInterfaceWindow (controller assets/root/nui_pet_mini.py)
	     shows it, a subclass of the legacy class on proxies: the pet's icon (a
	     press opens or folds it), the name and level, the grade in OLD's
	     color, the exp gauge (its hover writes legacy's exp line into the
	     hint), the ten basic and three heroic skill cells (the cells over
	     the grade's counts dimmed; hover shows the pet skill tooltip; a Pet
	     Revertus dropped on a cell resets that skill). Folded is the class
	     the sheets animate (open); the 30 seconds an open lasts are a
	     nui-countdown (fold_at) whose countdownend folds it. The document
	     exists while a pet is out; it sits at legacy's place, 260 from the
	     left, 280 above the bottom. A press raises it (board_press). -->
	<title>pet-mini</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="pet-mini.rcss"/>
</head>
<body template="nui" id="pet-mini" class="nui-window nui-fx nui-anim pet-mini" data-model="pet_mini"
      data-class-is-open="open" data-event-mousedown="board_press(ev.button)">
	<nui-countdown id="pet-mini-fold" class="pet-mini__fold" data-if="open" data-attr-end="fold_at"
	               data-event-countdownend="fold_due()"/>
	<handle class="pet-mini__handle" move_target="#document"></handle>
	<div id="pet-mini-icon" class="pet-mini__icon" data-event-mousedown="image_press(ev.button)">
		<img class="pet-mini__icon-image" data-if="icon != ''" data-attr-src="icon"/>
	</div>
	<div class="pet-mini__extras">
		<div id="pet-mini-title" class="pet-mini__title">{{ title }}</div>
		<div id="pet-mini-evo" class="pet-mini__evo" data-style---pet-grade="evolution_color">{{ evolution }}</div>
		<div id="pet-mini-exp" class="pet-mini__exp" data-event-mouseover="exp_over()" data-event-mouseout="exp_out()">
			<progress id="pet-mini-gauge" class="nui-gauge nui-gauge--blue pet-mini__gauge" direction="right" data-attr-value="exp"/>
		</div>
		<div id="pet-mini-hint" class="pet-mini__hint">{{ hint }}</div>
		<div id="pet-mini-cells" class="pet-mini__cells" data-class-nui-attach-right="attach_right">
			<div class="pet-mini__row">
				<div id="pet-mini-cell-0" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[0].kind == ''"
				     data-class-is-disabled="disabled[0]" data-class-is-target="cells[0].target != ''"
				     data-event-mousedown="cell_press(0, ev.button)" data-event-mouseup="cell_release(0, ev.button)"
				     data-event-dblclick="cell_use(0)" data-event-nuidrop="cell_drop(0)"
				     data-event-mouseover="cell_over(0)" data-event-mouseout="cell_out(0)">
					<img class="nui-slot__icon" data-if="cells[0].icon != ''" data-attr-src="cells[0].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-1" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[1].kind == ''"
				     data-class-is-disabled="disabled[1]" data-class-is-target="cells[1].target != ''"
				     data-event-mousedown="cell_press(1, ev.button)" data-event-mouseup="cell_release(1, ev.button)"
				     data-event-dblclick="cell_use(1)" data-event-nuidrop="cell_drop(1)"
				     data-event-mouseover="cell_over(1)" data-event-mouseout="cell_out(1)">
					<img class="nui-slot__icon" data-if="cells[1].icon != ''" data-attr-src="cells[1].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-2" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[2].kind == ''"
				     data-class-is-disabled="disabled[2]" data-class-is-target="cells[2].target != ''"
				     data-event-mousedown="cell_press(2, ev.button)" data-event-mouseup="cell_release(2, ev.button)"
				     data-event-dblclick="cell_use(2)" data-event-nuidrop="cell_drop(2)"
				     data-event-mouseover="cell_over(2)" data-event-mouseout="cell_out(2)">
					<img class="nui-slot__icon" data-if="cells[2].icon != ''" data-attr-src="cells[2].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-3" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[3].kind == ''"
				     data-class-is-disabled="disabled[3]" data-class-is-target="cells[3].target != ''"
				     data-event-mousedown="cell_press(3, ev.button)" data-event-mouseup="cell_release(3, ev.button)"
				     data-event-dblclick="cell_use(3)" data-event-nuidrop="cell_drop(3)"
				     data-event-mouseover="cell_over(3)" data-event-mouseout="cell_out(3)">
					<img class="nui-slot__icon" data-if="cells[3].icon != ''" data-attr-src="cells[3].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-4" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[4].kind == ''"
				     data-class-is-disabled="disabled[4]" data-class-is-target="cells[4].target != ''"
				     data-event-mousedown="cell_press(4, ev.button)" data-event-mouseup="cell_release(4, ev.button)"
				     data-event-dblclick="cell_use(4)" data-event-nuidrop="cell_drop(4)"
				     data-event-mouseover="cell_over(4)" data-event-mouseout="cell_out(4)">
					<img class="nui-slot__icon" data-if="cells[4].icon != ''" data-attr-src="cells[4].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-5" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[5].kind == ''"
				     data-class-is-disabled="disabled[5]" data-class-is-target="cells[5].target != ''"
				     data-event-mousedown="cell_press(5, ev.button)" data-event-mouseup="cell_release(5, ev.button)"
				     data-event-dblclick="cell_use(5)" data-event-nuidrop="cell_drop(5)"
				     data-event-mouseover="cell_over(5)" data-event-mouseout="cell_out(5)">
					<img class="nui-slot__icon" data-if="cells[5].icon != ''" data-attr-src="cells[5].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-6" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[6].kind == ''"
				     data-class-is-disabled="disabled[6]" data-class-is-target="cells[6].target != ''"
				     data-event-mousedown="cell_press(6, ev.button)" data-event-mouseup="cell_release(6, ev.button)"
				     data-event-dblclick="cell_use(6)" data-event-nuidrop="cell_drop(6)"
				     data-event-mouseover="cell_over(6)" data-event-mouseout="cell_out(6)">
					<img class="nui-slot__icon" data-if="cells[6].icon != ''" data-attr-src="cells[6].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-7" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[7].kind == ''"
				     data-class-is-disabled="disabled[7]" data-class-is-target="cells[7].target != ''"
				     data-event-mousedown="cell_press(7, ev.button)" data-event-mouseup="cell_release(7, ev.button)"
				     data-event-dblclick="cell_use(7)" data-event-nuidrop="cell_drop(7)"
				     data-event-mouseover="cell_over(7)" data-event-mouseout="cell_out(7)">
					<img class="nui-slot__icon" data-if="cells[7].icon != ''" data-attr-src="cells[7].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-8" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[8].kind == ''"
				     data-class-is-disabled="disabled[8]" data-class-is-target="cells[8].target != ''"
				     data-event-mousedown="cell_press(8, ev.button)" data-event-mouseup="cell_release(8, ev.button)"
				     data-event-dblclick="cell_use(8)" data-event-nuidrop="cell_drop(8)"
				     data-event-mouseover="cell_over(8)" data-event-mouseout="cell_out(8)">
					<img class="nui-slot__icon" data-if="cells[8].icon != ''" data-attr-src="cells[8].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-9" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--normal" data-class-is-empty="cells[9].kind == ''"
				     data-class-is-disabled="disabled[9]" data-class-is-target="cells[9].target != ''"
				     data-event-mousedown="cell_press(9, ev.button)" data-event-mouseup="cell_release(9, ev.button)"
				     data-event-dblclick="cell_use(9)" data-event-nuidrop="cell_drop(9)"
				     data-event-mouseover="cell_over(9)" data-event-mouseout="cell_out(9)">
					<img class="nui-slot__icon" data-if="cells[9].icon != ''" data-attr-src="cells[9].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
			</div>
			<div class="pet-mini__row">
				<div id="pet-mini-cell-10" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--heroic" data-class-is-empty="cells[10].kind == ''"
				     data-class-is-disabled="disabled[10]" data-class-is-target="cells[10].target != ''"
				     data-event-mousedown="cell_press(10, ev.button)" data-event-mouseup="cell_release(10, ev.button)"
				     data-event-dblclick="cell_use(10)" data-event-nuidrop="cell_drop(10)"
				     data-event-mouseover="cell_over(10)" data-event-mouseout="cell_out(10)">
					<img class="nui-slot__icon" data-if="cells[10].icon != ''" data-attr-src="cells[10].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-11" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--heroic" data-class-is-empty="cells[11].kind == ''"
				     data-class-is-disabled="disabled[11]" data-class-is-target="cells[11].target != ''"
				     data-event-mousedown="cell_press(11, ev.button)" data-event-mouseup="cell_release(11, ev.button)"
				     data-event-dblclick="cell_use(11)" data-event-nuidrop="cell_drop(11)"
				     data-event-mouseover="cell_over(11)" data-event-mouseout="cell_out(11)">
					<img class="nui-slot__icon" data-if="cells[11].icon != ''" data-attr-src="cells[11].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
				<div id="pet-mini-cell-12" class="nui-slot nui-anim nui-fx pet-mini__cell pet-mini__cell--heroic" data-class-is-empty="cells[12].kind == ''"
				     data-class-is-disabled="disabled[12]" data-class-is-target="cells[12].target != ''"
				     data-event-mousedown="cell_press(12, ev.button)" data-event-mouseup="cell_release(12, ev.button)"
				     data-event-dblclick="cell_use(12)" data-event-nuidrop="cell_drop(12)"
				     data-event-mouseover="cell_over(12)" data-event-mouseout="cell_out(12)">
					<img class="nui-slot__icon" data-if="cells[12].icon != ''" data-attr-src="cells[12].icon"/>
					<div class="pet-mini__lock"></div>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
