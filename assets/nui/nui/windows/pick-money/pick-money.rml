<rml>
<head>
	<!-- The pick money dialog of the dialog kit (controller:
	     assets/root/nui_pick_money.py): uiPickMoney.PickMoneyDialog. Not
	     modal, as in legacy: it opens over the inventory, which stays usable.
	     The controller places it above the mouse; the sheet centers it until
	     then, so a snapshot shows it. The field takes digits only; the
	     maximum shows beside it. -->
	<title>pick-money</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="pick-money.rcss"/>
</head>
<body template="nui" class="nui-window nui-fx nui-anim pick-money" data-model="pick_money">
	<div class="nui-window__titlebar pick-money__titlebar">
		<handle class="nui-window__handle pick-money__handle" move_target="#document">
			<span class="pick-money__title-icon"><span class="nui-glyph nui-glyph--coin"><span
				class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></span>
			<span class="nui-window__title pick-money__title">{{ title }}</span>
		</handle>
		<button id="pick-money-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim" data-event-click="cancel()"><span
			class="nui-glyph nui-glyph--close"><span class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
	</div>
	<div class="nui-window__body">
		<div class="nui-row pick-money__row">
			<input id="pick-money-field" type="text" class="nui-input pick-money__field" data-attr-maxlength="max" data-event-change="edit(ev.value, ev.linebreak)"/>
			<span class="pick-money__limit">{{ limit }}</span>
		</div>
		<!-- NOVA-190: a stack's split shows legacy's "Split all" box
		     (uiPickMoney.SetItemMode); a left press on the row flips it. -->
		<label id="pick-money-split" class="nui-toggle pick-money__split" data-if="split_on"
		       data-event-mousedown="split(ev.button)"><input type="checkbox" class="nui-toggle__input"
		       data-attrif-checked="split_checked"/><span class="nui-toggle__track nui-anim"><span
		       class="nui-toggle__knob nui-anim"></span></span><span class="nui-toggle__label">@game.ITEM_SPLIT_ALL</span></label>
		<div class="nui-dialog__footer pick-money__actions">
			<button id="pick-money-cancel" class="nui-button nui-button--medium nui-anim pick-money__action" data-event-click="cancel()">@ui.CANCEL</button>
			<button id="pick-money-accept" class="nui-button nui-button--medium nui-button--primary nui-anim pick-money__action" data-event-click="accept()">@ui.OK</button>
		</div>
	</div>
</body>
</rml>
