/* The player gauge's modern look: the modern red gauge, 100dp wide and 7dp
   tall, its track and rim dark in both palettes so it reads over the world,
   with the taskbar's damage chip on its fill's leading edge. The anchor is the
   gauge's own box, so its center sits on the name tail's x and its top 5dp
   below the tail (uiplayergauge.py:25-31). Classic (legacy's gauge art, 8dp
   tall): skins/classic/windows/player-gauge.rcss. */

body.player-gauge
{
	focus: none;
	tab-index: none;
}
.player-gauge__anchor
{
	width: 100dp;
}
progress.player-gauge__gauge
{
	width: 100dp;
	height: 7dp;
	box-sizing: border-box;
	border-width: 1dp;
	border-color: var(--scene);
	background-color: var(--scene);
}
progress.player-gauge__gauge fill
{
	border-right-width: 2dp;
	border-color: var(--chat-info);
}
