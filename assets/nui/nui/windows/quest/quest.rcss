/* The quest dialog, modern: a code-drawn card in the middle of the screen
   on legacy's geometry at 1.4 times (the 350 x 300 board as 500 x 420dp at
   least), its height growing with its content up to 90% of the screen, the
   text scrolling inside it beyond that. The text keeps legacy's flow from
   the top left (34dp in, 16dp type on a 23dp pitch; the server's lines are
   hand-wrapped below 60 bytes, about 45 characters of it), the speaker's
   title run in bold. The choices are centered bars under the text, as
   legacy's, 280 x 36dp, a list that scrolls past six; every choice shows
   (the pager is classic's). The Next button sits centered under the text,
   150 x 38dp, as legacy's sits under its last line. Four corner brackets
   with accent ticks and an accent sheen along the top edge dress the card;
   they take no pointer. A portrait stands left of the card, a banner above
   the text, a background faintly behind it, a script's free images in a
   row above it; the title card at the bottom center of the screen. Cinema
   (skin 5): the text alone in a subtitle box at the bottom center, no
   button, as legacy hides its board and the button with it. Scroll (skin
   3): the card shows its background whole, the choices two to a row. The
   scrim draws no backdrop: legacy draws none (--quest-scrim). Every control
   takes no focus (the modal body keeps it, for the facade's key rules) and
   acts on a left mousedown. Classic's legacy geometry is in
   skins/classic/windows/quest.rcss, which also takes back what is modern's
   alone here. */

body.nui-scrim.quest
{
	background-color: var(--quest-scrim);
}

.quest__board
{
	display: flex;
	flex-direction: column;
	width: 500dp;
	min-height: 420dp;
	max-width: 94vw;
	max-height: 90vh;
}

/* The dress: a sheen of the accent along the top edge, and an L bracket in
   each corner (15dp, 8dp in) with two short accent ticks across its
   corner, each bracket the top left one turned. */
.quest__sheen
{
	display: block;
	position: absolute;
	left: var(--space-5);
	right: var(--space-5);
	top: 0;
	height: 1dp;
	decorator: linear-gradient(90deg, transparent 0%, var(--accent-glow) 50%, transparent 100%);
	pointer-events: none;
}
.quest__corner
{
	display: block;
	position: absolute;
	width: 15dp;
	height: 15dp;
	border-width: 1dp 0 0 1dp;
	border-color: var(--border);
	pointer-events: none;
}
.quest__corner--tl { left: 8dp; top: 8dp; }
.quest__corner--tr { right: 8dp; top: 8dp; transform: rotate(90deg); }
.quest__corner--br { right: 8dp; bottom: 8dp; transform: rotate(180deg); }
.quest__corner--bl { left: 8dp; bottom: 8dp; transform: rotate(270deg); }
.quest__tick
{
	display: block;
	position: absolute;
	background-color: var(--accent-glow);
}
.quest__tick--h
{
	left: -4dp;
	top: 3dp;
	width: 6dp;
	height: 1dp;
}
.quest__tick--v
{
	left: 3dp;
	top: -4dp;
	width: 1dp;
	height: 6dp;
}

.quest__body
{
	display: block;
	position: relative;
	z-index: 0;
	flex: 0 1 auto;
	min-height: 0;
	padding: 34dp 28dp 0 34dp;
	overflow-y: auto;
}

/* Legacy's text at 1.4 times: 16dp type on a 23dp pitch, the speaker's
   title run in bold. */
.quest__text
{
	display: block;
	--quest-line: 23dp;
	font-size: 16dp;
}
.quest__text .nui-quest__run--title
{
	font-weight: bold;
}
/* A page with no text (an NPC's menu of chat titles) has only the open
   empty line: it takes no room, so the choices start at the card's top. A
   blank line between text lines keeps its pitch. */
.quest__text .nui-quest__line.is-empty:only-child
{
	min-height: 0dp;
	line-height: 0dp;
}

/* Images: only where the content is an image (the quest scripts' own art). */
/* The quest art is legacy's textures (a 220 x 151 picture in the top left of
   256 x 256); modern shows each at a size of its own, scaled evenly: the
   portrait 200dp beside the card's top, the banner 140dp, the free images
   96dp in a row; the background faintly over the whole text area
   (stretched, so it never makes the area scroll). */
.quest__portrait
{
	display: block;
	position: absolute;
	right: 100%;
	top: 0;
	width: 200dp;
	height: 200dp;
	margin-right: var(--space-3);
	pointer-events: none;
}
.quest__banner
{
	display: block;
	width: 140dp;
	height: 140dp;
	margin: var(--space-3) auto 0 auto;
	pointer-events: none;
}
.quest__background
{
	display: block;
	position: absolute;
	z-index: -1;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	opacity: 0.25;
	pointer-events: none;
}
.quest__images
{
	display: block;
	text-align: center;
}
.quest__image
{
	display: inline-block;
	width: 96dp;
	margin: 0 var(--space-1) var(--space-2) var(--space-1);
	pointer-events: none;
}
.quest__image-art
{
	display: block;
	width: 96dp;
	height: 96dp;
}

/* Input mode: the field under the text. While idle it takes no room, no
   pointer and no Tab and draws nothing, but stays laid out, so the facade
   focuses it in the same call that turns input mode on (the dialog kit's
   idle field). The idle rule outranks the classic field rule
   (skins/classic/windows/quest.rcss). */
.quest__input
{
	display: block;
	margin-top: var(--space-3);
}
.quest__field
{
	display: block;
	width: 280dp;
	max-width: 100%;
	margin: 0 auto;
}
.quest__input.is-idle
{
	margin-top: 0;
}
body.quest .quest__input.is-idle input.quest__field
{
	position: absolute;
	width: 0dp;
	min-width: 0dp;
	height: 0dp;
	min-height: 0dp;
	margin: 0dp;
	padding: 0dp;
	border-width: 0dp;
	opacity: 0;
	pointer-events: none;
	tab-index: none;
}

/* The choices: one centered bar per answer, legacy's 200 x 26 at 1.4
   times, wrapping a long answer. A one-line bar is 36dp (a 20dp line, 7dp
   of padding above and below, the 1dp border), so the list shows six whole
   bars (6 x 36 + 5 x 8) and scrolls past them. */
.quest__choices
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-2);
	max-height: 256dp;
	margin-top: var(--space-2);
	overflow-y: auto;
}
.quest__choice
{
	display: block;
	flex: 0 0 auto;
	width: 280dp;
	max-width: 100%;
	height: auto;
	min-height: 36dp;
	padding: 7dp var(--space-3);
	font-size: 14dp;
	line-height: 20dp;
	text-align: center;
	white-space: normal;
	font-weight: normal;
	focus: none;
	tab-index: none;
}
/* The answer the arrows focus: the hover look and the accent edge. */
.quest__choice.is-hover
{
	border-color: var(--accent);
}
.quest__pager
{
	display: none;
}
.quest__pager-prev, .quest__pager-next
{
	focus: none;
	tab-index: none;
}

/* The Next button's row, centered under the text: 7dp under the last
   finished line (16dp into the 23dp open line the interpreter keeps at the
   end), as legacy's sits just under its text. It stacks above the text
   column (z-index 0), so the open line it overlaps never takes the
   button's presses. */
.quest__footer
{
	display: block;
	position: relative;
	z-index: 1;
	flex: 0 0 auto;
	margin-top: -16dp;
	padding: 0 28dp 34dp 34dp;
	text-align: center;
}
/* Input mode: the field, not an open line, ends the text, so the button
   keeps its distance under it. */
.quest--input .quest__footer
{
	margin-top: var(--space-3);
}
.quest__next
{
	display: inline-block;
	width: 150dp;
	height: 38dp;
	font-size: 14dp;
	line-height: 36dp;
	focus: none;
	tab-index: none;
}

/* The title card (TITLE_IMAGE): bottom center of the screen, legacy's 0.5s
   in, 1s shown, 0.5s out; at rest (and under reduced motion) not drawn. */
.quest__title-card
{
	display: block;
	position: absolute;
	left: 50%;
	top: 100%;
	margin-top: -53dp;
	transform: translateX(-50%);
	opacity: 0;
	pointer-events: none;
}
.quest__title-card.is-on.nui-anim
{
	animation: 2s linear-in-out quest-title-card;
}
@keyframes quest-title-card
{
	0% { opacity: 0; }
	25% { opacity: 1; }
	75% { opacity: 1; }
	100% { opacity: 0; }
}

/* Cinema (skin 5): the text in a subtitle box above the bottom edge, on a
   frame without its border (nui-window--borderless, bound in the markup). */
body.quest.quest--cinema
{
	align-items: flex-end;
}
.quest--cinema .quest__board
{
	width: 640dp;
	min-height: 0;
	max-width: 90vw;
	margin-bottom: 12vh;
}
.quest--cinema .quest__body
{
	padding: var(--space-3) var(--space-4);
}
.quest--cinema .quest__corner, .quest--cinema .quest__sheen
{
	display: none;
}
.quest--cinema .nui-quest__line
{
	text-align: center;
}
.quest--cinema .quest__footer
{
	display: none;
}

/* Scroll (skin 3): the background whole at its own size (legacy's scroll
   art fills the top 331 rows of a 256 x 512 texture), the text over it, the
   choices two to a row. */
.quest--scroll .quest__board
{
	width: 288dp;
	min-height: 0;
}
.quest--scroll .quest__body
{
	min-height: 365dp;
	padding: var(--space-4) var(--space-4) var(--space-3);
	overflow: visible;
}
.quest--scroll .quest__text
{
	--quest-line: 1.4em;
	font-size: var(--font-md);
}
.quest--scroll .quest__corner
{
	display: none;
}
.quest--scroll .quest__background
{
	left: var(--space-4);
	top: var(--space-4);
	width: 256dp;
	height: 512dp;
	opacity: 1;
}
.quest--scroll .quest__text
{
	padding: 0 var(--space-3);
}
.quest--scroll .quest__choices
{
	flex-direction: row;
	flex-wrap: wrap;
}
.quest--scroll .quest__choices
{
	align-items: stretch;
}
.quest--scroll .quest__choice
{
	flex: 1 1 40%;
	width: auto;
	min-height: 32dp;
	padding: 6dp var(--space-3);
	font-size: var(--font-md);
	line-height: 18dp;
}
