/* The restart dialog's modern look (the reviewed design, board WRestart):
   two 42dp buttons at legacy's place (50, 50), in both skins, each a glyph
   and its label; restarting here, the first, on the accent's soft fill.
   Classic (the thin board, 200 x 88, with the xlarge button art):
   skins/classic/windows/restart.rcss. */
body.restart
{
	left: 50dp;
	top: 50dp;
	width: 280dp;
	min-width: 0;
	focus: none;
	tab-index: none;
}
.restart button
{
	tab-index: none;
}
.restart__buttons
{
	display: flex;
	flex-direction: column;
	gap: 10dp;
	padding: 14dp;
}
.restart__button
{
	display: block;
	width: 100%;
	height: 42dp;
	border-radius: 9dp;
	line-height: 40dp;
}
.restart__button .nui-glyph
{
	--glyph-ink: var(--text-muted);
	margin: -2dp 10dp 0 0;
}
.restart__button:hover .nui-glyph
{
	--glyph-ink: var(--text);
}
.restart__button--here
{
	border-color: var(--accent-glow);
	background-color: var(--selection);
}
.restart__button--here .nui-glyph, .restart__button--here:hover .nui-glyph
{
	--glyph-ink: var(--accent);
}
.restart__button--here:hover
{
	border-color: var(--accent);
}
