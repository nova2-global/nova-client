/* The password dialog's modern look (P16 spec 5.4.2): the dialog kit's look
   (components/dialog.rcss: the width, the centered text and field, the
   centered footer); legacy's two lines above the field, its three below in
   the muted text, Cancel and OK. The scrim centers it. Classic (legacy's
   250 x 150 board, the parameter slot under the field, the middle buttons
   at the uiscript's places): skins/classic/windows/safebox-password.rcss. */

.safebox-password button
{
	tab-index: none;
	focus: none;
}
.safebox-password__desc--2
{
	margin-bottom: var(--space-1);
}
.safebox-password__desc--3
{
	margin-top: var(--space-3);
}
.safebox-password__desc--3, .safebox-password__desc--4, .safebox-password__desc--5
{
	color: var(--text-muted);
	font-size: var(--font-sm);
}
.safebox-password__slot
{
	display: block;
}
