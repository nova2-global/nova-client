/* The password dialog's modern look (P16 spec 5.4.2; the reviewed mockup
   WSafeboxPassword): the dialog kit's look (components/dialog.rcss), 340dp
   wide, with the key emblem before the title; legacy's two lines above the
   field, the field 144dp wide with its dots spaced and centered, legacy's
   three lines below it in the small muted text, then OK (primary) and Cancel
   sharing a 220dp row. The scrim centers it. Classic (legacy's 250 x 150
   board, the parameter slot under the field, the middle buttons at the
   uiscript's places): skins/classic/windows/safebox-password.rcss. */

.safebox-password button
{
	tab-index: none;
	focus: none;
}
.safebox-password__window
{
	width: 338dp;
	min-width: 338dp;
	max-width: none;
}
/* The title's emblem: an accent chip with a key (its bow, its shaft and its
   bit). */
.safebox-password__title-icon
{
	display: inline-block;
	position: relative;
	box-sizing: border-box;
	width: 24dp;
	height: 24dp;
	margin-right: var(--space-2);
	border-width: 1dp;
	border-color: var(--accent-glow);
	border-radius: 7dp;
	background-color: var(--selection);
	vertical-align: middle;
}
.safebox-password__key-ring, .safebox-password__key-shaft, .safebox-password__key-bit
{
	display: block;
	position: absolute;
	box-sizing: border-box;
}
.safebox-password__key-ring
{
	left: 2dp;
	top: 6dp;
	width: 10dp;
	height: 10dp;
	border-width: 2dp;
	border-color: var(--accent);
	border-radius: 9999dp;
}
.safebox-password__key-shaft
{
	left: 11dp;
	top: 10dp;
	width: 9dp;
	height: 2dp;
	border-radius: 1dp;
	background-color: var(--accent);
}
.safebox-password__key-bit
{
	left: 14dp;
	top: 11dp;
	width: 6dp;
	height: 4dp;
	border-width: 0 2dp 0 2dp;
	border-color: var(--accent);
}
.safebox-password__body
{
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 10dp 12dp 12dp;
}
.safebox-password__desc
{
	line-height: 16dp;
}
.safebox-password__slot
{
	display: block;
	margin-top: var(--space-2);
}
.safebox-password__field
{
	width: 144dp;
	text-align: center;
	letter-spacing: 0.32em;
}
.safebox-password__desc--3, .safebox-password__desc--4, .safebox-password__desc--5
{
	color: var(--text-muted);
	font-size: var(--font-sm);
}
.safebox-password__desc--3
{
	margin-top: 10dp;
}
.safebox-password__footer
{
	display: flex;
	flex-direction: row;
	width: 220dp;
	margin-top: 14dp;
	padding: 0;
	gap: 10dp;
}
.safebox-password__button
{
	flex: 1 1 0;
	min-width: 0;
}
