<rml>
<head>
	<!-- The safebox and mall password dialog (uisafebox.py PasswordDialog,
	     uiscript passworddialog.py; P16 spec 5.4.2). While the safebox flag
	     is on, the Interface makes nui_safebox.PasswordDialog, a subclass of
	     the legacy class on proxies (its board: assets/root/
	     nui_safebox_password.py): the title and the chat command the
	     Interface sets, OK and Enter send the command with the password,
	     Cancel and Escape close it, all legacy's code. A modal (D12) above the
	     legacy UI layer: the scrim centers it, as legacy's ShowDialog centers
	     the window. The field is a password input whose text never enters the
	     model; its maxlength is SAFEBOX_PASSWORD_MAX_LEN. The buttons take no
	     focus and act on a left mousedown. -->
	<title>safebox-password</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="safebox-password.rcss"/>
</head>
<body template="nui" class="nui-scrim nui-fx safebox-password" data-model="safebox_password"
      data-event-mousedown="board_press(ev.button)">
	<div class="nui-window nui-fx nui-dialog nui-anim safebox-password__window" id="safebox-password">
		<div class="nui-window__titlebar safebox-password__titlebar">
			<handle class="nui-window__handle safebox-password__handle" move_target="safebox-password">
				<span class="safebox-password__title-icon"><span class="safebox-password__key-ring"></span><span
					class="safebox-password__key-shaft"></span><span class="safebox-password__key-bit"></span></span>
				<span class="nui-window__title safebox-password__title">{{ title }}</span>
			</handle>
			<button id="safebox-password-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim"
			        data-event-mousedown="close_press(ev.button)"><span class="nui-glyph nui-glyph--close"><span
				class="nui-glyph__a"></span><span class="nui-glyph__b"></span></span></button>
		</div>
		<div class="nui-window__body safebox-password__body">
			<p class="nui-dialog__text safebox-password__desc safebox-password__desc--1">@ui.PASSWORD_DESC_1</p>
			<p class="nui-dialog__text safebox-password__desc safebox-password__desc--2">@ui.PASSWORD_DESC_2</p>
			<div class="safebox-password__slot"><input id="safebox-password-field" type="password"
				class="nui-input nui-dialog__field safebox-password__field" data-attr-maxlength="max"/></div>
			<p class="nui-dialog__text safebox-password__desc safebox-password__desc--3">@ui.PASSWORD_DESC_3</p>
			<p class="nui-dialog__text safebox-password__desc safebox-password__desc--4">@ui.PASSWORD_DESC_4</p>
			<p class="nui-dialog__text safebox-password__desc safebox-password__desc--5">@ui.PASSWORD_DESC_5</p>
			<div class="nui-dialog__footer safebox-password__footer">
				<button id="safebox-password-accept" class="nui-button nui-button--medium nui-button--primary nui-anim safebox-password__button safebox-password__button--accept"
				        data-event-mousedown="accept_press(ev.button)">@ui.OK</button>
				<button id="safebox-password-cancel" class="nui-button nui-button--medium nui-anim safebox-password__button safebox-password__button--cancel"
				        data-event-mousedown="cancel_press(ev.button)">@ui.CANCEL</button>
			</div>
		</div>
	</div>
</body>
</rml>
