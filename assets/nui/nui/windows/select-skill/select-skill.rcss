.select-skill__ring--2.select-skill__ring--n6 .select-skill__cell--k1 { left: 375dp; top: 107dp; }
.select-skill__ring--2.select-skill__ring--n6 .select-skill__cell--k2 { left: 408dp; top: 180dp; }
.select-skill__ring--2.select-skill__ring--n6 .select-skill__cell--k3 { left: 408dp; top: 260dp; }
.select-skill__ring--2.select-skill__ring--n6 .select-skill__cell--k4 { left: 375dp; top: 333dp; }
.select-skill__ring--2.select-skill__ring--n6 .select-skill__cell--k5 { left: 316dp; top: 386dp; }
.select-skill__ring--2.select-skill__ring--n7 .select-skill__cell--k0 { left: 316dp; top: 54dp; }
.select-skill__ring--2.select-skill__ring--n7 .select-skill__cell--k1 { left: 367dp; top: 97dp; }
