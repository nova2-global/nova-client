/* Character select: an overlay (nui-overlay) over the legacy background and
   the 3D characters; only the board and the arrows take the mouse
   (nui-interactive). Positions are the legacy screen fractions (uiscript
   selectcharacterwindow.py): the board at 65/800 from the left with its
   bottom where the legacy board's was (57/600 above the bottom edge), so a
   tall scale keeps its buttons on the screen; the class-name art keeps its
   legacy offset from the board's top (-27, -149); the arrows sit at the
   legacy dragon art's places, (384/800, 505/600) and (558/800, 505/600),
   160 by 36. The class-name art and the empire flag are content in every
   theme; classic draws the legacy dragon art for the arrows.

   Modern (the reviewed design, stage 1): a 280dp panel with the legacy rows
   in their legacy order: the empire card (flag, kingdom, guild) in a well;
   the four slots as cells with their number, the name and the level with
   a mark, the chosen one in the accent's soft fill with an accent edge;
   name, level and play time as label and value wells; the four stat bars;
   Start (with its play mark) across the panel, Delete (danger) and Close
   under it. It stays under 500dp, so at 720dp of screen the class-name art
   still fits above it. The arrows are blades with their arrowheads, light
   on the dark scene in both palettes, the accent under the pointer.
   Classic (legacy's thin board, its boxes and art at 100%):
   skins/classic/windows/select.rcss. */
.select-board
{
	position: absolute;
	left: 8.125%;
	bottom: 9.5%;
	width: 280dp;
	min-width: 0dp;
	box-sizing: border-box;
	padding: 12dp 12dp 0dp 12dp;
}
.select-job
{
	position: absolute;
	left: -27dp;
	top: -149dp;
	pointer-events: none;
}
/* Below 720dp of screen the modern board's top is too close to the
   screen's top for the art 149dp above it, which would be cut (2400x1350
   at 200%: 675dp). There the art is left out, as D13 leaves out the
   keyboard. The classic board is short enough at any height, so the
   classic overlay shows the art there too. */
@media (max-height: 719dp)
{
	.select-job
	{
		display: none;
	}
}

/* --- The empire card --------------------------------------------------------------- */

.select-empire
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12dp;
	padding: 8dp 10dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 10dp;
}
.select-empire__flag
{
	display: block;
	flex: 0 0 auto;
	width: 64dp;
	height: 39.5dp;
}
.select-flag
{
	display: block;
	width: 64dp;
	height: 39.5dp;
}
.select-empire__text
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-width: 0dp;
	gap: 2dp;
}
.select-empire__text .select-value
{
	white-space: normal;
}
.select-empire__name
{
	font-size: 13dp;
	font-weight: bold;
}
.select-empire__guild
{
	color: var(--text-muted);
	font-size: var(--font-sm);
}

/* --- The slots ----------------------------------------------------------------------- */

.select-slots
{
	margin: 10dp 0dp 0dp 0dp;
}
.select-slots .nui-list__viewport
{
	display: flex;
	flex-direction: column;
	gap: 4dp;
}
/* A cell per slot: its number, the name in the middle, the level and its
   mark; the chosen slot in the accent's soft fill with an accent edge. */
.select-slot
{
	min-height: 28dp;
	padding: 0dp 10dp 0dp 7dp;
	gap: 6dp;
	background-color: var(--surface-raised);
	border-color: var(--border);
	border-radius: 8dp;
}
.select-slot.is-selected
{
	background-color: var(--selection);
	border-color: var(--accent);
	border-left-width: 3dp;
	padding-left: 5dp;
	color: var(--text);
}
.select-slot__index
{
	flex: 0 0 auto;
	width: 18dp;
	color: var(--text-muted);
	font-size: 10dp;
}
.select-slot .nui-list__label
{
	flex: 1 1 auto;
	min-width: 0dp;
	font-weight: bold;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
.select-slot--empty .nui-list__label
{
	color: var(--text-muted);
	font-weight: normal;
}
.select-slot .nui-list__meta
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	gap: 5dp;
	color: var(--text-muted);
}
.select-slot__dot
{
	display: block;
	width: 6dp;
	height: 6dp;
	border-radius: 3dp;
	background-color: var(--success);
}

/* --- Name, level and play time ------------------------------------------------------ */

.select-info
{
	display: flex;
	flex-direction: column;
	gap: 4dp;
	padding: 10dp 0dp 0dp 0dp;
}
.select-row
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	box-sizing: border-box;
	height: 26dp;
	padding: 0dp 9dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 8dp;
}
.select-label
{
	flex: 0 0 auto;
	color: var(--text-muted);
	font-size: var(--font-sm);
}
.select-value
{
	display: block;
	white-space: nowrap;
}
.select-row .select-value
{
	flex: 1 1 auto;
	min-width: 0dp;
	margin-left: var(--space-2);
	font-weight: bold;
	text-align: right;
}

/* --- The stat bars ------------------------------------------------------------------- */

.select-stats
{
	display: flex;
	flex-direction: column;
	gap: 6dp;
	padding: 10dp 0dp 0dp 0dp;
}
.select-stat
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 9dp;
	height: 14dp;
}
.select-stat__label
{
	flex: 0 0 auto;
	min-width: 30dp;
	color: var(--text-muted);
	font-size: 10dp;
	font-weight: bold;
}
.select-stat__gauge
{
	flex: 1 1 auto;
	height: 8dp;
}
/* SP in the SP blue, as the design's bars (the gauge's pink is gold). */
progress.select-stat__gauge--sp fill
{
	background-color: var(--gauge-blue);
	decorator: linear-gradient(180deg, var(--text-inverse) 0%, var(--gauge-blue) 24%, var(--gauge-blue) 100%);
}
.select-stat__value
{
	flex: 0 0 auto;
	width: 28dp;
	text-align: right;
}

/* --- Start, Delete and Close --------------------------------------------------------- */

.select-footer
{
	flex-direction: column;
	align-items: stretch;
	gap: 8dp;
	margin: 12dp -12dp 0dp -12dp;
	padding: 12dp;
}
.select-footer__main, .select-footer__row
{
	display: flex;
	flex-direction: row;
	gap: 8dp;
}
.select-button
{
	flex: 1 1 0dp;
	padding: 0dp var(--space-2);
}
.select-button--main
{
	height: 34dp;
	line-height: 32dp;
}
/* The play mark on Start: a triangle (a zero-size box with one colored
   border) before the label. */
.select-play
{
	display: inline-block;
	width: 0dp;
	height: 0dp;
	margin: 0dp 7dp 1dp 0dp;
	border-width: 5dp 0dp 5dp 8dp;
	border-color: transparent transparent transparent var(--accent-text);
	vertical-align: middle;
}

/* --- The rotate arrows ---------------------------------------------------------------- */

/* Each is the legacy art's 160 by 36 box: a blade (a long thin triangle,
   point outward, on a light edge) and its arrowhead (two bars), tilted as
   the legacy dragon blades are. The scene is dark in every palette, so the
   blade is the scene's color and the head the light text color; the head
   takes the accent under the pointer. The glyph text stays for classic,
   which shows it over its art while the arrows are disabled. */
.select-arrow
{
	position: absolute;
	top: 84.17%;
	width: 160dp;
	height: 36dp;
	margin: 0dp;
	padding: 0dp;
	background-color: transparent;
	border-color: transparent;
	color: transparent;
}
.select-arrow:hover, .select-arrow:active
{
	background-color: transparent;
}
.select-arrow--left
{
	left: 48%;
}
.select-arrow--right
{
	left: 69.75%;
}
.select-blade, .select-tip
{
	display: block;
	position: absolute;
	pointer-events: none;
}
/* A zero-size box with a colored top border and a clear left one: the
   point at the left end, the back (12dp) at the right. */
.select-blade
{
	top: 12dp;
	width: 0dp;
	height: 0dp;
	border-width: 12dp 0dp 0dp 124dp;
	border-color: var(--scene) transparent transparent transparent;
	transform-origin: 124dp 0dp;
}
.select-blade--edge
{
	top: 11dp;
	border-width: 14dp 0dp 0dp 128dp;
	border-color: var(--sheen) transparent transparent transparent;
	transform-origin: 128dp 1dp;
}
.select-arrow--left .select-blade
{
	left: 16dp;
	transform: rotate(-9deg);
}
.select-arrow--left .select-blade--edge
{
	left: 12dp;
}
/* The right blade is the left one mirrored about its back end, which sits
   20dp into the box. */
.select-arrow--right .select-blade
{
	left: -104dp;
	transform: scaleX(-1) rotate(-9deg);
}
.select-arrow--right .select-blade--edge
{
	left: -108dp;
}
.select-tip
{
	top: 24dp;
	width: 18dp;
	height: 2dp;
	border-radius: 1dp;
	background-color: var(--text-inverse);
}
.select-arrow--left .select-tip
{
	left: 14dp;
	transform-origin: 1dp 1dp;
}
.select-arrow--left .select-tip--a { transform: rotate(-38deg); }
.select-arrow--left .select-tip--b { transform: rotate(6deg); }
.select-arrow--right .select-tip
{
	left: 128dp;
	transform-origin: 17dp 1dp;
}
.select-arrow--right .select-tip--a { transform: rotate(38deg); }
.select-arrow--right .select-tip--b { transform: rotate(-6deg); }
.select-arrow:hover .select-tip
{
	background-color: var(--accent);
}
