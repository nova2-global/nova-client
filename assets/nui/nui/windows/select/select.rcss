/* Character select: an overlay (nui-overlay) over the legacy background and
   the 3D characters; only the board and the arrows take the mouse
   (nui-interactive). Positions are the legacy screen fractions and sizes the
   legacy pixels in dp (uiscript selectcharacterwindow.py): the board,
   208dp wide, at 65/800 from the left with its bottom where the legacy
   board's was (57/600 above the bottom edge), so a tall scale keeps its
   buttons on the screen; the class-name art keeps its legacy offset from
   the board's top (-27, -149); the arrows sit at (384/800, 505/600) and
   (558/800, 505/600). The class-name art, the empire flag and (classic)
   the arrows are legacy art in every theme. */
.select-board
{
	position: absolute;
	left: 8.125%;
	bottom: 9.5%;
	width: 208dp;
	min-width: 0dp;
	box-sizing: border-box;
}
.select-job
{
	position: absolute;
	left: -27dp;
	top: -149dp;
	pointer-events: none;
}

.select-empire
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: var(--space-2);
	padding: var(--space-3) var(--space-3) 0dp var(--space-3);
}
.select-empire__flag
{
	display: block;
	flex: 0 0 auto;
	width: 64dp;
	height: 39.5dp;
}
.select-flag
{
	display: block;
	width: 64dp;
	height: 39.5dp;
}
.select-empire__text
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-width: 0dp;
}
.select-empire__text .select-value
{
	white-space: normal;
}
.select-empire__name
{
	font-weight: bold;
}
.select-empire__guild
{
	color: var(--text-muted);
	font-size: var(--font-sm);
}

.select-slots
{
	margin: var(--space-2) var(--space-3) 0dp var(--space-3);
}
.select-slot
{
	padding: var(--space-1) var(--space-2);
}
.select-slot .nui-list__label
{
	flex: 1 1 auto;
}
.select-slot .nui-list__meta
{
	flex: 0 0 auto;
	color: var(--text-muted);
}

.select-info
{
	padding: var(--space-2) var(--space-3) 0dp var(--space-3);
}
.select-row
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	height: 20dp;
}
.select-label
{
	flex: 0 0 auto;
	color: var(--text-muted);
}
.select-value
{
	display: block;
	white-space: nowrap;
}
.select-row .select-value
{
	flex: 1 1 auto;
	min-width: 0dp;
	margin-left: var(--space-2);
	text-align: right;
}

.select-stats
{
	padding: var(--space-1) var(--space-3) var(--space-3) var(--space-3);
}
.select-stat
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: var(--space-2);
	height: 20dp;
}
.select-stat__label
{
	flex: 0 0 auto;
	min-width: 30dp;
	color: var(--text-muted);
	font-size: var(--font-sm);
}
.select-stat__gauge
{
	flex: 1 1 auto;
}
.select-stat__value
{
	flex: 0 0 auto;
	width: 28dp;
	text-align: right;
}

.select-footer
{
	flex-direction: column;
	align-items: stretch;
	gap: var(--space-2);
	padding: var(--space-3);
}
.select-footer__main, .select-footer__row
{
	display: flex;
	flex-direction: row;
	gap: var(--space-2);
}
.select-button
{
	flex: 1 1 0dp;
	padding: 0dp var(--space-2);
}

/* Modern arrows: icon buttons centered on the legacy dragon art (160 by 36). */
.select-arrow
{
	position: absolute;
	top: 84.17%;
	margin: 2dp 0dp 0dp 64dp;
}
.select-arrow--left
{
	left: 48%;
}
.select-arrow--right
{
	left: 69.75%;
}

/* --- Classic skin ------------------------------------------------------------
   The legacy thin board with its rows at the legacy offsets: the empire flag
   (half size) at (21, 12) beside the empire and guild boxes (90 by 18) at
   x 100, then the slot list (17dp rows), the name and level boxes (130 by
   18) at x 60 and the play time box (90 by 18) at x 100, 26dp apart, and
   the four stat rows (the legacy gauge, 100dp, at x 47, and a 39 by 18 box
   at x 151). Start or Create spans the board (180dp; the large art,
   stretched), Delete and Exit (88dp) under it. Value boxes are the legacy
   slot bar, with the text centered. The arrows are the legacy dragon art
   (160 by 36), without a label. */
.skin-classic .nui-window.select-board
{
	decorator: classic-thinboard;
	padding: 0dp 0dp 13dp 0dp;
}
.skin-classic .select-empire
{
	gap: 15dp;
	align-items: flex-start;
	padding: 12dp 0dp 0dp 21dp;
}
.skin-classic .select-empire__text
{
	flex: 0 0 auto;
	width: 90dp;
}
.skin-classic .select-empire__name
{
	font-weight: normal;
}
.skin-classic .select-empire__guild
{
	margin-top: 3dp;
	color: var(--text);
	font-size: var(--font-md);
}
.skin-classic .select-value
{
	box-sizing: border-box;
	height: 18dp;
	line-height: 16dp;
	padding: 0dp 2dp;
	background-color: var(--classic-slot-fill);
	border-width: 1dp;
	border-color: var(--classic-slot-dark) var(--classic-slot-light) var(--classic-slot-light) var(--classic-slot-dark);
	color: var(--text);
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
.skin-classic .select-slots
{
	margin: 6dp 10dp 0dp 10dp;
}
.skin-classic .select-info
{
	padding: 4dp 0dp 0dp 17dp;
}
/* A row spans the legacy 173dp (x 17 to 190). A label longer than the legacy
   offset (43dp, 83dp for the play time) narrows its box, which keeps its
   right edge. */
.skin-classic .select-row
{
	justify-content: flex-start;
	width: 173dp;
	height: 26dp;
}
.skin-classic .select-label
{
	min-width: 43dp;
	padding-right: 2dp;
	box-sizing: border-box;
	color: var(--text);
}
.skin-classic .select-label--long
{
	min-width: 83dp;
}
.skin-classic .select-row .select-value
{
	flex: 1 1 auto;
	min-width: 40dp;
	margin-left: auto;
	text-align: center;
}
.skin-classic .select-value--wide
{
	max-width: 130dp;
}
.skin-classic .select-value--time
{
	max-width: 90dp;
}
.skin-classic .select-stats
{
	padding: 0dp 0dp 0dp 17dp;
}
/* A stat row spans 173dp too: the label (30dp, longer where the locale's
   is), the gauge (100dp, narrower after a long label) and the box. */
.skin-classic .select-stat
{
	gap: 0dp;
	width: 173dp;
	height: 26dp;
}
.skin-classic .select-stat__label
{
	min-width: 30dp;
	padding-right: 2dp;
	box-sizing: border-box;
	color: var(--text);
	font-size: var(--font-md);
}
.skin-classic .select-stat__gauge
{
	flex: 1 1 auto;
	max-width: 100dp;
	margin: 0dp 4dp 0dp auto;
}
.skin-classic .select-stat__value
{
	width: 39dp;
	text-align: center;
}
.skin-classic .select-footer
{
	gap: 14dp;
	margin: 4dp 0dp 0dp 14dp;
	padding: 0dp;
}
.skin-classic .select-footer__row
{
	gap: 3dp;
}
.skin-classic .select-button
{
	flex: 0 0 auto;
	width: 88dp;
	min-width: 88dp;
	padding: 0dp;
}
.skin-classic .select-button--main
{
	width: 180dp;
}
/* The legacy labels are gray, Start and Create too. */
.skin-classic .select-button.nui-button--primary
{
	color: var(--classic-button-text);
}
.skin-classic .select-arrow
{
	width: 160dp;
	height: 36dp;
	margin: 0dp;
	color: transparent;
}
.skin-classic .select-arrow--left
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_left_button_01.sub");
}
.skin-classic .select-arrow--right
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_right_button_01.sub");
}
.skin-classic .select-arrow--left:hover, .skin-classic .select-arrow--left:focus-visible
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_left_button_02.sub");
}
.skin-classic .select-arrow--right:hover, .skin-classic .select-arrow--right:focus-visible
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_right_button_02.sub");
}
.skin-classic .select-arrow--left:active
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_left_button_03.sub");
}
.skin-classic .select-arrow--right:active
{
	decorator: image("d:/ymir work/ui/intro/select/dragon_right_button_03.sub");
}
