<rml>
<head>
	<!-- Character select: replaces the legacy select board (uiscript
	     selectcharacterwindow.py) while the select flag is on (controller:
	     assets/root/nui_select.py; SelectCharacterWindow subclasses
	     introSelect.SelectCharacterWindow, which keeps the 3D characters,
	     the hotkeys, the timers and every packet). An overlay: the legacy
	     background and the characters, drawn in the legacy UI layer, show
	     through, and only the board and the arrows take the mouse. The
	     slot list is new: one row per slot, with its character's name and
	     level. Names come from the model through nui.plain_text. While a
	     start is under way (busy) every button is disabled. -->
	<title>select</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="select.rcss"/>
</head>
<body template="nui" class="nui-overlay select" data-model="select">
	<div id="select-board" class="nui-window nui-interactive select-board">
		<img class="select-job" data-attr-src="'/' + job_image" data-if="job_image != ''"/>
		<div class="select-empire">
			<div class="select-empire__flag">
				<img class="select-flag" data-attr-src="flag_image" data-if="flag_image != ''"/>
			</div>
			<div class="select-empire__text">
				<span class="select-value select-empire__name">{{ empire_name }}</span>
				<span class="select-value select-empire__guild">{{ guild }}</span>
			</div>
		</div>
		<div class="nui-list select-slots">
			<div class="nui-list__viewport">
				<div class="nui-list__item nui-anim select-slot" data-for="s : slots"
					data-attr-id="'select-slot-' + s.index"
					data-class-is-selected="s.index == slot"
					data-event-click="pick_slot(s.index)"><span class="nui-list__label">{{ s.label }}</span><span class="nui-list__meta" data-if="s.level > 0">{{ s.level }}</span></div>
			</div>
		</div>
		<div class="select-info">
			<div class="select-row">
				<span class="select-label">@ui.SELECT_NAME</span>
				<span id="select-name" class="select-value select-value--wide">{{ name }}</span>
			</div>
			<div class="select-row">
				<span class="select-label">@ui.SELECT_LEVEL</span>
				<span id="select-level" class="select-value select-value--wide">{{ level }}</span>
			</div>
			<div class="select-row">
				<span class="select-label select-label--long">@ui.SELECT_PLAYTIME</span>
				<span id="select-playtime" class="select-value select-value--time">{{ playtime }}</span>
			</div>
		</div>
		<div class="select-stats">
			<div class="select-stat">
				<span class="select-stat__label">@ui.SELECT_HP</span>
				<progress id="select-gauge-hth" class="nui-gauge nui-gauge--red select-stat__gauge" direction="right" data-attr-value="gauge_hth"/>
				<span class="select-value select-stat__value">{{ stat_hth }}</span>
			</div>
			<div class="select-stat">
				<span class="select-stat__label">@ui.SELECT_SP</span>
				<progress id="select-gauge-int" class="nui-gauge nui-gauge--pink select-stat__gauge" direction="right" data-attr-value="gauge_int"/>
				<span class="select-value select-stat__value">{{ stat_int }}</span>
			</div>
			<div class="select-stat">
				<span class="select-stat__label">@ui.SELECT_ATT_GRADE</span>
				<progress id="select-gauge-str" class="nui-gauge nui-gauge--purple select-stat__gauge" direction="right" data-attr-value="gauge_str"/>
				<span class="select-value select-stat__value">{{ stat_str }}</span>
			</div>
			<div class="select-stat">
				<span class="select-stat__label">@ui.SELECT_DEX_GRADE</span>
				<progress id="select-gauge-dex" class="nui-gauge nui-gauge--blue select-stat__gauge" direction="right" data-attr-value="gauge_dex"/>
				<span class="select-value select-stat__value">{{ stat_dex }}</span>
			</div>
		</div>
		<div class="nui-window__footer select-footer">
			<div class="select-footer__main">
				<button id="select-start" class="nui-button nui-button--primary nui-anim select-button select-button--main" data-if="occupied" data-attrif-disabled="busy" data-event-click="start()">@ui.SELECT_SELECT</button>
				<button id="select-create" class="nui-button nui-button--primary nui-anim select-button select-button--main" data-if="!occupied" data-attrif-disabled="busy" data-event-click="create()">@ui.SELECT_CREATE</button>
			</div>
			<div class="select-footer__row">
				<button id="select-delete" class="nui-button nui-anim select-button" data-if="occupied" data-attrif-disabled="busy" data-event-click="remove()">@ui.SELECT_DELETE</button>
				<button id="select-exit" class="nui-button nui-anim select-button" data-attrif-disabled="busy" data-event-click="leave()">@ui.SELECT_EXIT</button>
			</div>
		</div>
	</div>
	<button id="select-left" class="nui-button nui-button--icon nui-anim nui-interactive select-arrow select-arrow--left" data-attrif-disabled="busy" data-event-click="left()">&#8249;</button>
	<button id="select-right" class="nui-button nui-button--icon nui-anim nui-interactive select-arrow select-arrow--right" data-attrif-disabled="busy" data-event-click="right()">&#8250;</button>
</body>
</rml>
