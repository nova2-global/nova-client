/* Server and channel board: a body-level window, 375dp wide, centered and
   72dp above the bottom edge, as the legacy ServerBoard (uiscript
   loginwindow.py). The server list (232dp; 224dp in modern, whose card
   has more padding) and the channel column (109dp) sit side by side; OK and Exit end the column. The list viewports are the
   legacy 351dp, and 160dp on a screen under 560dp, so the board fits at 200%
   on 900 lines.
   Modern (the reviewed login card's look, stage 1): 16dp of padding, each
   list in a sunken well, OK and Exit as wide as the channel column, 32dp
   tall, at its foot. Classic: skins/classic/windows/server-board.rcss. */
body.server-board
{
	width: 375dp;
	left: 50%;
	margin-left: -187.5dp;
	bottom: 72dp;
	min-width: 0dp;
	box-sizing: border-box;
	padding: 16dp;
}
.server-board__title
{
	display: block;
	padding-bottom: 4dp;
	text-align: center;
	font-weight: bold;
}
.server-board__row
{
	display: flex;
	flex-direction: row;
}
/* The lists in sunken wells (one class each, so classic's list rule keeps
   its plain boxes). */
.server-board__servers, .server-board__channels
{
	padding: 4dp;
	background-color: var(--surface-sunken);
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 10dp;
}
.server-board__servers
{
	width: 224dp;
	flex: 0 0 auto;
	margin-top: 8dp;
}
.server-board__servers .nui-list__viewport
{
	height: 351dp;
}
.server-board__split
{
	display: block;
	width: 0dp;
	margin: 8dp 4dp 0dp 5dp;
	border-left-width: 1dp;
	border-left-color: var(--border);
}
.server-board__side
{
	display: flex;
	flex-direction: column;
	width: 109dp;
	flex: 0 0 auto;
	margin-top: 8dp;
}
/* The column is as tall as the server list's well: the channel viewport,
   its well's 10dp of padding and border, and the two buttons with their
   gaps. */
.server-board__channels .nui-list__viewport
{
	height: 273dp;
}
/* The column is narrow: tighter rows, and neither the name nor the state
   shrinks (RmlUi flex items shrink below their content). */
.server-board__channels .nui-list__item
{
	padding: var(--space-2) 6dp;
	gap: var(--space-1);
}
.server-board__channels .nui-list__label
{
	flex: 0 0 auto;
}
.server-board__state
{
	flex: 0 0 auto;
	margin-left: auto;
}
.server-board__buttons
{
	display: flex;
	flex-direction: column;
	align-items: stretch;
	gap: 6dp;
	margin-top: 8dp;
}
.server-board__button
{
	min-width: 88dp;
}
.server-board__action
{
	height: 32dp;
	line-height: 30dp;
}

@media (max-height: 560dp)
{
	.server-board__servers .nui-list__viewport
	{
		height: 160dp;
	}
	.server-board__channels .nui-list__viewport
	{
		height: 82dp;
	}
}
