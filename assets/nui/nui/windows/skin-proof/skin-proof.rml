<rml>
<head>
	<!-- Dev page: the frame pieces of a skin at the legacy sizes of a typical
	     window (ui.Board 280x160 with a TitleBar, a close button, an input and
	     two large buttons), for the sharpness, seam and fidelity checks.
	     Nothing opens it but tests and verify kits. -->
	<title>skin-proof</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="skin-proof.rcss"/>
</head>
<body template="nui" class="nui-window proof">
	<div id="proof-titlebar" class="nui-window__titlebar">
		<handle class="nui-window__handle" move_target="#document"><span class="nui-window__title">Skin proof</span></handle>
		<button id="proof-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close">&#215;</button>
	</div>
	<input id="proof-field" type="text" class="nui-input" value="Metin2"/>
	<button id="proof-button" class="nui-button">@ui.OK</button>
	<button id="proof-button-over" class="nui-button is-hover">@ui.CANCEL</button>
</body>
</rml>
