/* The system options' modern look: a movable window, the legacy rows as
   label and control rows in legacy's order, then the Interface section
   under its heading. Choices are buttons; the one in effect is selected
   (is-selected). The facade centers the body. Classic (the legacy board at
   legacy's places, the Interface section under it on legacy art):
   skins/classic/windows/system-options.rcss. */

/* The sheet's own place frames the window in its 560 x 600dp snapshots;
   the facade's center() replaces it in the client. The window is never
   taller than the screen (about 500dp: 999 px at 200% on a 900 px screen):
   the title bar stays and the rows scroll. 99vh leaves room for the border
   outside the content box. */
body.system-options
{
	left: 30dp;
	top: 12dp;
	width: 500dp;
	max-height: 99vh;
	display: flex;
	flex-direction: column;
	focus: none;
	tab-index: none;
}
.system-options button
{
	tab-index: none;
}
.system-options__titlebar
{
	flex: 0 0 auto;
}

.system-options__body
{
	flex: 1 1 auto;
	overflow-y: auto;
	padding: var(--space-3) var(--space-4) var(--space-4) var(--space-4);
}

.so-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 32dp;
	margin-top: var(--space-2);
}
.so-row:first-child
{
	margin-top: 0;
}
.so-label
{
	display: block;
	flex: 0 0 auto;
	width: 120dp;
	color: var(--text-muted);
	font-size: var(--font-md);
}
.so-slider
{
	width: 260dp;
}
.so-choices
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	align-items: center;
	gap: var(--space-1);
}
.so-choices--wrap
{
	flex-wrap: wrap;
}
.so-slot
{
	display: block;
}
.so-choice
{
	display: block;
	padding: 0 var(--space-3);
}
.so-tiling-apply
{
	margin-left: var(--space-2);
}
.so-music-file
{
	display: block;
	margin-left: var(--space-3);
	color: var(--text);
	font-size: var(--font-md);
	white-space: nowrap;
}

/* The scale choices are short labels ("75%"), in a tighter button. */
.so-choice--scale
{
	padding: 0 var(--space-2);
	min-width: 52dp;
}
.so-auto-percent
{
	color: var(--text-muted);
	font-weight: normal;
}
.so-choice--scale.is-selected .so-auto-percent
{
	color: var(--text);
}

.so-interface
{
	display: block;
	margin-top: var(--space-4);
	padding-top: var(--space-3);
	border-top-width: 1dp;
	border-top-color: var(--border);
}
.so-heading
{
	display: block;
	margin-bottom: var(--space-1);
	color: var(--text);
	font-size: var(--font-md);
	font-weight: bold;
}
.so-row--motion
{
	min-height: 28dp;
}
.so-motion
{
	color: var(--text);
	font-size: var(--font-md);
}
