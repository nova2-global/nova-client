<rml>
<head>
	<!-- The system options (uisystemoption.py OptionDialog, uiscript
	     systemoptiondialog.py) and the Interface section NovaUI adds: the
	     theme, the UI scale and reduced motion. While the system-options flag
	     is on, the system menu makes the facade
	     nui_system_options.OptionDialog (controller
	     assets/root/nui_system_options.py) through uiSystemOption's factory.
	     The document exists only while the window shows (nui_hud.OnDemand);
	     the facade fills the model from the getters at each show. The legacy
	     rows keep legacy's order and calls: the sound and music sliders, the
	     background music and its Change button (the music list), the camera
	     distance, the fog and the tiling choices with Apply. The Interface
	     section applies each choice at once and saves it (nui.set_theme,
	     set_scale_percent, set_reduced_motion); the scale is a row of
	     choices, not a slider, so the window does not rescale under a drag
	     (P11 spec D12). The body and its controls take no focus: the buttons
	     act on a left mousedown, the sliders and the toggle on their change
	     events; Escape reaches the window in its legacy place
	     (nui_hud.EscapeProxy). The theme and scale choices are repeated in a
	     bare wrapper, so their own bindings read the item from a child (the
	     scale list shrinks when a custom percent goes). -->
	<title>system-options</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="system-options.rcss"/>
</head>
<body template="nui" class="nui-window nui-anim system-options" data-model="system_options">
	<div class="nui-window__titlebar system-options__titlebar">
		<handle class="nui-window__handle system-options__handle" move_target="#document">
			<span class="nui-window__title system-options__title">@ui.SYSTEMOPTION_TITLE</span>
		</handle>
		<button id="so-close" class="nui-button nui-button--ghost nui-button--icon nui-window__close nui-anim" data-event-mousedown="act('close', ev.button)">&#215;</button>
	</div>
	<div class="nui-window__body system-options__body">
		<div class="so-legacy">
			<div class="so-row so-row--sound">
				<span class="so-label so-label--sound">@ui.OPTION_SOUND</span>
				<input id="so-sound" type="range" class="nui-slider so-slider so-slider--sound" min="0" max="100" step="1"
					data-attr-value="sound_volume" data-event-change="sound(ev.value)"/>
			</div>
			<div class="so-row so-row--music">
				<span class="so-label so-label--music">@ui.OPTION_MUSIC</span>
				<input id="so-music" type="range" class="nui-slider so-slider so-slider--music" min="0" max="100" step="1"
					data-attr-value="music_volume" data-event-change="music(ev.value)"/>
			</div>
			<div class="so-row so-row--bgm">
				<button id="so-music-change" class="nui-button nui-button--medium nui-anim so-choice so-choice--middle so-music-change" data-event-mousedown="act('change_music', ev.button)"><span class="so-choice__label">@ui.OPTION_MUSIC_CHANGE</span></button>
				<span id="so-music-file" class="so-music-file">{{ music_file }}</span>
			</div>
			<div class="so-row so-row--camera">
				<span class="so-label so-label--camera">@ui.OPTION_CAMERA_DISTANCE</span>
				<div class="so-choices">
					<button id="so-camera-0" class="nui-button nui-button--medium nui-anim so-choice so-choice--middle so-choice--camera-0" data-class-is-selected="camera == 0" data-event-mousedown="choose('camera', 0, ev.button)"><span class="so-choice__label">@ui.OPTION_CAMERA_DISTANCE_SHORT</span></button>
					<button id="so-camera-1" class="nui-button nui-button--medium nui-anim so-choice so-choice--middle so-choice--camera-1" data-class-is-selected="camera == 1" data-event-mousedown="choose('camera', 1, ev.button)"><span class="so-choice__label">@ui.OPTION_CAMERA_DISTANCE_LONG</span></button>
				</div>
			</div>
			<div class="so-row so-row--fog">
				<span class="so-label so-label--fog">@ui.OPTION_FOG</span>
				<div class="so-choices">
					<button id="so-fog-0" class="nui-button nui-button--medium nui-anim so-choice so-choice--small so-choice--fog-0" data-class-is-selected="fog == 0" data-event-mousedown="choose('fog', 0, ev.button)"><span class="so-choice__label">@ui.OPTION_FOG_DENSE</span></button>
					<button id="so-fog-1" class="nui-button nui-button--medium nui-anim so-choice so-choice--small so-choice--fog-1" data-class-is-selected="fog == 1" data-event-mousedown="choose('fog', 1, ev.button)"><span class="so-choice__label">@ui.OPTION_FOG_MIDDLE</span></button>
					<button id="so-fog-2" class="nui-button nui-button--medium nui-anim so-choice so-choice--small so-choice--fog-2" data-class-is-selected="fog == 2" data-event-mousedown="choose('fog', 2, ev.button)"><span class="so-choice__label">@ui.OPTION_FOG_LIGHT</span></button>
				</div>
			</div>
			<div class="so-row so-row--tiling">
				<span class="so-label so-label--tiling">@ui.OPTION_TILING</span>
				<div class="so-choices">
					<button id="so-tiling-0" class="nui-button nui-button--medium nui-anim so-choice so-choice--small so-choice--tiling-0" data-class-is-selected="tiling == 0" data-event-mousedown="choose('tiling', 0, ev.button)"><span class="so-choice__label">@ui.OPTION_TILING_CPU</span></button>
					<button id="so-tiling-1" class="nui-button nui-button--medium nui-anim so-choice so-choice--small so-choice--tiling-1" data-class-is-selected="tiling == 1" data-event-mousedown="choose('tiling', 1, ev.button)"><span class="so-choice__label">@ui.OPTION_TILING_GPU</span></button>
					<button id="so-tiling-apply" class="nui-button nui-button--medium nui-anim so-choice so-choice--middle so-tiling-apply" data-event-mousedown="act('tiling_apply', ev.button)"><span class="so-choice__label">@ui.OPTION_TILING_APPLY</span></button>
				</div>
			</div>
		</div>
		<div id="so-interface" class="so-interface" data-if="interface">
			<div class="so-heading">@ui.OPTION_INTERFACE</div>
			<div class="so-row so-row--theme">
				<span class="so-label so-label--theme">@ui.THEME_TITLE</span>
				<div class="so-choices so-choices--wrap">
					<span class="so-slot" data-for="t : themes"><button class="nui-button nui-button--medium nui-anim so-choice so-choice--theme"
						data-attr-id="'so-theme-' + t.id" data-class-is-selected="t.id == theme" data-event-mousedown="choose_theme(t.id, ev.button)">{{ t.label }}</button></span>
				</div>
			</div>
			<div class="so-row so-row--scale">
				<span class="so-label so-label--scale">@ui.OPTION_UI_SCALE</span>
				<div class="so-choices so-choices--wrap">
					<span class="so-slot" data-for="s : scales"><button class="nui-button nui-anim so-choice so-choice--scale"
						data-attr-id="'so-scale-' + s.id" data-class-is-selected="s.percent == scale" data-event-mousedown="choose_scale(s.percent, ev.button)">{{ s.label }}<span
						class="so-auto-percent" data-if="s.id == 'auto'"> {{ auto_percent }}%</span></button></span>
				</div>
			</div>
			<div class="so-row so-row--motion">
				<!-- The checkbox inside a nui-toggle has no box of its own: a
				     click on the label (its id: so-motion-toggle) toggles it. -->
				<label id="so-motion-toggle" class="nui-toggle so-motion">
					<input id="so-motion" type="checkbox" class="nui-toggle__input"
						data-attrif-checked="reduced_motion" data-event-change="motion(ev.checked)"/>
					<span class="nui-toggle__track nui-anim"><span class="nui-toggle__knob nui-anim"></span></span>
					<span class="nui-toggle__label">@ui.OPTION_UI_REDUCED_MOTION</span>
				</label>
			</div>
		</div>
	</div>
</body>
</rml>
