/* The target board's modern look (the mockup's Target board): the shared
   overlay board (nui-board--tooltip, the tooltips' translucent black, dark
   in both palettes) at the top center, 10dp from the top. A monster's head
   holds its level in a ring, its name with its grade, its HP in percent and
   the close button, over a 12dp HP bar with the damage chip, a sheen and
   ticks; another character's board holds its portrait, its name over its
   class and guild, and the relation buttons in a row below. Classic (the legacy thin board, the outlined whole name,
   the legacy gauge and the small thin buttons 68dp apart):
   skins/classic/windows/target.rcss. */

body.target
{
	focus: none;
	tab-index: none;
}
.target button
{
	focus: none;
	tab-index: none;
}
/* A full-width row that centers the board, which is as wide as it needs. */
.target__wrap
{
	position: absolute;
	left: 0;
	right: 0;
	top: 10dp;
	display: flex;
	flex-direction: row;
	justify-content: center;
}
.target-board
{
	display: block;
	position: relative;
	box-sizing: border-box;
	min-width: 220dp;
	padding: var(--space-2) var(--space-6) var(--space-2) var(--space-3);
}
/* A monster with its HP: the mockup's 320dp board, the head and the bar. */
.target-board--hp
{
	width: 320dp;
	padding: 8dp 8dp 10dp 10dp;
}
.target-board__head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 20dp;
}
.target-board--hp .target-board__head, .target-board--level .target-board__head
{
	justify-content: flex-start;
	height: 30dp;
}
/* Legacy's whole name is classic's; the modern head shows the title. */
.target-board__name
{
	display: none;
}
.target-board__title
{
	color: var(--text-inverse);
	font-size: 13dp;
	font-weight: bold;
	white-space: nowrap;
	font-effect: shadow(0dp 1dp var(--text-outline));
}
.target-board--hp .target-board__title
{
	flex: 1 1 auto;
	overflow: hidden;
	text-overflow: ellipsis;
	margin-right: var(--space-2);
}
/* The level badge: a ring in the danger color holding the level. */
.target-board__badge
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 30dp;
	height: 30dp;
	margin-right: var(--space-2);
	border-width: 1dp;
	border-color: var(--danger);
	border-radius: 9999dp;
	background-color: var(--slot-disabled);
	text-align: center;
}
.target-board__level
{
	color: var(--tip-negative);
	font-size: var(--font-sm);
	font-weight: bold;
	line-height: 28dp;
}
.target-board__pct
{
	flex: 0 0 auto;
	margin-right: 28dp;
	color: var(--tip-normal);
	font-size: var(--font-sm);
	font-weight: bold;
}
/* A player target's head (target-board--player): the portrait in a ring as
   the monster's badge draws it, clipped round (a stencil mask while it
   shows), the name over the class and guild line; the head above hides. */
.target-board--player .target-board__head
{
	display: none;
}
.target-board__player
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 34dp;
}
.target-board__portrait
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 34dp;
	height: 34dp;
	margin-right: var(--space-2);
	overflow: hidden;
	border-width: 1dp;
	border-color: var(--danger);
	border-radius: 17dp;
	background-color: var(--slot-disabled);
}
.target-board__face
{
	position: absolute;
	left: 0;
	top: 0;
	width: 32dp;
	height: 32dp;
}
.target-board__meta
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-width: 0;
}
.target-board__sub
{
	display: block;
	margin-top: 1dp;
	color: var(--tip-normal);
	font-size: var(--font-xs);
	line-height: 13dp;
	white-space: nowrap;
	font-effect: shadow(0dp 1dp var(--text-outline));
}
/* The legacy gauge in the head is classic's; the modern bar is below. */
progress.target-board__hp
{
	display: none;
	width: 130dp;
	flex: 0 0 auto;
}
.target-board__close
{
	position: absolute;
	right: var(--space-1);
	top: var(--space-1);
	width: 24dp;
	height: 24dp;
	line-height: 22dp;
	font-size: var(--font-md);
}
.target-board--hp .target-board__close
{
	top: 11dp;
}
.target-board__glyph
{
	position: absolute;
	left: 3dp;
	top: 3dp;
	transform: scale(0.8);
	--glyph-ink: var(--tip-normal);
}
.target-board__close:hover .target-board__glyph
{
	--glyph-ink: var(--text-inverse);
}

/* The HP bar: 12dp, full width under the head. */
.target-board__bar
{
	display: block;
	position: relative;
	height: 12dp;
	margin-top: 7dp;
}
progress.target-board__gauge, progress.target-board__cover, .target-board__sheen-clock, .target-board__ticks
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}
/* The track stays dark in both palettes, on the dark overlay board. */
progress.target-board__gauge
{
	background-color: var(--cooldown-shade);
}
/* The damage chip: a light cap on the fill's leading edge. */
progress.target-board__gauge fill
{
	border-right-width: 2dp;
	border-color: var(--chat-info);
}
progress.target-board__cover
{
	background-color: transparent;
}
progress.target-board__cover fill
{
	border-radius: 9999dp;
	background-color: var(--scene);
}
/* The sheen crosses the bar once every 4s (the taskbar's HP sheen): by
   transform only, scaled to nothing at rest and at its ends; its gradient
   exists only while it moves. */
.target-board__sheen-clock
{
	pointer-events: none;
}
.target-board__sheen
{
	display: block;
	position: absolute;
	left: 0;
	top: 2dp;
	bottom: 2dp;
	width: 100%;
	transform-origin: 10% 50%;
	transform: scaleX(0);
	pointer-events: none;
}
nui-blink.nui-blink-off .target-board__sheen
{
	decorator: linear-gradient(90deg, var(--sheen-clear) 0%, var(--sheen) 10%, var(--sheen-clear) 20%, var(--sheen-clear) 100%);
}
nui-blink.nui-blink-off .target-board__sheen.nui-anim
{
	animation: 1.7s cubic-in-out target-sheen;
}
/* Reduced motion: no sheen, and no clock toggling its gradient. */
@media (theme: reduced-motion)
{
	.target-board__sheen-clock
	{
		display: none;
	}
}
@keyframes target-sheen
{
	0% { transform: translateX(0%) scaleX(0); }
	12% { transform: translateX(8%) scaleX(1); }
	88% { transform: translateX(72%) scaleX(1); }
	100% { transform: translateX(80%) scaleX(0); }
}
/* Ticks at every tenth (nine; 30dp apart on the 300dp bar). */
.target-board__ticks
{
	width: 90%;
	decorator: repeating-linear-gradient(90deg, transparent 0%, transparent 10.4%, var(--cooldown-shade) 10.4%, var(--cooldown-shade) 11.11%);
	pointer-events: none;
}

.target-board__buttons
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: center;
	gap: var(--space-1);
	margin-top: var(--space-2);
	margin-right: -18dp;
}
/* One button per slot (the slot hides the exchange button out of range). */
.target-board__slot
{
	display: flex;
}
.target-board__button
{
	height: 26dp;
	line-height: 24dp;
	padding: 0 var(--space-3);
	font-size: var(--font-sm);
}
