/* The taskbar's modern layout (the mockup's Taskbar board): one bar along
   the bottom edge; at its left the mall coin, the HP, SP and stamina gauges
   (the HP's damage chip, recovery tail, sheen and ticks, the SP's flowing
   stripes, the stamina's segments, names and values) and the four liquid
   EXP orbs in a well; in its middle, in a well of their own, the
   mouse-button modes and the quickslots (key and grade pills, the cooldown's
   seconds, the active slot's aura); the window buttons with their hotkeys
   at its right; the mode menus and the skill picker above the mode
   buttons. The classic layout is in skins/classic/windows/taskbar.rcss.
   Positions are anchored as legacy anchors them: the middle group from the
   screen's center, the window buttons from its right edge. The buttons are
   code-drawn with glyphs (components/glyph.rcss); the legacy button art is
   classic's, in its overlay. Motion: the SP flow runs endlessly by
   transform; the aura only while a quickslot is active; the HP sheen and
   the coin's glint are short runs a nui-blink clock starts. */

body.taskbar
{
	focus: none;
	tab-index: none;
}
.taskbar button
{
	focus: none;
	tab-index: none;
}

.taskbar-bar
{
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 48dp;
}
.taskbar-base
{
	display: none;
}

/* --- Gauges, the mall button and the EXP orbs --------------------------------- */

/* The left group fits the 264dp the narrow-screen steps leave it below
   1250dp (the coin, 120dp vitals and the four orbs); from 1250dp up it takes
   the mockup's room (164dp vitals and the EXP percent beside the orbs), at
   the end of this sheet. */
.taskbar-gauges
{
	position: absolute;
	left: 0;
	top: 0;
	width: 268dp;
	height: 47dp;
}
/* The item mall button: a gold coin with the shop glyph engraved in it, a
   warm glow, and a glint that crosses it once every 4s (a light bar moved
   by transform; it rests invisible, so reduced motion leaves the plain
   coin). The coin's colors are the same in both palettes, as the mockup's.
   Classic draws the legacy coin animation in its frames part instead, and
   hides the glint's host, which stops its clock too. The glint is a 0.72s
   animation that the nui-blink clock starts at each of its off halves, so
   between two glints nothing restyles. */
.taskbar-mall
{
	left: 5dp;
	top: 6dp;
	width: 36dp;
	height: 36dp;
	border-width: 1dp;
	border-color: var(--tip-socket-gold);
	border-radius: 9999dp;
	background-color: var(--tip-price);
	decorator: radial-gradient(circle at 50% 30%, var(--ember-hot) 0%, var(--tip-price) 45%, var(--tip-socket-gold) 100%);
}
.taskbar-mall.nui-fx
{
	box-shadow: 0 0 0 1dp var(--cooldown-shade), 0 0 12dp var(--ember-glow), inset 0 -3dp 5dp var(--cooldown-shade);
}
.taskbar-mall:hover, .taskbar-mall:active
{
	border-color: var(--ember-hot);
	background-color: var(--tip-price);
}
.taskbar-mall .taskbar-glyph, .taskbar-mall:hover .taskbar-glyph
{
	left: 9dp;
	top: 9dp;
	--glyph-ink: var(--scene);
}
.taskbar-mall__sheen
{
	display: block;
	position: absolute;
	left: 6dp;
	top: 5dp;
	width: 5dp;
	height: 24dp;
	border-radius: 3dp;
	background-color: var(--ember-hot);
	opacity: 0;
	pointer-events: none;
}
.taskbar-mall__beat, .taskbar-mall__blink
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	pointer-events: none;
}
nui-blink.nui-blink-off .taskbar-mall__sheen.nui-anim
{
	animation: 0.72s linear-in-out taskbar-mall-sheen;
}
@keyframes taskbar-mall-sheen
{
	0% { transform: translateX(0dp) rotate(20deg); opacity: 0; }
	22% { transform: translateX(4dp) rotate(20deg); opacity: 0.8; }
	100% { transform: translateX(20dp) rotate(20deg); opacity: 0; }
}

/* The vitals: HP, SP and stamina, stacked, each a gauge host 120dp wide. */
.taskbar-gauge-host
{
	display: block;
	position: absolute;
	left: 48dp;
	width: 120dp;
	pointer-events: auto;
}
.taskbar-gauge-host--hp
{
	top: 7dp;
	height: 13dp;
}
.taskbar-gauge-host--sp
{
	top: 23dp;
	height: 10dp;
}
.taskbar-gauge-host--st
{
	top: 36dp;
	height: 5dp;
}
/* Every layer of a gauge fills its host. */
progress.taskbar-gauge, progress.taskbar-recovery, progress.taskbar-cover,
.taskbar-sheen-clock, .taskbar-flow-clip, .taskbar-ticks, .taskbar-segments
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}
/* The track and the recovery to come: a lighter tail under the gauge, as
   long as the HP or SP the regeneration will reach. */
progress.taskbar-recovery
{
	border-radius: 9999dp;
	background-color: var(--gauge-track);
}
progress.taskbar-recovery fill
{
	border-radius: 9999dp;
}
progress.taskbar-recovery--hp fill
{
	background-color: var(--hp-recovery);
}
progress.taskbar-recovery--sp fill
{
	background-color: var(--sp-recovery);
}
/* HP and SP draw over their recovery bar, which holds the track. */
progress.taskbar-gauge--hp.nui-gauge, progress.taskbar-gauge--sp.nui-gauge
{
	background-color: transparent;
}
/* The damage chip: a light cap that trails the HP fill's leading edge (the
   fill's right border, outside the part the value sizes). */
progress.taskbar-gauge--hp fill
{
	border-right-width: 2dp;
	border-color: var(--chat-info);
}
/* The empty part of a gauge, drawn again over the moving light (the sheen,
   the flow) from the right edge to the fill or the recovery tail, whichever
   is longer, so the light shows on the fill alone. */
progress.taskbar-cover
{
	background-color: transparent;
}
progress.taskbar-cover fill
{
	border-radius: 9999dp;
	background-color: var(--gauge-track);
}
/* The HP sheen: a light band that crosses the bar once every 4s, scaled to
   nothing at its ends and at rest (so reduced motion shows the plain bar),
   by transform only; the band is as wide as the bar, its light in its first
   fifth, so the move is a share of the bar's width. Its gradient exists only
   in the blink's off half, while it moves. */
.taskbar-sheen-clock
{
	display: block;
	pointer-events: none;
}
.taskbar-sheen
{
	display: block;
	position: absolute;
	left: 0;
	top: 2dp;
	bottom: 2dp;
	width: 100%;
	transform-origin: 10% 50%;
	transform: scaleX(0);
	pointer-events: none;
}
nui-blink.nui-blink-off .taskbar-sheen
{
	decorator: linear-gradient(90deg, var(--sheen-clear) 0%, var(--sheen) 10%, var(--sheen-clear) 20%, var(--sheen-clear) 100%);
}
nui-blink.nui-blink-off .taskbar-sheen.nui-anim
{
	animation: 1.7s cubic-in-out taskbar-sheen;
}
/* Reduced motion: no sheen, and no clock toggling its gradient. */
@media (theme: reduced-motion)
{
	.taskbar-sheen-clock
	{
		display: none;
	}
}
@keyframes taskbar-sheen
{
	0% { transform: translateX(0%) scaleX(0); }
	12% { transform: translateX(8%) scaleX(1); }
	88% { transform: translateX(72%) scaleX(1); }
	100% { transform: translateX(80%) scaleX(0); }
}
/* The SP flow: light stripes that drift right along the fill, endlessly, by
   transform only (one stripe period, 13.24dp, per 1.2s), in a square clip
   (a scissor, no stencil; forced, since RmlUi counts neither a transform
   nor an absolute box as overflow). At rest (reduced motion) they stand
   still. */
.taskbar-flow-clip
{
	display: block;
	overflow: hidden;
	clip: always;
	pointer-events: none;
}
.taskbar-flow
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: -14dp;
	bottom: 0;
	decorator: repeating-linear-gradient(115deg, var(--tip-divider) 0dp, var(--tip-divider) 4dp, transparent 4dp, transparent 12dp);
	pointer-events: none;
}
.taskbar-flow.nui-anim
{
	animation: 1.2s linear-in-out infinite taskbar-flow;
}
@keyframes taskbar-flow
{
	from { transform: translateX(-13.24dp); }
	to { transform: translateX(0dp); }
}
/* The HP ticks, every tenth of the bar (nine, none at the ends). */
.taskbar-ticks
{
	display: block;
	width: 90%;
	decorator: repeating-linear-gradient(90deg, transparent 0%, transparent 10.4%, var(--cooldown-shade) 10.4%, var(--cooldown-shade) 11.11%);
	pointer-events: none;
}
/* Stamina in twenty segments: gaps of the bar's own surface over the fill
   and the track. */
.taskbar-segments
{
	display: block;
	decorator: repeating-linear-gradient(90deg, transparent 0%, transparent 4.1%, var(--surface) 4.1%, var(--surface) 5%);
	pointer-events: none;
}
/* The gauge's name at its left and its value in its middle, light text
   outlined so it reads on the fill and on the track in both palettes. */
.taskbar-gauge-label, .taskbar-gauge-value
{
	display: block;
	position: absolute;
	top: 0;
	height: 100%;
	color: var(--text-inverse);
	font-weight: bold;
	white-space: nowrap;
	font-effect: outline(1dp var(--text-outline));
	pointer-events: none;
}
.taskbar-gauge-label
{
	left: 6dp;
	font-size: 8dp;
}
.taskbar-gauge-value
{
	left: 0;
	right: 0;
	font-size: 9dp;
	text-align: center;
}
.taskbar-gauge-host--hp .taskbar-gauge-label, .taskbar-gauge-host--hp .taskbar-gauge-value
{
	line-height: 13dp;
}
.taskbar-gauge-host--sp .taskbar-gauge-label, .taskbar-gauge-host--sp .taskbar-gauge-value
{
	line-height: 10dp;
}

/* The EXP orbs: four glass orbs in a pill well, each filled from the
   bottom with gold liquid (its quarter of the level), a gold rim and a
   gloss over it; a full orb glows. The orb is the glass element alone: its
   liquid is a gradient with a hard stop at the level (the custom property
   --orb-level, from the feed, data-style---orb-level), drawn in the round
   box, so the surface is level at any height; the gradient is made again
   only when the level changes. The progress elements are classic's (the
   legacy point art cut at the value); the modern skins hide them. */
.taskbar-exp
{
	display: block;
	position: absolute;
	left: 172dp;
	top: 8dp;
	width: 92dp;
	height: 32dp;
	box-sizing: border-box;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 9999dp;
	background-color: var(--surface-sunken);
	pointer-events: auto;
}
progress.taskbar-orb
{
	display: none;
	position: absolute;
}
.taskbar-orb-glass
{
	--orb-level: 0%;
	display: block;
	position: absolute;
	top: 6dp;
	width: 18dp;
	height: 18dp;
	box-sizing: border-box;
	border-width: 1dp;
	border-color: var(--edge-gm);
	border-radius: 9999dp;
	background-color: var(--gauge-track);
	decorator: radial-gradient(circle at 38% 26%, var(--sheen) 0%, var(--sheen-clear) 38%),
		linear-gradient(0deg, var(--edge-gm) 0%, var(--gauge-pink) var(--orb-level), var(--sheen-clear) var(--orb-level), var(--sheen-clear) 100%);
	pointer-events: none;
}
.taskbar-orb-glass.is-full
{
	border-color: var(--ember-hot);
}
.taskbar-orb-glass.is-full.nui-fx
{
	box-shadow: 0 0 7dp var(--ember-glow);
}
.taskbar-orb--1 { left: 5dp; }
.taskbar-orb--2 { left: 26dp; }
.taskbar-orb--3 { left: 47dp; }
.taskbar-orb--4 { left: 68dp; }
/* The EXP percent beside the orbs, where there is room (below). */
.taskbar-exp__pct
{
	display: none;
	position: absolute;
	left: 92dp;
	top: 0;
	color: var(--gauge-pink);
	font-size: var(--font-sm);
	font-weight: bold;
	line-height: 30dp;
	white-space: nowrap;
	pointer-events: none;
}

/* The optional skin parts (P13 D21): hidden here and in classic; a skin's
   overlay gives them a display and a place. */
.taskbar-hp-ring, .taskbar-value
{
	display: none;
}

/* --- The middle group's well ------------------------------------------------------ */

/* A rounded well behind the mouse-button modes and the quickslots, 4dp past
   them on each side (the EXP well ends 2dp short of it at 1060dp). */
.taskbar-center
{
	display: block;
	position: absolute;
	left: 50%;
	top: 1dp;
	margin-left: -266dp;
	width: 532dp;
	height: 46dp;
	box-sizing: border-box;
	border-width: 1dp;
	border-color: var(--border);
	border-radius: 12dp;
	decorator: vertical-gradient(var(--surface-raised) var(--surface-sunken));
	pointer-events: none;
}

/* --- Buttons: chips with glyphs ------------------------------------------------ */

.taskbar-mall, .taskbar-mode, .taskbar-window, .taskbar-expand, .taskbar-pager__up, .taskbar-pager__down
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	padding: 0;
	pointer-events: auto;
}
.taskbar-mode, .taskbar-window, .taskbar-expand, .taskbar-pager__up, .taskbar-pager__down
{
	border-width: 1dp;
	border-color: transparent;
	border-radius: 7dp;
	background-color: transparent;
}
.taskbar-mode, .taskbar-window
{
	width: 40dp;
	height: 40dp;
}
/* The mouse-button modes: a cell like a quickslot's, with the mouse and its
   button in the top left corner. */
.taskbar-mode
{
	border-color: var(--border);
	background-color: var(--surface-sunken);
}
.taskbar-mode:hover, .taskbar-expand:hover
{
	background-color: var(--surface-hover);
	border-color: var(--accent);
}
.taskbar-mode:active, .taskbar-mode.is-open, .taskbar-expand:active
{
	background-color: var(--selection);
	border-color: var(--accent);
}
/* The window buttons: no chip at rest; a soft accent light under the
   pointer, a deeper one pressed. */
.taskbar-window:hover
{
	decorator: radial-gradient(circle at 50% 65%, var(--accent-glow) 0%, transparent 70%);
}
/* A button whose window is open (is-open): an accent ring around the soft
   light, the glyph in the accent and a short accent bar on the bottom edge
   (taskbar-open, hidden on the other buttons). */
.taskbar-window.is-open
{
	border-color: var(--accent-glow);
	decorator: radial-gradient(circle at 50% 60%, var(--accent-glow) 0%, transparent 70%);
}
.taskbar-window.is-open .taskbar-glyph
{
	--glyph-ink: var(--accent);
}
.taskbar-open
{
	display: none;
	position: absolute;
	left: 50%;
	bottom: -2dp;
	width: 14dp;
	height: 2dp;
	margin-left: -7dp;
	border-radius: 1dp;
	background-color: var(--accent);
	pointer-events: none;
}
.taskbar-window.is-open .taskbar-open
{
	display: block;
}
.taskbar-window:active
{
	background-color: var(--selection);
	decorator: none;
}

/* Each button's glyph, centered in the button's padding box (the mode
   buttons switch their glyph's shape with their mode), in the accent under
   the pointer. */
.taskbar-glyph
{
	position: absolute;
	left: 11dp;
	top: 11dp;
	transform: scale(1.25);
}
.taskbar-mode:hover .taskbar-glyph, .taskbar-window:hover .taskbar-glyph, .taskbar-expand:hover .taskbar-glyph,
.taskbar-pager__up:hover .taskbar-glyph, .taskbar-pager__down:hover .taskbar-glyph
{
	--glyph-ink: var(--accent);
}
/* The window buttons' glyphs are larger, over their hotkey. */
.taskbar-window .taskbar-glyph
{
	top: 7dp;
	transform: scale(1.4);
}
.taskbar-hotkey
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	bottom: 1dp;
	color: var(--text-muted);
	font-size: 8dp;
	font-weight: bold;
	line-height: 9dp;
	text-align: center;
	pointer-events: none;
}
.taskbar-window:hover .taskbar-hotkey
{
	color: var(--text);
}
.taskbar-expand .taskbar-glyph
{
	left: 3dp;
	transform: none;
	--glyph-ink: var(--text-muted);
}
/* The page buttons are 12dp tall: the chevron's ink, the middle of its
   16dp box, on the middle of their 10dp padding box. */
.taskbar-pager__up .taskbar-glyph, .taskbar-pager__down .taskbar-glyph
{
	left: 3dp;
	top: -3dp;
	transform: none;
	--glyph-ink: var(--text-muted);
}

/* The mouse in a mode cell: a small rounded body with its left or right
   button in the accent. */
.taskbar-mouse
{
	display: block;
	position: absolute;
	left: 2dp;
	top: 2dp;
	z-index: 4;
	box-sizing: border-box;
	width: 9dp;
	height: 12dp;
	border-width: 1dp;
	border-color: var(--text-muted);
	border-radius: 5dp;
	background-color: var(--tooltip-bg);
	pointer-events: none;
}
.taskbar-mouse__button
{
	display: block;
	position: absolute;
	top: 0;
	width: 3dp;
	height: 5dp;
	background-color: var(--accent);
}
.taskbar-mouse--left .taskbar-mouse__button
{
	left: 0;
	border-radius: 4dp 0 0 0;
}
.taskbar-mouse--right .taskbar-mouse__button
{
	right: 0;
	border-radius: 0 4dp 0 0;
}

.taskbar-mode--left
{
	left: 50%;
	top: 4dp;
	margin-left: -262dp;
}
.taskbar-mode--right
{
	left: 50%;
	top: 4dp;
	margin-left: 222dp;
}
.taskbar-right-skill
{
	position: absolute;
	left: 50%;
	top: 4dp;
	margin-left: 222dp;
}

.taskbar-window--character
{
	right: 140dp;
	top: 4dp;
}
.taskbar-window--inventory
{
	right: 96dp;
	top: 4dp;
}
.taskbar-window--messenger
{
	right: 52dp;
	top: 4dp;
}
.taskbar-window--system
{
	right: 8dp;
	top: 4dp;
}

/* The camera mode image while the quick camera key is held, over the right
   mode button. */
.taskbar-camera
{
	position: absolute;
	left: 50%;
	top: 4dp;
	margin-left: 222dp;
	width: 40dp;
	height: 40dp;
	box-sizing: border-box;
	border-width: 1dp;
	border-color: var(--accent);
	border-radius: 7dp;
	background-color: var(--selection);
}

/* --- Quickslots ------------------------------------------------------------------ */

.taskbar-quick
{
	position: absolute;
	left: 50%;
	top: 4dp;
	margin-left: -214dp;
	width: 428dp;
	height: 40dp;
}
/* Eight 40dp cells 4dp apart, the fifth 28dp further right: the gap the
   expand button sits in (cells 1 to 4 end at 172dp, 5 to 8 start at 204dp). */
.taskbar-quick-grid
{
	position: absolute;
	left: 0;
	top: 0;
	width: 376dp;
	flex-wrap: nowrap;
	pointer-events: auto;
}
.taskbar-quick-grid .nui-slot:nth-child(5)
{
	margin-left: 28dp;
}
.taskbar-expand
{
	left: 176dp;
	top: 0;
	width: 24dp;
	height: 40dp;
	border-color: var(--border);
}
/* The key in a pill at the cell's top left. */
.taskbar-key
{
	left: 2dp;
	top: 2dp;
	padding: 0 3dp;
	border-radius: 4dp;
	background-color: var(--tooltip-bg);
	color: var(--text-inverse);
	font-size: 8dp;
	font-weight: bold;
	line-height: 11dp;
}
.taskbar-key-art
{
	display: none;
}
/* The count or skill level in a pill at the bottom right; a skill's grade
   (the legacy label: m1 to m10, g1 to g10, p) in its grade's color. */
.taskbar-cell .taskbar-count
{
	right: 2dp;
	bottom: 2dp;
	padding: 0 3dp;
	border-radius: 4dp;
	font-size: 9dp;
	line-height: 12dp;
}
.taskbar-cell .taskbar-count--m
{
	background-color: var(--tip-positive);
	color: var(--scene);
}
.taskbar-cell .taskbar-count--g
{
	background-color: var(--gauge-blue);
	color: var(--text-inverse);
}
.taskbar-cell .taskbar-count--p
{
	background-color: var(--tip-socket-gold);
	color: var(--scene);
}
/* The seconds of a cooldown, over its sweep. */
.taskbar-cool
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	z-index: 4;
	color: var(--text-inverse);
	font-size: 13dp;
	font-weight: bold;
	line-height: 32dp;
	text-align: center;
	font-effect: outline(1dp var(--text-outline));
	pointer-events: none;
}
/* An active quickslot: the accent edge and the component's static glow,
   and the aura, a spark that runs along the cell's edge, round in 2.2s,
   endlessly while the slot is active (by transform; it rests at the top
   left corner under reduced motion). It stands in for the component's
   breathing ring, which this grid does not show (nor run). */
.taskbar-quick-grid .nui-slot.is-active
{
	border-color: var(--accent);
}
.taskbar-quick-grid .nui-slot__ring
{
	display: none;
}
.taskbar-quick-grid .nui-slot__ring.is-on.nui-anim
{
	animation: none;
}
.taskbar-aura
{
	display: block;
	position: absolute;
	left: -6dp;
	top: -6dp;
	z-index: 6;
	width: 12dp;
	height: 12dp;
	decorator: radial-gradient(circle, var(--text-inverse) 0%, var(--accent) 30%, transparent 70%);
	pointer-events: none;
}
.taskbar-aura.is-on.nui-anim
{
	animation: 2.2s linear-in-out infinite taskbar-aura;
}
@keyframes taskbar-aura
{
	0% { transform: translate(0dp, 0dp); }
	25% { transform: translate(38dp, 0dp); }
	50% { transform: translate(38dp, 38dp); }
	75% { transform: translate(0dp, 38dp); }
	100% { transform: translate(0dp, 0dp); }
}

.taskbar-pager
{
	position: absolute;
	left: 380dp;
	top: 0;
	width: 24dp;
	height: 40dp;
}
.taskbar-pager__board
{
	display: none;
}
.taskbar-pager__up, .taskbar-pager__down
{
	left: 0;
	width: 24dp;
	height: 12dp;
}
.taskbar-pager__up
{
	top: 0;
}
.taskbar-pager__down
{
	top: 28dp;
}
.taskbar-pager__page
{
	display: block;
	position: absolute;
	left: 0;
	top: 12dp;
	width: 24dp;
	height: 16dp;
	color: var(--text);
	font-size: var(--font-md);
	font-weight: bold;
	line-height: 16dp;
	text-align: center;
	pointer-events: none;
}

/* --- Tooltips -------------------------------------------------------------------- */

.taskbar-tip
{
	pointer-events: none;
}
/* Near the screen's right edge (the inventory, messenger and system
   buttons): the hint grows to the left. */
.taskbar-tip--end
{
	left: auto;
	right: 0;
	margin-right: 0;
	margin-left: -320dp;
}
/* The left mode menu's hints, left of their buttons. */
.taskbar-tip--side
{
	left: auto;
	right: 100%;
	bottom: auto;
	top: 10dp;
	margin-bottom: 0;
	margin-right: var(--space-1);
	margin-left: -320dp;
}

/* --- Mode menus and the skill picker --------------------------------------------- */

.taskbar-menu
{
	position: absolute;
	bottom: 52dp;
	padding: var(--space-1);
}
.taskbar-menu .taskbar-mode
{
	position: relative;
	margin: 0;
}
.taskbar-menu--left
{
	left: 50%;
	margin-left: -267dp;
	width: 50dp;
	height: 130dp;
}
.taskbar-menu--left .taskbar-mode
{
	display: block;
	margin-bottom: var(--space-1);
}
.taskbar-menu--right
{
	left: 50%;
	margin-left: 173dp;
	width: 94dp;
	height: 50dp;
	display: flex;
	flex-direction: row;
	gap: var(--space-1);
}
/* One panel above the right menu: the first category's row at the bottom,
   each row's first skill at its right, as legacy lays the picker out. */
/* 4dp above the right menu, whose box is 60dp tall from 52dp up (50dp,
   its padding and its border). */
.taskbar-picker
{
	position: absolute;
	right: 50%;
	margin-right: -262dp;
	bottom: 116dp;
	display: flex;
	flex-direction: column-reverse;
	align-items: flex-end;
	gap: var(--space-1);
	padding: var(--space-1);
}
.taskbar-picker__row
{
	flex-direction: row-reverse;
}

/* --- Wide screens ------------------------------------------------------------------
   From 1250dp the left group takes the mockup's room: it ends at 352dp, 7dp
   short of the middle group's well, which starts 266dp left of the center. The
   coin grows to 38dp, the vitals to 160dp, and the EXP well holds the
   percent beside the orbs. */
@media (min-width: 1250dp)
{
	.taskbar-gauges { width: 352dp; }
	.taskbar-mall { left: 6dp; top: 5dp; width: 38dp; height: 38dp; }
	.taskbar-mall .taskbar-glyph, .taskbar-mall:hover .taskbar-glyph { left: 10dp; top: 10dp; }
	.taskbar-mall__sheen { left: 7dp; top: 6dp; }
	.taskbar-gauge-host { left: 52dp; width: 160dp; }
	.taskbar-gauge-host--hp { top: 6dp; height: 14dp; }
	.taskbar-gauge-host--sp { top: 23dp; height: 11dp; }
	.taskbar-gauge-host--st { top: 37dp; height: 5dp; }
	.taskbar-gauge-label { font-size: 9dp; }
	.taskbar-gauge-value { font-size: 10dp; }
	.taskbar-gauge-host--hp .taskbar-gauge-label, .taskbar-gauge-host--hp .taskbar-gauge-value { line-height: 14dp; }
	.taskbar-gauge-host--sp .taskbar-gauge-label, .taskbar-gauge-host--sp .taskbar-gauge-value { line-height: 11dp; }
	.taskbar-exp { left: 220dp; width: 132dp; }
	.taskbar-exp__pct { display: block; }
}

/* --- Narrow screens ----------------------------------------------------------------
   The bar needs 1060dp: the gauges and the EXP orbs end at 268dp, and the
   middle group starts 262dp left of the center. On a narrower screen (a
   1280 wide one at 150%, 1024 at 100%) the whole document shrinks about its
   bottom-left corner, in steps, until the bar fits again; the document grows
   by the inverse, so its center and right anchors stay on the screen's, and
   the menus and the picker shrink with their buttons. Classic fits from
   800dp and resets this (skins/classic/windows/taskbar.rcss). The last step
   (60%) fits from 636dp; below that the parts touch again. */
@media (max-width: 1059dp)
{
	body.taskbar { top: -5.2632%; width: 105.2632%; height: 105.2632%; transform-origin: 0% 100%; transform: scale(0.95); }
}
@media (max-width: 1006dp)
{
	body.taskbar { top: -11.1111%; width: 111.1111%; height: 111.1111%; transform: scale(0.9); }
}
@media (max-width: 953dp)
{
	body.taskbar { top: -17.6471%; width: 117.6471%; height: 117.6471%; transform: scale(0.85); }
}
@media (max-width: 900dp)
{
	body.taskbar { top: -25%; width: 125%; height: 125%; transform: scale(0.8); }
}
@media (max-width: 847dp)
{
	body.taskbar { top: -33.3333%; width: 133.3333%; height: 133.3333%; transform: scale(0.75); }
}
@media (max-width: 794dp)
{
	body.taskbar { top: -42.8571%; width: 142.8571%; height: 142.8571%; transform: scale(0.7); }
}
@media (max-width: 741dp)
{
	body.taskbar { top: -53.8462%; width: 153.8462%; height: 153.8462%; transform: scale(0.65); }
}
@media (max-width: 688dp)
{
	body.taskbar { top: -66.6667%; width: 166.6667%; height: 166.6667%; transform: scale(0.6); }
}
