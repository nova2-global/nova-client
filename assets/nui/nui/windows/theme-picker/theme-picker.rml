<rml>
<head>
	<!-- Intro theme picker: one button per player theme (nui/theme/themes.json),
	     under the legacy flag strip at the top left. Controller:
	     assets/root/nui_theme_picker.py; nui_login.py opens it with the login
	     board. Its body never takes the focus, so a press leaves the board's
	     caret and typed text where they are; RmlUi then sends no click, so
	     the buttons act on mousedown. The label is plain English for now, like
	     the theme labels. -->
	<title>theme-picker</title>
	<link type="text/template" href="../../nui.rtpl"/>
	<link type="text/rcss" href="theme-picker.rcss"/>
</head>
<body template="nui" class="theme-picker" data-model="theme_picker">
	<span class="theme-picker__label">Theme</span>
	<button class="nui-button nui-button--small theme-picker__button" data-for="theme : themes" data-attr-id="'theme-pick-' + theme.id" data-class-is-selected="theme.id == current" data-event-mousedown="pick(theme.id, ev.button)">{{ theme.label }}</button>
</body>
</rml>
